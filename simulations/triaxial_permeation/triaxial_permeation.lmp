# ================= Triaxial Permeation Simulation (piston-driven flow) =======
# PERMEATION MODE ONLY.  Split out of slab_with_flow.lmp (which carried both
# compression and permeation modes behind compression_mode logic gates) so the
# permeation path is self-contained and free of per-step mode branching.
# The compression counterpart lives in ../triaxial_compression/.
#
# Starting from an equilibrated configuration produced by the slab_with_support
# PERIODIC slab workflow (slab_with_support_periodic.ipynb).
# Variables from bash script: dataname, interaction, epsSS, epsSP, nsteps
#
# Atom types: 1=polymer, 2=crosslinker, 3=solvent, 4=support, 5=piston
#   (PERIODIC geometry — laterally periodic, NO type-6 side walls.)
#
# Reduced LJ units: tau = sigma*sqrt(m/epsilon)
# dt = 0.005 → 1e6 steps ≈ 4.1e3 tau
#
# Behaviour:
#   - Phase 0:   NVT equilibration at fixed box volume (piston z-free, floats;
#                piston-solvent WCA OFF so the piston can be repositioned later).
#   - Phase 0.5: anisotropic Langevin + NPH re-pressurises the box to P_target
#                (the fixed-volume read relaxes below P_target otherwise).
#   - Phase 2:   (1) REPOSITION the piston to the 35/65 free-solvent split
#                (piston-solvent still OFF -> slides freely); (2) turn piston-
#                solvent WCA ON so it pushes solvent as a plug; (3) constant-
#                PRESSURE (force-controlled) production drive.  Records feed/
#                permeate reservoir pressures and permeate flux.  Halts if the
#                feed reservoir thins to feed_halt_thick (piston nears the gel).


# ==========================================================================
#                              PARAMETERS
# ==========================================================================

# ----- Continuation flag -----
# 0 = fresh start (default)
# 1 = continuation from a final .data file (via continue_sim.sh)
#
# When cont=1, Phase 0 / Phase 0.5 are skipped (the data file already holds the
# equilibrated, re-pressurised state); Phase 2 resumes from the current config.
variable cont index 0

# ----- Physical Parameters -----
variable sigma         equal 1.0
variable temp_target   equal 1.0
variable P_target      equal 1.5
variable timestep_prod equal 0.005

# ----- Phase 0: NVT equilibration steps -----
variable perm_setup_freq equal 50000    # permeation Phase 0 NVT

# ----- Permeation Phase 2 -----
# NOTE: production is now constant-PRESSURE (force-controlled) — see the Phase 2
# piston block for v_reposition / P_piston.  v_piston_perm is retained only as a
# legacy velocity knob and is NOT used to drive production.
variable v_piston_perm     equal 0.002  # σ/τ (legacy; unused by force-controlled production)
variable feed_halt_thick   equal 2.0    # halt when feed reservoir ≤ this (σ)
variable flux_freq         equal 1000   # permeate bead count output interval (steps)

# ----- Output Frequencies -----
variable thermo_freq     equal 25000 # 2000  # 250000
variable dump_freq_setup equal 10000      # frequent dumps during Phase 1
variable dump_freq_prod  equal 20000 # 5000 # 100000     # sparse dumps during Phase 2
variable volume_freq     equal 5000 # 1000 # 5000

# Cavity Widom dump cadence — all-atom frames for cavity_widom.py post-processing.
# More frames → lower noise in time-averaged μ_ex(z): noise ∝ 1/√num_widom_frames.
# Dump runs during the production phase.
variable num_widom_frames equal 50
variable nfreq_widom_dump equal floor(${nsteps}/v_num_widom_frames)

# ======================================================================

# ----- Time Averaging (stress) -----
# nfreq = nevery * nrepeat  (LAMMPS constraint)
variable num_stress_curves equal 10    # target output frames
variable nevery_target     equal 100   # ~0.5 tau — near stress decorrelation time
variable nrepeat_max       equal 2000  # cap to preserve transient resolution
variable nrepeat_min       equal 50    # floor for adequate noise reduction

variable nfreq_raw    equal floor(${nsteps}/v_num_stress_curves)
variable nrepeat_raw  equal floor(v_nfreq_raw/v_nevery_target)

# Clamp nrepeat to [min, max]
variable nr_lo equal (v_nrepeat_raw>v_nrepeat_min)*v_nrepeat_raw+(v_nrepeat_raw<=v_nrepeat_min)*v_nrepeat_min
variable nrepeat_stress equal (v_nr_lo<v_nrepeat_max)*v_nr_lo+(v_nr_lo>=v_nrepeat_max)*v_nrepeat_max

# Derive nevery and enforce exact constraint
variable nevery_stress equal floor(v_nfreq_raw/v_nrepeat_stress)
variable nfreq_stress  equal v_nevery_stress*v_nrepeat_stress

print ">>> Stress: nevery=${nevery_stress} nrepeat=${nrepeat_stress} nfreq=${nfreq_stress}"
print ">>> Mode: PERMEATION (piston-driven flow)"

# ----- Spatial Binning -----
variable binWidth    equal 2.0
variable rg_scale    equal 1.8   # Rg multiplier (~90% coverage for Gaussian)
variable region_frac equal 1     # fraction of polymer extent for analysis regions


# ==========================================================================
#                           INITIALIZATION
# ==========================================================================

units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

# Single lj/cut pair style.
# NOTE: sub-style virial filtering ("compute stress/atom NULL pair <style>")
# is not supported by this LAMMPS build — the "pair" keyword in compute
# stress/atom includes ALL pair interactions and takes no further arguments.
# The hybrid pair_style approach (using lj/expand for 3-3 to get a unique
# style name) was attempted but also rejected.  The solvent-solvent-only
# stress decomposition is therefore omitted; see the poroelasticity notes
# in compression_analysis.ipynb for the post-processing correction.
pair_style lj/cut 1.122
bond_style fene

read_data data_files/${dataname}.data nocoeff

comm_modify cutoff 5.0

print "========================================"
print "Triaxial permeation simulation: ${dataname}"
print "Interaction: epsSS=${epsSS}, epsSP=${epsSP}"
print "Production steps: ${nsteps}"
print "Permeation: force-controlled piston (constant pressure); see Phase 2 for P_piston"
print "========================================"


# ==========================================================================
#                          GROUP DEFINITIONS
# ==========================================================================

group polymer   type 1 2
group solvent   type 3
group support   type 4
group piston    type 5
group mobile    type 1 2 3
group gel_system type 1 2 3 4 5


# ==========================================================================
#                       INTERATOMIC POTENTIALS
# ==========================================================================

# Default: full LJ for all pairs
pair_coeff * * 1.0 ${sigma} 1.122

# Polymer-solvent (tunable)
pair_coeff 1 3 ${epsSP} ${sigma} 1.122    # polymer-solvent
pair_coeff 2 3 ${epsSP} ${sigma} 1.122    # crosslinker-solvent

# Solvent-solvent (tunable)
pair_coeff 3 3 ${epsSS} ${sigma} 1.122    # solvent-solvent

# Polymer/crosslinker with support and piston (WCA repulsive)
pair_coeff 1 4 1.0 ${sigma} 1.122
pair_coeff 2 4 1.0 ${sigma} 1.122
pair_coeff 1 5 1.0 ${sigma} 1.122
pair_coeff 2 5 1.0 ${sigma} 1.122

# Solvent-piston: mode-dependent from the start.
#   Compression: OFF — piston passes through solvent freely, loads gel directly.
#   Permeation:  ON  — piston pushes solvent as a plug through the gel.
# PERMEATION pre-positioning: piston-solvent WCA starts OFF so the piston can be
# repositioned by sliding freely THROUGH the solvent to the 45/55 split (see
# Phase 2).  It is turned ON there (pair_coeff 3 5 1.0 ...) only AFTER
# repositioning, so the piston then pushes the solvent as a plug through the gel.
pair_coeff 3 5 0.0 ${sigma} 0.0          # OFF until repositioning done (Phase 2)


# Non-interacting pairs
pair_coeff 3 4 0.0 ${sigma} 0.0   # solvent-support
pair_coeff 4 4 0.0 ${sigma} 0.0   # support-support
pair_coeff 4 5 0.0 ${sigma} 0.0   # support-piston
pair_coeff 5 5 0.0 ${sigma} 0.0   # piston-piston

# ----- Bonds and Angles -----
bond_coeff * 30.0 1.5 1.0 1.0
special_bonds fene

# Angle style — hybrid (uncomment if angles are present in data file)
#angle_style hybrid cosine harmonic
#angle_coeff 1 cosine 1.0
#angle_coeff 2 harmonic 40.0 109.47

# ----- Neighbor List Exclusions -----
neigh_modify exclude type 4 4   # support-support
neigh_modify exclude type 5 5   # piston-piston
neigh_modify exclude type 4 5   # support-piston


# ==========================================================================
#                           RIGID BODIES
# ==========================================================================

# Support: completely frozen
velocity support set 0.0 0.0 0.0
fix rigid_support support rigid single force * off off off torque * off off off


# Piston: z-motion enabled from the start (rigid, z-DOF free) so it floats on
# the solvent.  Released to nve+setforce during Phase 0.5 (aniso NPH) so it
# scales with the box, then restored to this z-free rigid float.  In Phase 2 it
# is repositioned (velocity), then switched to constant-pressure force control.
velocity piston set 0.0 0.0 0.0


fix rigid_piston piston rigid single force * off off on torque * off off off


# ==========================================================================
#                           THERMO OUTPUT
# ==========================================================================

compute mobile_temp mobile temp
compute mobile_press all pressure thermo_temp pair bond
thermo_style custom step c_mobile_temp pe ke etotal press c_mobile_press vol lx ly lz
thermo_modify lost warn
thermo ${thermo_freq}

# ----- Piston force compute (defined early to record a Phase 0 baseline) -----
# c_piston_fz: sum of pairwise z-forces on ALL piston atoms.
#   Positive = net upward (gel/solvent pushing piston up).
#   The piston floats z-free (no setforce), so the value is live from Phase 0 on.
compute piston_fz      piston reduce sum fz
variable piston_area      equal lx*ly          # cross-sectional area of simulation box
variable piston_pressure_z equal c_piston_fz/v_piston_area  # force normalised by area


# ==========================================================================
#                    PHASE 0: NVT EQUILIBRATION
# ==========================================================================
# Equilibrate at the current box volume.  No pressure adjustment here — the box
# is re-pressurised to P_target by the aniso Langevin+NPH block (Phase 0.5).
# Box dimensions stay fixed throughout Phase 0.

print "========================================"
print "Phase 0: NVT equilibration"
print "========================================"

reset_timestep 0
timestep ${timestep_prod}

# ----- cont=1: skip minimize + Phase 0 NVT (data file already holds equilibrated config) -----
if "${cont} == 1" then "jump SELF label_after_phase0"

# Brief minimize to clean up any residual overlaps from the data-file build
minimize 1.0e-4 1.0e-6 1000 10000

# Setup trajectory
dump traj_setup gel_system custom ${dump_freq_setup} &
   traj_files/gel_setup_${dataname}_${interaction}_${nsteps}.lammpstrj &
   id type mol x y z

# NVT equilibration at fixed volume (piston z-free, floats on solvent)
fix nvt_equil mobile nvt temp ${temp_target} ${temp_target} 1.0

# Record piston force from the very start of Phase 0 to capture the equilibrium
# (zero-applied-pressure) baseline.  The piston floats freely on solvent
# (fix rigid_piston force * off off on, no setforce), so c_piston_fz is live now.
fix out_piston_force all print ${volume_freq} '$(step) $(c_piston_fz)' file output_files/piston_data/piston_force_${dataname}_${interaction}_${nsteps}.dat screen no

run ${perm_setup_freq}

print ">>> Post-Phase-0 NVT: T=$(c_mobile_temp)  mobile_press=$(c_mobile_press)"
unfix nvt_equil

label label_after_phase0

# run 0 initializes all computes so their values can be referenced in
# variable formulas and print statements below (required when cont=1 skips
# the minimize that previously served this purpose).
run 0

# ==========================================================================
#              PHASE 0.5: ANISOTROPIC LANGEVIN + NPH -> P_target
# ==========================================================================
# Re-pressurises the box to P_target by anisotropically swelling/deswelling the
# gel (each of x,y,z barostatted to the full scalar target).  Needed because the
# fixed-volume read relaxes below P_target.  The piston and support are
# temporarily put on nve+setforce so they scale freely with the box without
# contributing spurious virial to the barostat, then restored afterward.
#
# Why Langevin + NPH (not fix npt / Nosé-Hoover):
#   FENE bonds under compression inject kinetic energy faster than the
#   Nosé-Hoover chain can remove it → T stuck at ~6.  Langevin's per-atom
#   friction coefficient (∝ v) removes energy in direct proportion to how
#   hot each atom is — it always wins against FENE heating.
#
# Key parameters:
#   npt_P_damp: barostat damping (τ).  100 τ is a good default; increase to
#               500–1000 if FENE bond warnings appear.
#   npt_p05_steps: run length.  200k is usually enough; increase if
#                  mobile_press has not converged at the end of the run.

variable npt_P_damp    equal 50.0   # barostat damping (τ); increase if FENE errors appear
variable npt_p05_steps equal 120000  # run length; increase if mobile_press not converged
# Aniso NPH targets the FULL scalar pressure per direction (thermo `Press`),
# exactly like slab_with_support.lmp's aniso barostat and
# triaxial_compression.lmp's Phase 0.5.  NO +0.41 kinetic offset (that was the
# old iso-NPH convention).  Without this block the fixed-volume read relaxes to
# ~1.2 instead of P_target on the periodic geometry.
variable npt_P05_target equal ${P_target}

# ----- cont=1: box already at equilibrium pressure -> skip Phase 0.5 -----
if "${cont} == 1" then "jump SELF label_after_phase05"

print '========================================'
print 'Phase 0.5 (permeation): Langevin+NPH aniso -> full Press target=${npt_P05_target}'
print '========================================'

# Release piston to scale with the box (nve+setforce, no fix rigid) so it does
# not inject spurious virial into the barostat.
unfix rigid_piston
fix nve_piston      piston nve
fix setforce_piston piston setforce 0.0 0.0 0.0

# Release support to scale with the box.
unfix rigid_support
fix freeze_support support setforce 0.0 0.0 0.0
fix nve_support    support nve

# Langevin + NPH (aniso).  Langevin's per-atom friction beats FENE heating that
# would otherwise leave a Nose-Hoover thermostat stuck hot.
fix lang_p05 mobile langevin ${temp_target} ${temp_target} 1.0 48279
fix nph_p05  mobile nph aniso ${npt_P05_target} ${npt_P05_target} ${npt_P_damp}
run ${npt_p05_steps}
unfix lang_p05
unfix nph_p05

print '>>> Post-Langevin+NPH: T=$(c_mobile_temp)  Press=$(press)  mobile_press=$(c_mobile_press)  lx=$(lx) ly=$(ly) lz=$(lz)'

# Restore rigid piston at its new (scaled) position, z-DOF free (floats on
# solvent again); support fully frozen.
unfix nve_piston
unfix setforce_piston
velocity piston set 0.0 0.0 0.0
fix rigid_piston piston rigid single force * off off on torque * off off off

unfix freeze_support
unfix nve_support
velocity support set 0.0 0.0 0.0
fix rigid_support support rigid single force * off off off torque * off off off

# NVT settle at the re-pressurised box volume.
fix nvt_p05_eq mobile nvt temp ${temp_target} ${temp_target} 1.0
run 50000
unfix nvt_p05_eq

print '>>> Post-Phase-0.5: T=$(c_mobile_temp)  Press=$(press)  mobile_press=$(c_mobile_press)  lz=$(lz)'

label label_after_phase05

print ">>> Pre-production: T=$(c_mobile_temp)  mobile_press=$(c_mobile_press)"
# traj_setup dump only exists when cont=0 (Phase 0 ran).  It is intentionally NOT
# undumped here any more: extended to keep recording through Phase 0.5 AND the
# Phase 2 piston reposition, so the setup/reposition motion is captured even if
# production dies early (the production trajectories were empty when the run died
# at the WCA switch-on).  It is handed off to traj_flow immediately before the
# production run begins (see "Hand off the setup trajectory" below), so the two
# dumps are never active simultaneously — no overlapping-dump conflict.


# ==========================================================================
#                    ANALYSIS: POLYMER TRACKING
# ==========================================================================

compute polymer_com polymer com

# ----- Bounding Box (BB) — gel dimensions from min/max coordinates -----
# Sensitive to outlier beads; kept for diagnostics and gel dimension output.
compute minx polymer reduce min x
compute maxx polymer reduce max x
compute miny polymer reduce min y
compute maxy polymer reduce max y
compute minz polymer reduce min z
compute maxz polymer reduce max z

variable gel_lx_bb equal c_maxx-c_minx
variable gel_ly_bb equal c_maxy-c_miny
variable gel_lz_bb equal c_maxz-c_minz
variable gel_vol_bb equal v_gel_lx_bb*v_gel_ly_bb*v_gel_lz_bb

# ----- Radius of Gyration (Rg) — robust gel dimensions -----
# For a uniform rectangular prism: Rg_ii² = L_i²/12  →  L_i = 2√3·√(Rg_ii²)
# c_rg_tensor[i] returns Rg_ii² (diagonal component of gyration tensor).
compute rg_tensor polymer gyration

variable gel_lx_rg equal 2.0*sqrt(3.0*c_rg_tensor[1])
variable gel_ly_rg equal 2.0*sqrt(3.0*c_rg_tensor[2])
variable gel_lz_rg equal 2.0*sqrt(3.0*c_rg_tensor[3])
variable gel_vol_rg equal v_gel_lx_rg*v_gel_ly_rg*v_gel_lz_rg

# Robust gel-top estimate: polymer COM_z + half the Rg-based z-thickness.
# c_maxz (raw maximum) is polluted by stray crosslinker/polymer beads that
# diffuse into the solvent.  The Rg-based estimate is unaffected because
# COM and Rg² are mean/variance over ~96k atoms — one outlier < 0.004%.
variable gel_top_rg equal c_polymer_com[3]+0.5*v_gel_lz_rg

# ----- Box dimensions -----
variable box_lx equal lx
variable box_ly equal ly
variable box_lz equal lz

# ----- Piston position/velocity computes -----
# Defined here (before run 0) so they are initialized alongside polymer/rg computes.
# Used unconditionally in piston output fixes, and in permeation-mode reservoir
# regions where LAMMPS evaluates variable bounds at region creation time.
compute piston_com piston com          # PBC-aware COM; use [3] for z
compute piston_vz piston reduce ave vz  # velocities do not wrap
# Support membrane z (frozen, so its COM is fixed).  The support sits near the
# BOTTOM of the periodic cell; the permeate reservoir is the solvent BELOW it.
# Used as the fixed reference plane for the permeate flux counter and reservoirs.
compute support_com support com

# ----- Polymer z-displacement reference -----
# Defined here so run 0 below captures the post-Phase-0.5 equilibrated positions
# as the reference configuration.  This gives u_z(z, 0) = 0 at Phase 2 start
# by construction.  c_displace_poly[3] is the PBC-aware z-displacement per atom.
compute displace_poly polymer displace/atom

run 0   # initializes ALL computes in one pass; sets displace_poly reference

# ----- Snapshot Rg tensor for diagnostics and analysis region sizing -----
variable Rg_xx equal c_rg_tensor[1]
variable Rg_yy equal c_rg_tensor[2]
variable Rg_zz equal c_rg_tensor[3]

print "Rg_xx = ${Rg_xx}  →  Lx_rg = $(v_gel_lx_rg)"
print "Rg_yy = ${Rg_yy}  →  Ly_rg = $(v_gel_ly_rg)"
print "Rg_zz = ${Rg_zz}  →  Lz_rg = $(v_gel_lz_rg)"
print "BB:  Lx=$(v_gel_lx_bb) Ly=$(v_gel_ly_bb) Lz=$(v_gel_lz_bb)"

# Analysis region half-widths (use rg_scale for ~90% coverage)
variable eps equal 1.0e-12
variable hw_x equal v_region_frac*v_rg_scale*sqrt(v_Rg_xx + v_eps)
variable hw_y equal v_region_frac*v_rg_scale*sqrt(v_Rg_yy + v_eps)
variable hw_z equal v_region_frac*v_rg_scale*sqrt(v_Rg_zz + v_eps)

print "hw_x = ${hw_x}"
print "hw_y = ${hw_y}"
print "hw_z = ${hw_z}"

# ----- Gel strain (Rg-based) -----
# $(v_gel_lz_rg) — parentheses force immediate numeric evaluation right now,
# storing a constant. ${gel_lz_rg} would store the expression string instead.
# Snapshot the (fixed) support plane z as a constant now that computes are live.
variable support_z equal $(c_support_com[3])
print ">>> Support plane z = ${support_z}   (permeate reservoir = solvent below this)"

variable gel_lz_initial equal $(v_gel_lz_rg)
print ">>> Initial gel thickness (Rg): L0 = ${gel_lz_initial}"
print ">>> Initial gel thickness (BB): L0 = $(v_gel_lz_bb)"
print ">>> Gel top (Rg-based) = $(v_gel_top_rg)   c_maxz (raw) = $(c_maxz)   Piston z = $(c_piston_com[3])   Gap = $(c_piston_com[3]-v_gel_top_rg)"

variable gel_strain equal (v_gel_lz_initial - v_gel_lz_rg) / v_gel_lz_initial


# ==========================================================================
#     OUTPUT: GEL STRAIN + Rg THICKNESS  (started PRE-DRIVE for a baseline)
# ==========================================================================
# Defined HERE — before the Phase 1.5 reference window and the Phase 2 piston
# reposition — so gel thickness / strain is recorded from the equilibrated,
# pre-motion state.  The strain_zz and gel_dimensions_rg files therefore open
# with a flat eps~=0 baseline (before the piston moves or loads), then continue
# as ONE unbroken series through the reference window and production.  These
# replace the (now removed) production-phase definitions of the same two fixes.
fix out_strain_zz all print ${volume_freq} &
    "$(step) ${gel_lz_initial} $(v_gel_lz_rg)" &
    file output_files/stress_data/strain_zz_${dataname}_${interaction}_${nsteps}.dat screen no
fix out_gel_dims_rg all print ${volume_freq} "$(step) $(v_gel_lx_rg) $(v_gel_ly_rg) $(v_gel_lz_rg)" &
    file output_files/volume_data/gel_dimensions_rg_${dataname}_${interaction}_${nsteps}.dat screen no


# ==========================================================================
#  PHASE 1.5: PRE-DRIVE REFERENCE-STATE (zero-flux baseline) RECORDING
# ==========================================================================
# Permeation analog of triaxial_compression.lmp's epsilon=0 reference window.
# Records the equilibrated gel at P_target BEFORE the piston repositions or
# loads it — piston floating on solvent, no applied pressure gradient, no flow.
# All observables are averaged into "_ref_" files so triaxial_permeation.ipynb
# can overlay a clean baseline on the production evolutions.
#
# SELF-CONTAINED by design: it declares its OWN "_r" compute IDs and its own
# thermostat (nvt_ref), records, then tears everything down.  It therefore never
# shares a chunk/atom compute with the production stress fixes (defined far
# below), so there is no cross-phase chunk/atom lock to poison.  The run length
# is still padded to a ref_nfreq epoch boundary so each ref fix ave/time /
# ave/chunk releases its lock cleanly on end_of_step before the unfix.
# Skipped for cont=1 (the _ref files already exist from the original run).
if "${cont} == 1" then "jump SELF label_after_ref_rec"

# reference averaging cadence (same idiom as triaxial_compression.lmp Phase 1.5)
variable ref_avg_steps equal 150000     # total reference window (padded up to epoch)
variable ref_nevery    equal 100         # sample cadence within a ref snapshot
variable ref_nfreq     equal 10000       # one ref snapshot every ref_nfreq steps
variable ref_nrepeat   equal v_ref_nfreq/v_ref_nevery   # = 100 samples / snapshot
#   -> ~15 reference snapshots, each averaging 100 decorrelated samples (=> CIs)

# ----- reference chunk/atom (one per reduce/chunk user; full-box z, binWidth) -----
compute chunk_zr_poly_zz polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_zr_poly_xx polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_zr_poly_yy polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_zr_solv_zz solvent chunk/atom bin/1d z lower ${binWidth}
compute chunk_zr_solv_xx solvent chunk/atom bin/1d z lower ${binWidth}
compute chunk_zr_solv_yy solvent chunk/atom bin/1d z lower ${binWidth}
compute chunk_zr_dens    solvent chunk/atom bin/1d z lower ${binWidth}

# ----- reference per-atom component stresses (virial only; sign matches production) -----
compute stress_poly_r polymer stress/atom NULL
compute stress_solv_r solvent stress/atom NULL
variable r_sig_p_zz atom -c_stress_poly_r[3]/(lx*ly*${binWidth})
variable r_sig_s_zz atom -c_stress_solv_r[3]/(lx*ly*${binWidth})
variable r_sig_p_xx atom -c_stress_poly_r[1]/(lx*ly*${binWidth})
variable r_sig_s_xx atom -c_stress_solv_r[1]/(lx*ly*${binWidth})
variable r_sig_p_yy atom -c_stress_poly_r[2]/(lx*ly*${binWidth})
variable r_sig_s_yy atom -c_stress_solv_r[2]/(lx*ly*${binWidth})

compute sigmazz_poly_r polymer reduce/chunk chunk_zr_poly_zz sum v_r_sig_p_zz
compute sigmazz_solv_r solvent reduce/chunk chunk_zr_solv_zz sum v_r_sig_s_zz
compute sigmaxx_poly_r polymer reduce/chunk chunk_zr_poly_xx sum v_r_sig_p_xx
compute sigmaxx_solv_r solvent reduce/chunk chunk_zr_solv_xx sum v_r_sig_s_xx
compute sigmayy_poly_r polymer reduce/chunk chunk_zr_poly_yy sum v_r_sig_p_yy
compute sigmayy_solv_r solvent reduce/chunk chunk_zr_solv_yy sum v_r_sig_s_yy

# ----- reference pair/local (solvent) for the ss baseline (post-processed) -----
compute pl_local_r  solvent pair/local  fx fy fz
compute ids_local_r solvent property/local patom1 patom2 ptype1 ptype2

print '========================================'
print 'Phase 1.5: zero-flux reference recording (${ref_avg_steps} steps, ref_nfreq=${ref_nfreq})'
print '========================================'

# Thermostat the mobile group for the reference window (none is active between
# the Phase 0.5 teardown and the Phase 2 setup).  Piston keeps its rigid z-free
# float (rigid_piston) and support stays frozen (rigid_support) => equilibrium.
fix nvt_ref mobile nvt temp ${temp_target} ${temp_target} 1.0

# ----- coarse partial-stress component references (poly + solv, zz/xx/yy) -----
fix ref_sigmazz_poly all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmazz_poly_r mode vector file output_files/stress_data/sigmazz_polymer_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmazz_solv all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmazz_solv_r mode vector file output_files/stress_data/sigmazz_solvent_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmaxx_poly all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmaxx_poly_r mode vector file output_files/stress_data/sigmaxx_polymer_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmaxx_solv all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmaxx_solv_r mode vector file output_files/stress_data/sigmaxx_solvent_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmayy_poly all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmayy_poly_r mode vector file output_files/stress_data/sigmayy_polymer_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmayy_solv all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmayy_solv_r mode vector file output_files/stress_data/sigmayy_solvent_ref_${dataname}_${interaction}_${nsteps}.dat

# ----- solvent number-density reference (coarse; matches production format) -----
fix ref_dens all ave/chunk ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} chunk_zr_dens density/number file output_files/chemical_potential/solvent_density_z_ref_${dataname}_${interaction}_${nsteps}.dat

# ----- ss / traj reference dumps (one frame per ref_nfreq) -> sigma_s,ss baseline -----
dump pairlocal_ref solvent local ${ref_nfreq} output_files/pair_data/pairs_ref_${dataname}_${interaction}_${nsteps}.dump &
    c_ids_local_r[1] c_ids_local_r[2] c_ids_local_r[3] c_ids_local_r[4] c_pl_local_r[1] c_pl_local_r[2] c_pl_local_r[3]
dump traj_ref gel_system custom ${ref_nfreq} traj_files/traj_ref_${dataname}_${interaction}_${nsteps}.lammpstrj id type mol x y z

# Run for ref_avg_steps, PADDED up to the next ref_nfreq epoch boundary so the
# ave/time + ave/chunk locks release cleanly on end_of_step before the unfix.
variable ref_run_steps equal (floor(($(step)+${ref_avg_steps}-1)/${ref_nfreq})+1)*${ref_nfreq}-$(step)
print '>>> Reference window: running ${ref_run_steps} steps (>= ${ref_avg_steps}, aligned to ref_nfreq=${ref_nfreq})'
run ${ref_run_steps}

# ----- tear down the reference fixes/dumps/computes (locks already released) -----
undump pairlocal_ref
undump traj_ref
unfix ref_sigmazz_poly
unfix ref_sigmazz_solv
unfix ref_sigmaxx_poly
unfix ref_sigmaxx_solv
unfix ref_sigmayy_poly
unfix ref_sigmayy_solv
unfix ref_dens
unfix nvt_ref
uncompute sigmazz_poly_r
uncompute sigmazz_solv_r
uncompute sigmaxx_poly_r
uncompute sigmaxx_solv_r
uncompute sigmayy_poly_r
uncompute sigmayy_solv_r
uncompute stress_poly_r
uncompute stress_solv_r
uncompute pl_local_r
uncompute ids_local_r
uncompute chunk_zr_poly_zz
uncompute chunk_zr_poly_xx
uncompute chunk_zr_poly_yy
uncompute chunk_zr_solv_zz
uncompute chunk_zr_solv_xx
uncompute chunk_zr_solv_yy
uncompute chunk_zr_dens

print '>>> Reference recording done.  step=$(step)  gel_strain=$(v_gel_strain)'

label label_after_ref_rec


# ==========================================================================
#              PHASE 2: PRODUCTION — piston forcing
# ==========================================================================

print "========================================"
print "Phase 2: Production — piston forcing"
print "========================================"

# ----- Compression: unfreeze piston, switch to velocity control -----
# The piston was re-frozen after Phase 0.5 Langevin+NPH (rigid + setforce 0).
# Unfreeze, then re-fix with force*off off off so the prescribed velocity
# is maintained exactly (no force-driven acceleration from the gel).
#
# cont=1 compression: piston stays frozen (already at ~comp_percent strain).
#   halt_compress fires immediately on the first volume_freq check, and the
#   entire run becomes a pure stress-relaxation measurement.
label label_skip_comp_piston_setup

# ----- Thermostat (x,y only — z is flow/compression direction) -----
compute myTemp mobile temp/partial 1 1 0
fix nvt_prod mobile nvt temp ${temp_target} ${temp_target} 1.0
fix_modify nvt_prod temp myTemp

# ==========================================================================
#   PERMEATION PISTON:  (1) reposition to the 45/55 solvent split,
#                       (2) enable piston-solvent WCA,
#                       (3) constant-PRESSURE (force-controlled) production
# ==========================================================================
# slab_with_support equilibration leaves the piston floating slightly HIGH.
# First reposition it (piston-solvent still OFF -> slides freely through the
# solvent) until the FREE solvent is split ~35% on the support/permeate side and
# ~65% on the gel/feed side (piston "before halfway", gel side larger).
# THEN switch piston-solvent WCA ON and run a constant-PRESSURE production drive.

# ---- parameters ----
variable feed_frac_target  equal 0.65    # target fraction of FREE solvent on the gel (feed) side (35% permeate / 65% feed)
variable v_reposition      equal 0.01    # sigma/tau, controlled descent speed while repositioning
variable nsteps_reposition equal 400000  # cap; halt fires when the split is reached
variable P_piston          equal 0.1     # applied piston PRESSURE for production (= 0.1*M, small deformation)

# ---- free-solvent split bookkeeping (piston faces; gel top from Rg) ----
variable piston_z_bot equal c_piston_com[3]-0.5*${sigma}
variable piston_z_top equal c_piston_com[3]+0.5*${sigma}
# feed side: solvent between gel top and the piston bottom face (the compressible
# feed reservoir the piston acts on).
region reg_feed_split block EDGE EDGE EDGE EDGE v_gel_top_rg v_piston_z_bot side in
group g_feed_split dynamic solvent region reg_feed_split every 1000
variable n_feed_split equal count(g_feed_split)
#
# perm side: solvent ABOVE the piston (the 45% side).  Counted BY DIFFERENCE so
# the reposition can start with the piston still parked at the top boundary:
#   n_perm = n_total - (solvent in [zlo, piston_z_top]).
# The OLD region [piston_z_top, EDGE] evaluates at reposition step 0 while the
# piston is still at the top (piston_z_top >= zhi) -> zlo>zhi -> LAMMPS "Variable
# evaluation in region gave bad value" (the crash).  The complementary region
# [EDGE, piston_z_top] can never invert (zlo < piston_z_top always), and at step 0
# it simply spans the whole box so n_perm = 0 (correct: nothing above the piston
# yet).  As the piston descends into the feed column, solvent appears above it and
# n_perm grows, so feed_frac drops monotonically to the target.
region reg_below_piston block EDGE EDGE EDGE EDGE EDGE v_piston_z_top side in
group g_below_piston dynamic solvent region reg_below_piston every 1000
variable n_total_solv equal count(solvent)
variable n_perm_split equal v_n_total_solv-count(g_below_piston)
variable feed_frac    equal v_n_feed_split/(v_n_feed_split+v_n_perm_split)

# ---- (1) reposition: controlled descent, halt when feed fraction reaches target ----
# The piston starts high (feed_frac > target); descending shrinks the feed region
# so feed_frac DECREASES monotonically -> halt when it drops to feed_frac_target.
unfix rigid_piston
fix rigid_piston piston rigid single force * off off off torque * off off off
velocity piston set 0.0 0.0 -${v_reposition}
fix halt_reposition all halt 1000 v_feed_frac <= ${feed_frac_target} error continue
print ">>> Repositioning piston: feed_frac now $(v_feed_frac)  (target ${feed_frac_target})  piston_z=$(c_piston_com[3])"
run ${nsteps_reposition}
unfix halt_reposition
velocity piston set 0.0 0.0 0.0
print ">>> Reposition done: feed_frac=$(v_feed_frac)  piston_z=$(c_piston_com[3])  gel_top=$(v_gel_top_rg)"

# ---- (2) enable piston-solvent WCA: the piston now pushes solvent as a plug ----
pair_coeff 3 5 1.0 ${sigma} 1.122

# ---- (2.5) relax piston-solvent overlaps BEFORE force-loading ----
# The reposition descended the piston with piston-solvent WCA OFF, so solvent
# beads are now embedded inside the 1-sigma-thick piston slab.  Enabling WCA
# (above) turns those ~zero-distance overlaps into enormous repulsions; stepping
# them straight into the production thermostat launches atoms in a single step
# and triggers the FENE "bond atoms missing" blowup (the step-507002 crash, where
# PotEng jumped to ~7e23 on the first production step).  Bleed the overlaps out
# gently first: fix nve/limit caps per-atom displacement per step (0.05 sigma) so
# no atom can fly regardless of force magnitude, and Langevin removes the injected
# heat (per-atom friction beats FENE heating; same rationale as Phase 0.5).  The
# piston is held FIXED during this stage — rigid_piston (force * off off off,
# velocity 0) zeroes the net body force in all three directions, so the escaping
# solvent cannot shove the piston and the 45/55 split from the reposition is
# preserved.  Only the mobile group (polymer+solvent) is re-integrated here.
variable n_wca_relax equal 5000
unfix nvt_prod
fix relax_nvelim mobile nve/limit 0.05
fix relax_lang   mobile langevin ${temp_target} ${temp_target} 1.0 58291
run ${n_wca_relax}
unfix relax_nvelim
unfix relax_lang
fix nvt_prod mobile nvt temp ${temp_target} ${temp_target} 1.0
fix_modify nvt_prod temp myTemp
print ">>> WCA overlap relax done: T=$(c_mobile_temp)  mobile_press=$(c_mobile_press)"

# ---- (3) piston force RAMP -> constant-PRESSURE production ----
# Periodic full-box piston cannot use fix rigid for a force load (see the
# slab_with_support periodic-piston note): setforce zeroes x,y (no lateral
# drift), aveforce averages the z-force across piston atoms (so they translate
# together as a rigid slab in z) and ADDS the per-atom applied load, then nve
# integrates.
#
# Rather than applying the full load in a single step, the net downward force on
# the piston is RAMPED from 0 up to F_max in n_ramp (= 5) equal increments,
# holding each stage for ramp_steps.  This eases the gel into the
# load gently (complementary to the Phase 2.5 overlap relax).  F_max is snapshot
# to the current box (= P_piston*lx*ly, the same max force the constant-pressure
# drive would apply now).  After the ramp reaches F_max the aveforce target is
# switched to the box-tracking f_load_atom so PRODUCTION holds constant PRESSURE.
unfix rigid_piston
fix setforce_piston piston setforce 0.0 0.0 NULL
fix nve_piston      piston nve

variable n_ramp      equal 5                       # number of equal force increments (0 -> F_max)
variable F_max_ramp  equal $(v_P_piston*lx*ly)     # constant snapshot of the target net force
variable ramp_dF     equal v_F_max_ramp/v_n_ramp   # per-stage net-force increment (= F_max/5)
variable ramp_steps  equal 1000                    # steps held at each increment (tune as needed)

# Staged net force = stage*(F_max/n_ramp); stage n_ramp lands exactly on F_max.
# aveforce re-evaluates v_f_ramp_atom every step, so bumping the loop counter
# (next ramp_stage) is all that changes the applied force between stages.
variable F_stage     equal v_ramp_stage*v_ramp_dF
variable f_ramp_atom equal -v_F_stage/count(piston)
fix aveforce_piston piston aveforce NULL NULL v_f_ramp_atom

print ">>> Piston force ramp: 0 -> F_max=$(v_F_max_ramp) in ${n_ramp} equal stages of $(v_ramp_dF)  (${ramp_steps} steps each)"
variable ramp_stage loop ${n_ramp}
label piston_ramp_loop
print ">>> Piston ramp stage ${ramp_stage}/${n_ramp}: net F=$(v_F_stage)"
run ${ramp_steps}
next ramp_stage
jump SELF piston_ramp_loop

# ---- constant-PRESSURE production drive (box-tracking, held to the end) ----
# The load tracks lx*ly so the applied PRESSURE P_piston is held constant
# (v_f_load_atom is re-evaluated every step).
variable f_load_atom equal -v_P_piston*lx*ly/count(piston)
unfix aveforce_piston
fix aveforce_piston piston aveforce NULL NULL v_f_load_atom
print ">>> Production: force-controlled piston at P_piston=${P_piston}  (net F=$(-v_P_piston*lx*ly))"

# ----- Reset displacement reference to production onset (u_z(z,0)=0) -----
# The fix ave/chunk that consumes this is defined AFTER the chunk definitions
# (see OUTPUT: POLYMER Z-DISPLACEMENT); no steps run in between, so the
# reference set here is preserved to the production run start.
uncompute displace_poly
compute displace_poly polymer displace/atom
variable uz_poly atom c_displace_poly[3]

# ----- Hand off the setup trajectory to the production trajectory -----
# Undump traj_setup HERE (rather than after Phase 0.5) so it recorded Phase 0.5 +
# the reposition + the WCA overlap relax, then stop it exactly as the production
# dump is created below.  The two dumps are strictly sequential (traj_setup ends
# before traj_flow begins), so they are never simultaneously active — this avoids
# the overlapping-dump problem entirely.
if "${cont} == 0" then "undump traj_setup"

# ----- Production Trajectory (sparse sampling) -----
dump traj_flow gel_system custom ${dump_freq_prod} &
    traj_files/gel_flow_${dataname}_${interaction}_${nsteps}.lammpstrj &
    id type mol x y z
# first yes: always write a frame at the production start step so, even if
# production ever dies immediately, there is a snapshot of the exact starting
# configuration (the setup/reposition frames now live in traj_setup instead).
dump_modify traj_flow first yes


# ==========================================================================
#                    ANALYSIS: DYNAMIC REGIONS
# ==========================================================================

# Region for X-direction binning: restricted in Y-Z, full extent in X
variable reg_x_ylo equal c_polymer_com[2]-v_hw_y
variable reg_x_yhi equal c_polymer_com[2]+v_hw_y
variable reg_x_zlo equal c_polymer_com[3]-v_hw_z
variable reg_x_zhi equal c_polymer_com[3]+v_hw_z
region reg_x block EDGE EDGE v_reg_x_ylo v_reg_x_yhi v_reg_x_zlo v_reg_x_zhi side in

# Region for Y-direction binning: restricted in X-Z, full extent in Y
variable reg_y_xlo equal c_polymer_com[1]-v_hw_x
variable reg_y_xhi equal c_polymer_com[1]+v_hw_x
variable reg_y_zlo equal c_polymer_com[3]-v_hw_z
variable reg_y_zhi equal c_polymer_com[3]+v_hw_z
region reg_y block v_reg_y_xlo v_reg_y_xhi EDGE EDGE v_reg_y_zlo v_reg_y_zhi side in

# NOTE: Z-direction binning uses the full simulation box (no region restriction).
# This allows piston position to be visualized in permeation mode, and ensures
# support stress appears at its true z-location. X and Y profiles retain the
# polymer-COM-tracked lateral restriction above.


# ==========================================================================
#                    ANALYSIS: CHUNK DEFINITIONS
# ==========================================================================

# 1D binning with dynamic rectangular regions (x, y — single user each, no conflict)
compute chunk_x_polymer polymer chunk/atom bin/1d x lower ${binWidth} region reg_x
compute chunk_y_polymer polymer chunk/atom bin/1d y lower ${binWidth} region reg_y
compute chunk_x_solvent solvent chunk/atom bin/1d x lower ${binWidth} region reg_x
compute chunk_y_solvent solvent chunk/atom bin/1d y lower ${binWidth} region reg_y

# Z profiles — one chunk/atom per reduce/chunk user.
# LAMMPS 22Jul2025 rejects multiple fix ave/time sharing the same chunk/atom
# via different reduce/chunk computes ("Two fix commands using same compute
# chunk/atom command in incompatible ways").  Each compute reduce/chunk must
# therefore reference a unique chunk/atom ID.
#
#   chunk_z_poly_p   → press_z_polymer  (isotropic z-press, polymer)
#   chunk_z_poly_zz  → sigmazz_poly
#   chunk_z_poly_xx  → sigmaxx_poly
#   chunk_z_poly_yy  → sigmayy_poly
#   chunk_z_polymer  → fix avg_disp_z_poly (displacement, relaxation phase only)
#   chunk_z_solv_p   → press_z_solvent  (isotropic z-press, solvent)
#   chunk_z_solv_zz  → sigmazz_solv
#   chunk_z_solv_xx  → sigmaxx_solv
#   chunk_z_solv_yy  → sigmayy_solv
compute chunk_z_poly_p   polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_poly_zz  polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_poly_xx  polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_poly_yy  polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_polymer  polymer chunk/atom bin/1d z lower ${binWidth}

compute chunk_z_solv_p   solvent chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_solv_zz  solvent chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_solv_xx  solvent chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_solv_yy  solvent chunk/atom bin/1d z lower ${binWidth}

# Piston and support — single user each, no conflict
compute chunk_z_piston  piston  chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_support support chunk/atom bin/1d z lower ${binWidth}


# ==========================================================================
#                    ANALYSIS: PARTIAL STRESSES
# ==========================================================================

compute stress_polymer polymer stress/atom NULL
compute stress_solvent solvent stress/atom NULL

# Partial stress for each atom: P = -(σxx + σyy + σzz)/(3*vol)
variable press_polymer_x atom -(c_stress_polymer[1]+c_stress_polymer[2]+c_stress_polymer[3])/(3.0*${binWidth}*ly*lz)
variable press_polymer_y atom -(c_stress_polymer[1]+c_stress_polymer[2]+c_stress_polymer[3])/(3.0*lx*${binWidth}*lz)
variable press_polymer_z atom -(c_stress_polymer[1]+c_stress_polymer[2]+c_stress_polymer[3])/(3.0*lx*ly*${binWidth})

variable press_solvent_x atom -(c_stress_solvent[1]+c_stress_solvent[2]+c_stress_solvent[3])/(3.0*${binWidth}*ly*lz)
variable press_solvent_y atom -(c_stress_solvent[1]+c_stress_solvent[2]+c_stress_solvent[3])/(3.0*lx*${binWidth}*lz)
variable press_solvent_z atom -(c_stress_solvent[1]+c_stress_solvent[2]+c_stress_solvent[3])/(3.0*lx*ly*${binWidth})

# Sum pre-divided per-atom contributions over chunks → pressure per bin
compute press_x_polymer polymer reduce/chunk chunk_x_polymer sum v_press_polymer_x
compute press_y_polymer polymer reduce/chunk chunk_y_polymer sum v_press_polymer_y
compute press_z_polymer polymer reduce/chunk chunk_z_poly_p  sum v_press_polymer_z

compute press_x_solvent solvent reduce/chunk chunk_x_solvent  sum v_press_solvent_x
compute press_y_solvent solvent reduce/chunk chunk_y_solvent  sum v_press_solvent_y
compute press_z_solvent solvent reduce/chunk chunk_z_solv_p   sum v_press_solvent_z

# Piston and support partial stresses — same methodology as above.
# stress/atom NULL captures pairwise virial only (no kinetic term), which is
# correct for rigid bodies; internal constraint forces are excluded.
compute stress_piston  piston  stress/atom NULL
compute stress_support support stress/atom NULL

variable press_piston_z  atom -(c_stress_piston[1]+c_stress_piston[2]+c_stress_piston[3])/(3.0*lx*ly*${binWidth})
variable press_support_z atom -(c_stress_support[1]+c_stress_support[2]+c_stress_support[3])/(3.0*lx*ly*${binWidth})

compute press_z_piston  piston  reduce/chunk chunk_z_piston  sum v_press_piston_z
compute press_z_support support reduce/chunk chunk_z_support sum v_press_support_z

# ── True ZZ partial-stress component (σzz only) ───────────────────────────
# The isotropic press_*_z variables above average (σxx+σyy+σzz)/3, which
# mixes background pressure into the compression signal and cannot be used
# directly to compute the longitudinal modulus.  These variables isolate the
# ZZ virial component (c_stress[3]) needed for the Terzaghi decomposition:
#   σ'_zz = (σ_p_zz + σ_s_zz) − p_pore,   p_pore = σ_s_zz / φ_s
# Note: still virial-only (NULL kinetic); kinetic contribution is isotropic
# and cancels in the effective-stress difference for an equilibrated solvent.
variable sigma_p_zz atom -c_stress_polymer[3]/(lx*ly*${binWidth})
variable sigma_s_zz atom -c_stress_solvent[3]/(lx*ly*${binWidth})
variable sigma_p_xx atom -c_stress_polymer[1]/(lx*ly*${binWidth})
variable sigma_s_xx atom -c_stress_solvent[1]/(lx*ly*${binWidth})
variable sigma_p_yy atom -c_stress_polymer[2]/(lx*ly*${binWidth})
variable sigma_s_yy atom -c_stress_solvent[2]/(lx*ly*${binWidth})

compute sigmazz_poly polymer reduce/chunk chunk_z_poly_zz sum v_sigma_p_zz
compute sigmazz_solv solvent  reduce/chunk chunk_z_solv_zz sum v_sigma_s_zz
compute sigmaxx_poly polymer reduce/chunk chunk_z_poly_xx sum v_sigma_p_xx
compute sigmaxx_solv solvent  reduce/chunk chunk_z_solv_xx sum v_sigma_s_xx
compute sigmayy_poly polymer reduce/chunk chunk_z_poly_yy sum v_sigma_p_yy
compute sigmayy_solv solvent  reduce/chunk chunk_z_solv_yy sum v_sigma_s_yy

# ── Pair-local data for ss-only virial (post-processing) ─────────────────
# compute stress/atom does not support sub-style filtering in this LAMMPS
# build (the "pair" keyword means ALL pair interactions).  Instead, we record
# per-pair virial via compute pair/local and filter for ss pairs in Python.
#
# Using group=solvent guarantees all 3-3 (ss) pairs are captured:
#   For any ss pair (i,j) with i<j by atom ID, both atoms are type 3 and
#   therefore in the solvent group → atom i is always in the group → pair
#   is always included.  Some 3-polymer ps pairs are also captured but are
#   discarded in post-processing by filtering ptype1==ptype2==3.
#
# fx/fy/fz = force on atom I due to atom J.  lj/cut exposes force components
#   but NOT the virial fields p1/p2/p3 (those require special per-pair virial
#   support that lj/cut does not implement → "extra field" error at runtime).
#   The virial is reconstructed in post-processing from forces + positions:
#     p_zz_pair = -(r_z * fz)   where r_z = z_J - z_I  (PBC-corrected)
#     p_xx_pair = -(r_x * fx),  p_yy_pair = -(r_y * fy)
#   Sign convention: positive p means repulsive/compressed → same as p1/p2/p3.
#   z-positions z_I and z_J come from the main traj dump (same dump_freq_prod).
#
# Post-processing steps (see compression_analysis.ipynb):
#   1. Read pairs dump (atom IDs, types, fx/fy/fz) frame by frame.
#   2. Read main traj dump (id type x y z) at the same timesteps.
#   3. Filter: keep rows where ptype1==3 AND ptype2==3.
#   4. For each ss pair:
#        r_x/y/z = pos_J - pos_I  (with PBC wrap: if |r_α| > L_α/2, subtract L_α)
#        p_zz = -(r_z * fz);  z_mid = (z_I + z_J) / 2; assign to z-bin
#   5. sigma_ss_zz(bin) = sum(p_zz_in_bin) / (lx * ly * binWidth)
#      (no extra factor of 2: fx/fy/fz is force on atom I only, and r_I*f_I
#       gives the full pair contribution already — the other half r_J*f_J
#       is equal by Newton's 3rd law, so sum over all I-as-first pairs gives
#       the complete double-counted virial; divide by 2 if you use both atoms)
#      → safest: only count each pair once (as stored in this dump) and use
#        W_pair = -(r_z * fz) without the factor of 2.
compute pl_local  solvent pair/local  fx fy fz
compute ids_local solvent property/local patom1 patom2 ptype1 ptype2


# ==========================================================================
#                 ANALYSIS: POLYMER Z-DISPLACEMENT
# ==========================================================================
# u_z(z, t): mean z-displacement of polymer atoms per z-bin.
# Feeds the cooperative-diffusivity extraction via:
#   ∂u_z/∂t = D_c ∂²u_z/∂z²
# phi_p ∝ u_z, so this PDE is equivalent to the volume-fraction formulation
# but avoids the computationally expensive Voronoi step.
#
# Uses the same z-binning (chunk_z_polymer) as the stress profiles so that
# displacement and stress outputs are spatially registered.
# Reference is the Phase 2 start (set by run 0 above); u_z(z, 0) = 0 everywhere.

variable uz_poly atom c_displace_poly[3]

# Note: compute reduce/chunk only supports sum/min/max, not ave.
# Per-bin mean is obtained directly via fix ave/chunk in the OUTPUT section below.


# ==========================================================================
#                  ANALYSIS: RESERVOIR PRESSURES (permeation mode only)
# ==========================================================================
# Reservoir pressures are only meaningful in permeation mode:
#   Feed reservoir:     solvent between gel top and piston bottom face.
#                       Gel top is approximated by the Rg-based gel_top_rg
#                       (robust to stray beads); c_maxz is NOT used here.
#   Permeate reservoir: solvent above piston top face to box top; solvent that
#                       has permeated through gel + support wraps via PBC here.
#
# Piston is 1 sigma thick; its center of mass is c_piston_com[3], so:
#   bottom face = c_piston_com[3] - 0.5*sigma
#   top face    = c_piston_com[3] + 0.5*sigma
# Using the actual faces (rather than the COM) keeps solvent that is between
# the gel top and piston bottom correctly in the feed reservoir, and avoids
# counting any piston volume in either reservoir.
#
# P_res = sum[-( σxx+σyy+σzz )_i / 3] / V_res,   V_res = lx·ly·h_res

# Piston face positions
variable piston_z_bot equal c_piston_com[3]-0.5*${sigma}
variable piston_z_top equal c_piston_com[3]+0.5*${sigma}

# Feed: gel top → piston bottom face.
# NOTE: c_maxz is used here (not gel_top_rg) because the region requires a
# dynamic lower bound that tracks the true polymer surface.  The clamping guard
# prevents LAMMPS "bad value" errors when a stray bead raises c_maxz above the
# piston: if c_maxz >= piston_z_bot − σ, the lower bound is clamped to
# piston_z_bot − σ, keeping the region at least 1σ tall.
variable res_feed_zlo equal (c_maxz<(c_piston_com[3]-1.5*${sigma}))*c_maxz+(c_maxz>=(c_piston_com[3]-1.5*${sigma}))*(c_piston_com[3]-1.5*${sigma})
region reg_feed_res block EDGE EDGE EDGE EDGE v_res_feed_zlo v_piston_z_bot side in

# Permeate: solvent ABOVE the piston top face (piston_z_top → box top).  Together
# with reg_feed_res (below the piston) this gives the two piston-relative reservoir
# pressures the 45/55 reposition sets up.  This region is defined AFTER the
# reposition run, by which point the piston has descended into the feed column
# (out of the top z-boundary), so piston_z_top < zhi and the block is valid; as
# the production piston descends further, piston_z_top only drops, so the region
# grows and never inverts.  (The step-0 inversion that crashed the run occurred in
# the REPOSITION counter, which is evaluated while the piston is still parked at
# the top — that counter is now handled crash-safe via reg_below_piston, above.)
region reg_perm_res block EDGE EDGE EDGE EDGE v_piston_z_top EDGE side in

# Dynamic solvent groups — membership refreshed every stress sampling interval
group g_solvent_feed dynamic solvent region reg_feed_res every ${nevery_stress}
group g_solvent_perm dynamic solvent region reg_perm_res every ${nevery_stress}

# Per-atom pressure·volume; reuses c_stress_solvent
variable pv_solvent atom -(c_stress_solvent[1]+c_stress_solvent[2]+c_stress_solvent[3])/3.0

compute pv_feed g_solvent_feed reduce sum v_pv_solvent
compute pv_perm g_solvent_perm reduce sum v_pv_solvent

# Reservoir volumes (height = distance between region faces, not piston COM)
variable vol_feed equal lx*ly*(v_piston_z_bot-v_res_feed_zlo)
# perm reservoir height = box top − piston top face (above-piston slab)
variable vol_perm equal lx*ly*(zhi-v_piston_z_top)

# Instantaneous reservoir pressures
variable P_res_feed equal c_pv_feed/v_vol_feed
variable P_res_perm equal c_pv_perm/v_vol_perm

# halt_p_target removed: velocity-controlled permeation does not need a
# ramp-to-equilibrium phase.  halt_perm (feed ≤ feed_halt_thick) is the
# sole termination condition for the permeation run.


# ==========================================================================
#         PERMEATION: PERMEATE FLUX COUNTER + FEED-THICKNESS HALT
# ==========================================================================
# Permeate flux counter — located AT THE SUPPORT.  Permeate = solvent that has
# left the support->piston span (i.e. crossed below the support membrane).  With
# the production piston (WCA ON) sealing the top, solvent can only leave the
# support->piston span downward through the support, so the count below rises
# monotonically and IS the cumulative permeate count:
#
#   Flux = ΔN_permeate / (Δt × Lx × Ly)  — computed in post-processing.
#
# Located AT THE SUPPORT: N_permeate = n_total − (solvent in [support_z, piston_bot]),
# i.e. everything that has crossed below the support (or wrapped above the piston).
# This replaces the old "top 10σ band" counter, which was wrong for the periodic
# geometry (permeate collects at the BOTTOM, below the support, not near zhi).
# reg_perm_span never inverts (support_z is a fixed plane below the piston).
#
# Feed-thickness halt: stops the run when the feed reservoir (between gel top
# and piston bottom face) is ≤ feed_halt_thick = 2σ, preventing the piston
# from crashing into the gel and causing FENE errors.

region reg_perm_span block EDGE EDGE EDGE EDGE v_support_z v_piston_z_bot side in
group g_perm_span dynamic solvent region reg_perm_span every ${flux_freq}
variable N_permeate equal v_n_total_solv-count(g_perm_span)

fix out_permeate_flux all print ${flux_freq} '$(step) $(v_N_permeate)' file output_files/permeation_data/permeate_count_${dataname}_${interaction}_${nsteps}.dat screen no

# Feed-reservoir thickness = piston bottom face − gel top (Rg-based, robust)
# c_maxz is NOT used here: stray crosslinker beads in the solvent give a
# spuriously large c_maxz that would falsely trigger an early halt.
variable feed_thickness equal c_piston_com[3]-0.5-v_gel_top_rg
fix halt_perm all halt ${volume_freq} v_feed_thickness <= ${feed_halt_thick} error continue

print ">>> Phase 2 start: piston_z=$(c_piston_com[3])  gel_top_rg=$(v_gel_top_rg)  gel_top_raw=$(c_maxz)"


# ==========================================================================
#                         OUTPUT: PISTON DATA
# ==========================================================================

fix out_piston_pos all print ${volume_freq} "$(step) $(c_piston_com[3])" &
    file output_files/piston_data/piston_position_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_piston_vel all print ${volume_freq} "$(step) $(c_piston_vz)" &
    file output_files/piston_data/piston_velocity_${dataname}_${interaction}_${nsteps}.dat screen no

# ----- Block-averaged piston force (noise reduction; same idiom as triaxial_compression.lmp) -----
# Under force control the piston fluctuates more, so the raw c_piston_fz signal
# (out_piston_force, defined in Phase 0) is noisy.  c_piston_fz is a GLOBAL
# reduce (no chunk/atom lock), so we block-average it over each volume_freq
# window with fix ave/time, cutting the scatter by ~sqrt(pf_nrepeat) while
# keeping the same output cadence.  Writes the same 2-column "step  <F_z>"
# format as the raw file so the notebook reads it identically.
variable pf_nevery  equal 50                              # sample every 50 steps (~0.25 tau)
variable pf_nrepeat equal floor(${volume_freq}/v_pf_nevery)  # samples per window
variable pf_nfreq   equal v_pf_nevery*v_pf_nrepeat        # = volume_freq (exact multiple)
fix out_piston_force_avg all ave/time ${pf_nevery} ${pf_nrepeat} ${pf_nfreq} &
    c_piston_fz ave one &
    file output_files/piston_data/piston_force_avg_${dataname}_${interaction}_${nsteps}.dat

# (Raw + block-averaged piston-force recording is set up above; it began at
# Phase 0 to capture the zero-pressure baseline and spans the production run.)


# ── Per-pair force dump for ss-only stress (post-processing) ──────────────
# Columns: patom1 patom2 ptype1 ptype2 fx fy fz
#   (fx/fy/fz = force on atom I due to atom J)
# Frequency: nfreq_stress — one pairs frame per stress-profile snapshot.
# This synchronises σ_s,ss(z,t) with σ_p(z,t) and σ_s(z,t) so all three
# can be plotted on the same time-evolution axes in compression_analysis.ipynb.
# Atom positions for r_IJ are supplied by traj_stress_sync (same timesteps).
# Output directory must exist before the run: output_files/pair_data/
dump pairlocal_dump solvent local ${nfreq_stress} &
    output_files/pair_data/pairs_${dataname}_${interaction}_${nsteps}.dump &
    c_ids_local[1] c_ids_local[2] c_ids_local[3] c_ids_local[4] &
    c_pl_local[1] c_pl_local[2] c_pl_local[3]

# Companion position dump — same frequency, same timesteps as pairlocal_dump.
# Used by compute_ss_stress_from_pairs to look up r_IJ for each ss pair.
# Column layout matches gel_flow_*.lammpstrj so read_lammpstrj_frame works.
# Output directory must exist before the run: traj_files/
dump traj_stress_sync gel_system custom ${nfreq_stress} &
    traj_files/traj_stress_${dataname}_${interaction}_${nsteps}.lammpstrj &
    id type mol x y z


# ==========================================================================
#             OUTPUT: POLYMER Z-DISPLACEMENT PROFILE (time-averaged)
# ==========================================================================
# Identical nevery/nrepeat/nfreq as stress profiles → displacement and stress
# curves are time-aligned for joint fitting in compression_analysis.ipynb.
# File format mirrors stress output: header + one row per nfreq, columns = bins.

# The displacement reference (displace_poly) was reset at production onset (in the
# Phase 2 piston block, after repositioning) so u_z(z,0)=0 at the start of the
# force-controlled production drive.
#
# Defined HERE (not in the Phase 2 piston block) because it references
# chunk_z_polymer, which is defined in ANALYSIS: CHUNK DEFINITIONS above.  The
# displace_poly reference was reset at production onset (Phase 2 piston block);
# no steps ran in between, so u_z(z,0)=0 holds at the production run start.
fix avg_disp_z_poly all ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_z_polymer v_uz_poly &
    file output_files/displacement_data/disp_z_polymer_${dataname}_${interaction}_${nsteps}.dat


# ==========================================================================
#                  OUTPUT: RESERVOIR PRESSURES (permeation mode only)
# ==========================================================================
fix avg_P_feed all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} v_P_res_feed file output_files/stress_data/pressure_feed_${dataname}_${interaction}_${nsteps}.dat

fix avg_P_perm all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} v_P_res_perm file output_files/stress_data/pressure_permeate_${dataname}_${interaction}_${nsteps}.dat

# ----- Permeation: piston force vs reservoir pressure comparison -----
# At mechanical quasi-equilibrium the piston force balances the pressure difference:
#   c_piston_fz  ≈  (P_res_feed − P_res_perm) × lx × ly
# P_feed_force (= P_res_feed × lx × ly) is the feed-pressure force equivalent;
# comparing it to c_piston_fz validates that the reservoir pressure measurement
# is consistent with the actual contact force on the piston.
#
# Output file columns (one row per volume_freq steps):
#   step | F_piston_z | P_piston (=F/A) | P_res_feed | P_res_perm | P_feed×A
variable P_feed_force equal v_P_res_feed*v_piston_area
fix out_piston_force_perm all print ${volume_freq} '$(step) $(c_piston_fz) $(v_piston_pressure_z) $(v_P_res_feed) $(v_P_res_perm) $(v_P_feed_force)' file output_files/piston_data/piston_force_pressure_${dataname}_${interaction}_${nsteps}.dat screen no


# ==========================================================================
#                    OUTPUT: GEL STRAIN (for longitudinal modulus)
# ==========================================================================
# Columns: timestep | L_initial_rg (constant) | L_current_rg (dynamic)
# ΔL = L_initial - L_current;  ε = ΔL / L_initial
# Gel thickness from Rg: L = 2√3·√(Rg_zz²)  (uniform rectangular prism)
# This file is read by longitudinal_modulus_analysis.ipynb.
#
# NOTE: out_strain_zz is now defined PRE-DRIVE (see "OUTPUT: GEL STRAIN + Rg
# THICKNESS" above, before the Phase 1.5 reference window) so the strain_zz file
# opens with the equilibrated eps~=0 baseline.  It is intentionally NOT redefined
# here (a second definition of the same fix ID would error).

# Echo current strain to thermo log as well
variable gel_strain_pct equal v_gel_strain*100.0
fix out_gel_strain_thermo all print ${thermo_freq} &
    ">>> gel_strain = $(v_gel_strain_pct) %" screen yes &
    file output_files/stress_data/gel_strain_log_${dataname}_${interaction}_${nsteps}.dat


# ==========================================================================
#                    OUTPUT: GEL DIMENSIONS
# ==========================================================================

# Bounding-box volume and dimensions (for comparison/diagnostics)
fix out_gel_vol_bb all print ${volume_freq} "$(step) $(v_gel_vol_bb)" &
    file output_files/volume_data/gel_volume_bb_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_gel_dims_bb all print ${volume_freq} "$(step) $(v_gel_lx_bb) $(v_gel_ly_bb) $(v_gel_lz_bb)" &
    file output_files/volume_data/gel_dimensions_bb_${dataname}_${interaction}_${nsteps}.dat screen no

# Rg-based volume and dimensions (rectangular prism: L_i = 2√3·√Rg_ii²)
fix out_gel_vol_rg all print ${volume_freq} "$(step) $(v_gel_vol_rg)" &
    file output_files/volume_data/gel_volume_rg_${dataname}_${interaction}_${nsteps}.dat screen no

# NOTE: out_gel_dims_rg is now defined PRE-DRIVE (see "OUTPUT: GEL STRAIN + Rg
# THICKNESS" above) so the gel_dimensions_rg file opens with the equilibrated
# baseline.  It is intentionally NOT redefined here.

# Box dimensions
fix out_box_dims all print ${volume_freq} "$(step) $(v_box_lx) $(v_box_ly) $(v_box_lz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_polymer_com all print ${volume_freq} &
    "$(step) $(c_polymer_com[1]) $(c_polymer_com[2]) $(c_polymer_com[3])" &
    file output_files/volume_data/polymer_com_${dataname}_${interaction}_${nsteps}.dat screen no


# ==========================================================================
#            (ε=0 REFERENCE-STATE RECORDING — now done in Phase 1.5 above)
# ==========================================================================
# The zero-flux reference state IS now recorded, in the Phase 1.5 block near the
# top of Phase 2 (before the piston repositions).  Its label_after_ref_rec jump
# target lives there.  The old placeholder label that used to sit here has been
# removed to avoid a duplicate label of the same name.


# ==========================================================================
#                    OUTPUT: PARTIAL STRESS PROFILES (time-averaged)
# ==========================================================================
# These production ave/time (mode vector, via reduce/chunk) fixes acquire a
# compute chunk/atom lock.  Permeation runs them for a single production `run`
# and tears them down at final cleanup, so there is no competing ref_ fix to
# collide with (unlike triaxial_compression, which must sequence an ε=0
# reference block ahead of these on the same chunk/atom computes).

fix avg_stress_x_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_x_polymer mode vector file output_files/stress_data/stress_x_polymer_${dataname}_${interaction}_${nsteps}.dat

fix avg_stress_y_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_y_polymer mode vector file output_files/stress_data/stress_y_polymer_${dataname}_${interaction}_${nsteps}.dat

fix avg_stress_z_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_z_polymer mode vector file output_files/stress_data/stress_z_polymer_${dataname}_${interaction}_${nsteps}.dat

fix avg_stress_x_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_x_solvent mode vector file output_files/stress_data/stress_x_solvent_${dataname}_${interaction}_${nsteps}.dat

fix avg_stress_y_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_y_solvent mode vector file output_files/stress_data/stress_y_solvent_${dataname}_${interaction}_${nsteps}.dat

fix avg_stress_z_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_z_solvent mode vector file output_files/stress_data/stress_z_solvent_${dataname}_${interaction}_${nsteps}.dat

fix avg_stress_z_pist all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_z_piston mode vector file output_files/stress_data/stress_z_piston_${dataname}_${interaction}_${nsteps}.dat

fix avg_stress_z_supp all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_z_support mode vector file output_files/stress_data/stress_z_support_${dataname}_${interaction}_${nsteps}.dat

# True ZZ partial-stress outputs (σzz component only; used for longitudinal modulus)
fix avg_sigmazz_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmazz_poly mode vector file output_files/stress_data/sigmazz_polymer_${dataname}_${interaction}_${nsteps}.dat

fix avg_sigmazz_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmazz_solv mode vector file output_files/stress_data/sigmazz_solvent_${dataname}_${interaction}_${nsteps}.dat

fix avg_sigmaxx_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmaxx_poly mode vector file output_files/stress_data/sigmaxx_polymer_${dataname}_${interaction}_${nsteps}.dat

fix avg_sigmaxx_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmaxx_solv mode vector file output_files/stress_data/sigmaxx_solvent_${dataname}_${interaction}_${nsteps}.dat

fix avg_sigmayy_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmayy_poly mode vector file output_files/stress_data/sigmayy_polymer_${dataname}_${interaction}_${nsteps}.dat

fix avg_sigmayy_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmayy_solv mode vector file output_files/stress_data/sigmayy_solvent_${dataname}_${interaction}_${nsteps}.dat


# ==========================================================================
#        OUTPUT: SOLVENT DENSITY PROFILE + CAVITY-WIDOM TRAJECTORY
# ==========================================================================
# Solvent density profile: z-binned number density, time-averaged over
# windows aligned to nfreq_widom_dump.  Used by plot_lammps_log.py's
# plot_chempot_diagnostics to form mu_total(z) = mu_ex + kT*ln(rho_s).
#
# Cavity-Widom trajectory: all-atom snapshot at nfreq_widom_dump cadence.
# cavity_widom.py reads this to compute mu_ex(z) via test-particle insertion.
#
# Both are defined here (after ref_ teardown) so all frames come from the
# production phase. Active for the full run ${nsteps} + relax/perm_relax runs.
# NOTE: output_files/chemical_potential/ must exist before the run.
#       run_lammps.sh creates it automatically; for direct LAMMPS invocation:
shell mkdir -p output_files/chemical_potential

variable nevery_density  equal 100
variable nrepeat_density equal floor(v_nfreq_widom_dump/v_nevery_density)
variable nfreq_density   equal v_nevery_density*v_nrepeat_density
print ">>> Density: nevery=${nevery_density} nrepeat=${nrepeat_density} nfreq=${nfreq_density}"

compute chunk_z_solv_density solvent chunk/atom bin/1d z lower ${binWidth}
fix avg_solv_density all ave/chunk ${nevery_density} ${nrepeat_density} ${nfreq_density} &
    chunk_z_solv_density density/number &
    file output_files/chemical_potential/solvent_density_z_${dataname}_${interaction}_${totsteps}.dat

# All-atom trajectory for cavity_widom.py (solvent type 3 + all others for WCA energy)
dump widom_traj all custom ${nfreq_widom_dump} &
    traj_files/widom_${dataname}_${interaction}_${totsteps}.lammpstrj id type x y z


print ">>> Starting Phase 2 production run (nsteps = ${nsteps})"
print ">>> Mode: PERMEATION (piston-driven flow)"
if "${cont} == 1" then "print '>>> Continuing after ${oldsteps} timesteps'"

variable phase2_start equal $(step)

# ==========================================================================
#                         PRODUCTION RUN
# ==========================================================================
# Runs to completion (nsteps) unless halt_perm fires first (feed reservoir
# thins to feed_halt_thick).

run ${nsteps}


# ==========================================================================
#                            POST-RUN CLEANUP
# ==========================================================================
# The main run ended because halt_perm fired (feed ≤ feed_halt_thick) or
# nsteps were exhausted.  Velocity-controlled permeation has no second run
# phase; simply unfix the halt and proceed to final cleanup.
unfix halt_perm

# Piston force output — removed here after all runs are complete
unfix out_piston_force
unfix out_piston_force_avg
unfix out_piston_force_perm

# Unfix permeation-mode fixes
unfix out_permeate_flux
unfix avg_disp_z_poly

undump traj_flow
undump pairlocal_dump
undump traj_stress_sync
undump widom_traj
unfix avg_solv_density

print "========================================"
print "Simulation complete"
print "========================================"

variable outfile string "final_flow_${dataname}_${interaction}_${nsteps}"
write_data ${outfile}.data



