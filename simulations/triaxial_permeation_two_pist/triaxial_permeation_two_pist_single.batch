#!/usr/bin/env bash
#SBATCH --job-name=triax_perm2p
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=6
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --output=%x.o%j.%N
source "$HOME/Documents/lammps_work/scripts/batch_prologue.sh"

# Two-piston permeation: one constant-pressure drive at a single dP (P_feed = PRESS_TARGET +
# DP_PISTON, P_perm = PRESS_TARGET) for NSTEPS after the settle, reference window and dP ramp.
# Then FROZEN=1 (Phase 2d): the polymer is stopped in its steady state and the same dP drives
# solvent through the rigid network for FROZEN_STEPS (files _<NSTEPS>_f; kappa_f against the
# live kappa). UNLOAD=1 (Phase 2c, off by default) adds a ramp back to zero dP and a free
# re-swelling hold (files _<NSTEPS>_u; costs ~10 M steps). The deck has no wall_timeout.
#
# DATANAME comes from the environment (default: the 5-bead rot45 standard gel, the same
# _two_pist_pm40 file the compression deck reads). Variants:
#     DATANAME=<stem> sbatch triaxial_permeation_two_pist_single.batch
#     DATANAME=<15-bead stem> DP_PISTON=<0.24 M> sbatch ...        dP from the 15-bead compression's M (eps_F = dP/(2M) ~ 0.12);
#                                                                  1.9x the atoms: add --nodes=10 or halve the budgets
#     FROZEN_AT=ref NSTEPS_OVERRIDE=4000000 DATANAME=<stem> sbatch ...   network frozen in the reference state BEFORE the
#                                                                  ramp: the undeformed gel's kappa (~6 M steps)
# Analysis: triaxial_permeation_single_two_pist.ipynb (figure 9 kappa, 9f frozen, 12 drive D_c, 12u unload).

FOLDER=triaxial_permeation_two_pist
DATANAME="${DATANAME:-final_config_slab_support_periodic_5beads_tall_rho04_rot45_1.0_1.0_20000000_two_pist_pm40}"
INTERACTION=1.0_1.0
NSTEPS="${NSTEPS_OVERRIDE:-10800000}"   # drive length and output-file tag: 54 k tau = 4.1 tau_1 at the drive D_c 0.147, L 138
export PRESS_TARGET=1.5
export DP_PISTON="${DP_PISTON:-0.1}"
export FROZEN=1 FROZEN_STEPS=4000000 FROZEN_AT="${FROZEN_AT:-end}"
export UNLOAD="${UNLOAD:-0}" UNLOAD_STEPS="${UNLOAD_STEPS:-8000000}"
echo ">>> DATANAME=$DATANAME DP_PISTON=$DP_PISTON FROZEN_AT=$FROZEN_AT UNLOAD=$UNLOAD NSTEPS=$NSTEPS"

bash "$LAMMPS_WORK_DIR/scripts/run_lammps.sh" "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS"
