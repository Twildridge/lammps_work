#!/usr/bin/env bash
#SBATCH --job-name=builder_u_test
#SBATCH --partition=debug
#SBATCH --account=csb197
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=00:30:00
#SBATCH --output=/home/dpollard/Documents/lammps_runs/chain_length_testing/builder_uniformity_20261114/%x.o%j
# builder_uniformity_test.batch (2026-11-14) -- side-by-side builds of the random 10-bead periodic
# slab with different weights of the density-uniformity term of the bond-switch acceptance
# (lib/data_file_generator.www_bond_switch, w_uniform).  No MD: each build ends with the builder's
# own isotropy and density reports, which is what is compared.  Small block (6 x 6 x 8 cells) so
# that all variants finish inside the debug limit; the metrics are intensive.
#   WEIGHTS="0 0.3 1 3"   BOX_XY=47   THICK=62   SEED=7 (bond_switch_seed)
# Files go to scratch ($SCRATCH_DIR/builder_uniformity_20261114); logs next to this job's output.
set -u
source "$HOME/Documents/lammps_work/scripts/lib/site.sh"
LOGDIR=$RUNS_DIR/chain_length_testing/builder_uniformity_20261114
OUT=$SCRATCH_DIR/builder_uniformity_20261114
mkdir -p "$OUT"
load_python_module
python -c "import numpy, scipy; print('numpy', numpy.__version__, 'scipy', scipy.__version__)"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
cd "$LAMMPS_WORK_DIR/scripts/lib" || exit 1
# VARIANTS: space-separated "weight[:key=value[,key=value...]]" items, e.g. "0 1:n_sweeps=48 1:n_sweeps=48,u_voxel=1.0"
TAGS=()
for item in ${VARIANTS:-${WEIGHTS:-0 0.3 1 3}}; do
    w=${item%%:*}; opts=""; [ "$item" = "$w" ] || opts=${item#*:}
    tag="_w${w}${opts:+_$(echo "$opts" | tr ',=' '__')}_s${SEED:-7}"; TAGS+=("$tag")
    # shellcheck disable=SC2086
    python -u build_beads_sweep.py --beads 10 --network random_u --shape test --box-xy "${BOX_XY:-47}" --thickness "${THICK:-62}" \
        --w-uniform "$w" ${opts:+--switch-opt ${opts//,/ }} --switch-seed "${SEED:-7}" --tag "$tag" --outdir "$OUT" > "$LOGDIR/build${tag}.log" 2>&1 &
done
wait
for f in "${TAGS[@]/#/$LOGDIR/build}"; do f="$f.log";
    echo "===== $f"
    grep -E "density-uniformity term ON|bond switching done|Fano factor after|4th-rank anisotropy|Born-affine Zener|polymer density on|largest empty sphere|DENSITY|^built|Traceback|Error" "$f" | cut -c1-230
done
