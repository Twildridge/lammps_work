# ========== Pure Solvent Equilibration ==========
# Variables loaded via bash script:
# - dataname: name of data file
# - interaction: epsSS label (e.g. "1p0")
# - nsteps: production run steps
# - oldsteps: previous timesteps (for restart)
# - totsteps: total cumulative timesteps
# - epsSS: solvent-solvent interaction strength

# Reduced LJ units: tau = sigma*sqrt(m/epsilon)
# (sigma = 1, m = 1, epsilon = 1.0)
# dt = 0.005 → 1e6 steps ≈ 5e3 tau


# ========== Simulation Parameters ==========
variable sigma equal 1.0
variable binWidth equal 2

# Time averaging parameters
variable nevery_avg_stress equal 200
variable nrepeat_avg_stress equal 50
variable nfreq_avg_stress equal 10000

# Output frequencies
variable thermo_freq equal 5000
variable dump_freq equal 25000
variable volume_freq equal 5000

# Equilibration parameters
variable temp_target equal 1.0
variable press_target equal 0.5
variable tdamp equal 1.0
variable pdamp equal 1.0
variable timestep_gentle equal 0.001
variable timestep_prod equal 0.005
variable nsteps_gentle equal 1000



# ========== Initialization ==========
units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

# Read initial data or restart
variable is_restart equal is_file(restart_${dataname}_${interaction}_${oldsteps}.restart)
variable restartFlag string file

# Force fresh start if oldsteps is 0
if "${oldsteps} == 0" then &
    "variable is_restart equal 0"

if "${is_restart} == 1" then &
    "read_restart restart_${dataname}_${interaction}_${oldsteps}.restart" &
else &
    "read_data data_files/${dataname}.data"

if "${is_restart} == 1" then &
    "variable restartFlag string append"

print ">>> is_restart = ${is_restart}"
print ">>> Previous    # of timesteps: ${oldsteps}"
print ">>> Current     # of timesteps: ${nsteps}"
print ">>> Cumulative  # of timesteps: ${totsteps}"

comm_modify cutoff 5.0



# ========== Group Definitions ==========
group solvent type 1



# =====================================================================
#   PHASE 1: INTERATOMIC POTENTIALS
# =====================================================================
pair_style lj/cut 2.5
pair_coeff 1 1 ${epsSS} ${sigma} 2.5  # solvent-solvent

bond_style none
special_bonds lj 0.0 0.0 0.0



# =====================================================================
#   PHASE 2: ENERGY MINIMIZATION (fresh start only)
# =====================================================================
if "${is_restart} == 0" then &
    "minimize 1.0e-4 1.0e-6 10000 100000"



# =====================================================================
#   THERMO OUTPUT
# =====================================================================
thermo_style custom step temp pe ke etotal press vol lx ly lz
thermo ${thermo_freq}



# =====================================================================
#   PHASE 3: GENTLE NVT THERMALIZATION (fresh start only)
# =====================================================================
if "${is_restart} == 0" then "reset_timestep 0"
if "${is_restart} == 0" then "velocity solvent create 0.1 12345 mom yes rot no"
if "${is_restart} == 0" then "fix 1 solvent nve/limit 0.01"
if "${is_restart} == 0" then "fix 2 solvent langevin ${temp_target} ${temp_target} ${tdamp} 904297"
if "${is_restart} == 0" then "timestep ${timestep_gentle}"
if "${is_restart} == 0" then "run ${nsteps_gentle}"
if "${is_restart} == 0" then "unfix 1"
if "${is_restart} == 0" then "unfix 2"



# ========== Number Density & Box Dimensions ==========
# Number density = N_solvent / V_box (units: 1/sigma^3)
variable N_solvent equal count(solvent)
variable box_vol   equal lx*ly*lz
variable num_density equal v_N_solvent/v_box_vol

# Box dimensions for volume tracking
variable box_lx equal lx
variable box_ly equal ly
variable box_lz equal lz



# ========== NPT Equilibration ==========
if "${is_restart} == 0" then "reset_timestep 0"
fix 1 solvent npt temp ${temp_target} ${temp_target} ${tdamp} iso ${press_target} ${press_target} ${pdamp}
timestep ${timestep_prod}
if "${is_restart} == 0" then "run ${nsteps_gentle}"



# =====================================================================
#   PRODUCTION RUN
# =====================================================================

# Trajectory output
dump solv_traj solvent custom ${dump_freq} traj_files/solvent_${dataname}_${interaction}_${totsteps}.lammpstrj id type mol x y z

# Box dimensions → reused by plot_lammps_log.py "Box Volume / Initial" panel
fix box_dims_output all print ${volume_freq} "$(step) ${box_lx} ${box_ly} ${box_lz}" &
    ${restartFlag} output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat screen no

# Number density (beads/sigma^3) → new panel in plot_lammps_log.py
fix num_density_output all print ${volume_freq} "$(step) ${num_density}" &
    ${restartFlag} output_files/volume_data/num_density_${dataname}_${interaction}_${totsteps}.dat screen no

# Production run
run ${nsteps}



# ========== Cleanup ==========
unfix 1
undump solv_traj



# ========== Save Final Configuration ==========
write_restart restart_${dataname}_${interaction}_${totsteps}.restart
write_data final_config_${dataname}_${interaction}_${totsteps}.data
