#!/usr/bin/env bash
# One allocation-benchmark run.  submit_benchmark.sh sets job name, partition, account, nodes,
# tasks, cpus, memory and time on the sbatch command line, and ROLE, NBEADS, SCALE, MAP,
# COMM_CUT, NSTEPS, REP, TAG and CLUSTER through --export.  Do not sbatch this by hand.
#SBATCH --output=logs_slurm/%x.o%j.%N

# Same environment as production: the cluster's MPI settings and modules from scripts/lib/site.sh
source "$HOME/Documents/lammps_work/scripts/lib/site.sh" || exit 1
mpi_env
load_lammps_modules

bash "$LAMMPS_WORK_DIR/simulations/allocation_benchmark/run_benchmark.sh"
