#!/bin/bash -l
#SBATCH --job-name=solv_flow
#SBATCH --output=slurm_%j.out
#SBATCH --error=slurm_%j.err
#SBATCH --account=csb197
#SBATCH --nodes=5
#SBATCH --ntasks-per-node=120
#SBATCH --cpus-per-task=1
#SBATCH --partition=compute
#SBATCH --time=6:00:00


# Load required modules for LAMMPS on Expanse (use this order)
module purge
module load slurm
module load cpu/0.17.3b
module load gcc/10.2.0/npcyll4
module load openmpi/4.1.3/oq3qvsv
module load lammps/20210310/jqd2pok-omp
module load python/3.8.12/7zdjza7


export UCX_LOG_LEVEL=ERROR
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

ulimit -n 2048 # gives more headroom for number of open file descriptors

# Set simulation parameters
FOLDER="slab_with_flow"
DATANAME="walled_slab_support_5beads_tall_4_1.0_1.05_15000000"
INTERACTION="1.0_1.05" # first number is solvent–solvent; second is polymer–solvent
NSTEPS=10001
OLDSTEPS=0          # Set to 0 for fresh run, or previous totsteps for continuation
TYPE=""             # Options: stress, volume, stressvol, or leave empty (just type "")

# Navigate to the scripts directory
cd ~/Documents/lammps_work/scripts || exit 1

# Run the simulation
if [ -z "$TYPE" ]; then
    ./run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS" "$OLDSTEPS"
else
    ./run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS" "$OLDSTEPS" "$TYPE"
fi
