#!/usr/bin/env bash

#SBATCH --job-name=triax_comp2p_quarter
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=32
#SBATCH --cpus-per-task=4
#SBATCH --mem=0
#SBATCH --time=24:00:00
#SBATCH --output=%x.o%j.%N

# -----------------------------------------------------------------------
# SELF-SYNC GUARD (must run BEFORE COMPRESSIONS is defined below).  sbatch
# submits whatever copy of this file is on disk; if it is stale the sweep list
# is wrong and run_lammps.sh's own git pull is too late (COMPRESSIONS is already
# exported).  Pull first, then re-exec the fresh batch.  (Mirrors
# triaxial_compression.batch / shear_slab.batch.)
# -----------------------------------------------------------------------
LAMMPS_WORK_DIR="$HOME/Documents/lammps_work"
if [ -z "${TRIAX_BATCH_SYNCED:-}" ]; then
    echo ">>> [self-sync] pulling lammps_work before defining COMPRESSIONS..."
    command -v git &>/dev/null && git -C "$LAMMPS_WORK_DIR" pull --rebase --autostash || true
    export TRIAX_BATCH_SYNCED=1
    exec bash "$LAMMPS_WORK_DIR/simulations/triaxial_compression_two_pist/triaxial_compression_two_pist_quarter.batch"
fi
echo ">>> [self-sync] running freshly synced batch (TRIAX_BATCH_SYNCED=1)"

# Set environment variables
declare -xr OMPI_UNIT='core'
declare -xr OMPI_MCA_btl='self,vader'

declare -xr UCX_LOG_LEVEL='ERROR'
declare -xr UCX_TLS='self,cma,shm,rc,ud,dc'
declare -xr UCX_NET_DEVICES='mlx5_2:1'
declare -xir UCX_MAX_RNDV_RAILS=1

declare -xir OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"

# Load required modules for LAMMPS on Expanse (use this order)
module reset
module load gcc/10.2.0
module load openmpi/4.1.3
module load python/3.8.12

# =======================================================================
# QUARTER-THICKNESS GEL (2026-10-05): third thickness of the L^2 test of the hold relaxation.
# The half-thickness run showed the hold IS drainage (tau_1 2316 tau at L 60 against 6206 at
# L 114), but its fitted D_c came out LOWER than the full gel's (0.040 against 0.053; tau_1
# ratio 2.7, L^2 ratio 3.56).  If that is real, part of the relaxation time does not scale as
# L^2 -- e.g. a fixed-thickness layer at each plate in series with the bulk, tau_1 =
# L^2/(4 pi^2 D_c) + b L -- and the bulk D_c is ~0.084, the steady-permeation / Darcy value.
# Two thicknesses cannot tell; on this gel (L_bb 31.6) the two readings are a factor 2 apart:
#     pure L^2:              fitted D_c ~0.05   (tau_1 ~ 450 tau)
#     linear boundary term:  fitted D_c ~0.026  (tau_1 ~ 900 tau)
# Data file: scripts/lib/slab_two_pistons.py --cut-existing <..._two_pist.data>
#   --gel-keep-frac 0.25 --output <..._two_pist_quarter.data>   (cut_two_pist; 161,635 atoms)
#
# What differs from the half-thickness batch, and why:
#   * DISP_FINE_NFREQ=5000: the hold displacement profile is ALSO written every 25 tau on
#     1-sigma bins (disp_z_polymer_fine; lib/triaxial.py load_disp prefers it).  The standard
#     file has 1000-tau blocks and its first complete block ends 1000-1900 tau into the hold:
#     at the half run's 0.15 / 0.20 levels the transient was already down to 0.2 sigma (S/N ~2)
#     and those D_c are only bounds.  Here tau_1 is under 1000 tau, so the standard file alone
#     would miss the relaxation entirely.
#   * STRAIN_TARGETS (0.20 0.30 0.40): the SAME absolute plate closures as the half run's
#     0.10 / 0.15 / 0.20 (6.8 / 10.2 / 13.6 sigma), so the transient amplitudes match.  The
#     ~4 sigma the applied strain loses to rigid travel (seating + the soft cut face; half run:
#     applied 0.10 / 0.15 / 0.20 -> profile strain 0.05 / 0.09 / 0.14) is a larger share of a
#     thin gel: expect profile strains of ~0.10 / 0.18 / 0.27, the states of run 7's
#     0.10 / 0.20 / 0.3 levels.  Three levels = three independent transients.
#   * Holds stay FLAT at 4M steps (20,000 tau, > 20 tau_1 either way): far more than the D_c
#     fit needs, but the plateau window (last 25 %) sets the noise of M and kappa = D_c/M, and
#     the gel has a quarter of the beads per unit area (half run, 0.10: M known to +-32 %).
#   * The feed piston barely moves (half run: +0.2 sigma over the sweep; the load piston is
#     solvent-transparent), so the 15-sigma feed margin is not a limit at 0.40.
# Analysis: triaxial_compression_sweep_two_pist.ipynb with DATANAME ..._quarter, the new RUN_ID,
#   COMP_LEVELS ["0.20", "0.30", "0.40"].
#
# TWO-PISTON COMPRESSION (2026-09-16): drained consolidation at constant bath
# pressure.  Both reservoirs are held at PRESS_TARGET by NPT-pistons and a
# solvent-transparent load piston loads the network through the SAME cumulative
# strain sweep as triaxial_compression.batch (STRAIN_TARGETS -> COMPRESSIONS,
# _c<strain> tags, auto-sized holds, sweep notebook).  This is the ONLY sweep in
# the two-piston sequence (it generates the stress-strain curve).
#
# DATANAME is the CONVERTER output (scripts/slab_two_pistons.ipynb) of the
# 2026-09-07 piston-transparent slab; copy it to ~/Documents/lammps_data/input_data/.
# =======================================================================
FOLDER="triaxial_compression_two_pist"
DATANAME="final_config_slab_support_periodic_5beads_tall_rho04_new_1.0_1.0_14000002_two_pist_quarter"
INTERACTION="1.0_1.0"   # epsSS_epsSP
# NSTEPS: (a) FALLBACK hold length with -var hold_auto 0 and (b) the tag of the
# setup-phase files only.  Every reference/production file is tagged with its
# level's AUTO-SIZED HOLD LENGTH (..._<hold>_c<strain>.dat) -- see the NSTEPS
# block of triaxial_compression.batch; the notebooks resolve the tags (NSTEPS=None).
NSTEPS=4000000          # the flat hold length of every level (HOLD_AUTO=0 below)
TYPE=""
PRESS_TARGET=1.5        # bath pressure on BOTH wet pistons for the whole run

# ----- NPT-piston knobs (forwarded by run_lammps.sh as -var) -----
export PISTON_MASS=1000       # mass per piston bead (types 5/6/7)
export C_PIST_FRAC=1.0        # damping / critical damping (the .lmp prints C_crit and the period)
export NPT_PISTON_STEPS=1000000   # Phase-1 settle of the wet pistons (replaces the 2M aniso NPH Phase 0)
export SETTLE_HALT=0          # 1 = end the settle early once both pistons are at rest
export HOLD_AUTO=0            # flat holds of NSTEPS steps (see the header)
export DISP_FINE_NFREQ=5000   # fine-cadence hold displacement profile: block length in steps (25 tau); 0 = off
export DISP_FINE_BIN=1.0      # its z-bin width (sigma)

# -----------------------------------------------------------------------
# Compression stress-strain SWEEP: cumulative strain targets (fraction of the BB
# reference thickness L0_bb).  Each level: symmetric drive -- load piston DOWN +
# support UP, half the closure each (DRIVE_SPLIT below) -- until the plate gap
# reaches the target (fix halt), freeze both, auto-sized hold, files tagged _c<strain>.  Solvent expelled
# by the compression raises the FEED PISTON by ~strain*L0: the converter's
# margin_feed (default 15 sigma ~ strain 0.10 on the rho04 slab) must cover the
# deepest level or the box-face halt ends the run -- rebuild the data file with
# a larger margin_feed for deeper sweeps (slab_two_pistons.ipynb prints the limit).
#
# WALL TIME: as triaxial_compression.batch (~7-10M steps per level with auto
# holds) plus the settle; ~290k atoms.  Do a SHORT trial first
# (STRAIN_TARGETS=(0.05) with -var hold_auto 0 and a small NSTEPS).
# -----------------------------------------------------------------------
# NOTE: the list must be exported as a SCALAR string (bash does not export
# arrays); STRAIN_TARGETS is the array, COMPRESSIONS the scalar run_lammps.sh reads.
# example: STRAIN_TARGETS=(0.05 0.10 0.15 0.20)
STRAIN_TARGETS=(0.20 0.30 0.40)
export COMPRESSIONS="${STRAIN_TARGETS[*]}"
export DRIVE_SPLIT=0.5        # load-piston share of the gap closure (0.5 = symmetric drive; 1.0 = load piston only)

# Navigate to the scripts directory
cd ~/Documents/lammps_work/scripts || exit 1

# Run the simulation
# Positional args to run_lammps.sh: FOLDER DATANAME INTERACTION NSTEPS TYPE PRESS_TARGET
bash run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS" "$TYPE" "$PRESS_TARGET"
