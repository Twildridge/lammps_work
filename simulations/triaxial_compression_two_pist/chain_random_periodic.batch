#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# chain_random_periodic.batch (2026-11-02) -- the bridge between the random periodic slab
# equilibration and its two-piston compression run.  Submitted by
# scripts/submit_random_periodic_pipeline.sh as
#     sbatch --dependency=afterany:<slab job> --export=ALL,SLAB_JOB=<slab job> chain_random_periodic.batch
# so it starts when that job ends, on ONE core of the shared partition (a few SU).  It
#   1. finds the slab run's final_config_<DATANAME>_1.0_1.0_14000000.data (newest run dir,
#      continuation_* subdirs included);
#   2. if there is none and the slab job chained a continuation (CHAIN=1: run_lammps.sh prints
#      the continuation's "Submitted batch job N" into the slab job's output file), re-submits
#      ITSELF with --dependency=afterany on that job and exits (at most 6 hops);
#   3. copies the final config to ~/Documents/lammps_data/input_data/ (the slab run dir keeps its
#      copy), converts it with scripts/lib/slab_two_pistons_periodic.py into the two-piston
#      geometry (<stem>_two_pist.data, an entry in slab_data_file_info.md), and
#   4. submits triaxial_compression_two_pist_random.batch from this folder.
# Everything is idempotent: an existing copy / converted file is kept, not rewritten.
# Successor of archive/simulations/triaxial_compression/chain_after_slab.batch (2026-09-07),
# which ran the one-piston deck inside its own 4-node allocation; this one only bridges.
# ---------------------------------------------------------------------------
#SBATCH --job-name=chain_random_periodic
#SBATCH --partition=shared
#SBATCH --account=csb197
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --output=%x.o%j.%N
{
set -u
LAMMPS_WORK_DIR="$HOME/Documents/lammps_work"
SLAB_DIR="$LAMMPS_WORK_DIR/simulations/slab_with_support"
TRIAX_DIR="$LAMMPS_WORK_DIR/simulations/triaxial_compression_two_pist"
RUNS="$HOME/Documents/lammps_runs/slab_with_support"
INPUT_DATA="$HOME/Documents/lammps_data/input_data"
DATANAME="slab_support_periodic_5beads_tall_rho04_random"
INTERACTION="1.0_1.0"
NSTEPS=14000000
FINAL="final_config_${DATANAME}_${INTERACTION}_${NSTEPS}.data"
TWO_PIST="${FINAL%.data}_two_pist.data"
TRIAX_BATCH="triaxial_compression_two_pist_random.batch"
SLAB_JOB="${SLAB_JOB:-}"          # the slab job (or continuation) this job waited on
CHAIN_HOPS="${CHAIN_HOPS:-0}"

echo "======================================================================"
echo "chain_random_periodic  $(date)   job ${SLURM_JOB_ID:-?}   waited on slab job ${SLAB_JOB:-?} (hop ${CHAIN_HOPS})"
echo "======================================================================"
if [ -n "$SLAB_JOB" ]; then
    echo ">>> slab job ${SLAB_JOB} accounting:"
    sacct -j "$SLAB_JOB" --format=JobID,JobName%24,State,Elapsed,ExitCode -X 2>/dev/null || true
fi

# ---- 1. the slab's final configuration -----------------------------------------
SRC=""
for f in $(ls -t "$RUNS"/slab_with_support_${DATANAME}_${INTERACTION}_*/"$FINAL" \
                 "$RUNS"/slab_with_support_${DATANAME}_${INTERACTION}_*/continuation_*/"$FINAL" 2>/dev/null); do
    SRC="$f"; break
done

if [ -z "$SRC" ]; then
    echo ">>> no $FINAL under $RUNS yet."
    # ---- 2. did the slab job chain a continuation?  ------------------------------
    NEXT=""
    if [ -n "$SLAB_JOB" ]; then
        OUT=$(ls -t "$SLAB_DIR"/*.o${SLAB_JOB}.* 2>/dev/null | head -1 || true)
        if [ -n "$OUT" ]; then
            echo ">>> slab job output: $OUT"
            NEXT=$(grep -oE 'Submitted batch job [0-9]+' "$OUT" | tail -1 | awk '{print $4}' || true)
        fi
    fi
    if [ -n "$NEXT" ] && [ "$CHAIN_HOPS" -lt 6 ]; then
        echo ">>> the slab job chained continuation job ${NEXT}; waiting for it (hop $((CHAIN_HOPS + 1)))..."
        squeue -j "$NEXT" 2>/dev/null || true
        cd "$TRIAX_DIR" || exit 1
        sbatch --dependency=afterany:"$NEXT" --export=ALL,SLAB_JOB="$NEXT",CHAIN_HOPS=$((CHAIN_HOPS + 1)) "$TRIAX_DIR/chain_random_periodic.batch"
        exit $?
    fi
    echo "ERROR: the slab run produced no $FINAL and no continuation job was found."
    echo "       Check $SLAB_DIR/slab_periodic_random.o${SLAB_JOB}.* and the newest run dir under $RUNS."
    echo "       When the final config exists, run by hand:  cd $TRIAX_DIR && SLAB_JOB=$SLAB_JOB bash chain_random_periodic.batch"
    exit 1
fi
echo ">>> slab final configuration: $SRC"
grep -m1 "Total wall time" "$(dirname "$SRC")/log.lammps" 2>/dev/null || true

# ---- 3. copy to input_data and convert ------------------------------------------------
mkdir -p "$INPUT_DATA"
if [ -e "$INPUT_DATA/$FINAL" ]; then
    echo ">>> $INPUT_DATA/$FINAL already exists; keeping it."
else
    cp "$SRC" "$INPUT_DATA/$FINAL" && echo ">>> copied to $INPUT_DATA/$FINAL"
fi
ls -la "$INPUT_DATA/$FINAL"

if [ -e "$INPUT_DATA/$TWO_PIST" ]; then
    echo ">>> $INPUT_DATA/$TWO_PIST already exists; keeping it."
else
    source /etc/profile.d/modules.sh
    module reset 2>/dev/null || true
    module unload python/3.8.12 2>/dev/null || true
    module load anaconda3/2021.05/q4munrg
    python -c "import numpy, scipy; print('numpy', numpy.__version__, 'scipy', scipy.__version__)"
    echo ">>> converting to the two-piston geometry (scripts/lib/slab_two_pistons_periodic.py)..."
    cd "$LAMMPS_WORK_DIR/scripts/lib" || exit 1
    if ! python slab_two_pistons_periodic.py --input "$INPUT_DATA/$FINAL" --output "$INPUT_DATA/$TWO_PIST"; then
        echo "ERROR: the two-piston conversion failed; the triaxial run was NOT submitted."
        rm -f "$INPUT_DATA/$TWO_PIST"
        exit 1
    fi
fi
ls -la "$INPUT_DATA/$TWO_PIST"

# ---- 4. the compression run -------------------------------------------------------------
cd "$TRIAX_DIR" || exit 1
echo ">>> submitting $TRIAX_BATCH (DATANAME ${TWO_PIST%.data})"
grep -n '^DATANAME=\|^NSTEPS=\|^STRAIN_TARGETS=' "$TRIAX_BATCH"
sbatch "$TRIAX_BATCH"
exit $?
}
exit
