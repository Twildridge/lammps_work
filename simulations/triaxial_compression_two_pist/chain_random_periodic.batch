#!/usr/bin/env bash
# chain_random_periodic.batch -- the bridge between a periodic slab equilibration and its two-piston
# run(s), on one core of the shared partition. Submit it with --dependency=afterany on the slab job
# (scripts/submit_random_periodic_pipeline.sh does, for the random pipeline):
#     sbatch --dependency=afterany:<job> --export=ALL,SLAB_JOB=<job>[,knobs...] chain_random_periodic.batch
# Knobs (environment; defaults = the random pipeline):
#     SLAB_FOLDER    run folder of the equilibration (slab_with_support | chain_length_testing)
#     SLAB_DATANAME  its DATANAME; SLAB_NSTEPS its budget NSTEPS (the final_config tag)
#     MARGIN_PERM    converter --margin-perm (empty = default -> <stem>_two_pist; 40 -> <stem>_two_pist_pm40,
#                    the file both two-piston decks read since 2026-11-07)
#     SUBMIT         "compression" (default) and/or "permeation"; DP_PISTON is passed through when set
# e.g. the rot45 standard gel after  NETWORK=rot45 bash submit_chain_length_sweep.sh 5  (job J):
#     sbatch --dependency=afterany:J --export=ALL,SLAB_JOB=J,SLAB_FOLDER=chain_length_testing,\
#       SLAB_DATANAME=slab_support_periodic_5beads_tall_rho04_rot45,SLAB_NSTEPS=14000000,MARGIN_PERM=40,\
#       SUBMIT="compression permeation" chain_random_periodic.batch
# It finds the slab run's final_config (continuation_* subdirs included); if the slab job chained a
# continuation instead, it re-submits itself after that job (at most 6 hops). Then it copies the final
# config to input_data/, converts it (lib/slab_two_pistons_periodic.py) and submits the run(s) with
# DATANAME exported. Existing copies and converted files are kept.
#SBATCH --job-name=chain_random_periodic
#SBATCH --partition=shared
#SBATCH --account=csb197
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --output=%x.o%j.%N
{
set -u
source "$HOME/Documents/lammps_work/scripts/lib/site.sh"
TRIAX_DIR="$LAMMPS_WORK_DIR/simulations/triaxial_compression_two_pist"
SLAB_FOLDER="${SLAB_FOLDER:-slab_with_support}"
RUNS="$RUNS_DIR/$SLAB_FOLDER"
INPUT_DATA="$INPUT_DATA_DIR"
DATANAME="${SLAB_DATANAME:-slab_support_periodic_5beads_tall_rho04_random}"
INTERACTION="1.0_1.0"
NSTEPS="${SLAB_NSTEPS:-14000000}"
MARGIN_PERM="${MARGIN_PERM:-}"
SUBMIT="${SUBMIT:-compression}"
FINAL="final_config_${DATANAME}_${INTERACTION}_${NSTEPS}.data"
if [ -n "$MARGIN_PERM" ]; then
    TWO_PIST="${FINAL%.data}_two_pist_pm${MARGIN_PERM%.*}.data"
    CONV_OPTS=(--margin-perm "$MARGIN_PERM")
else
    TWO_PIST="${FINAL%.data}_two_pist.data"
    CONV_OPTS=()
fi
# the compression batch: the random pipeline's own batch for its DATANAME, else the single batch with DATANAME exported
if [ "$DATANAME" = "slab_support_periodic_5beads_tall_rho04_random" ] && [ -z "$MARGIN_PERM" ]; then
    TRIAX_BATCH="triaxial_compression_two_pist_random.batch"
else
    TRIAX_BATCH="triaxial_compression_two_pist_single.batch"
fi
PERM_DIR="$LAMMPS_WORK_DIR/simulations/triaxial_permeation_two_pist"
PERM_BATCH="triaxial_permeation_two_pist_single.batch"
SLAB_JOB="${SLAB_JOB:-}"          # the slab job (or continuation) this job waited on
CHAIN_HOPS="${CHAIN_HOPS:-0}"

echo "======================================================================"
echo "chain_random_periodic  $(date)   job ${SLURM_JOB_ID:-?}   waited on slab job ${SLAB_JOB:-?} (hop ${CHAIN_HOPS})"
echo "======================================================================"
if [ -n "$SLAB_JOB" ]; then
    echo ">>> slab job ${SLAB_JOB} accounting:"
    sacct -j "$SLAB_JOB" --format=JobID,JobName%24,State,Elapsed,ExitCode -X 2>/dev/null || true
fi

# ---- 1. the slab's final configuration -----------------------------------------
SRC=""
for f in $(ls -t "$RUNS"/${SLAB_FOLDER}_${DATANAME}_${INTERACTION}_*/"$FINAL" \
                 "$RUNS"/${SLAB_FOLDER}_${DATANAME}_${INTERACTION}_*/continuation_*/"$FINAL" 2>/dev/null); do
    SRC="$f"; break
done

if [ -z "$SRC" ]; then
    echo ">>> no $FINAL under $RUNS yet."
    # ---- 2. did the slab job chain a continuation?  ------------------------------
    NEXT=""
    if [ -n "$SLAB_JOB" ]; then
        OUT=$(ls -t "$LAMMPS_WORK_DIR/simulations/$SLAB_FOLDER"/*.o${SLAB_JOB}.* 2>/dev/null | head -1 || true)
        if [ -n "$OUT" ]; then
            echo ">>> slab job output: $OUT"
            NEXT=$(grep -oE 'Submitted batch job [0-9]+' "$OUT" | tail -1 | awk '{print $4}' || true)
        fi
    fi
    if [ -n "$NEXT" ] && [ "$CHAIN_HOPS" -lt 6 ]; then
        echo ">>> the slab job chained continuation job ${NEXT}; waiting for it (hop $((CHAIN_HOPS + 1)))..."
        squeue -j "$NEXT" 2>/dev/null || true
        cd "$TRIAX_DIR" || exit 1
        sbatch --dependency=afterany:"$NEXT" --export=ALL,SLAB_JOB="$NEXT",CHAIN_HOPS=$((CHAIN_HOPS + 1)),SLAB_FOLDER="$SLAB_FOLDER",SLAB_DATANAME="$DATANAME",SLAB_NSTEPS="$NSTEPS",MARGIN_PERM="$MARGIN_PERM",SUBMIT="$SUBMIT" "$TRIAX_DIR/chain_random_periodic.batch"
        exit $?
    fi
    echo "ERROR: the slab run produced no $FINAL and no continuation job was found."
    echo "       Check the slab job's output file in $LAMMPS_WORK_DIR/simulations/$SLAB_FOLDER and the newest run dir under $RUNS."
    echo "       When the final config exists, run by hand:  cd $TRIAX_DIR && SLAB_JOB=$SLAB_JOB SLAB_FOLDER=$SLAB_FOLDER SLAB_DATANAME=$DATANAME SLAB_NSTEPS=$NSTEPS MARGIN_PERM=$MARGIN_PERM SUBMIT=\"$SUBMIT\" bash chain_random_periodic.batch"
    exit 1
fi
echo ">>> slab final configuration: $SRC"
grep -m1 "Total wall time" "$(dirname "$SRC")/log.lammps" 2>/dev/null || true

# ---- 3. copy to input_data and convert ------------------------------------------------
mkdir -p "$INPUT_DATA"
if [ -e "$INPUT_DATA/$FINAL" ]; then
    echo ">>> $INPUT_DATA/$FINAL already exists; keeping it."
else
    cp "$SRC" "$INPUT_DATA/$FINAL" && echo ">>> copied to $INPUT_DATA/$FINAL"
fi
ls -la "$INPUT_DATA/$FINAL"

if [ -e "$INPUT_DATA/$TWO_PIST" ]; then
    echo ">>> $INPUT_DATA/$TWO_PIST already exists; keeping it."
else
    load_python_module
    python -c "import numpy, scipy; print('numpy', numpy.__version__, 'scipy', scipy.__version__)"
    echo ">>> converting to the two-piston geometry (scripts/lib/slab_two_pistons_periodic.py ${CONV_OPTS[*]})..."
    cd "$LAMMPS_WORK_DIR/scripts/lib" || exit 1
    if ! python slab_two_pistons_periodic.py --input "$INPUT_DATA/$FINAL" --output "$INPUT_DATA/$TWO_PIST" "${CONV_OPTS[@]}"; then
        echo "ERROR: the two-piston conversion failed; the triaxial run was NOT submitted."
        rm -f "$INPUT_DATA/$TWO_PIST"
        exit 1
    fi
fi
ls -la "$INPUT_DATA/$TWO_PIST"

# ---- 4. the two-piston run(s) ----------------------------------------------------------------
RC=0
export DATANAME="${TWO_PIST%.data}"
case " $SUBMIT " in *" compression "*)
    cd "$TRIAX_DIR" || exit 1
    echo ">>> submitting $TRIAX_BATCH (DATANAME $DATANAME)"
    grep -n '^DATANAME=\|^NSTEPS=\|^STRAIN_TARGETS=\|^export UNLOAD_STEPS=' "$TRIAX_BATCH"
    sbatch --export=ALL,DATANAME="$DATANAME" "$TRIAX_BATCH" || RC=$?
    ;;
esac
case " $SUBMIT " in *" permeation "*)
    cd "$PERM_DIR" || exit 1
    echo ">>> submitting $PERM_BATCH (DATANAME $DATANAME, DP_PISTON ${DP_PISTON:-batch default})"
    grep -n '^DATANAME=\|^NSTEPS=\|^export DP_PISTON=\|^export UNLOAD_STEPS=' "$PERM_BATCH"
    sbatch --export=ALL,DATANAME="$DATANAME"${DP_PISTON:+,DP_PISTON="$DP_PISTON"} "$PERM_BATCH" || RC=$?
    ;;
esac
exit $RC
}
exit
