# ============ Triaxial Compression Simulation (piston-loaded gel) ============
# COMPRESSION MODE ONLY.  Split out of slab_with_flow.lmp (which carried both
# compression and permeation modes behind compression_mode logic gates) so the
# compression path is self-contained and free of per-step mode branching.
# The permeation counterpart lives in ../triaxial_permeation/.
#
# Starting from an equilibrated configuration produced by the
# slab_with_support workflow on the PERIODIC slab generator
# (slab_with_support_periodic.ipynb).
# Variables from bash script: dataname, interaction, epsSS, epsSP, nsteps
#
# Atom types: 1=crosslink, 2=chain bead, 3=solvent, 4=support(frozen),
#             5=piston(mobile).  NO side walls (the periodic geometry is
#             laterally periodic — there is nothing to confine).
#
# GEOMETRY (periodic generator):
#   The slab spans the WHOLE x-y plane: box_x = box_y = units*a EXACTLY, no
#   side solvent padding.  Network bonds wrap the x and y PBC only; z is a
#   finite slab (no bonds cross z).  boundary p p p with a single z-period
#   that recirculates through the z-PBC:
#       below solvent | support sheet (type4, frozen) | gap | polymer slab |
#       top solvent (piston type5 parked high) -> wraps to next image's support.
#   Because the slab is laterally periodic and unconfined, x,y are free to
#   relax; z compression is applied solely by the piston (NO box barostat in z).
#   Single support + single piston sheet → c_piston_fz/(lx*ly) is the true
#   piston stress (no multi-period normalisation needed).
#
# Reduced LJ units: tau = sigma*sqrt(m/epsilon)
# dt = 0.005 → 1e6 steps ≈ 4.1e3 tau
#
# Behaviour:
#   - Piston-solvent WCA is OFF throughout; the piston passes through the
#     solvent freely and loads the gel network directly.
#   - Phase 0:   NVT equilibration at fixed box volume (piston frozen).
#   - Phase 0.5: anisotropic Langevin + NPH to re-pressurise the box to
#                P_target (full Press, matching slab_with_support.lmp's
#                aniso barostat).  Needed because the fixed-volume read
#                relaxes below P_target.  Rigid bodies temporarily on
#                nve+setforce so they scale with the box.  The piston is
#                frozen here, so barostatting z is safe; the box is frozen
#                again before Phase 2, where z is piston-controlled only.
#   - Phase 1.5 (NEW): pre-compression REFERENCE window.  Piston held at v=0
#                for ref_avg_steps; ALL observables (partial stresses, σ_ss,
#                σ_pp, solvent mass density) are averaged into "_ref_" files,
#                emitting several snapshots so the notebook can form CIs.
#   - Phase 2 (production): constant-velocity piston to comp_percent strain,
#                then freeze + relax for the remainder of nsteps.
#
# Recorded observables (z-profiles, z-normal binning; see ANALYSIS sections):
#   1) partial stresses of polymer and solvent (group-based stress/atom)
#   2) solvent-only stress  sigma_s,ss  (pair/local ss-pair virial; virial-only)
#   3) polymer-only stress  sigma_p,pp  (pair/local pp-pair virial + FENE bond
#                                        virial; virial-only)        [NEW]
#   4) solvent MASS density profile                                 [NEW]
#   5) (mass fraction rho_s/rho_s0 is derived in the notebook from 4 + reference)
# Dual-resolution z-binning: a coarse global profile plus finer bins in user-
# defined windows around the support and the piston.               [NEW]


# ==========================================================================
#                              PARAMETERS
# ==========================================================================

# ----- Continuation flag -----
# 0 = fresh start (default)
# 1 = continuation from a final .data file (via continue_sim.sh)
#
# When cont=1 the following are skipped (data file already holds the state):
#   Phase 0    — NVT equilibration run (box volume/piston position stay as-is)
#   Phase 0.5  — anisotropic Langevin+NPH re-pressurisation to P_target
#   Phase 1.5  — reference recording (reference files already exist)
#   Phase 2 piston setup — piston stays frozen; halt_compress fires immediately
#                          and the run becomes a pure stress-relaxation measurement
variable cont index 0

# ----- Physical Parameters -----
variable sigma         equal 1.0
variable temp_target   equal 1.0
variable P_target      equal 1.5
variable timestep_prod equal 0.005

# ----- Phase 0: NVT equilibration steps -----
variable comp_setup_freq equal 50000    # compression Phase 0 NVT

# ----- Compression Phase 2 -----
# comp_percent: LEGACY single-target fallback.  The SWEEP uses the index
# variable `compressions` (below); comp_percent is retained only for reference.
variable comp_percent    equal 0.1      # (legacy) single strain threshold
variable v_piston_prod   equal 0.04     # sigma/tau (= 1 sigma per 5000 steps at dt=0.005)

# ---- Compression stress-strain SWEEP: cumulative strain targets --------------
# `compressions` is an index-style variable supplied on the command line by
# run_lammps.sh as:  -var compressions 0.05 0.10 0.15 0.20
# (set in triaxial_compression.batch via COMPRESSIONS=(...)).  If NOT supplied,
# the in-script default below (single 0.10 target) is used, reproducing the
# original single-operating-point run.  A command-line index variable always
# overrides this fallback.  The script compresses INCREMENTALLY from one target
# to the next (piston never reverses), holding a production window at each --
# exactly like shear_slab.lmp's cumulative strain loop.  See the SWEEP LOOP
# near the end of this file.  cont=1 is NOT supported for a multi-value sweep.
variable compressions      index 0.10
variable compressions_list index "STALE-run_lammps.sh--no-list-passed--running-single-default-only"

# Safety cap on the per-increment velocity drive.  fix halt normally stops the
# drive at the target strain LONG before this (a ~5-10% increment needs only a
# few x10^4 steps at v_piston_prod); this is only a buffer so a level cannot run
# unbounded if the target is somehow never reached.
variable nsteps_comp equal 500000

# ----- Phase 1.5: pre-compression REFERENCE averaging window -----
# After Phase 0.5 the gel is equilibrated at P_target.  Hold the piston at v=0
# and average ALL observables over this window to define the ε=0 reference
# state.  ref_nfreq sets how often a reference snapshot is emitted; several
# snapshots over ref_avg_steps let the notebook form confidence intervals on
# the reference profiles.  The window is padded to end on a ref_nfreq epoch
# boundary (chunk/atom lock requirement — see Phase 1.5 block).
variable ref_avg_steps equal 150000     # total pre-compression reference window
variable ref_nevery    equal 100         # sample cadence within a ref snapshot
variable ref_nfreq     equal 10000        # one ref snapshot every ref_nfreq steps
variable ref_nrepeat   equal v_ref_nfreq/v_ref_nevery   # = 100 samples / snapshot
#   → 150000/10000 = 15 reference snapshots, each averaging 100 decorrelated samples

# ----- Solvent mass density -----
# Solvent bead mass for converting number density → mass density in the notebook
# (LAMMPS density/mass uses the masses in the data file directly; this is a
# bookkeeping value for the analysis only).
variable solvent_mass  equal 1.0

# ----- Output Frequencies -----
variable thermo_freq     equal 250000 # 2000  # 250000
variable dump_freq_setup equal 10000      # frequent dumps during Phase 1
# Production (gel_flow) dump cadence — tie to nsteps so the compression is
# always resolved regardless of run length.  At dump_freq_prod = nsteps (the
# old fixed 200000) a short run captured only ONE production frame, taken
# before the piston had descended into the gel — making it look like the
# piston never reached the gel.  Lower the divisor for finer resolution if
# the all-atom dump size on scratch allows (gel_system = full system).
variable dump_freq_prod  equal floor(${nsteps}/20)   # ~20 production frames
variable volume_freq     equal 5000 # 1000 # 5000

# Finer cadence for the STRAIN / POSITION diagnostics (strain_zz, piston &
# polymer positions, gel dimensions).  These are tiny per-line prints, so a
# high rate is cheap and lets the piston-motion (drive) phase be resolved —
# especially useful for pinning the exact step where gel_strain crosses the
# target and for the strain-diagnostic plot in triaxial_compression.ipynb.
variable strain_freq     equal 1000
# Drive-phase all-atom trajectory cadence: captures the piston pushing the slab
# through the solvent onto the support.  The drive is short, so 2000 gives
# plenty of frames without a large file.
variable drive_dump_freq equal 2000

# Cavity Widom dump cadence — all-atom frames for cavity_widom.py post-processing.
# More frames → lower noise in time-averaged μ_ex(z): noise ∝ 1/√num_widom_frames.
# Dump starts after the ε=0 reference recording block (production phase only).
variable num_widom_frames equal 50
variable nfreq_widom_dump equal floor(${nsteps}/v_num_widom_frames)

# ======================================================================

# ----- Time Averaging (stress) -----
# nfreq = nevery * nrepeat  (LAMMPS constraint)
variable num_stress_curves equal 10    # target output frames
variable nevery_target     equal 100   # ~0.5 tau — near stress decorrelation time
variable nrepeat_max       equal 2000  # cap to preserve transient resolution
variable nrepeat_min       equal 50    # floor for adequate noise reduction

variable nfreq_raw    equal floor(${nsteps}/v_num_stress_curves)
variable nrepeat_raw  equal floor(v_nfreq_raw/v_nevery_target)

# Clamp nrepeat to [min, max]
variable nr_lo equal (v_nrepeat_raw>v_nrepeat_min)*v_nrepeat_raw+(v_nrepeat_raw<=v_nrepeat_min)*v_nrepeat_min
variable nrepeat_stress equal (v_nr_lo<v_nrepeat_max)*v_nr_lo+(v_nr_lo>=v_nrepeat_max)*v_nrepeat_max

# Derive nevery and enforce exact constraint
variable nevery_stress equal floor(v_nfreq_raw/v_nrepeat_stress)
variable nfreq_stress  equal v_nevery_stress*v_nrepeat_stress

print ">>> Stress: nevery=${nevery_stress} nrepeat=${nrepeat_stress} nfreq=${nfreq_stress}"
print ">>> Mode: COMPRESSION (piston-loaded gel)"

# ----- Spatial Binning -----
variable binWidth    equal 2.0
variable rg_scale    equal 1.8   # Rg multiplier (~90% coverage for Gaussian)
variable region_frac equal 1     # fraction of polymer extent for analysis regions

# ----- Dual-resolution z-binning (fine bins near support + piston) -----
# Coarse global profiles use binWidth.  In addition, finer bins of width
# binWidth_fine are written within a half-window fine_halfwin of the support
# top and of the piston, where the stress gradients are sharpest.  The notebook
# stitches the coarse and fine profiles.  The fine regions track the support
# COM and piston COM dynamically so they follow the piston as the gel compresses.
variable binWidth_fine equal 0.5    # fine bin width (σ) near support/piston
variable fine_halfwin  equal 6.0    # half-height of each fine window (σ)


# ==========================================================================
#                           INITIALIZATION
# ==========================================================================

units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

# Single lj/cut pair style.
# NOTE: sub-style virial filtering ("compute stress/atom NULL pair <style>")
# is not supported by this LAMMPS build — the "pair" keyword in compute
# stress/atom includes ALL pair interactions and takes no further arguments.
# The hybrid pair_style approach (using lj/expand for 3-3 to get a unique
# style name) was attempted but also rejected.  The solvent-solvent-only
# stress decomposition is therefore omitted; see the poroelasticity notes
# in compression_analysis.ipynb for the post-processing correction.
pair_style lj/cut 1.122
bond_style fene

read_data data_files/${dataname}.data nocoeff

comm_modify cutoff 5.0

print "========================================"
print "Triaxial compression simulation: ${dataname}"
print "Interaction: epsSS=${epsSS}, epsSP=${epsSP}"
print "Production steps: ${nsteps}"
print "Compression piston velocity: ${v_piston_prod} sigma/tau"
print "========================================"


# ==========================================================================
#                          GROUP DEFINITIONS
# ==========================================================================

group polymer   type 1 2
group solvent   type 3
group support   type 4
group piston    type 5
group mobile    type 1 2 3
group gel_system type 1 2 3 4 5


# ==========================================================================
#                       INTERATOMIC POTENTIALS
# ==========================================================================

# Default: full LJ for all pairs
pair_coeff * * 1.0 ${sigma} 1.122

# Polymer-solvent (tunable)
pair_coeff 1 3 ${epsSP} ${sigma} 1.122    # polymer-solvent
pair_coeff 2 3 ${epsSP} ${sigma} 1.122    # crosslinker-solvent

# Solvent-solvent (tunable)
pair_coeff 3 3 ${epsSS} ${sigma} 1.122    # solvent-solvent

# Polymer/crosslinker with support and piston (WCA repulsive)
pair_coeff 1 4 1.0 ${sigma} 1.122
pair_coeff 2 4 1.0 ${sigma} 1.122
pair_coeff 1 5 1.0 ${sigma} 1.122
pair_coeff 2 5 1.0 ${sigma} 1.122

# Solvent-piston: OFF for compression — piston passes through solvent freely,
# loads gel directly.
pair_coeff 3 5 0.0 ${sigma} 0.0          # OFF (compression)

# Non-interacting pairs
pair_coeff 3 4 0.0 ${sigma} 0.0   # solvent-support
pair_coeff 4 4 0.0 ${sigma} 0.0   # support-support
pair_coeff 4 5 0.0 ${sigma} 0.0   # support-piston
pair_coeff 5 5 0.0 ${sigma} 0.0   # piston-piston

# ----- Bonds and Angles -----
bond_coeff * 30.0 1.5 1.0 1.0
special_bonds fene

# Angle style — hybrid (uncomment if angles are present in data file)
#angle_style hybrid cosine harmonic
#angle_coeff 1 cosine 1.0
#angle_coeff 2 harmonic 40.0 109.47

# ----- Neighbor List Exclusions -----
neigh_modify exclude type 4 4   # support-support
neigh_modify exclude type 5 5   # piston-piston
neigh_modify exclude type 4 5   # support-piston


# ==========================================================================
#                           RIGID BODIES
# ==========================================================================

# Support: completely frozen
velocity support set 0.0 0.0 0.0
fix rigid_support support rigid single force * off off off torque * off off off

# Piston: fully frozen during Phase 0 / Phase 0.5 NVT (force * off off off +
#   setforce 0).  Stays rigid+frozen through equilibration (no barostat means
#   no dilation to scale with), then released for constant-velocity
#   compression in Phase 2.
velocity piston set 0.0 0.0 0.0

fix rigid_piston piston rigid single force * off off off torque * off off off
fix freeze_piston piston setforce 0.0 0.0 0.0



# ==========================================================================
#                           THERMO OUTPUT
# ==========================================================================

compute mobile_temp mobile temp
compute mobile_press all pressure thermo_temp pair bond
thermo_style custom step c_mobile_temp pe ke etotal press c_mobile_press vol lx ly lz
thermo_modify lost warn
thermo ${thermo_freq}

# ----- Piston force compute (defined early so permeation mode can record a
#       Phase 0 equilibrium baseline; compression mode only outputs from Phase 2) -----
# c_piston_fz: sum of pairwise z-forces on ALL piston atoms.
#   Positive = net upward (gel/solvent pushing piston up).
#   In compression mode, setforce 0 is still active here → value will be 0
#   until Phase 2 (when setforce is removed); the fix print is only defined
#   for compression AFTER Phase 0.5 cleanup (see OUTPUT: PISTON DATA).
#   In permeation mode, no setforce is ever applied, so the value is live now.
compute piston_fz      piston reduce sum fz
variable piston_area      equal lx*ly          # cross-sectional area of simulation box
variable piston_pressure_z equal c_piston_fz/v_piston_area  # force normalised by area

# ----- Block-averaged piston force (noise reduction for P(t) and M_piston) -----
# c_piston_fz is the INSTANTANEOUS pairwise contact force on the piston -> it
# carries the full thermal fluctuation (that is the scatter seen in P(t)).
# There is no damping on the piston (rigid + velocity-controlled), and damping
# it would corrupt this measurement, so noise is reduced the correct way: by
# time-averaging.  fix out_piston_force_avg (see PRODUCTION stress block) block-
# averages c_piston_fz over each volume_freq window, cutting the scatter by
# ~sqrt(pf_nrepeat) while keeping the same output cadence as the raw file.
# c_piston_fz is a GLOBAL reduce (not chunk/atom), so there is no ave/time lock
# issue and the fix can span the compression + relaxation runs freely.
variable pf_nevery  equal 50                        # sample every 50 steps (~0.25 tau)
variable pf_nrepeat equal floor(${volume_freq}/v_pf_nevery)   # samples per window
variable pf_nfreq   equal v_pf_nevery*v_pf_nrepeat   # = volume_freq (exact multiple)


# ==========================================================================
#              PHASE 0: NVT EQUILIBRATION (BOTH MODES)
# ==========================================================================
# Equilibrate at the current box volume.  No pressure adjustment here —
# Phase 0.5 (aniso NPH) re-pressurises the box to P_target, then Phase 2
# applies the piston.  Box dimensions stay fixed throughout Phase 0.

print "========================================"
print "Phase 0: NVT equilibration"
print "========================================"

reset_timestep 0
timestep ${timestep_prod}

# ----- cont=1: skip minimize + Phase 0 NVT (data file already holds equilibrated config) -----
if "${cont} == 1" then "jump SELF label_after_phase0"

# Brief minimize to clean up any residual overlaps from the data-file build
minimize 1.0e-4 1.0e-6 1000 10000

# Setup trajectory
dump traj_setup gel_system custom ${dump_freq_setup} &
   traj_files/gel_setup_${dataname}_${interaction}_${nsteps}.lammpstrj &
   id type mol x y z

# NVT equilibration at fixed volume (piston frozen for compression, z-free for permeation)
fix nvt_equil mobile nvt temp ${temp_target} ${temp_target} 1.0

# Permeation: record piston force from the very start of Phase 0 to capture the
# equilibrium (zero-applied-pressure) baseline.  The piston floats freely on solvent
# (fix rigid_piston force * off off on, no setforce), so c_piston_fz is live now.
# Compression mode: force output begins AFTER Phase 0.5 (see OUTPUT: PISTON DATA).

run ${comp_setup_freq}

print ">>> Post-Phase-0 NVT: T=$(c_mobile_temp)  mobile_press=$(c_mobile_press)"
unfix nvt_equil

label label_after_phase0

# run 0 initializes all computes so their values can be referenced in
# variable formulas and print statements below (required when cont=1 skips
# the minimize that previously served this purpose).
run 0

# ==========================================================================
#    PHASE 0.5 (COMPRESSION ONLY): ANISOTROPIC LANGEVIN + NPH → P_target
# ==========================================================================
# WHY a barostat is needed here:
#   The equilibrated input only sits at P_target while slab_with_support.lmp's
#   aniso NPT actively holds it there.  Read at FIXED volume, the pressure
#   bleeds off — the minimize relaxes the pair virial and the thermostat cools
#   T (1.26→1.0), dropping the kinetic term — so the system settles to its
#   natural fixed-volume pressure (~1.2 full), NOT P_target.  This block
#   re-pressurises the box to P_target so the ε=0 reference is correct.
#
# WHY aniso (matches slab_with_support.lmp): each of x,y,z is barostatted
#   INDEPENDENTLY to the full scalar target P_target, so the unconfined,
#   laterally-periodic slab relaxes to its own equilibrium shape at bath
#   pressure (cell stays orthogonal; no tilt).  The target is the FULL pressure
#   (thermo `Press`), exactly as the equilibration used `aniso 1.5` — so the
#   thermo Press lands at ~1.5 here, consistent with the equilibration output.
#
# WHY this does NOT fight the piston: the piston is frozen during Phase 0.5
#   (no velocity drive until Phase 2).  Barostatting z is therefore safe here.
#   The box is frozen again after this block; Phase 2 compresses purely by the
#   piston with NO box barostat (which is where a z-barostat WOULD conflict).
#
# All rigid bodies (piston, support) are temporarily put on nve+setforce so
# they scale freely with the box (dilate all remaps them) without injecting
# spurious virial into the barostat, then restored to rigid+frozen afterward.
#
# Why Langevin + NPH (not fix npt / Nosé-Hoover):
#   FENE bonds inject kinetic energy faster than a Nosé-Hoover chain can remove
#   it → T can stick at ~6.  Langevin's per-atom friction (∝ v) removes energy
#   in proportion to how hot each atom is — it always wins against FENE heating.
#
# Key parameters:
#   npt_P_damp:    barostat damping (τ).  Increase (e.g. 200–1000) if FENE bond
#                  warnings appear or the box oscillates.
#   npt_p05_steps: barostat run length; increase if Press has not converged.

variable npt_P_damp    equal 50.0    # barostat damping (τ); increase if FENE errors appear
variable npt_p05_steps equal 120000  # run length; increase if Press not converged
# aniso targets the FULL scalar pressure per direction (no kinetic offset
# needed, unlike the old iso-NPH+0.41 convention which drove c_mobile_press).
variable npt_P05_target equal ${P_target}

# ----- cont=1 + compression: jump over Phase 0.5 (box already at equilibrium pressure) -----
if "${cont} == 1" then "jump SELF label_after_phase05"

print '========================================'
print 'Phase 0.5 (compression): Langevin+NPH aniso → full Press target=${npt_P05_target}'
print '========================================'

# Release piston to scale with the box (nve+setforce, no fix rigid)
unfix freeze_piston
unfix rigid_piston
fix nve_piston      piston nve
fix setforce_piston piston setforce 0.0 0.0 0.0

# Release support to scale with the box
unfix rigid_support
fix freeze_support support setforce 0.0 0.0 0.0
fix nve_support    support nve

fix lang_p05 mobile langevin ${temp_target} ${temp_target} 1.0 48279
fix nph_p05  mobile nph aniso ${npt_P05_target} ${npt_P05_target} ${npt_P_damp}
run ${npt_p05_steps}
unfix lang_p05
unfix nph_p05

print '>>> Post-Langevin+NPH: T=$(c_mobile_temp)  Press=$(press)  mobile_press=$(c_mobile_press)  lx=$(lx) ly=$(ly) lz=$(lz)'

# Restore rigid piston at its new (scaled) position
unfix nve_piston
unfix setforce_piston
velocity piston set 0.0 0.0 0.0
fix rigid_piston piston rigid single force * off off off torque * off off off
fix freeze_piston piston setforce 0.0 0.0 0.0

# Restore rigid support
unfix freeze_support
unfix nve_support
velocity support set 0.0 0.0 0.0
fix rigid_support support rigid single force * off off off torque * off off off

# NVT settle at the new (re-pressurised) box volume, all rigid bodies restored
fix nvt_p05_eq mobile nvt temp ${temp_target} ${temp_target} 1.0
run 50000
unfix nvt_p05_eq

label label_after_phase05

print '>>> Post-Phase-0.5: T=$(c_mobile_temp)  Press=$(press)  mobile_press=$(c_mobile_press)  lz=$(lz)'

print ">>> Pre-production: T=$(c_mobile_temp)  mobile_press=$(c_mobile_press)"
# traj_setup dump only exists when cont=0 (Phase 0 ran)
if "${cont} == 0" then "undump traj_setup"


# ==========================================================================
#                    ANALYSIS: POLYMER TRACKING
# ==========================================================================

compute polymer_com polymer com

# ----- Bounding Box (BB) — gel dimensions from min/max coordinates -----
# Sensitive to outlier beads; kept for diagnostics and gel dimension output.
compute minx polymer reduce min x
compute maxx polymer reduce max x
compute miny polymer reduce min y
compute maxy polymer reduce max y
compute minz polymer reduce min z
compute maxz polymer reduce max z

variable gel_lx_bb equal c_maxx-c_minx
variable gel_ly_bb equal c_maxy-c_miny
variable gel_lz_bb equal c_maxz-c_minz
variable gel_vol_bb equal v_gel_lx_bb*v_gel_ly_bb*v_gel_lz_bb

# ----- Radius of Gyration (Rg) — robust gel dimensions -----
# For a uniform rectangular prism: Rg_ii² = L_i²/12  →  L_i = 2√3·√(Rg_ii²)
# c_rg_tensor[i] returns Rg_ii² (diagonal component of gyration tensor).
compute rg_tensor polymer gyration

variable gel_lx_rg equal 2.0*sqrt(3.0*c_rg_tensor[1])
variable gel_ly_rg equal 2.0*sqrt(3.0*c_rg_tensor[2])
variable gel_lz_rg equal 2.0*sqrt(3.0*c_rg_tensor[3])
variable gel_vol_rg equal v_gel_lx_rg*v_gel_ly_rg*v_gel_lz_rg

# Robust gel-top estimate: polymer COM_z + half the Rg-based z-thickness.
# c_maxz (raw maximum) is polluted by stray crosslinker/polymer beads that
# diffuse into the solvent.  The Rg-based estimate is unaffected because
# COM and Rg² are mean/variance over ~96k atoms — one outlier < 0.004%.
variable gel_top_rg equal c_polymer_com[3]+0.5*v_gel_lz_rg

# ----- Box dimensions -----
variable box_lx equal lx
variable box_ly equal ly
variable box_lz equal lz

# ----- Piston position/velocity computes -----
# Defined here (before run 0) so they are initialized alongside polymer/rg computes.
# Used unconditionally in piston output fixes, and in permeation-mode reservoir
# regions where LAMMPS evaluates variable bounds at region creation time.
compute piston_com piston com          # PBC-aware COM; use [3] for z
compute piston_vz piston reduce ave vz  # velocities do not wrap

# Support COM (z) — used to centre the fine-resolution z-binning window on the
# support so the high-resolution profile follows the support if it ever moves.
compute support_com support com         # PBC-aware COM; use [3] for z

# ----- Polymer z-displacement reference -----
# Defined here so run 0 below captures the post-Phase-0.5 equilibrated positions
# as the reference configuration.  This gives u_z(z, 0) = 0 at Phase 2 start
# by construction.  c_displace_poly[3] is the PBC-aware z-displacement per atom.
compute displace_poly polymer displace/atom

run 0   # initializes ALL computes in one pass; sets displace_poly reference

# ----- Snapshot Rg tensor for diagnostics and analysis region sizing -----
variable Rg_xx equal c_rg_tensor[1]
variable Rg_yy equal c_rg_tensor[2]
variable Rg_zz equal c_rg_tensor[3]

print "Rg_xx = ${Rg_xx}  →  Lx_rg = $(v_gel_lx_rg)"
print "Rg_yy = ${Rg_yy}  →  Ly_rg = $(v_gel_ly_rg)"
print "Rg_zz = ${Rg_zz}  →  Lz_rg = $(v_gel_lz_rg)"
print "BB:  Lx=$(v_gel_lx_bb) Ly=$(v_gel_ly_bb) Lz=$(v_gel_lz_bb)"

# Analysis region half-widths (use rg_scale for ~90% coverage)
variable eps equal 1.0e-12
variable hw_x equal v_region_frac*v_rg_scale*sqrt(v_Rg_xx + v_eps)
variable hw_y equal v_region_frac*v_rg_scale*sqrt(v_Rg_yy + v_eps)
variable hw_z equal v_region_frac*v_rg_scale*sqrt(v_Rg_zz + v_eps)

print "hw_x = ${hw_x}"
print "hw_y = ${hw_y}"
print "hw_z = ${hw_z}"

# ----- Gel strain (Rg-based) -----
# $(v_gel_lz_rg) — parentheses force immediate numeric evaluation right now,
# storing a constant. ${gel_lz_rg} would store the expression string instead.
variable gel_lz_initial equal $(v_gel_lz_rg)
print ">>> Initial gel thickness (Rg): L0 = ${gel_lz_initial}"
print ">>> Initial gel thickness (BB): L0 = $(v_gel_lz_bb)"
print ">>> Gel top (Rg-based) = $(v_gel_top_rg)   c_maxz (raw) = $(c_maxz)   Piston z = $(c_piston_com[3])   Gap = $(c_piston_com[3]-v_gel_top_rg)"

variable gel_strain equal (v_gel_lz_initial - v_gel_lz_rg) / v_gel_lz_initial


# ==========================================================================
#              PHASE 2: PRODUCTION — piston forcing
# ==========================================================================

print "========================================"
print "Phase 2: Production — piston forcing"
print "========================================"

# ----- Compression: unfreeze piston, switch to velocity control -----
# The piston was held rigid+frozen (rigid + setforce 0) through Phase 0/0.5.
# Unfreeze, then re-fix with force*off off off so the prescribed velocity
# is maintained exactly (no force-driven acceleration from the gel).
#
# cont=1 compression: piston stays frozen (already at ~comp_percent strain).
#   halt_compress fires immediately on the first volume_freq check, and the
#   entire run becomes a pure stress-relaxation measurement.
if "${cont} == 1" then "jump SELF label_skip_comp_piston_setup"
unfix freeze_piston
unfix rigid_piston
fix rigid_piston piston rigid single force * off off off torque * off off off
velocity piston set 0.0 0.0 -${v_piston_prod}
label label_skip_comp_piston_setup

# ----- Thermostat (x,y only — z is flow/compression direction) -----
compute myTemp mobile temp/partial 1 1 0
fix nvt_prod mobile nvt temp ${temp_target} ${temp_target} 1.0
fix_modify nvt_prod temp myTemp

# ----- Permeation: constant-velocity piston (v_piston_perm = 5% of v_piston_prod) -----
# Re-fix piston with all forces off and prescribe velocity, matching the
# compression-mode approach.  The halt_perm condition (feed ≤ feed_halt_thick)
# is the sole termination condition — no ramp/equilibration phase needed.
# cont=1 permeation: piston velocity is re-applied from current position, resuming
#   the drive at v_piston_perm exactly as if the run had not been interrupted.

# Permeation piston force output.  For fresh starts (cont=0) this was already
# defined in Phase 0 (to capture the zero-pressure baseline); for continuations
# (cont=1) Phase 0 was skipped, so define it here at Phase 2 onset.

# ----- Permeation: start displacement recording at Phase 2 onset -----
# Reference positions reset here so u_z(z,0) = 0 at the start of the drive.



# ==========================================================================
#                    ANALYSIS: DYNAMIC REGIONS
# ==========================================================================

# Region for X-direction binning: restricted in Y-Z, full extent in X
variable reg_x_ylo equal c_polymer_com[2]-v_hw_y
variable reg_x_yhi equal c_polymer_com[2]+v_hw_y
variable reg_x_zlo equal c_polymer_com[3]-v_hw_z
variable reg_x_zhi equal c_polymer_com[3]+v_hw_z
region reg_x block EDGE EDGE v_reg_x_ylo v_reg_x_yhi v_reg_x_zlo v_reg_x_zhi side in

# Region for Y-direction binning: restricted in X-Z, full extent in Y
variable reg_y_xlo equal c_polymer_com[1]-v_hw_x
variable reg_y_xhi equal c_polymer_com[1]+v_hw_x
variable reg_y_zlo equal c_polymer_com[3]-v_hw_z
variable reg_y_zhi equal c_polymer_com[3]+v_hw_z
region reg_y block v_reg_y_xlo v_reg_y_xhi EDGE EDGE v_reg_y_zlo v_reg_y_zhi side in

# NOTE: Z-direction binning uses the full simulation box (no region restriction).
# This allows piston position to be visualized in permeation mode, and ensures
# support stress appears at its true z-location. X and Y profiles retain the
# polymer-COM-tracked lateral restriction above.


# ==========================================================================
#                    ANALYSIS: CHUNK DEFINITIONS
# ==========================================================================

# 1D binning with dynamic rectangular regions (x, y — single user each, no conflict)
compute chunk_x_polymer polymer chunk/atom bin/1d x lower ${binWidth} region reg_x
compute chunk_y_polymer polymer chunk/atom bin/1d y lower ${binWidth} region reg_y
compute chunk_x_solvent solvent chunk/atom bin/1d x lower ${binWidth} region reg_x
compute chunk_y_solvent solvent chunk/atom bin/1d y lower ${binWidth} region reg_y

# Z profiles — one chunk/atom per reduce/chunk user.
# LAMMPS 22Jul2025 rejects multiple fix ave/time sharing the same chunk/atom
# via different reduce/chunk computes ("Two fix commands using same compute
# chunk/atom command in incompatible ways").  Each compute reduce/chunk must
# therefore reference a unique chunk/atom ID.
#
#   chunk_z_poly_p   → press_z_polymer  (isotropic z-press, polymer)
#   chunk_z_poly_zz  → sigmazz_poly
#   chunk_z_poly_xx  → sigmaxx_poly
#   chunk_z_poly_yy  → sigmayy_poly
#   chunk_z_polymer  → fix avg_disp_z_poly (displacement, relaxation phase only)
#   chunk_z_solv_p   → press_z_solvent  (isotropic z-press, solvent)
#   chunk_z_solv_zz  → sigmazz_solv
#   chunk_z_solv_xx  → sigmaxx_solv
#   chunk_z_solv_yy  → sigmayy_solv
compute chunk_z_poly_p   polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_poly_zz  polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_poly_xx  polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_poly_yy  polymer chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_polymer  polymer chunk/atom bin/1d z lower ${binWidth}

compute chunk_z_solv_p   solvent chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_solv_zz  solvent chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_solv_xx  solvent chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_solv_yy  solvent chunk/atom bin/1d z lower ${binWidth}

# Piston and support — single user each, no conflict
compute chunk_z_piston  piston  chunk/atom bin/1d z lower ${binWidth}
compute chunk_z_support support chunk/atom bin/1d z lower ${binWidth}


# ==========================================================================
#                    ANALYSIS: PARTIAL STRESSES
# ==========================================================================

compute stress_polymer polymer stress/atom NULL
compute stress_solvent solvent stress/atom NULL

# Partial stress for each atom: P = -(σxx + σyy + σzz)/(3*vol)
variable press_polymer_x atom -(c_stress_polymer[1]+c_stress_polymer[2]+c_stress_polymer[3])/(3.0*${binWidth}*ly*lz)
variable press_polymer_y atom -(c_stress_polymer[1]+c_stress_polymer[2]+c_stress_polymer[3])/(3.0*lx*${binWidth}*lz)
variable press_polymer_z atom -(c_stress_polymer[1]+c_stress_polymer[2]+c_stress_polymer[3])/(3.0*lx*ly*${binWidth})

variable press_solvent_x atom -(c_stress_solvent[1]+c_stress_solvent[2]+c_stress_solvent[3])/(3.0*${binWidth}*ly*lz)
variable press_solvent_y atom -(c_stress_solvent[1]+c_stress_solvent[2]+c_stress_solvent[3])/(3.0*lx*${binWidth}*lz)
variable press_solvent_z atom -(c_stress_solvent[1]+c_stress_solvent[2]+c_stress_solvent[3])/(3.0*lx*ly*${binWidth})

# Sum pre-divided per-atom contributions over chunks → pressure per bin
compute press_x_polymer polymer reduce/chunk chunk_x_polymer sum v_press_polymer_x
compute press_y_polymer polymer reduce/chunk chunk_y_polymer sum v_press_polymer_y
compute press_z_polymer polymer reduce/chunk chunk_z_poly_p  sum v_press_polymer_z

compute press_x_solvent solvent reduce/chunk chunk_x_solvent  sum v_press_solvent_x
compute press_y_solvent solvent reduce/chunk chunk_y_solvent  sum v_press_solvent_y
compute press_z_solvent solvent reduce/chunk chunk_z_solv_p   sum v_press_solvent_z

# Piston and support partial stresses — same methodology as above.
# stress/atom NULL captures pairwise virial only (no kinetic term), which is
# correct for rigid bodies; internal constraint forces are excluded.
compute stress_piston  piston  stress/atom NULL
compute stress_support support stress/atom NULL

variable press_piston_z  atom -(c_stress_piston[1]+c_stress_piston[2]+c_stress_piston[3])/(3.0*lx*ly*${binWidth})
variable press_support_z atom -(c_stress_support[1]+c_stress_support[2]+c_stress_support[3])/(3.0*lx*ly*${binWidth})

compute press_z_piston  piston  reduce/chunk chunk_z_piston  sum v_press_piston_z
compute press_z_support support reduce/chunk chunk_z_support sum v_press_support_z

# ── True ZZ partial-stress component (σzz only) ───────────────────────────
# The isotropic press_*_z variables above average (σxx+σyy+σzz)/3, which
# mixes background pressure into the compression signal and cannot be used
# directly to compute the longitudinal modulus.  These variables isolate the
# ZZ virial component (c_stress[3]) needed for the Terzaghi decomposition:
#   σ'_zz = (σ_p_zz + σ_s_zz) − p_pore,   p_pore = σ_s_zz / φ_s
# Note: still virial-only (NULL kinetic); kinetic contribution is isotropic
# and cancels in the effective-stress difference for an equilibrated solvent.
variable sigma_p_zz atom -c_stress_polymer[3]/(lx*ly*${binWidth})
variable sigma_s_zz atom -c_stress_solvent[3]/(lx*ly*${binWidth})
variable sigma_p_xx atom -c_stress_polymer[1]/(lx*ly*${binWidth})
variable sigma_s_xx atom -c_stress_solvent[1]/(lx*ly*${binWidth})
variable sigma_p_yy atom -c_stress_polymer[2]/(lx*ly*${binWidth})
variable sigma_s_yy atom -c_stress_solvent[2]/(lx*ly*${binWidth})

compute sigmazz_poly polymer reduce/chunk chunk_z_poly_zz sum v_sigma_p_zz
compute sigmazz_solv solvent  reduce/chunk chunk_z_solv_zz sum v_sigma_s_zz
compute sigmaxx_poly polymer reduce/chunk chunk_z_poly_xx sum v_sigma_p_xx
compute sigmaxx_solv solvent  reduce/chunk chunk_z_solv_xx sum v_sigma_s_xx
compute sigmayy_poly polymer reduce/chunk chunk_z_poly_yy sum v_sigma_p_yy
compute sigmayy_solv solvent  reduce/chunk chunk_z_solv_yy sum v_sigma_s_yy

# ── Pair-local data for ss-only virial (post-processing) ─────────────────
# compute stress/atom does not support sub-style filtering in this LAMMPS
# build (the "pair" keyword means ALL pair interactions).  Instead, we record
# per-pair virial via compute pair/local and filter for ss pairs in Python.
#
# Using group=solvent guarantees all 3-3 (ss) pairs are captured:
#   For any ss pair (i,j) with i<j by atom ID, both atoms are type 3 and
#   therefore in the solvent group → atom i is always in the group → pair
#   is always included.  Some 3-polymer ps pairs are also captured but are
#   discarded in post-processing by filtering ptype1==ptype2==3.
#
# fx/fy/fz = force on atom I due to atom J.  lj/cut exposes force components
#   but NOT the virial fields p1/p2/p3 (those require special per-pair virial
#   support that lj/cut does not implement → "extra field" error at runtime).
#   The virial is reconstructed in post-processing from forces + positions:
#     p_zz_pair = -(r_z * fz)   where r_z = z_J - z_I  (PBC-corrected)
#     p_xx_pair = -(r_x * fx),  p_yy_pair = -(r_y * fy)
#   Sign convention: positive p means repulsive/compressed → same as p1/p2/p3.
#   z-positions z_I and z_J come from the main traj dump (same dump_freq_prod).
#
# Post-processing steps (see compression_analysis.ipynb):
#   1. Read pairs dump (atom IDs, types, fx/fy/fz) frame by frame.
#   2. Read main traj dump (id type x y z) at the same timesteps.
#   3. Filter: keep rows where ptype1==3 AND ptype2==3.
#   4. For each ss pair:
#        r_x/y/z = pos_J - pos_I  (with PBC wrap: if |r_α| > L_α/2, subtract L_α)
#        p_zz = -(r_z * fz);  z_mid = (z_I + z_J) / 2; assign to z-bin
#   5. sigma_ss_zz(bin) = sum(p_zz_in_bin) / (lx * ly * binWidth)
#      (no extra factor of 2: fx/fy/fz is force on atom I only, and r_I*f_I
#       gives the full pair contribution already — the other half r_J*f_J
#       is equal by Newton's 3rd law, so sum over all I-as-first pairs gives
#       the complete double-counted virial; divide by 2 if you use both atoms)
#      → safest: only count each pair once (as stored in this dump) and use
#        W_pair = -(r_z * fz) without the factor of 2.
compute pl_local  solvent pair/local  fx fy fz
compute ids_local solvent property/local patom1 patom2 ptype1 ptype2

# ── Pair-local + bond-local data for pp-only (polymer self) virial ────────
# Polymer-only stress σ_p,pp(z): the same pair/local technique as σ_s,ss, but
# filtered to polymer-polymer pairs (ptype1,ptype2 ∈ {1,2}) AND augmented with
# the FENE bond virial — every bond in the system is polymer-polymer, so the
# full bond virial is a polymer self-stress contribution.
#
#   group=polymer guarantees every pp pair is captured (both atoms in group).
#   Filter ptype1∈{1,2} AND ptype2∈{1,2} in post-processing to drop ps pairs.
#
# Bond virial (post-processing): for each bond with atoms I,J,
#   r_IJ = pos_J − pos_I (PBC),  |r| = dist
#   compute bond/local `force` = signed scalar bond force (= fbond·r, the actual
#   force magnitude along the bond).  Force on atom I is F_I = −(force/|r|)·r_IJ.
#   W_zz = −(r_z · F_I,z) = (force/|r|)·r_z²   (matches the pair sign convention).
#   Assign to the bond-midpoint z-bin; σ_pp_bond,zz(bin) = Σ W_zz / (lx·ly·binW).
# sigma_p,pp is virial-only (no kinetic term); the notebook validates it against
# the group-based sigma_p (sign check via BOND_SIGN).
compute pl_local_poly  polymer pair/local  fx fy fz
compute ids_local_poly polymer property/local patom1 patom2 ptype1 ptype2
compute bnd_local      all     bond/local   force dist
compute bnd_ids        all     property/local batom1 batom2 btype


# ==========================================================================
#            ANALYSIS: FINE-RESOLUTION Z-BINNING (support + piston)
# ==========================================================================
# Dual-resolution scheme: the coarse global profiles (binWidth) above are
# supplemented by finer profiles (binWidth_fine) inside two z-windows that
# track the support and the piston — exactly where σ_zz and the solvent
# density vary most sharply.  The notebook stitches coarse + fine profiles.
#
# Fine profiles are provided for the most diagnostic group-based observables:
#   σ_zz (polymer + solvent → total σ_zz) and solvent number+mass density.
# σ_s,ss and σ_p,pp can be re-binned at any resolution for free in the
# notebook (they are reconstructed from the pair/bond dumps), so they need no
# extra LAMMPS computes here.
#
# Regions track the support COM and piston COM so the windows follow the
# piston as the gel compresses.  Region bounds are re-evaluated each step.
variable fine_sup_zlo equal c_support_com[3]-v_fine_halfwin
variable fine_sup_zhi equal c_support_com[3]+v_fine_halfwin
variable fine_pis_zlo equal c_piston_com[3]-v_fine_halfwin
variable fine_pis_zhi equal c_piston_com[3]+v_fine_halfwin
region reg_fine_support block EDGE EDGE EDGE EDGE v_fine_sup_zlo v_fine_sup_zhi side in
region reg_fine_piston  block EDGE EDGE EDGE EDGE v_fine_pis_zlo v_fine_pis_zhi side in

# Fine per-atom σ_zz (bin volume uses binWidth_fine, not binWidth!)
variable sigma_p_zz_f atom -c_stress_polymer[3]/(lx*ly*${binWidth_fine})
variable sigma_s_zz_f atom -c_stress_solvent[3]/(lx*ly*${binWidth_fine})

# One chunk/atom per reduce/chunk user (LAMMPS forbids sharing a chunk/atom
# between fixes in incompatible ways — see CHUNK DEFINITIONS note above).
compute chunk_zf_poly_sup polymer chunk/atom bin/1d z lower ${binWidth_fine} region reg_fine_support
compute chunk_zf_poly_pis polymer chunk/atom bin/1d z lower ${binWidth_fine} region reg_fine_piston
compute chunk_zf_solv_sup solvent chunk/atom bin/1d z lower ${binWidth_fine} region reg_fine_support
compute chunk_zf_solv_pis solvent chunk/atom bin/1d z lower ${binWidth_fine} region reg_fine_piston
compute chunk_zf_dens_sup solvent chunk/atom bin/1d z lower ${binWidth_fine} region reg_fine_support
compute chunk_zf_dens_pis solvent chunk/atom bin/1d z lower ${binWidth_fine} region reg_fine_piston

# Coarse solvent-density chunk (defined here, not in the density OUTPUT section,
# so it is available to BOTH the reference window and production density fixes).
compute chunk_z_solv_density solvent chunk/atom bin/1d z lower ${binWidth}

compute sigmazz_poly_fs polymer reduce/chunk chunk_zf_poly_sup sum v_sigma_p_zz_f
compute sigmazz_poly_fp polymer reduce/chunk chunk_zf_poly_pis sum v_sigma_p_zz_f
compute sigmazz_solv_fs solvent reduce/chunk chunk_zf_solv_sup sum v_sigma_s_zz_f
compute sigmazz_solv_fp solvent reduce/chunk chunk_zf_solv_pis sum v_sigma_s_zz_f


# ==========================================================================
#                 ANALYSIS: POLYMER Z-DISPLACEMENT
# ==========================================================================
# u_z(z, t): mean z-displacement of polymer atoms per z-bin.
# Feeds the cooperative-diffusivity extraction via:
#   ∂u_z/∂t = D_c ∂²u_z/∂z²
# phi_p ∝ u_z, so this PDE is equivalent to the volume-fraction formulation
# but avoids the computationally expensive Voronoi step.
#
# Uses the same z-binning (chunk_z_polymer) as the stress profiles so that
# displacement and stress outputs are spatially registered.
# Reference is the Phase 2 start (set by run 0 above); u_z(z, 0) = 0 everywhere.

variable uz_poly atom c_displace_poly[3]

# Note: compute reduce/chunk only supports sum/min/max, not ave.
# Per-bin mean is obtained directly via fix ave/chunk in the OUTPUT section below.


print ">>> Phase 2 start: piston_z=$(c_piston_com[3])  gel_top_rg=$(v_gel_top_rg)  gel_top_raw=$(c_maxz)  support_z=$(c_support_com[3])"

# ==========================================================================
#  PHASE 1.5: PRE-COMPRESSION REFERENCE-STATE (ε=0) RECORDING
# ==========================================================================
# Skipped for cont=1: the reference files already exist from the original run.
#
# The piston is held at v=0 and ALL observables are averaged over a window of
# ref_avg_steps (≈150k) so that compression_analysis.ipynb has a clean ε=0
# reference for every quantity.  Unlike the production stress fixes (which
# emit on the nfreq_stress cadence tied to nsteps and would give only the
# post-compression state as their first snapshot), the reference fixes use a
# dedicated ref_nfreq cadence so the window yields SEVERAL snapshots
# (ref_avg_steps / ref_nfreq ≈ 15) — enough for the notebook to form
# confidence intervals on each reference profile.
#
# Reference observables (all tagged "_ref_"):
#   • partial-stress components σ_zz/σ_xx/σ_yy, polymer + solvent (coarse)
#   • fine-binned σ_zz, polymer + solvent, support + piston windows
#   • solvent number + mass density (coarse + fine)
#   • ss / pp / bond / traj dumps over the window → σ_s,ss and σ_p,pp reference
#
# CHUNK/ATOM LOCK: the reference fixes share chunk/atom computes with the
# production fixes (chunk_z_poly_zz, chunk_zf_*, chunk_z_solv_density, …).
# They MUST be torn down — and their chunk/atom locks released — before the
# production fixes are defined.  fix ave/time / ave/chunk release their lock
# only when end_of_step fires unlock() at an nfreq epoch boundary (their
# destructor unlocks only for ave=RUNNING/WINDOW, not the default ave=ONE).
# So the reference run length is padded to end on a ref_nfreq boundary; the
# subsequent unfix then sees lockfix==nullptr and is a clean no-op for lock
# state.  See the chunk/atom lock note in slab_with_flow's history.
if "${cont} == 1" then "jump SELF label_after_ref_rec"

print '========================================'
print 'Phase 1.5: ε=0 reference recording (${ref_avg_steps} steps, ref_nfreq=${ref_nfreq})'
print '========================================'

# Hold the piston still during the reference window (cancels the
# v_piston_prod assignment made during Phase 2 setup; restored below).
velocity piston set 0.0 0.0 0.0

# ----- Coarse partial-stress component references -----
fix ref_sigmazz_poly all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmazz_poly mode vector file output_files/stress_data/sigmazz_polymer_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmazz_solv all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmazz_solv mode vector file output_files/stress_data/sigmazz_solvent_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmaxx_poly all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmaxx_poly mode vector file output_files/stress_data/sigmaxx_polymer_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmaxx_solv all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmaxx_solv mode vector file output_files/stress_data/sigmaxx_solvent_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmayy_poly all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmayy_poly mode vector file output_files/stress_data/sigmayy_polymer_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmayy_solv all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmayy_solv mode vector file output_files/stress_data/sigmayy_solvent_ref_${dataname}_${interaction}_${nsteps}.dat

# ----- Fine-binned σ_zz references (support + piston windows) -----
fix ref_sigmazz_poly_fs all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmazz_poly_fs mode vector file output_files/stress_data/sigmazz_polymer_fine_support_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmazz_poly_fp all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmazz_poly_fp mode vector file output_files/stress_data/sigmazz_polymer_fine_piston_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmazz_solv_fs all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmazz_solv_fs mode vector file output_files/stress_data/sigmazz_solvent_fine_support_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_sigmazz_solv_fp all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} c_sigmazz_solv_fp mode vector file output_files/stress_data/sigmazz_solvent_fine_piston_ref_${dataname}_${interaction}_${nsteps}.dat

# ----- Solvent number + mass density references (coarse + fine) -----
fix ref_dens     all ave/chunk ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} chunk_z_solv_density density/number density/mass file output_files/chemical_potential/solvent_density_z_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_dens_fs  all ave/chunk ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} chunk_zf_dens_sup    density/number density/mass file output_files/chemical_potential/solvent_density_z_fine_support_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_dens_fp  all ave/chunk ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} chunk_zf_dens_pis    density/number density/mass file output_files/chemical_potential/solvent_density_z_fine_piston_ref_${dataname}_${interaction}_${nsteps}.dat

# ----- ss / pp / bond / traj reference dumps (one frame per ref_nfreq) -----
# dump local/custom carry no fix ave/time epoch-lock issue, so they may run
# freely through the window; each emits ≈ref_avg_steps/ref_nfreq frames that
# the notebook averages (with CIs) for the σ_s,ss and σ_p,pp references.
dump pairlocal_ref      solvent local  ${ref_nfreq} output_files/pair_data/pairs_ref_${dataname}_${interaction}_${nsteps}.dump c_ids_local[1] c_ids_local[2] c_ids_local[3] c_ids_local[4] c_pl_local[1] c_pl_local[2] c_pl_local[3]
dump pairlocal_poly_ref polymer local  ${ref_nfreq} output_files/pair_data/polymer_pairs_ref_${dataname}_${interaction}_${nsteps}.dump c_ids_local_poly[1] c_ids_local_poly[2] c_ids_local_poly[3] c_ids_local_poly[4] c_pl_local_poly[1] c_pl_local_poly[2] c_pl_local_poly[3]
dump bondlocal_ref      all     local  ${ref_nfreq} output_files/pair_data/bonds_ref_${dataname}_${interaction}_${nsteps}.dump c_bnd_ids[1] c_bnd_ids[2] c_bnd_ids[3] c_bnd_local[1] c_bnd_local[2]
dump traj_ref           gel_system custom ${ref_nfreq} traj_files/traj_ref_${dataname}_${interaction}_${nsteps}.lammpstrj id type mol x y z

# Run for ref_avg_steps, PADDED up to the next ref_nfreq epoch boundary so the
# ave/time + ave/chunk locks release cleanly on end_of_step (see note above).
variable ref_run_steps equal (floor(($(step)+${ref_avg_steps}-1)/${ref_nfreq})+1)*${ref_nfreq}-$(step)
print '>>> Reference window: running ${ref_run_steps} steps (≥ ${ref_avg_steps}, aligned to ref_nfreq=${ref_nfreq})'
run ${ref_run_steps}

# Tear down reference dumps and fixes (locks already released at epoch boundary)
undump pairlocal_ref
undump pairlocal_poly_ref
undump bondlocal_ref
undump traj_ref
unfix ref_sigmazz_poly
unfix ref_sigmazz_solv
unfix ref_sigmaxx_poly
unfix ref_sigmaxx_solv
unfix ref_sigmayy_poly
unfix ref_sigmayy_solv
unfix ref_sigmazz_poly_fs
unfix ref_sigmazz_poly_fp
unfix ref_sigmazz_solv_fs
unfix ref_sigmazz_solv_fp
unfix ref_dens
unfix ref_dens_fs
unfix ref_dens_fp

# Reinstate the production-velocity assignment for the actual compression
velocity piston set 0.0 0.0 -${v_piston_prod}

print '>>> Reference recording done.  step=$(step)  gel_strain=$(v_gel_strain:%.4f)'

label label_after_ref_rec


# ==========================================================================
#            ONE-TIME SETUP FOR THE COMPRESSION SWEEP (post-reference)
# ==========================================================================
# The gel is at P_target, the epsilon=0 reference files are written, and the
# piston is velocity-controlled (rigid, all forces off) with velocity currently
# -v_piston_prod.  The loop below walks the cumulative ${compressions} targets:
# for each, it (a) drives the piston until gel_strain >= target (fix halt),
# (b) freezes the piston, and (c) runs an NSTEPS production HOLD recording the
# full observable set tagged _c<target>.  The next iteration resumes driving
# FURTHER from the held state (cumulative), matching shear_slab.lmp.

variable gel_strain_pct equal v_gel_strain*100.0
shell mkdir -p output_files/chemical_potential

print "############################################################"
print ">>> COMPRESSION SWEEP LIST (raw from run_lammps.sh): ${compressions_list}"
print ">>>   first target=${compressions}   drive cap=${nsteps_comp}   hold=${nsteps} per level"
print ">>>   If the line above reads 'STALE-run_lammps.sh...', only ONE level"
print ">>>   will run -- update run_lammps.sh on the cluster and resubmit."
print "############################################################"


# ==========================================================================
#                    COMPRESSION SWEEP LOOP (cumulative)
# ==========================================================================
# Epoch note: every fix ave/time (mode vector, via reduce/chunk) and fix
# ave/chunk below is created right before the production 'run ${hold_steps}'
# and removed right after it.  hold_steps is padded so the run ENDS on an
# nfreq_stress epoch boundary (multiple of nfreq_stress from step 0), so
# end_of_step fires unlock() on the chunk/atom compute BEFORE the unfix -- the
# same idiom the epsilon=0 reference window uses to avoid the "Two fix commands
# using same compute chunk/atom in incompatible ways" lock corruption.
label comp_loop

print "########################################################"
print "  COMPRESSION TARGET (cumulative) = ${compressions}"
print "########################################################"

# ----- Per-level loggers that span BOTH the drive and the hold -----
# fix print (and one GLOBAL ave/time on c_piston_fz) -- none use a compute
# chunk/atom, so they carry NO lock and may be unfixed at any step.  They record
# the piston descent + force rise AND the subsequent relaxation during the hold.
fix out_piston_pos all print ${strain_freq} "$(step) $(c_piston_com[3])" &
    file output_files/piston_data/piston_position_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no
fix out_piston_vel all print ${strain_freq} "$(step) $(c_piston_vz)" &
    file output_files/piston_data/piston_velocity_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no
fix out_piston_force all print ${volume_freq} '$(step) $(c_piston_fz)' &
    file output_files/piston_data/piston_force_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no
fix out_piston_force_avg all ave/time ${pf_nevery} ${pf_nrepeat} ${pf_nfreq} &
    c_piston_fz ave one &
    file output_files/piston_data/piston_force_avg_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix out_strain_zz all print ${strain_freq} &
    "$(step) ${gel_lz_initial} $(v_gel_lz_rg)" &
    file output_files/stress_data/strain_zz_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no
fix out_gel_strain_thermo all print ${thermo_freq} &
    ">>> gel_strain = $(v_gel_strain_pct:%.2f) %" screen yes &
    file output_files/stress_data/gel_strain_log_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix out_gel_vol_bb all print ${strain_freq} "$(step) $(v_gel_vol_bb)" &
    file output_files/volume_data/gel_volume_bb_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no
fix out_gel_dims_bb all print ${strain_freq} "$(step) $(v_gel_lx_bb) $(v_gel_ly_bb) $(v_gel_lz_bb)" &
    file output_files/volume_data/gel_dimensions_bb_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no
fix out_gel_vol_rg all print ${strain_freq} "$(step) $(v_gel_vol_rg)" &
    file output_files/volume_data/gel_volume_rg_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no
fix out_gel_dims_rg all print ${strain_freq} "$(step) $(v_gel_lx_rg) $(v_gel_ly_rg) $(v_gel_lz_rg)" &
    file output_files/volume_data/gel_dimensions_rg_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no
fix out_box_dims all print ${strain_freq} "$(step) $(v_box_lx) $(v_box_ly) $(v_box_lz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no
fix out_polymer_com all print ${strain_freq} &
    "$(step) $(c_polymer_com[1]) $(c_polymer_com[2]) $(c_polymer_com[3])" &
    file output_files/volume_data/polymer_com_${dataname}_${interaction}_${nsteps}_c${compressions}.dat screen no

# ----- PHASE 2a: drive the piston until gel_strain >= this cumulative target -----
velocity piston set 0.0 0.0 -${v_piston_prod}
# halt checked on the fine strain cadence so the piston stops as close as
# possible to exactly ${compressions} (less overshoot than a coarse check).
fix halt_compress all halt ${strain_freq} v_gel_strain >= ${compressions} error continue
# Drive-phase trajectory: captures the PISTON MOTION — the slab being pushed
# through the solvent and settling onto the support — which no other dump
# covers (traj_flow starts only in the hold, after the piston freezes).  The
# fix halt ends this run at the target, so the LAST frame is right before the
# piston stops; undumped immediately after the drive.
dump traj_drive gel_system custom ${drive_dump_freq} &
    traj_files/gel_drive_${dataname}_${interaction}_${nsteps}_c${compressions}.lammpstrj &
    id type mol x y z
print ">>> [level ${compressions}] driving piston (cap ${nsteps_comp} steps)..."
run ${nsteps_comp}
unfix halt_compress
undump traj_drive
print ">>> [level ${compressions}] drive done: gel_strain = $(v_gel_strain:%.4f)  (target ${compressions})  step=$(step)"

# ----- Freeze the piston at this strain for the production hold -----
velocity piston set 0.0 0.0 0.0

# ----- Reset the displacement reference to the (held) compressed state so
#       u_z(z,0)=0 at the onset of THIS level's relaxation (for D_c). -----
variable uz_poly delete
uncompute displace_poly
compute displace_poly polymer displace/atom
variable uz_poly atom c_displace_poly[3]

# ----- PHASE 2b: production HOLD -- chunk-locked averaging fixes created HERE -----
dump traj_flow gel_system custom ${dump_freq_prod} &
    traj_files/gel_flow_${dataname}_${interaction}_${nsteps}_c${compressions}.lammpstrj &
    id type mol x y z
dump pairlocal_dump solvent local ${nfreq_stress} &
    output_files/pair_data/pairs_${dataname}_${interaction}_${nsteps}_c${compressions}.dump &
    c_ids_local[1] c_ids_local[2] c_ids_local[3] c_ids_local[4] &
    c_pl_local[1] c_pl_local[2] c_pl_local[3]
dump traj_stress_sync gel_system custom ${nfreq_stress} &
    traj_files/traj_stress_${dataname}_${interaction}_${nsteps}_c${compressions}.lammpstrj &
    id type mol x y z
dump pairlocal_poly polymer local ${nfreq_stress} &
    output_files/pair_data/polymer_pairs_${dataname}_${interaction}_${nsteps}_c${compressions}.dump &
    c_ids_local_poly[1] c_ids_local_poly[2] c_ids_local_poly[3] c_ids_local_poly[4] &
    c_pl_local_poly[1] c_pl_local_poly[2] c_pl_local_poly[3]
dump bondlocal_dump all local ${nfreq_stress} &
    output_files/pair_data/bonds_${dataname}_${interaction}_${nsteps}_c${compressions}.dump &
    c_bnd_ids[1] c_bnd_ids[2] c_bnd_ids[3] c_bnd_local[1] c_bnd_local[2]
dump widom_traj all custom ${nfreq_widom_dump} &
    traj_files/widom_${dataname}_${interaction}_${nsteps}_c${compressions}.lammpstrj id type x y z

fix avg_stress_x_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_x_polymer mode vector file output_files/stress_data/stress_x_polymer_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_stress_y_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_y_polymer mode vector file output_files/stress_data/stress_y_polymer_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_stress_z_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_z_polymer mode vector file output_files/stress_data/stress_z_polymer_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_stress_x_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_x_solvent mode vector file output_files/stress_data/stress_x_solvent_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_stress_y_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_y_solvent mode vector file output_files/stress_data/stress_y_solvent_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_stress_z_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_z_solvent mode vector file output_files/stress_data/stress_z_solvent_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_stress_z_pist all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_z_piston mode vector file output_files/stress_data/stress_z_piston_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_stress_z_supp all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_press_z_support mode vector file output_files/stress_data/stress_z_support_${dataname}_${interaction}_${nsteps}_c${compressions}.dat

fix avg_sigmazz_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmazz_poly mode vector file output_files/stress_data/sigmazz_polymer_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_sigmazz_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmazz_solv mode vector file output_files/stress_data/sigmazz_solvent_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_sigmaxx_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmaxx_poly mode vector file output_files/stress_data/sigmaxx_polymer_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_sigmaxx_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmaxx_solv mode vector file output_files/stress_data/sigmaxx_solvent_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_sigmayy_poly all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmayy_poly mode vector file output_files/stress_data/sigmayy_polymer_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_sigmayy_solv all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmayy_solv mode vector file output_files/stress_data/sigmayy_solvent_${dataname}_${interaction}_${nsteps}_c${compressions}.dat

fix avg_sigmazz_poly_fs all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmazz_poly_fs mode vector file output_files/stress_data/sigmazz_polymer_fine_support_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_sigmazz_poly_fp all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmazz_poly_fp mode vector file output_files/stress_data/sigmazz_polymer_fine_piston_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_sigmazz_solv_fs all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmazz_solv_fs mode vector file output_files/stress_data/sigmazz_solvent_fine_support_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_sigmazz_solv_fp all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    c_sigmazz_solv_fp mode vector file output_files/stress_data/sigmazz_solvent_fine_piston_${dataname}_${interaction}_${nsteps}_c${compressions}.dat

# Solvent density: use the STRESS cadence (not a separate density cadence) so
# the ave/chunk teardown lands on the SAME nfreq_stress epoch boundary as the
# run end -- guaranteeing a clean chunk/atom unlock before the next level.
fix avg_solv_density all ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_z_solv_density density/number density/mass &
    file output_files/chemical_potential/solvent_density_z_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_solv_density_fs all ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_zf_dens_sup density/number density/mass &
    file output_files/chemical_potential/solvent_density_z_fine_support_${dataname}_${interaction}_${nsteps}_c${compressions}.dat
fix avg_solv_density_fp all ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_zf_dens_pis density/number density/mass &
    file output_files/chemical_potential/solvent_density_z_fine_piston_${dataname}_${interaction}_${nsteps}_c${compressions}.dat

fix avg_disp_z_poly all ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_z_polymer v_uz_poly &
    file output_files/displacement_data/disp_z_polymer_${dataname}_${interaction}_${nsteps}_c${compressions}.dat

variable hold_steps equal (floor(($(step)+${nsteps}-1)/${nfreq_stress})+1)*${nfreq_stress}-$(step)
print ">>> [level ${compressions}] production HOLD for ${hold_steps} steps (>= ${nsteps}, aligned to nfreq_stress=${nfreq_stress})"
run ${hold_steps}

# ----- Teardown this level's hold fixes/dumps (lock released on the epoch-
#       aligned end_of_step above) BEFORE the next increment. -----
unfix avg_disp_z_poly
unfix avg_solv_density_fp
unfix avg_solv_density_fs
unfix avg_solv_density
unfix avg_sigmazz_solv_fp
unfix avg_sigmazz_solv_fs
unfix avg_sigmazz_poly_fp
unfix avg_sigmazz_poly_fs
unfix avg_sigmayy_solv
unfix avg_sigmayy_poly
unfix avg_sigmaxx_solv
unfix avg_sigmaxx_poly
unfix avg_sigmazz_solv
unfix avg_sigmazz_poly
unfix avg_stress_z_supp
unfix avg_stress_z_pist
unfix avg_stress_z_solv
unfix avg_stress_y_solv
unfix avg_stress_x_solv
unfix avg_stress_z_poly
unfix avg_stress_y_poly
unfix avg_stress_x_poly
undump widom_traj
undump bondlocal_dump
undump pairlocal_poly
undump traj_stress_sync
undump pairlocal_dump
undump traj_flow

# ----- Teardown the drive+hold loggers -----
unfix out_polymer_com
unfix out_box_dims
unfix out_gel_dims_rg
unfix out_gel_vol_rg
unfix out_gel_dims_bb
unfix out_gel_vol_bb
unfix out_gel_strain_thermo
unfix out_strain_zz
unfix out_piston_force_avg
unfix out_piston_force
unfix out_piston_vel
unfix out_piston_pos

print ">>> Completed level ${compressions}:  gel_strain = $(v_gel_strain:%.4f)  step=$(step)"

variable hold_steps delete

next compressions
jump SELF comp_loop


# ==========================================================================
#                            FINAL STATE
# ==========================================================================
print "========================================"
print "Triaxial compression stress-strain sweep complete"
print "  Final gel_strain: $(v_gel_strain:%.4f)"
print "  Final box: $(lx:%.3f) x $(ly:%.3f) x $(lz:%.3f)"
print "========================================"

variable outfile string "final_flow_${dataname}_${interaction}_${nsteps}"
write_data ${outfile}.data
