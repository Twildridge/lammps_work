# ========== Pure Solvent Single-Pressure NPT Equilibration ==========
# Equilibrates a pure LJ solvent at a single target pressure P* for
# use in computing the volume of mixing:
#
#   ΔV_mix = V_mixture − V_pure_polymer − V_pure_solvent
#
# Structure:
#   Stage 0 — Minimize + Gentle Langevin NVT
#   Stage 1 — NPT production  (single run, block-averaged output)
#
# Atom types in the solvent-only data file (produced by split_gel_data.py):
#   1 = Solvent          (original type 3)
#   2 = Bottom support   (original type 4) — frozen; present only if walls exist
#   3 = Top piston       (original type 5) — frozen; present only if walls exist
#
# If no support/piston beads exist (plain solvent-only file), the script
# degrades gracefully: the support and piston groups are empty and their
# fixes/pair_coeffs are harmless no-ops.
#
# Pair interactions (matching slab_with_support.lmp, in remapped types):
#   1–1  solvent–solvent   : epsSS, cutoff 2.5
#   1–2  solvent–support   : off (0.0)
#   1–3  solvent–piston    : WCA  (ε=1.0, cutoff 1.22σ)
#   2–2  support–support   : off
#   2–3  support–piston    : off
#   3–3  piston–piston     : off
#
# Outputs:
#   vol_pure_solvent_${dataname}_${interaction}.dat
#     → columns: step  press_mean  vol_mean  rho_mean  (one row per block)
#   output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat
#     → columns: step  lx  ly  lz
#
# Variables passed from bash:
#   dataname     — data file name (no extension)
#   interaction  — epsilon label (e.g. "1p0")
#   epsSS        — solvent-solvent LJ epsilon
#   nsteps       — NPT run length (divisible by n_blocks * 100)
#   n_blocks     — number of block-average windows (recommend 10)



# ========== Parameters ==========
variable sigma        equal 1.0
variable temp_target  equal 1.0
variable press_target index 1.5 # overridden by -var on command line
variable vel_seed     equal 12345  # RNG seed for create_velocity; overridden by -var for replica sweeps
variable tdamp        equal 1.0
variable pdamp        equal 1.0
variable n_blocks     equal 10

variable timestep_gentle equal 0.001
variable timestep_prod   equal 0.005
variable nsteps_gentle   equal 50000

variable thermo_freq   equal 10000
variable volume_freq   equal 10000

variable block_steps   equal ${nsteps}/${n_blocks}
variable nrepeat_block equal ${block_steps}/100



# ========== Initialization ==========
units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

read_data data_files/${dataname}.data

print ">>> solvent_pure: T*=${temp_target} P*=${press_target} epsSS=${epsSS} nsteps=${nsteps}"

comm_modify cutoff 5.0



# ========== Group Definitions ==========
# Groups are always defined.  If a type is absent the group is simply empty,
# and any fix applied to it becomes a harmless no-op.
group solvent type 1
group support type 2
group piston  type 3
group walls   type 2 3    # combined frozen group



# ========== Pair Interactions ==========
# Full pair_style with all 3 possible types.
# Interactions reproduce the slab_with_support.lmp conventions after
# the 3→1, 4→2, 5→3 type remapping performed by split_gel_data.py.
pair_style lj/cut 1.122
pair_coeff * * 0.0 ${sigma} 0.0       # default: all off
pair_coeff 1 1 ${epsSS} ${sigma} 1.122  # solvent–solvent

# Skip neighbour-list build for purely zero-interaction pairs
# neigh_modify exclude type 2 2
# neigh_modify exclude type 3 3
# neigh_modify exclude type 2 3

bond_style none
special_bonds lj 0.0 0.0 0.0

thermo_style custom step temp pe ke etotal press vol lx ly lz
thermo ${thermo_freq}


# ── Rescale box so solvent starts at bulk liquid density ──────────────
# This eliminates the polymer-void pressure collapse before NVT begins.
variable rho_liquid  equal 0.5          # bulk LJ liquid density at T*=1, P*=0.1
variable N_s         equal count(solvent)
variable V_box       equal lx*ly*lz
variable rho_current equal v_N_s/v_V_box
variable scale_f     equal (v_rho_current/v_rho_liquid)^(1.0/3.0)

print ">>> Solvent density before rescale: ${rho_current}"
print ">>> Box scale factor: ${scale_f}"

change_box all x scale ${scale_f} y scale ${scale_f} z scale ${scale_f} remap



# =====================================================================
#   STAGE 0 — Freeze walls, minimize solvent, gentle NVT ramp
# =====================================================================
# Freeze support and piston before minimization so the minimizer only
# moves solvent atoms.  setforce on an empty group is a safe no-op.
velocity walls set 0.0 0.0 0.0
fix freeze_walls walls setforce 0.0 0.0 0.0

minimize 1.0e-4 1.0e-6 10000 100000

reset_timestep 0
velocity solvent create 0.1 ${vel_seed} mom yes rot no
fix gentle solvent nve/limit 0.05
fix lang   solvent langevin ${temp_target} ${temp_target} ${tdamp} 904297
timestep ${timestep_gentle}
run ${nsteps_gentle}
unfix gentle
unfix lang



# =====================================================================
#   STAGE 1 — NPT production with block averaging
#
#   NPT is applied only to the solvent group.  Support/piston atoms
#   remain frozen via fix freeze_walls (setforce 0 0 0).  When the
#   barostat rescales the box the frozen atoms are rescaled too — this
#   is physically correct since they are non-interacting rigid layers
#   that ride with the periodic cell, not independent particles.
# =====================================================================
variable N_solvent   equal count(solvent)
variable box_vol     equal lx*ly*lz
variable num_density equal v_N_solvent/v_box_vol
variable inst_press  equal press

reset_timestep 0
fix 1 solvent npt temp ${temp_target} ${temp_target} ${tdamp} &
    iso ${press_target} ${press_target} ${pdamp}
timestep ${timestep_prod}

fix box_out all print ${volume_freq} "$(step) $(lx) $(ly) $(lz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat &
    screen no title "# step lx ly lz"

fix block_avg all ave/time 100 ${nrepeat_block} ${block_steps} &
    v_inst_press v_box_vol v_num_density &
    ave one &
    file vol_pure_solvent_${dataname}_${interaction}.dat &
    title1 "# one row per ${block_steps}-step block" &
    title2 "# step  press_mean  vol_mean  rho_mean"

run ${nsteps}

unfix block_avg
unfix box_out
unfix freeze_walls
unfix 1



write_data final_config_pure_solvent_${dataname}_${interaction}.data
print ">>> Done. Output: vol_pure_solvent_${dataname}_${interaction}.dat"
