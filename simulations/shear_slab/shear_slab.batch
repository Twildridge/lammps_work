#!/usr/bin/env bash

#SBATCH --job-name=shear_slab
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128 # was 32, 128
#SBATCH --cpus-per-task=1     # was 4, 1
#SBATCH --mem=0
#SBATCH --time=24:00:00
#SBATCH --output=%x.o%j.%N
# #SBATCH --error=%x.e%j.%N

# -----------------------------------------------------------------------
# SELF-SYNC GUARD (must run BEFORE STRAINS is defined below).
# sbatch submits whatever copy of this file is on disk at submit time. If that
# local copy is STALE (e.g. predates the STRAINS sweep), the run silently does
# the wrong thing — and run_lammps.sh's own `git pull` is too late to fix it,
# because this batch has ALREADY exported STRAINS by the time run_lammps.sh
# runs. (That is exactly how a sweep collapses to a single strain=0.1.)
# Fix: pull the repo FIRST, then re-exec the freshly pulled batch so STRAINS
# is always read from the current file. The guard var prevents an exec loop.
# -----------------------------------------------------------------------
LAMMPS_WORK_DIR="$HOME/Documents/lammps_work"
if [ -z "${SHEAR_BATCH_SYNCED:-}" ]; then
    echo ">>> [self-sync] pulling lammps_work before defining STRAINS..."
    command -v git &>/dev/null && git -C "$LAMMPS_WORK_DIR" pull --rebase --autostash || true
    export SHEAR_BATCH_SYNCED=1
    exec bash "$LAMMPS_WORK_DIR/simulations/shear_slab/shear_slab.batch"
fi
echo ">>> [self-sync] running freshly synced batch (SHEAR_BATCH_SYNCED=1)"

# Set environment variables
declare -xr OMPI_UNIT='core'
declare -xr OMPI_MCA_btl='self,vader'

declare -xr UCX_LOG_LEVEL='ERROR'
declare -xr UCX_TLS='self,cma,shm,rc,ud,dc'
declare -xr UCX_NET_DEVICES='mlx5_2:1'
declare -xir UCX_MAX_RNDV_RAILS=1

declare -xir OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"

# Load required modules for LAMMPS on Expanse (use this order)
module reset
module load gcc/10.2.0
module load openmpi/4.1.3
module load python/3.8.12

# -----------------------------------------------------------------------
# Simulation parameters
# DATANAME: isolated swollen gel from isolate_gel.ipynb
#   (output of slab_with_support run → isolate_gel → lammps_data/input_data/)
# NSTEPS: Phase 3 production steps only (Phase 1 + 2 lengths are in shear_slab.lmp)
#   Phase 1 (NPT equil):  nsteps_equil = 50000
#   Phase 2 (shear):      nsteps_shear = 200000
#   Phase 3 (production): NSTEPS (set here)
# -----------------------------------------------------------------------
FOLDER="shear_slab"
DATANAME="isolated_slab_support_5beads_tall_rho04_p1.5_1.0_1.0_600000_with_plates"
INTERACTION="1.0_1.0"   # epsSS_epsSP (solvent-solvent _ polymer-solvent)
NSTEPS=1000000
OLDSTEPS=0              # Set to 0 for fresh run, or previous totsteps for continuation
TYPE=""                 # Options: stress, volume, stressvol, or leave empty

# -----------------------------------------------------------------------
# Stress-strain curve: cumulative shear strains to step through.
#   strains = [0.1, 0.15, 0.2, 0.25, 0.3]
# The gel shears to the first strain, runs an NSTEPS production hold there,
# then shears FURTHER (incrementally, from that state) to each subsequent
# strain and holds again. Each strain writes its own output files tagged
# _g<strain>. For a single operating point, use one value, e.g. (0.1).
# If this is left unset, shear_slab.lmp falls back to a single strain of 0.1.
# -----------------------------------------------------------------------
STRAINS=(0.1 0.15 0.2 0.25 0.3)
export STRAINS="${STRAINS[*]}"   # space-separated for run_lammps.sh / LAMMPS -var

# Navigate to the scripts directory
cd ~/Documents/lammps_work/scripts || exit 1

# Run the simulation
if [ -z "$TYPE" ]; then
    ./run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS" "$OLDSTEPS"
else
    ./run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS" "$OLDSTEPS" "$TYPE"
fi
