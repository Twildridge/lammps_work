# ========== Shear Modulus Simulation — Plate-Driven ==========
# Input: isolated gel WITH shear plates attached (from add_plates_to_gel.py).
# Atom types: 1=polymer, 2=crosslinker, 3=solvent, 4=plate
# Bond types:  1=FENE (polymer-polymer), 2=harmonic (plate-polymer, k=30, r0=1)
#
# Shear method: fix move linear on plate atoms.
#   Right plate (+x face): vz = +vshear   Left plate (-x face): vz = -vshear
#   Plates move only in z (vx=vy=0) — no rotation possible.
#   Plate atoms are bonded (harmonic) to surface polymer → gel shears internally.
#   No velocity-gradient zone, no exponential profile, no group-limit issues.
#
# Why NOT the earlier gradient fix move approach (abandoned):
#   Hard fix move linear on polymer: FENE failure at driven/interior boundary.
#   Exponential gradient on polymer: rotation in xz even with vz=0.
#   Plates physically separate the driven boundary from the FENE network:
#   the harmonic bond stretches to transmit the shear; FENE bonds in the
#   interior only see the distributed gel strain (safe at 10% target).
#
# Phases:
#   1. NVT equilibration — plates frozen (fix move linear 0 0 0), gel NVT
#   2. Shear — plates driven at ±vshear, gel NVT
#   3. Production — plates frozen at Phase 2 final position, gel NVT
#      G = <sigma_p_xz> / gel_strain_cm_final
#
# Outputs:
#   stress_data/stress_tensor_polymer_*.dat   6-component polymer stress vs time
#   stress_data/stress_tensor_solvent_*.dat   6-component solvent stress vs time
#   stress_data/stress_profile_z_polymer_*.dat z-binned polymer stress
#   stress_data/stress_profile_z_solvent_*.dat z-binned solvent stress
#   stress_data/shear_strain_*.dat            step  gel_lz_initial  gel_gap  gel_strain_cm
#   volume_data/gel_dimensions_rg_*.dat       Rg-based gel dimensions
#   volume_data/box_dimensions_*.dat          box dims vs step
#   volume_data/polymer_com_*.dat             polymer COM vs step


# ==========================================================================
#                              PARAMETERS
# ==========================================================================

variable sigma          equal 1.0
variable temp_target    equal 1.0
variable P_target       equal 1.5
variable timestep_prod  equal 0.005

# Shear strain target (keep <= 0.10 for linear elastic regime)
variable target_strain_xz equal 0.10

# Phase lengths
variable nsteps_equil  equal 50000    # Phase 1: NVT equilibration (plates frozen)
variable nsteps_shear  equal 285000   # Phase 2: plate-driven shear
# nsteps (Phase 3 production) from bash via -var nsteps

# Output frequencies
variable thermo_freq     equal 10000
variable dump_freq_setup equal 10000
variable dump_freq_prod  equal 10000
variable stress_freq     equal 5000

# Time averaging (stress) — adaptive
variable num_stress_curves equal 10
variable nevery_target     equal 100
variable nrepeat_max       equal 2000
variable nrepeat_min       equal 50

variable nfreq_raw    equal floor(${nsteps}/v_num_stress_curves)
variable nrepeat_raw  equal floor(v_nfreq_raw/v_nevery_target)

variable nr_lo equal (v_nrepeat_raw>v_nrepeat_min)*v_nrepeat_raw+(v_nrepeat_raw<=v_nrepeat_min)*v_nrepeat_min
variable nrepeat_stress equal (v_nr_lo<v_nrepeat_max)*v_nr_lo+(v_nr_lo>=v_nrepeat_max)*v_nrepeat_max
variable nevery_stress equal floor(v_nfreq_raw/v_nrepeat_stress)
variable nfreq_stress  equal v_nevery_stress*v_nrepeat_stress

print ">>> Stress averaging: nevery=${nevery_stress}  nrepeat=${nrepeat_stress}  nfreq=${nfreq_stress}"
print ">>> Shear: γ_target=${target_strain_xz}  nsteps_shear=${nsteps_shear}  (plate-driven)"

# Spatial binning
variable binWidth    equal 2.0
variable rg_scale    equal 1.8
variable region_frac equal 1


# ==========================================================================
#                           INITIALIZATION
# ==========================================================================

units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

pair_style lj/cut 1.122
bond_style hybrid fene harmonic

read_data data_files/${dataname}.data nocoeff

comm_modify cutoff 5.0

print "========================================"
print "Shear slab simulation (plate-driven): ${dataname}"
print "Interaction: epsSS=${epsSS}, epsSP=${epsSP}"
print "Production steps: ${nsteps}"
print "Target shear strain: ${target_strain_xz}"
print "========================================"


# ==========================================================================
#                          GROUP DEFINITIONS
# ==========================================================================

group polymer    type 1 2
group backbone   type 1
group crosslinks type 2
group solvent    type 3
group gel        type 1 2 3      # all mobile gel atoms (NVT target)
group plate      type 4          # all plate atoms

# Right/left plate by x-position (box midplane).
# group intersect takes GROUP IDs — must create intermediate groups from regions first,
# then intersect with the plate type group.
variable xmid equal 0.5*(xlo+xhi)
region reg_plate_right block ${xmid} EDGE EDGE EDGE EDGE EDGE  units box
region reg_plate_left  block EDGE  ${xmid} EDGE EDGE EDGE EDGE units box

group all_right_x  region reg_plate_right   # all atoms right of xmid (any type)
group all_left_x   region reg_plate_left    # all atoms left  of xmid (any type)
group plate_right  intersect plate all_right_x
group plate_left   intersect plate all_left_x

print ">>> plate_right: $(count(plate_right))  plate_left: $(count(plate_left))"


# ==========================================================================
#                       INTERATOMIC POTENTIALS
# ==========================================================================

# WCA (purely repulsive) for all pairs by default
pair_coeff * * 1.0 ${sigma} 1.122

# Tunable polymer-solvent and solvent-solvent
pair_coeff 1 3 ${epsSP} ${sigma} 1.122
pair_coeff 2 3 ${epsSP} ${sigma} 1.122
pair_coeff 3 3 ${epsSS} ${sigma} 1.122

# Plate interactions (WCA — plate atoms only need to be non-overlapping)
pair_coeff 4 4 1.0 ${sigma} 1.122    # plate-plate
pair_coeff 1 4 1.0 ${sigma} 1.122    # polymer-plate
pair_coeff 2 4 1.0 ${sigma} 1.122    # crosslinker-plate
pair_coeff 3 4 1.0 ${sigma} 1.122    # solvent-plate

# Bond coefficients
bond_coeff 1 fene     30.0 1.5 1.0 1.0   # polymer-polymer FENE (Kremer-Grest)
bond_coeff 2 harmonic 30.0 1.0            # plate-polymer harmonic (k=30, r0=1)

special_bonds fene
neigh_modify delay 0 every 1 check yes


# ==========================================================================
#                           THERMO OUTPUT
# ==========================================================================

compute gel_temp  gel   temp
compute gel_press all   pressure gel_temp pair bond

thermo_style custom step c_gel_temp pe ke etotal press c_gel_press &
    pxx pyy pzz pxy pxz pyz vol lx ly lz xy xz yz
thermo_modify lost warn
thermo ${thermo_freq}


# ==========================================================================
#              PHASE 1: NVT EQUILIBRATION (Plates Frozen)
# ==========================================================================
# Plates are frozen in place; gel equilibrates via NVT.
# Box stays orthogonal and fixed in z — plates define the z boundaries.
# NVT (not NPT): plate positions are fixed, so changing box z would
# create overlaps between gel and plates.

print "========================================"
print "Phase 1: NVT equilibration (${nsteps_equil} steps, plates frozen)"
print "========================================"

reset_timestep 0
timestep ${timestep_prod}

# Triclinic needed for any later use (LAMMPS restriction: before any dump)
# Box stays orthogonal and fixed in x — plates define the x boundaries.
change_box all triclinic

dump traj_setup gel custom ${dump_freq_setup} &
    traj_files/setup_${dataname}_${interaction}_${nsteps}.lammpstrj &
    id type mol x y z

minimize 1.0e-4 1.0e-6 500 5000

fix freeze_plates_1 plate     move linear 0 0 0
fix nvt_equil       gel       nvt temp ${temp_target} ${temp_target} 1.0
fix mom_equil       gel       momentum 100 linear 1 1 1

run ${nsteps_equil}

unfix mom_equil
unfix nvt_equil
unfix freeze_plates_1

print ">>> Post-equilibration T = $(c_gel_temp)  P = $(press)"
print ">>> Box after Phase 1: $(lx) x $(ly) x $(lz)"


# ==========================================================================
#                  GEL CHARACTERIZATION (post-equilibration)
# ==========================================================================

compute polymer_com polymer com
compute minx        polymer reduce min x
compute maxx        polymer reduce max x
compute rg_tensor   polymer gyration

variable gel_lx_rg equal 2.0*sqrt(3.0*c_rg_tensor[1])
variable gel_ly_rg equal 2.0*sqrt(3.0*c_rg_tensor[2])
variable gel_lz_rg equal 2.0*sqrt(3.0*c_rg_tensor[3])
variable gel_vol_rg equal v_gel_lx_rg*v_gel_ly_rg*v_gel_lz_rg

run 0

variable gel_xlo      equal $(c_minx)
variable gel_xhi      equal $(c_maxx)
variable gel_gap      equal $(v_gel_xhi - v_gel_xlo)   # gap direction (x)
variable gel_lz_initial equal $(v_gel_lz_rg)            # long axis reference (z)

print ">>> Gel x-extent: ${gel_xlo} to ${gel_xhi}  (gap = ${gel_gap} σ)"
print ">>> Gel Rg dims: $(v_gel_lx_rg) x $(v_gel_ly_rg) x $(v_gel_lz_rg)"
print ">>> gel_lz_initial (Rg, long axis): ${gel_lz_initial}"

# Rg half-widths (for spatial analysis region sizing)
variable eps   equal 1.0e-12
variable Rg_xx equal c_rg_tensor[1]
variable Rg_yy equal c_rg_tensor[2]
variable Rg_zz equal c_rg_tensor[3]
variable hw_x equal v_region_frac*v_rg_scale*sqrt(v_Rg_xx + v_eps)
variable hw_y equal v_region_frac*v_rg_scale*sqrt(v_Rg_yy + v_eps)
variable hw_z equal v_region_frac*v_rg_scale*sqrt(v_Rg_zz + v_eps)

# COM tracking groups — outermost 1% of polymer (in x) for gel_strain_cm
# Strain = (z-COM_right - z-COM_left - zcm_sep_0) / gel_gap
# i.e., how far the right and left polymer surfaces have displaced in z
variable track_frac      equal 0.01
variable right_track_xlo equal $(v_gel_xhi - v_track_frac * v_gel_gap)
variable left_track_xhi  equal $(v_gel_xlo + v_track_frac * v_gel_gap)

region reg_track_right block ${right_track_xlo} ${gel_xhi} EDGE EDGE EDGE EDGE units box
region reg_track_left  block ${gel_xlo} ${left_track_xhi}  EDGE EDGE EDGE EDGE units box

group all_track_right region reg_track_right
group all_track_left  region reg_track_left
group poly_right_s intersect backbone all_track_right
group poly_left_s  intersect backbone all_track_left

compute zcm_right poly_right_s com
compute zcm_left  poly_left_s  com

run 0

variable zcm_sep_0    equal $(c_zcm_right[3] - c_zcm_left[3])
variable gel_strain_cm equal (c_zcm_right[3] - c_zcm_left[3] - v_zcm_sep_0) / v_gel_gap

print ">>> zcm_sep_0 (z-COM right-left, t=0): ${zcm_sep_0}"
print ">>> poly_right_s: $(count(poly_right_s))  poly_left_s: $(count(poly_left_s))"

# Plate velocity for target strain:
#   vshear = target_strain * gel_gap / (2 * nsteps_shear * dt)
# Both plates contribute equally; gel_gap is the polymer x-extent (gap direction).
variable vshear     equal $(v_target_strain_xz * v_gel_gap / (2.0 * v_nsteps_shear * v_timestep_prod))
variable neg_vshear equal -v_vshear
print ">>> vshear = ${vshear} σ/τ"


# ==========================================================================
#              PHASE 2: SHEAR APPLICATION (Plate-Driven)
# ==========================================================================
# Top plate driven at +vshear, bottom at -vshear.
# fix move linear prescribes vx=±vshear, vy=0, vz=0 every step — plates
# translate purely in x, no rotation possible.
# Gel (types 1,2,3) evolves freely under NVT.
# Angular momentum of gel zeroed every 100 steps (rotation prevention).

print "========================================"
print "Phase 2: Plate-driven shear (${nsteps_shear} steps)"
print "  Right plate (+x): vz = +${vshear}   Left plate (-x): vz = -${vshear}"
print "  Box stays ORTHOGONAL (xz = 0)"
print "========================================"

fix drive_right  plate_right move linear  0 0  ${vshear}
fix drive_left   plate_left  move linear  0 0  ${neg_vshear}
fix nvt_shear  gel       nvt  temp ${temp_target} ${temp_target} 1.0
fix mom_lin    gel       momentum 100 linear 1 1 1
fix mom_rot    gel       momentum 100 angular

# Columns: step  gel_lz_initial  gel_gap  gel_strain_cm
fix out_shear_strain all print ${stress_freq} &
    "$(step) ${gel_lz_initial} ${gel_gap} $(v_gel_strain_cm)" &
    file output_files/stress_data/shear_strain_${dataname}_${interaction}_${nsteps}.dat screen no

run ${nsteps_shear}

unfix out_shear_strain
unfix mom_rot
unfix mom_lin
unfix nvt_shear
unfix drive_left
unfix drive_right
undump traj_setup

print ">>> Phase 2 complete"
print ">>>   gel_strain_cm = $(v_gel_strain_cm)  (target: ${target_strain_xz})"
print ">>>   G = <sigma_p_xz> / $(v_gel_strain_cm)  [gap=x, shear=z]"
print ">>> Post-shear gel (Rg): $(v_gel_lx_rg) x $(v_gel_ly_rg) x $(v_gel_lz_rg)"

# Freeze Rg half-widths as constants (gel geometry now fixed)
variable hw_x equal $(v_hw_x)
variable hw_y equal $(v_hw_y)
variable hw_z equal $(v_hw_z)


# ==========================================================================
#                    ANALYSIS: PARTIAL STRESSES
# ==========================================================================

compute stress_polymer polymer stress/atom NULL
compute stress_solvent solvent  stress/atom NULL

# Box-integrated polymer stress
compute sig_p_xx polymer reduce sum c_stress_polymer[1]
compute sig_p_yy polymer reduce sum c_stress_polymer[2]
compute sig_p_zz polymer reduce sum c_stress_polymer[3]
compute sig_p_xy polymer reduce sum c_stress_polymer[4]
compute sig_p_xz polymer reduce sum c_stress_polymer[5]
compute sig_p_yz polymer reduce sum c_stress_polymer[6]

variable stress_p_xx equal c_sig_p_xx/vol
variable stress_p_yy equal c_sig_p_yy/vol
variable stress_p_zz equal c_sig_p_zz/vol
variable stress_p_xy equal c_sig_p_xy/vol
variable stress_p_xz equal c_sig_p_xz/vol
variable stress_p_yz equal c_sig_p_yz/vol

# Box-integrated solvent stress
compute sig_s_xx solvent reduce sum c_stress_solvent[1]
compute sig_s_yy solvent reduce sum c_stress_solvent[2]
compute sig_s_zz solvent reduce sum c_stress_solvent[3]
compute sig_s_xy solvent reduce sum c_stress_solvent[4]
compute sig_s_xz solvent reduce sum c_stress_solvent[5]
compute sig_s_yz solvent reduce sum c_stress_solvent[6]

variable stress_s_xx equal c_sig_s_xx/vol
variable stress_s_yy equal c_sig_s_yy/vol
variable stress_s_zz equal c_sig_s_zz/vol
variable stress_s_xy equal c_sig_s_xy/vol
variable stress_s_xz equal c_sig_s_xz/vol
variable stress_s_yz equal c_sig_s_yz/vol

# Per-atom z-bin stress (pre-divided by bin volume for fix ave/chunk)
variable s_p_xx atom c_stress_polymer[1]/(lx*ly*${binWidth})
variable s_p_yy atom c_stress_polymer[2]/(lx*ly*${binWidth})
variable s_p_zz atom c_stress_polymer[3]/(lx*ly*${binWidth})
variable s_p_xy atom c_stress_polymer[4]/(lx*ly*${binWidth})
variable s_p_xz atom c_stress_polymer[5]/(lx*ly*${binWidth})
variable s_p_yz atom c_stress_polymer[6]/(lx*ly*${binWidth})

variable s_s_xx atom c_stress_solvent[1]/(lx*ly*${binWidth})
variable s_s_yy atom c_stress_solvent[2]/(lx*ly*${binWidth})
variable s_s_zz atom c_stress_solvent[3]/(lx*ly*${binWidth})
variable s_s_xy atom c_stress_solvent[4]/(lx*ly*${binWidth})
variable s_s_xz atom c_stress_solvent[5]/(lx*ly*${binWidth})
variable s_s_yz atom c_stress_solvent[6]/(lx*ly*${binWidth})


# ==========================================================================
#                    ANALYSIS: SPATIAL CHUNKS (z-binning)
# ==========================================================================

variable binWidth_reduced equal $(v_binWidth/lz)
compute chunk_z_polymer polymer chunk/atom bin/1d z lower ${binWidth_reduced} units reduced
compute chunk_z_solvent  solvent  chunk/atom bin/1d z lower ${binWidth_reduced} units reduced


# ==========================================================================
#              PHASE 3: NVT PRODUCTION (Plates Frozen at Final Position)
# ==========================================================================
# Both plates frozen at Phase 2 final positions (fix move linear 0 0 0).
# Gel NVT: interior relaxes to mechanical equilibrium at frozen strain.
# G = <sigma_p_xz> / gel_strain_cm_final.

print "========================================"
print "Phase 3: NVT production (${nsteps} steps)"
print "  Plates frozen at Phase 2 final positions"
print "  gel_strain_cm = $(v_gel_strain_cm)  (= γ for G)"
print "========================================"

fix freeze_right  plate_right move linear 0 0 0
fix freeze_left   plate_left  move linear 0 0 0
fix nvt_prod    gel       nvt  temp ${temp_target} ${temp_target} 1.0
fix mom_prod    gel       momentum 100 linear 1 1 1 angular

dump traj_prod gel custom ${dump_freq_prod} &
    traj_files/prod_${dataname}_${interaction}_${nsteps}.lammpstrj &
    id type mol x y z


# ==========================================================================
#    OUTPUT: BOX-INTEGRATED STRESS TENSOR
# ==========================================================================

fix avg_stress_polymer all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_p_xx v_stress_p_yy v_stress_p_zz &
    v_stress_p_xy v_stress_p_xz v_stress_p_yz &
    file output_files/stress_data/stress_tensor_polymer_${dataname}_${interaction}_${nsteps}.dat

fix avg_stress_solvent all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_s_xx v_stress_s_yy v_stress_s_zz &
    v_stress_s_xy v_stress_s_xz v_stress_s_yz &
    file output_files/stress_data/stress_tensor_solvent_${dataname}_${interaction}_${nsteps}.dat


# ==========================================================================
#    OUTPUT: Z-PROFILE STRESS TENSOR
# ==========================================================================

fix prof_z_polymer polymer ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_z_polymer &
    v_s_p_xx v_s_p_yy v_s_p_zz v_s_p_xy v_s_p_xz v_s_p_yz &
    norm none &
    file output_files/stress_data/stress_profile_z_polymer_${dataname}_${interaction}_${nsteps}.dat

fix prof_z_solvent solvent ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_z_solvent &
    v_s_s_xx v_s_s_yy v_s_s_zz v_s_s_xy v_s_s_xz v_s_s_yz &
    norm none &
    file output_files/stress_data/stress_profile_z_solvent_${dataname}_${interaction}_${nsteps}.dat


# ==========================================================================
#    OUTPUT: GEL AND BOX DIMENSIONS
# ==========================================================================

fix out_gel_dims_rg all print ${stress_freq} &
    "$(step) $(v_gel_lx_rg) $(v_gel_ly_rg) $(v_gel_lz_rg)" &
    file output_files/volume_data/gel_dimensions_rg_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_box_dims all print ${stress_freq} &
    "$(step) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_polymer_com all print ${stress_freq} &
    "$(step) $(c_polymer_com[1]) $(c_polymer_com[2]) $(c_polymer_com[3])" &
    file output_files/volume_data/polymer_com_${dataname}_${interaction}_${nsteps}.dat screen no


# ==========================================================================
#                         PRODUCTION RUN
# ==========================================================================

run ${nsteps}


# ==========================================================================
#                            CLEANUP
# ==========================================================================

undump traj_prod
unfix mom_prod
unfix nvt_prod
unfix freeze_left
unfix freeze_right

print "========================================"
print "Shear slab simulation complete"
print "  gel_strain_cm (γ for G): $(v_gel_strain_cm)  (target: ${target_strain_xz})"
print "  gel_lz_initial: ${gel_lz_initial}  gel_gap: ${gel_gap}"
print "  Final box: $(lx) x $(ly) x $(lz)  xz = $(xz)"
print "========================================"

variable outfile string "final_shear_${dataname}_${interaction}_${nsteps}"
write_data ${outfile}.data
