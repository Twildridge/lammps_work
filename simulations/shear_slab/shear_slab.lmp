# ==========================================================================
#                     SHEAR MODULUS (AFFINE, PERIODIC)
# ==========================================================================
# Relaxed equilibrium shear modulus for dense crosslinked gel
# G = <sigma_xz> / gamma
# gamma = xz / lz
#
# Key choices:
# - affine shear via fix deform remap x
# - periodic boundary p p p
# - polymer-only stress
# - no plates (avoids overconstraint)
# ==========================================================================


# ==========================================================================
#                              PARAMETERS
# ==========================================================================

variable sigma          equal 1.0
variable temp_target    equal 1.0
variable P_target       equal 1.5
variable timestep       equal 0.005

variable target_strain_xz equal 0.10
variable nsteps_equil     equal 50000
variable nsteps_shear     equal 200000


variable erate equal ${target_strain_xz}/(${nsteps_shear}*${timestep})

variable thermo_freq equal 10000
variable stress_freq equal 5000


# ==========================================================================
#                           INITIALIZATION
# ==========================================================================

units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

pair_style lj/cut 1.122
bond_style fene

read_data data_files/${dataname}.data nocoeff

comm_modify cutoff 5.0

print "========================================"
print "Affine shear modulus simulation"
print "========================================"


# ==========================================================================
#                           GROUPS
# ==========================================================================

group polymer type 1 2
group solvent type 3
group all_mobile type 1 2 3


# ==========================================================================
#                        INTERACTIONS
# ==========================================================================

pair_coeff * * 1.0 ${sigma} 1.122
pair_coeff 1 3 ${epsSP} ${sigma} 1.122
pair_coeff 2 3 ${epsSP} ${sigma} 1.122
pair_coeff 3 3 ${epsSS} ${sigma} 1.122

bond_coeff * 30.0 1.5 1.0 1.0
special_bonds fene

neigh_modify delay 0 every 1 check yes


# ==========================================================================
#                            THERMO
# ==========================================================================

compute mobile_temp all_mobile temp
compute mobile_press all pressure mobile_temp pair bond

thermo_style custom step c_mobile_temp pe ke etotal press &
    pxx pyy pzz pxy pxz pyz vol lx ly lz xy xz yz
thermo ${thermo_freq}


# ==========================================================================
#                        PHASE 1: EQUILIBRATION
# ==========================================================================

print "Phase 1: NPT equilibration"

reset_timestep 0
timestep ${timestep}

minimize 1.0e-4 1.0e-6 500 5000

fix npt_equil all_mobile npt temp ${temp_target} ${temp_target} 1.0 &
    iso ${P_target} ${P_target} 10.0

run ${nsteps_equil}

unfix npt_equil

fix rm all momentum 100 linear 1 1 1 angular


# ==========================================================================
#                        PHASE 2: AFFINE SHEAR
# ==========================================================================

print "Phase 2: Affine shear"

fix nvt_shear all_mobile nvt temp ${temp_target} ${temp_target} 1.0

fix deform_shear all deform 1 xz erate ${erate} remap x

fix shear_strain all print ${stress_freq} &
    "$(step) $(xz) $(lz) $(xz/lz)" &
    file output_files/stress_data/shear_strain_${dataname}.dat screen no

run ${nsteps_shear}

unfix shear_strain
unfix deform_shear
unfix nvt_shear


# ==========================================================================
#                 STRESS COMPUTATION (POLYMER ONLY)
# ==========================================================================

compute stress_polymer polymer stress/atom NULL

compute sig_p_xz polymer reduce sum c_stress_polymer[5]

variable sigma_xz equal c_sig_p_xz/vol


# ==========================================================================
#                        PHASE 3: RELAXATION
# ==========================================================================

print "Phase 3: relaxation"

fix nvt_prod all_mobile nvt temp ${temp_target} ${temp_target} 1.0
fix rm2 all momentum 100 linear 1 1 1 angular

fix avg_stress all ave/time ${stress_freq} 1000 ${stress_freq} &
    v_sigma_xz file output_files/stress_data/stress_tensor_${dataname}.dat

run ${nsteps}


# ==========================================================================
#                           CLEANUP
# ==========================================================================

unfix avg_stress
unfix nvt_prod
unfix rm
unfix rm2

print "========================================"
print "DONE"
print "Final strain = $(xz/lz)"
print "========================================"

write_data final_shear_${dataname}.data