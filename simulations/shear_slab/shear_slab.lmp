# ========== Shear Modulus Simulation — Plate-Driven ==========
# Input: isolated gel WITH shear plates attached (from add_plates_to_gel.py).
# Atom types: 1=polymer, 2=crosslinker, 3=solvent, 4=plate
# Bond types:  1=FENE (polymer-polymer), 2=harmonic (plate-polymer, k=30, r0=1)
#
# Shear method: fix move linear on plate atoms.
#   Right plate (+x face): vz = +vshear   Left plate (-x face): vz = -vshear
#   Plates move only in z (vx=vy=0) — no rotation possible.
#   Plate atoms are bonded (harmonic) to surface polymer → gel shears internally.
#   No velocity-gradient zone, no exponential profile, no group-limit issues.
#
# Why NOT the earlier gradient fix move approach (abandoned):
#   Hard fix move linear on polymer: FENE failure at driven/interior boundary.
#   Exponential gradient on polymer: rotation in xz even with vz=0.
#   Plates physically separate the driven boundary from the FENE network:
#   the harmonic bond stretches to transmit the shear; FENE bonds in the
#   interior only see the distributed gel strain (safe at 10% target).
#
# Phases:
#   1. Equilibration (ONCE) — NPT then NVT, plates frozen (fix move linear 0 0 0)
#   2+3. STRAIN LOOP over ${strains} (cumulative, incremental):
#        For each target strain:
#          2. Shear — plates driven at ±vshear until gel_strain_cm reaches target
#          3. Production — plates frozen at that strain, gel NVT
#             G(γ) = <sigma_p_zx> / gel_strain_cm   at each target
#        The next iteration resumes shearing FURTHER from the held state, so
#        the gel walks monotonically through 0.1 -> 0.15 -> ... (stress-strain).
#
# Stress-strain curve: G / sigma_zx at each strain (shear_analysis.ipynb).
# Cooperative diffusivity D_c (∝ G): from the Phase-3 relaxation of the polymer
# z-displacement profile u_z(x) toward the linear shear ramp (displacement_data).
#
# Outputs (one set per strain, tagged _g<strain>):
#   stress_data/stress_tensor_polymer_*_g<γ>.dat   6-component polymer stress vs time
#   stress_data/stress_tensor_solvent_*_g<γ>.dat   6-component solvent stress vs time
#   stress_data/stress_profile_x_polymer_*_g<γ>.dat x-binned polymer stress (gap dir)
#   stress_data/stress_profile_x_solvent_*_g<γ>.dat x-binned solvent stress (gap dir)
#   stress_data/shear_strain_*_g<γ>.dat            step  gel_lz_initial  gel_gap  gel_strain_cm
#   displacement_data/disp_z_polymer_*_g<γ>.dat    x-binned mean polymer u_z (for D_c)
#   volume_data/gel_dimensions_rg_*_g<γ>.dat       Rg-based gel dimensions
#   volume_data/box_dimensions_*_g<γ>.dat          box dims vs step
#   volume_data/polymer_com_*_g<γ>.dat             polymer COM vs step


# ==========================================================================
#                              PARAMETERS
# ==========================================================================

variable sigma          equal 1.0
variable temp_target    equal 1.0
variable P_target       equal 1.5
variable timestep_prod  equal 0.005

# ---- Stress-strain curve: list of cumulative shear strains -------------------
# 'strains' is an index-style variable supplied on the command line by
# run_lammps.sh as:   -var strains 0.1 0.15 0.2 0.25 0.3
# (set in shear_slab.batch via STRAINS=(...)).  If it is NOT supplied, the
# in-script default below is used instead: a single strain of 0.10.  (A
# command-line index variable always takes precedence over this fallback.)
# The script loops over these values, shearing INCREMENTALLY from one target
# to the next (see the STRAIN LOOP near the end) and running a production hold
# at each.  Keep individual targets in the linear-elastic regime if you want a
# clean G; the curve will reveal where it departs from linearity.
variable strains index 0.10

# Diagnostic: run_lammps.sh also passes the raw list as a single string
# (-var strains_list "0.1 0.15 ...") purely for logging. If the log shows the
# STALE fallback string below instead of your list, the run_lammps.sh that
# executed did NOT pass -var strains (its on-disk copy was out of date when the
# job started — the script's own git pull only updates it for the NEXT run).
# In that case ONLY the single in-script default strain above runs. Fix: make
# sure run_lammps.sh on the cluster is current BEFORE submitting, then resubmit.
variable strains_list index "STALE-run_lammps.sh--no-list-passed--running-single-default-only"

# Reference strain used ONLY to set the (constant) plate drive speed vshear.
# Each increment is stopped by fix halt at the current ${strains} target, so
# this controls how fast the plates move, not where they stop.
variable strain_rate_ref equal 0.10

# Phase lengths
variable nsteps_npt    equal 50000    # Phase 1a: NPT — find equilibrium volume (plates frozen)
variable nsteps_equil  equal 100000   # Phase 1b: NVT — equilibrate at NPT volume (plates frozen)
variable nsteps_shear_base equal 285000   # reference for vshear calculation
variable nsteps_shear      equal 570000   # 2× safety buffer — halt fires at target_strain
# nsteps (Phase 3 production) from bash via -var nsteps

# Output frequencies
variable thermo_freq     equal 25000
variable dump_freq_setup equal 25000
variable dump_freq_prod  equal 25000
variable stress_freq     equal 10000

# Time averaging (stress) — adaptive
variable num_stress_curves equal 10
variable nevery_target     equal 100
variable nrepeat_max       equal 2000
variable nrepeat_min       equal 50

variable nfreq_raw    equal floor(${nsteps}/v_num_stress_curves)
variable nrepeat_raw  equal floor(v_nfreq_raw/v_nevery_target)

variable nr_lo equal (v_nrepeat_raw>v_nrepeat_min)*v_nrepeat_raw+(v_nrepeat_raw<=v_nrepeat_min)*v_nrepeat_min
variable nrepeat_stress equal (v_nr_lo<v_nrepeat_max)*v_nr_lo+(v_nr_lo>=v_nrepeat_max)*v_nrepeat_max
variable nevery_stress equal floor(v_nfreq_raw/v_nrepeat_stress)
variable nfreq_stress  equal v_nevery_stress*v_nrepeat_stress

print ">>> Stress averaging: nevery=${nevery_stress}  nrepeat=${nrepeat_stress}  nfreq=${nfreq_stress}"
print "############################################################"
print ">>> STRAIN SWEEP LIST (raw from run_lammps.sh): ${strains_list}"
print ">>>   first target=${strains}   nsteps_shear=${nsteps_shear}  (plate-driven, incremental)"
print ">>>   If the line above reads 'STALE-run_lammps.sh...', only ONE strain"
print ">>>   will run — update run_lammps.sh on the cluster and resubmit."
print "############################################################"

# Spatial binning
variable binWidth    equal 2.0
variable rg_scale    equal 1.8
variable region_frac equal 1


# ==========================================================================
#                           INITIALIZATION
# ==========================================================================

units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

pair_style lj/cut 1.122
bond_style hybrid fene harmonic

read_data data_files/${dataname}.data nocoeff

comm_modify cutoff 5.0

print "========================================"
print "Shear slab simulation (plate-driven): ${dataname}"
print "Interaction: epsSS=${epsSS}, epsSP=${epsSP}"
print "Production steps per strain: ${nsteps}"
print "Cumulative shear strain targets (first=${strains}): see STRAIN LOOP"
print "========================================"


# ==========================================================================
#                          GROUP DEFINITIONS
# ==========================================================================

group polymer    type 1 2
group backbone   type 1
group crosslinks type 2
group solvent    type 3
group gel        type 1 2 3      # all mobile gel atoms (NVT target)
group plate      type 4          # all plate atoms

# Right/left plate by x-position (box midplane).
# group intersect takes GROUP IDs — must create intermediate groups from regions first,
# then intersect with the plate type group.
variable xmid equal 0.5*(xlo+xhi)
region reg_plate_right block ${xmid} EDGE EDGE EDGE EDGE EDGE  units box
region reg_plate_left  block EDGE  ${xmid} EDGE EDGE EDGE EDGE units box

group all_right_x  region reg_plate_right   # all atoms right of xmid (any type)
group all_left_x   region reg_plate_left    # all atoms left  of xmid (any type)
group plate_right  intersect plate all_right_x
group plate_left   intersect plate all_left_x

print ">>> plate_right: $(count(plate_right))  plate_left: $(count(plate_left))"


# ==========================================================================
#                       INTERATOMIC POTENTIALS
# ==========================================================================

# WCA (purely repulsive) for all pairs by default
pair_coeff * * 1.0 ${sigma} 1.122

# Tunable polymer-solvent and solvent-solvent
pair_coeff 1 3 ${epsSP} ${sigma} 1.122
pair_coeff 2 3 ${epsSP} ${sigma} 1.122
pair_coeff 3 3 ${epsSS} ${sigma} 1.122

# Plate interactions (WCA — plate atoms only need to be non-overlapping)
pair_coeff 4 4 1.0 ${sigma} 1.122    # plate-plate
pair_coeff 1 4 1.0 ${sigma} 1.122    # polymer-plate
pair_coeff 2 4 1.0 ${sigma} 1.122    # crosslinker-plate
pair_coeff 3 4 1.0 ${sigma} 1.122    # solvent-plate

# Bond coefficients
bond_coeff 1 fene     30.0 1.5 1.0 1.0   # polymer-polymer FENE (Kremer-Grest)
bond_coeff 2 harmonic 30.0 1.0            # plate-polymer harmonic (k=30, r0=1)

special_bonds fene
neigh_modify delay 0 every 1 check yes


# ==========================================================================
#                           THERMO OUTPUT
# ==========================================================================

compute gel_temp  gel   temp
compute gel_press all   pressure gel_temp pair bond

thermo_style custom step c_gel_temp pe ke etotal press c_gel_press &
    pxx pyy pzz pxy pxz pyz vol lx ly lz xy xz yz
thermo_modify lost warn
thermo ${thermo_freq}


# ==========================================================================
#              PHASE 1: EQUILIBRATION (NPT then NVT, plates frozen)
# ==========================================================================
# Phase 1a — NPT (${nsteps_npt} steps):
#   Plates frozen with fix move linear 0 0 0; box adjusts iso to P_target.
#   Plate atoms scale with the box (their reduced coords stay fixed) so the
#   plate-polymer gap shrinks/grows consistently with the gel.
#   Goal: find the equilibrium box volume at P = P_target.
#
# Phase 1b — NVT (${nsteps_equil} steps):
#   Box locked at the NPT-final volume (no barostat → constant V).
#   Plates remain frozen. Gel thermalises at fixed volume.
#   Goal: relax internal stresses at the correct density before shear.

print "========================================"
print "Phase 1a: NPT equilibration (${nsteps_npt} steps, plates frozen)"
print "========================================"

reset_timestep 0
timestep ${timestep_prod}

# Triclinic box required before any dump (LAMMPS restriction).
change_box all triclinic

dump traj_setup all custom ${dump_freq_setup} &
    traj_files/setup_${dataname}_${interaction}_${nsteps}.lammpstrj &
    id type mol x y z

# Freeze plates during minimize — only gel atoms relax around the plates.
fix freeze_plates_min plate setforce 0.0 0.0 0.0
velocity plate set 0.0 0.0 0.0
minimize 1.0e-4 1.0e-6 5000 50000
unfix freeze_plates_min

# --- Phase 1a: NPT ---
fix freeze_plates_npt plate   move linear 0 0 0
fix npt_equil         gel     npt temp ${temp_target} ${temp_target} 1.0 &
                                   iso ${P_target} ${P_target} 10.0
fix mom_npt           gel     momentum 100 linear 1 1 1

run ${nsteps_npt}

unfix mom_npt
unfix npt_equil
unfix freeze_plates_npt

print ">>> Post-NPT T = $(c_gel_temp)  P = $(press)"
print ">>> NPT-final box: $(lx) x $(ly) x $(lz)  (this becomes the NVT input volume)"

print "========================================"
print "Phase 1b: NVT equilibration (${nsteps_equil} steps, plates frozen)"
print "  Box fixed at NPT-final volume"
print "========================================"

# --- Phase 1b: NVT at NPT-final volume ---
# No barostat → box dimensions unchanged from NPT end.
fix freeze_plates_1 plate   move linear 0 0 0
fix nvt_equil       gel     nvt temp ${temp_target} ${temp_target} 1.0
fix mom_equil       gel     momentum 100 linear 1 1 1

run ${nsteps_equil}

unfix mom_equil
unfix nvt_equil
unfix freeze_plates_1

print ">>> Post-NVT T = $(c_gel_temp)  P = $(press)"
print ">>> Box after Phase 1: $(lx) x $(ly) x $(lz)"


# ==========================================================================
#                  GEL CHARACTERIZATION (post-equilibration)
# ==========================================================================

compute polymer_com polymer com
compute minx        polymer reduce min x
compute maxx        polymer reduce max x
compute rg_tensor   polymer gyration

variable gel_lx_rg equal 2.0*sqrt(3.0*c_rg_tensor[1])
variable gel_ly_rg equal 2.0*sqrt(3.0*c_rg_tensor[2])
variable gel_lz_rg equal 2.0*sqrt(3.0*c_rg_tensor[3])
variable gel_vol_rg equal v_gel_lx_rg*v_gel_ly_rg*v_gel_lz_rg

run 0

variable gel_xlo      equal $(c_minx)
variable gel_xhi      equal $(c_maxx)
variable gel_gap      equal $(v_gel_xhi - v_gel_xlo)   # gap direction (x)
variable gel_lz_initial equal $(v_gel_lz_rg)            # long axis reference (z)

print ">>> Gel x-extent: ${gel_xlo} to ${gel_xhi}  (gap = ${gel_gap} σ)"
print ">>> Gel Rg dims: $(v_gel_lx_rg) x $(v_gel_ly_rg) x $(v_gel_lz_rg)"
print ">>> gel_lz_initial (Rg, long axis): ${gel_lz_initial}"

# Rg half-widths (for spatial analysis region sizing)
variable eps   equal 1.0e-12
variable Rg_xx equal c_rg_tensor[1]
variable Rg_yy equal c_rg_tensor[2]
variable Rg_zz equal c_rg_tensor[3]
variable hw_x equal v_region_frac*v_rg_scale*sqrt(v_Rg_xx + v_eps)
variable hw_y equal v_region_frac*v_rg_scale*sqrt(v_Rg_yy + v_eps)
variable hw_z equal v_region_frac*v_rg_scale*sqrt(v_Rg_zz + v_eps)

# COM tracking groups — outermost 1% of polymer (in x) for gel_strain_cm
# Strain = (z-COM_right - z-COM_left - zcm_sep_0) / gel_gap
# i.e., how far the right and left polymer surfaces have displaced in z
variable track_frac      equal 0.01
variable right_track_xlo equal $(v_gel_xhi - v_track_frac * v_gel_gap)
variable left_track_xhi  equal $(v_gel_xlo + v_track_frac * v_gel_gap)

region reg_track_right block ${right_track_xlo} ${gel_xhi} EDGE EDGE EDGE EDGE units box
region reg_track_left  block ${gel_xlo} ${left_track_xhi}  EDGE EDGE EDGE EDGE units box

group all_track_right region reg_track_right
group all_track_left  region reg_track_left
group poly_right_s intersect backbone all_track_right
group poly_left_s  intersect backbone all_track_left

compute zcm_right poly_right_s com
compute zcm_left  poly_left_s  com

run 0

variable zcm_sep_0    equal $(c_zcm_right[3] - c_zcm_left[3])
variable gel_strain_cm equal (c_zcm_right[3] - c_zcm_left[3] - v_zcm_sep_0) / v_gel_gap

print ">>> zcm_sep_0 (z-COM right-left, t=0): ${zcm_sep_0}"
print ">>> poly_right_s: $(count(poly_right_s))  poly_left_s: $(count(poly_left_s))"

# Plate velocity: 1.1× the speed that would reach strain_rate_ref in nsteps_shear_base steps.
# The drive speed is CONSTANT for every increment; the run is capped by fix halt
# at each ${strains} target, so nsteps_shear is just a safety buffer.
#   vshear = 1.1 * strain_rate_ref * gel_gap / (2 * nsteps_shear_base * dt)
variable vshear     equal $(v_strain_rate_ref * v_gel_gap / (2.0 * v_nsteps_shear_base * v_timestep_prod) * 1.1)
variable neg_vshear equal -v_vshear
print ">>> vshear = ${vshear} σ/τ  (constant plate speed; halt fires at each ${strains} target)"

# Phase-1 setup trajectory is done — the per-strain production trajectories
# (one per ${strains}) are dumped inside the loop below.
undump traj_setup


# ==========================================================================
#             BULK REGION (exclude 3σ near each plate)   [defined ONCE]
# ==========================================================================
# Atoms within 3σ of either plate surface are bonded to the plate via harmonic
# springs and carry artifactual constraint stresses. Exclude them from all
# stress/displacement measurements so only the interior gel is sampled.
# The gap direction (x) does not change during z-shear, so this region — and
# the analysis computes below — are defined ONCE and reused for every strain.

variable xlo_bulk equal ${gel_xlo}+3.0
variable xhi_bulk equal ${gel_xhi}-3.0
variable bulk_lx  equal v_xhi_bulk-v_xlo_bulk       # x-extent of bulk region
variable bulk_vol equal v_bulk_lx*ly*lz             # bulk volume (ly,lz fixed post-NPT)
region   reg_bulk block ${xlo_bulk} ${xhi_bulk} EDGE EDGE EDGE EDGE units box
group    all_bulk  region reg_bulk
group    poly_bulk intersect polymer all_bulk
group    solv_bulk intersect solvent all_bulk
print ">>> Bulk x-range: ${xlo_bulk} to ${xhi_bulk}  (bulk_lx = $(v_bulk_lx))"
print ">>> bulk_vol = $(v_bulk_vol)"
print ">>> poly_bulk: $(count(poly_bulk))  solv_bulk: $(count(solv_bulk))"


# ==========================================================================
#              ANALYSIS: PARTIAL STRESSES   [computes defined ONCE]
# ==========================================================================

compute stress_polymer poly_bulk stress/atom NULL
compute stress_solvent solv_bulk stress/atom NULL

# Box-integrated polymer stress (bulk only)
compute sig_p_xx poly_bulk reduce sum c_stress_polymer[1]
compute sig_p_yy poly_bulk reduce sum c_stress_polymer[2]
compute sig_p_zz poly_bulk reduce sum c_stress_polymer[3]
compute sig_p_xy poly_bulk reduce sum c_stress_polymer[4]
compute sig_p_zx poly_bulk reduce sum c_stress_polymer[5]
compute sig_p_yz poly_bulk reduce sum c_stress_polymer[6]

variable stress_p_xx equal c_sig_p_xx/v_bulk_vol
variable stress_p_yy equal c_sig_p_yy/v_bulk_vol
variable stress_p_zz equal c_sig_p_zz/v_bulk_vol
variable stress_p_xy equal c_sig_p_xy/v_bulk_vol
variable stress_p_zx equal c_sig_p_zx/v_bulk_vol
variable stress_p_yz equal c_sig_p_yz/v_bulk_vol

# Box-integrated solvent stress (bulk only)
compute sig_s_xx solv_bulk reduce sum c_stress_solvent[1]
compute sig_s_yy solv_bulk reduce sum c_stress_solvent[2]
compute sig_s_zz solv_bulk reduce sum c_stress_solvent[3]
compute sig_s_xy solv_bulk reduce sum c_stress_solvent[4]
compute sig_s_zx solv_bulk reduce sum c_stress_solvent[5]
compute sig_s_yz solv_bulk reduce sum c_stress_solvent[6]

variable stress_s_xx equal c_sig_s_xx/v_bulk_vol
variable stress_s_yy equal c_sig_s_yy/v_bulk_vol
variable stress_s_zz equal c_sig_s_zz/v_bulk_vol
variable stress_s_xy equal c_sig_s_xy/v_bulk_vol
variable stress_s_zx equal c_sig_s_zx/v_bulk_vol
variable stress_s_yz equal c_sig_s_yz/v_bulk_vol

# Per-atom x-bin stress (pre-divided by bin volume for fix ave/chunk).
# Bins are slabs normal to x (gap direction); bin volume = binWidth * Ly * Lz.
variable s_p_xx atom c_stress_polymer[1]/(${binWidth}*ly*lz)
variable s_p_yy atom c_stress_polymer[2]/(${binWidth}*ly*lz)
variable s_p_zz atom c_stress_polymer[3]/(${binWidth}*ly*lz)
variable s_p_xy atom c_stress_polymer[4]/(${binWidth}*ly*lz)
variable s_p_zx atom c_stress_polymer[5]/(${binWidth}*ly*lz)
variable s_p_yz atom c_stress_polymer[6]/(${binWidth}*ly*lz)

variable s_s_xx atom c_stress_solvent[1]/(${binWidth}*ly*lz)
variable s_s_yy atom c_stress_solvent[2]/(${binWidth}*ly*lz)
variable s_s_zz atom c_stress_solvent[3]/(${binWidth}*ly*lz)
variable s_s_xy atom c_stress_solvent[4]/(${binWidth}*ly*lz)
variable s_s_zx atom c_stress_solvent[5]/(${binWidth}*ly*lz)
variable s_s_yz atom c_stress_solvent[6]/(${binWidth}*ly*lz)


# ==========================================================================
#              ANALYSIS: SPATIAL CHUNKS (x-binning)   [defined ONCE]
# ==========================================================================

variable binWidth_reduced equal $(v_binWidth/lx)
compute chunk_x_polymer poly_bulk chunk/atom bin/1d x lower ${binWidth_reduced} units reduced
compute chunk_x_solvent  solv_bulk chunk/atom bin/1d x lower ${binWidth_reduced} units reduced


# ==========================================================================
#       POLYMER z-DISPLACEMENT (for cooperative diffusivity D_c)   [ONCE]
# ==========================================================================
# u_z(x): mean polymer z-displacement per x-bin (gap direction). The reference
# configuration is RESET to the start of each production hold inside the loop
# (uncompute/compute), so u_z(x, 0) = 0 at the onset of each Phase-3 relaxation
# — mirroring the compression D_c measurement. With the plates frozen during
# the hold, the boundary displacement stays ~0 and the interior relaxes toward
# the linear shear ramp; D_c (∝ G) is fit from that relaxation.
compute  displace_shear polymer displace/atom
variable uz_shear atom 0.0    # placeholder so 'variable ... delete' is always valid


# ==========================================================================
#                       STRAIN LOOP (incremental shear)
# ==========================================================================
# For each ${strains} value: drive the plates until the cumulative
# gel_strain_cm reaches that target, then freeze the plates and run an
# NSTEPS production hold while recording stress + displacement. The next
# iteration resumes shearing FURTHER from the current (held) state, so the
# gel walks monotonically through the requested strain list.
#
# Epoch note: every fix ave/time and fix ave/chunk below is created right
# before its production 'run ${nsteps}' and removed right after it, i.e. only
# on epoch boundaries (nsteps is an integer multiple of nfreq_stress). This
# avoids the mid-epoch chunk/atom-lock corruption that mid-run unfixes cause.

label strain_loop

print "########################################################"
print "  STRAIN TARGET (cumulative) = ${strains}"
print "########################################################"


# ---------- PHASE 2: incremental shear to ${strains} ----------
fix drive_right  plate_right move linear  0 0  ${vshear}
fix drive_left   plate_left  move linear  0 0  ${neg_vshear}
fix nvt_shear  gel       nvt  temp ${temp_target} ${temp_target} 1.0
fix mom_lin    gel       momentum 100 linear 1 1 1
fix mom_rot    gel       momentum 100 angular

# Columns: step  gel_lz_initial  gel_gap  gel_strain_cm
fix out_shear_strain all print ${stress_freq} &
    "$(step) ${gel_lz_initial} ${gel_gap} $(v_gel_strain_cm)" &
    file output_files/stress_data/shear_strain_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no

# Halt when the cumulative target strain is reached (error continue: run exits
# cleanly and the script proceeds to the production hold).
fix halt_shear all halt ${stress_freq} v_gel_strain_cm >= ${strains} error continue

run ${nsteps_shear}

unfix halt_shear
unfix out_shear_strain
unfix mom_rot
unfix mom_lin
unfix nvt_shear
unfix drive_left
unfix drive_right

print ">>> Reached gel_strain_cm = $(v_gel_strain_cm)  (target ${strains})"


# ---------- Reset displacement reference to THIS production start ----------
# Delete the variable first so the compute it references can be safely replaced;
# the recreated displace/atom captures the current (held) config as u_z(x,0)=0.
variable uz_shear delete
uncompute displace_shear
compute   displace_shear polymer displace/atom
variable  uz_shear atom c_displace_shear[3]


# ---------- PHASE 3: NVT production hold at this strain ----------
fix freeze_right  plate_right move linear 0 0 0
fix freeze_left   plate_left  move linear 0 0 0
fix nvt_prod    gel       nvt  temp ${temp_target} ${temp_target} 1.0
fix mom_prod    gel       momentum 100 linear 1 1 1 angular

dump traj_prod all custom ${dump_freq_prod} &
    traj_files/prod_${dataname}_${interaction}_${nsteps}_g${strains}.lammpstrj &
    id type mol x y z

# -- Box-integrated stress tensors (one row per nfreq block; ~num_stress_curves
#    blocks per hold -> block-to-block scatter gives the stress-strain error bar) --
fix avg_stress_polymer all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_p_xx v_stress_p_yy v_stress_p_zz &
    v_stress_p_xy v_stress_p_zx v_stress_p_yz &
    file output_files/stress_data/stress_tensor_polymer_${dataname}_${interaction}_${nsteps}_g${strains}.dat

fix avg_stress_solvent all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_s_xx v_stress_s_yy v_stress_s_zz &
    v_stress_s_xy v_stress_s_zx v_stress_s_yz &
    file output_files/stress_data/stress_tensor_solvent_${dataname}_${interaction}_${nsteps}_g${strains}.dat

# -- x-profile stress tensors --
fix prof_x_polymer poly_bulk ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_x_polymer &
    v_s_p_xx v_s_p_yy v_s_p_zz v_s_p_xy v_s_p_zx v_s_p_yz &
    norm none &
    file output_files/stress_data/stress_profile_x_polymer_${dataname}_${interaction}_${nsteps}_g${strains}.dat

fix prof_x_solvent solv_bulk ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_x_solvent &
    v_s_s_xx v_s_s_yy v_s_s_zz v_s_s_xy v_s_s_zx v_s_s_yz &
    norm none &
    file output_files/stress_data/stress_profile_x_solvent_${dataname}_${interaction}_${nsteps}_g${strains}.dat

# -- Polymer z-displacement profile u_z(x) (mean per x-bin) for D_c --
fix avg_disp_x_poly poly_bulk ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_x_polymer v_uz_shear &
    file output_files/displacement_data/disp_z_polymer_${dataname}_${interaction}_${nsteps}_g${strains}.dat

# -- Gel / box dimensions, polymer COM --
fix out_gel_dims_rg all print ${stress_freq} &
    "$(step) $(v_gel_lx_rg) $(v_gel_ly_rg) $(v_gel_lz_rg)" &
    file output_files/volume_data/gel_dimensions_rg_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no

fix out_box_dims all print ${stress_freq} &
    "$(step) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no

fix out_polymer_com all print ${stress_freq} &
    "$(step) $(c_polymer_com[1]) $(c_polymer_com[2]) $(c_polymer_com[3])" &
    file output_files/volume_data/polymer_com_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no

print "========================================"
print "Phase 3 production at strain ${strains} (${nsteps} steps, plates frozen)"
print "  gel_strain_cm = $(v_gel_strain_cm)  (= γ for G)"
print "  G(γ) = <sigma_p_zx> / $(v_gel_strain_cm)"
print "========================================"

run ${nsteps}

undump traj_prod
unfix out_polymer_com
unfix out_box_dims
unfix out_gel_dims_rg
unfix avg_disp_x_poly
unfix prof_x_solvent
unfix prof_x_polymer
unfix avg_stress_solvent
unfix avg_stress_polymer
unfix mom_prod
unfix nvt_prod
unfix freeze_left
unfix freeze_right

print ">>> Completed strain ${strains}:  gel_strain_cm = $(v_gel_strain_cm)"

next strains
jump SELF strain_loop


# ==========================================================================
#                            FINAL STATE
# ==========================================================================

print "========================================"
print "Shear slab stress-strain sweep complete"
print "  Final gel_strain_cm: $(v_gel_strain_cm)"
print "  gel_lz_initial: ${gel_lz_initial}  gel_gap: ${gel_gap}"
print "  Final box: $(lx) x $(ly) x $(lz)  xz = $(xz)"
print "========================================"

variable outfile string "final_shear_${dataname}_${interaction}_${nsteps}"
write_data ${outfile}.data
