# ========== Periodic Single-Pressure NPT Equilibration (mix OR pure) ==========
# Generic WCA + FENE periodic NPT engine used by the volume-of-mixing pipeline
# for BOTH the mixed isolated gel AND the pure-polymer reference:
#
#   ΔV_mix = V_mixture − V_pure_polymer − V_pure_solvent   (all NPT volumes)
#
# It integrates the `mobile` group = types 1,2,3, so it self-adapts:
#   * pure-polymer input (types 1,2 only)  → type-3 group empty, runs as before
#   * mixed isolated gel (types 1,2,3)      → solvent moves and equilibrates too
#
# SCIENTIFIC BASIS for the volmix redesign (2026-06):
#   * All three boxes now use IDENTICAL WCA (lj/cut 1.122σ, ε=1). The old
#     attractive-LJ polymer reference (lj/cut 2.5) was the dominant artifact —
#     fixing it cut ΔV_mix/(V_sol+V_pol) ~10× (≈0.20 → ≈0.02).
#   * V_mix is now an NPT box volume measured the SAME way as the references,
#     instead of a geometric bounding box (the two are different kinds of
#     volume and must not be subtracted).
#   * Inputs carry all polymer + all solvent (no trim) → identical atom counts
#     across mix and pure runs → scale factors = 1.
#   * Remaining ΔV_mix (~1–3 %, rising with P*) is physical packing frustration
#     between bonded beads (≈0.97σ) and free beads (1.122σ), retained because
#     matching them would break Kremer–Grest no-chain-crossing.
#
# Structure:
#   Stage 0 — Harmonic pre-relaxation (WCA + harmonic bonds, NVE/limit)
#   Stage 1 — Gentle Langevin NVT     (WCA + FENE, NVE/limit)
#   Stage 2 — NPT production          (single run, block-averaged output)
#
# Atom types:  1 = Crosslink,  2 = Chain bead,  3 = Solvent (mix only)
#
# Outputs:
#   vol_pure_polymer_${dataname}_${interaction}.dat
#     → columns: step  press_mean  vol_mean  rho_mean  (one row per block)
#   output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat
#     → columns: step  lx  ly  lz   ← V_mix / V_pol read from here
#
# Variables passed from bash:
#   dataname     — data file name (no extension)
#   interaction  — epsilon label (e.g. "1.0_1.0" for the mix, "1.0_0.0" pure)
#   epsSS        — WCA epsilon applied to ALL pairs (=1.0 for athermal mixing)
#   nsteps       — NPT run length (divisible by n_blocks * 100)
#   n_blocks     — number of block-average windows (recommend 10)



# ========== Parameters ==========
variable sigma        equal 1.0
variable temp_target  equal 1.0
variable press_target index 1.5 # overridden by -var on command line
variable vel_seed     index 12345  # RNG seed for create_velocity; overridden by -var for replica sweeps
variable tdamp        equal 1.0
variable pdamp        equal 1.0
variable n_blocks     equal 10

variable timestep_gentle equal 0.001
variable timestep_prod   equal 0.005
variable nsteps_gentle   equal 1000

variable thermo_freq   equal 10000
variable volume_freq   equal 10000

variable block_steps   equal ${nsteps}/${n_blocks}
variable nrepeat_block equal ${block_steps}/100



# ========== Initialization ==========
units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

read_data data_files/${dataname}.data

print ">>> polymer_pure(generic): T*=${temp_target} P*=${press_target} eps=${epsSS} nsteps=${nsteps}"

comm_modify cutoff 5.0

# `mobile` = everything we integrate. For a pure-polymer file type 3 is absent,
# so `mobile` == `polymer` and behaviour is unchanged; for the mixed isolated
# gel, solvent (type 3) is included and equilibrates under NPT alongside the
# network.
group polymer type 1 2
group solvent type 3
group mobile  type 1 2 3

variable N_mobile equal count(mobile)
print ">>> N_polymer=$(count(polymer))  N_solvent=$(count(solvent))  N_mobile=${N_mobile}"

thermo_style custom step temp pe ke etotal press vol lx ly lz
thermo ${thermo_freq}



# =====================================================================
#   STAGE 0 — Harmonic pre-relaxation
#
#   The diamond lattice places chain beads by linear interpolation,
#   giving bond lengths of bead_spacing*sqrt(3)/4 (~0.52σ at
#   bead_spacing=1.2) — well below the FENE equilibrium of ~0.96σ.
#   A harmonic spring (r0=0.96σ) under WCA-only non-bonded interactions
#   expands them safely before FENE is activated.
# =====================================================================
pair_style lj/cut 1.122
pair_coeff * * ${epsSS} ${sigma} 1.122

bond_style harmonic
bond_coeff 1 30.0 0.96

special_bonds lj 0.0 1.0 1.0

reset_timestep 0
velocity mobile create 0.01 ${vel_seed} mom yes rot no
fix pre  mobile nve/limit 0.05
fix lang mobile langevin 0.01 0.01 ${tdamp} 904297
timestep ${timestep_gentle}
run 10000
unfix pre
unfix lang

pair_style lj/cut 1.122
pair_coeff * * ${epsSS} ${sigma} 1.122

bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0



# =====================================================================
#   STAGE 1 — Gentle Langevin NVT (ramp T from 0.01 → temp_target)
# =====================================================================
reset_timestep 0
fix gentle mobile nve/limit 0.01
fix lang   mobile langevin 0.01 ${temp_target} ${tdamp} 904297
timestep ${timestep_gentle}
run ${nsteps_gentle}
unfix gentle
unfix lang



# =====================================================================
#   STAGE 2 — NPT production with block averaging
# =====================================================================
variable box_vol     equal lx*ly*lz
variable num_density equal v_N_mobile/v_box_vol
variable inst_press  equal press

reset_timestep 0
fix 1 mobile npt temp ${temp_target} ${temp_target} ${tdamp} &
    iso ${press_target} ${press_target} ${pdamp}
timestep ${timestep_prod}

fix box_out all print ${volume_freq} "$(step) $(lx) $(ly) $(lz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat &
    screen no title "# step lx ly lz"

fix block_avg all ave/time 100 ${nrepeat_block} ${block_steps} &
    v_inst_press v_box_vol v_num_density &
    ave one &
    file vol_pure_polymer_${dataname}_${interaction}.dat &
    title1 "# one row per ${block_steps}-step block" &
    title2 "# step  press_mean  vol_mean  rho_mean"

run ${nsteps}

unfix block_avg
unfix box_out
unfix 1



write_data final_config_pure_polymer_${dataname}_${interaction}.data
print ">>> Done. Output: vol_pure_polymer_${dataname}_${interaction}.dat"
