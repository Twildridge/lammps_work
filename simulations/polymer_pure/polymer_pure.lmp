# ========== Periodic Single-Pressure NPT Equilibration (mix OR pure) ==========
# Generic WCA + FENE periodic NPT engine used by the volume-of-mixing pipeline
# for BOTH the mixed isolated gel AND the pure-polymer reference:
#
#   ΔV_mix = V_mixture − V_pure_polymer − V_pure_solvent   (all NPT volumes)
#
# It integrates the `mobile` group = types 1,2,3, so it self-adapts:
#   * pure-polymer input (types 1,2 only)  → type-3 group empty, runs as before
#   * mixed isolated gel (types 1,2,3)      → solvent moves and equilibrates too
#
# SCIENTIFIC BASIS for the volmix redesign (2026-06):
#   * All three boxes now use IDENTICAL WCA (lj/cut 1.122σ, ε=1). The old
#     attractive-LJ polymer reference (lj/cut 2.5) was the dominant artifact —
#     fixing it cut ΔV_mix/(V_sol+V_pol) ~10× (≈0.20 → ≈0.02).
#   * V_mix is now an NPT box volume measured the SAME way as the references,
#     instead of a geometric bounding box (the two are different kinds of
#     volume and must not be subtracted).
#   * Inputs carry all polymer + all solvent (no trim) → identical atom counts
#     across mix and pure runs → scale factors = 1.
#   * Remaining ΔV_mix (~1–3 %, rising with P*) is physical packing frustration
#     between bonded beads (≈0.97σ) and free beads (1.122σ), retained because
#     matching them would break Kremer–Grest no-chain-crossing.
#
# Structure:
#   Stage 0 — Harmonic pre-relaxation (WCA + harmonic bonds, NVE/limit)
#   Stage 1 — Gentle Langevin NVT     (WCA + FENE, NVE/limit)
#   Stage 2 — NPT production          (single run, block-averaged output)
#
# Atom types:  1 = Crosslink,  2 = Chain bead,  3 = Solvent (mix only)
#
# CALIBRATION-SWEEP UPDATE (2026-08): the barostat is now ANISO (was iso) —
# lx, ly, lz relax independently so residual normal-stress anisotropy from the
# generator/isolation relaxes out instead of freezing into the aspect ratio.
# CONVERGENCE GATE (checked in calibration_analysis.ipynb, NOT enforced here):
# production averages are only valid if Pxx≈Pyy≈Pzz within CI and the aspect
# ratio is stable over the averaged window. Off-diagonal stresses (Pxy,Pxz,Pyz)
# are logged and flagged only — no silent switch to a triclinic barostat.
#
# Outputs:
#   vol_pure_polymer_${dataname}_${interaction}.dat
#     → columns: step  press_mean  vol_mean  rho_mean  (one row per block)
#   output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat
#     → columns: step  lx  ly  lz   ← V_mix / V_pol read from here
#   output_files/volume_data/pressure_tensor_${dataname}_${interaction}_${totsteps}.dat
#     → columns: step  pxx pyy pzz pxy pxz pyz  (window-averaged, aniso gate input)
#   traj_files/calib_${dataname}_${interaction}_${totsteps}.lammpstrj
#     → calib_frames+1 all-atom frames near the end (Voronoi input; Python-
#       side tessellation only — NO Voronoi computes in any .lmp)
#
# Variables passed from bash:
#   dataname     — data file name (no extension)
#   interaction  — epsilon label (e.g. "1.0_1.0" for the mix, "1.0_0.0" pure)
#   epsSS        — WCA epsilon applied to ALL pairs (=1.0 for athermal mixing)
#   nsteps       — NPT run length (divisible by n_blocks * 100)
#   n_blocks     — number of block-average windows (recommend 10)



# ========== Parameters ==========
variable sigma        equal 1.0
variable temp_target  equal 1.0
variable press_target index 1.5 # overridden by -var on command line
variable vel_seed     index 12345  # RNG seed for create_velocity; overridden by -var for replica sweeps
variable tdamp        equal 1.0
variable pdamp        equal 1.0
variable n_blocks     equal 10

variable timestep_gentle equal 0.001
variable timestep_prod   equal 0.005
variable nsteps_gentle   equal 1000

variable thermo_freq   equal 10000
variable volume_freq   equal 10000

# Calibration dump: a few decorrelated all-atom frames appended AFTER the
# production run (barostat still on), ~calib_dump_every*dt/tau apart.
# Driver-configurable via -var; index → command line wins.
variable calib_frames     index 5
variable calib_dump_every index 2000

variable block_steps   equal ${nsteps}/${n_blocks}
variable nrepeat_block equal ${block_steps}/100

# ----- Continuation flag -----
# 0 = fresh start (default)
# 1 = continuation from a final .data file (via continue_sim.sh). The data
#     file already holds a relaxed, thermalized (FENE) polymer/mix — Stage 0
#     (harmonic pre-relax) and Stage 1 (gentle Langevin ramp) are skipped
#     entirely and Stage 2 (NPT production) just runs ${nsteps} more steps.
#     The FENE pair/bond settings are always reissued regardless (settings
#     aren't stored in the data file).
variable cont index 0

# ----- Pre-relaxed-coordinates flag -----
# 0 = coordinates come from the diamond-lattice builder (default): bonds are
#     at ~0.52σ and need Stage 0's harmonic expansion before FENE is safe.
# 1 = coordinates come from an already-equilibrated FENE configuration that
#     carries NO Velocities section — e.g. the isolated_* files produced by
#     isolate_gel.py for the calibration sweep. Bonds are already at FENE
#     scale, so Stage 0's harmonic pre-relax is skipped, but velocities are
#     still seeded from ${vel_seed} and Stage 1's gentle ramp still runs, so
#     the run follows exactly the same path a fresh one does from that point.
#
# Distinct from cont=1, which additionally assumes the data file HAS
# velocities and so skips the seeding and Stage 1 as well. Setting cont=1 on a
# velocity-less file would start every replica from rest with identical
# initial conditions, collapsing the NREPS replica average.
variable prerelaxed index 0


# ========== Initialization ==========
units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

read_data data_files/${dataname}.data

print ">>> polymer_pure(generic): T*=${temp_target} P*=${press_target} eps=${epsSS} nsteps=${nsteps}"

comm_modify cutoff 5.0

# `mobile` = everything we integrate. For a pure-polymer file type 3 is absent,
# so `mobile` == `polymer` and behaviour is unchanged; for the mixed isolated
# gel, solvent (type 3) is included and equilibrates under NPT alongside the
# network.
group polymer type 1 2
group solvent type 3
group mobile  type 1 2 3

variable N_mobile equal count(mobile)
print ">>> N_polymer=$(count(polymer))  N_solvent=$(count(solvent))  N_mobile=${N_mobile}"

thermo_style custom step temp pe ke etotal press vol lx ly lz
thermo ${thermo_freq}

# Bonded-neighbour pair exclusions. Set once, before any branch, so all three
# entry paths (fresh, prerelaxed, cont) use identical exclusions. This used to
# live inside Stage 0, which meant cont=1 runs silently fell back to LAMMPS's
# 0 0 0 default and dropped the 1-3/1-4 pair interactions a fresh run keeps.
special_bonds lj 0.0 1.0 1.0

# cont=1: the continued data file already holds beads at a safe (FENE-scale)
# separation AND its own velocities — skip the seeding and the pre-relax both.
if "${cont} == 1" then "jump SELF label_skip_stage0"

# Seed velocities on every non-continuation path. The data file carries no
# Velocities section in either case, and this is the ONLY per-replica
# difference in a calibration sweep, so it must happen whether or not the
# harmonic pre-relax below is needed.
reset_timestep 0
velocity mobile create 0.01 ${vel_seed} mom yes rot no

# prerelaxed=1: bonds already sit at FENE scale, so the harmonic expansion is
# not just unnecessary but actively wrong — it re-relaxes an equilibrated
# network under a different bond style.
if "${prerelaxed} == 1" then "jump SELF label_skip_stage0"

# =====================================================================
#   STAGE 0 — Harmonic pre-relaxation
#
#   The diamond lattice places chain beads by linear interpolation,
#   giving bond lengths of bead_spacing*sqrt(3)/4 (~0.52σ at
#   bead_spacing=1.2) — well below the FENE equilibrium of ~0.96σ.
#   A harmonic spring (r0=0.96σ) under WCA-only non-bonded interactions
#   expands them safely before FENE is activated.
# =====================================================================
pair_style lj/cut 1.122
pair_coeff * * ${epsSS} ${sigma} 1.122

bond_style harmonic
bond_coeff 1 30.0 0.96

fix pre  mobile nve/limit 0.05
fix lang mobile langevin 0.01 0.01 ${tdamp} 904297
timestep ${timestep_gentle}
run 10000
unfix pre
unfix lang

label label_skip_stage0

# Always reissue the FENE pair/bond settings — not stored in the data file,
# and needed whether Stage 0 ran or was skipped.
pair_style lj/cut 1.122
pair_coeff * * ${epsSS} ${sigma} 1.122

bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0

# cont=1: the continued data file already holds beads thermalized at
# temp_target — skip the gentle ramp entirely.
if "${cont} == 1" then "jump SELF label_skip_stage1"

# =====================================================================
#   STAGE 1 — Gentle Langevin NVT (ramp T from 0.01 → temp_target)
# =====================================================================
reset_timestep 0
fix gentle mobile nve/limit 0.01
fix lang   mobile langevin 0.01 ${temp_target} ${tdamp} 904297
timestep ${timestep_gentle}
run ${nsteps_gentle}
unfix gentle
unfix lang

label label_skip_stage1

# =====================================================================
#   STAGE 2 — NPT production with block averaging
# =====================================================================
variable box_vol     equal lx*ly*lz
variable num_density equal v_N_mobile/v_box_vol
variable inst_press  equal press

reset_timestep 0
# aniso (2026-08): lx, ly, lz couple to Pxx, Pyy, Pzz independently — see the
# convergence-gate note in the header. Box stays orthogonal.
fix 1 mobile npt temp ${temp_target} ${temp_target} ${tdamp} &
    aniso ${press_target} ${press_target} ${pdamp}
timestep ${timestep_prod}

fix box_out all print ${volume_freq} "$(step) $(lx) $(ly) $(lz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat &
    screen no title "# step lx ly lz"

# Full pressure tensor, window-averaged every volume_freq steps — input for
# the analysis-side aniso gate (Pxx≈Pyy≈Pzz; off-diagonals flagged only).
variable nrepeat_ptens equal ${volume_freq}/100
fix ptens_out all ave/time 100 ${nrepeat_ptens} ${volume_freq} &
    c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] &
    c_thermo_press[4] c_thermo_press[5] c_thermo_press[6] &
    file output_files/volume_data/pressure_tensor_${dataname}_${interaction}_${totsteps}.dat &
    title1 "# window-averaged pressure tensor, one row per ${volume_freq} steps" &
    title2 "# step  pxx  pyy  pzz  pxy  pxz  pyz"

fix block_avg all ave/time 100 ${nrepeat_block} ${block_steps} &
    v_inst_press v_box_vol v_num_density &
    ave one &
    file vol_pure_polymer_${dataname}_${interaction}.dat &
    title1 "# one row per ${block_steps}-step block" &
    title2 "# step  press_mean  vol_mean  rho_mean"

run ${nsteps}

unfix block_avg

# ----- Calibration dump: all-atom frames near the end -----
# Writes calib_frames+1 frames: the production-end frame (run start is a
# multiple of the dump interval) plus calib_frames more, calib_dump_every
# steps apart for decorrelation. Barostat (and box_out/ptens_out) stay on —
# these extra steps are equilibrium NPT sampling. Voronoi runs Python-side on
# these frames (lib/volfrac.py) — never in the engine.
variable calib_dump_steps equal v_calib_frames*v_calib_dump_every
shell mkdir -p traj_files
dump calib_dump all custom ${calib_dump_every} &
    traj_files/calib_${dataname}_${interaction}_${totsteps}.lammpstrj id type x y z
run ${calib_dump_steps}
undump calib_dump

unfix ptens_out
unfix box_out
unfix 1



variable outfile string "purepol_${dataname}_${interaction}_${totsteps}"
write_data ${outfile}.data
print ">>> Done. Output: vol_pure_polymer_${dataname}_${interaction}.dat"
