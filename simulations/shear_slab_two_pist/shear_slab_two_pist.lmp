# ===== Shear Modulus, ISOLATED gel in a two-piston bath, displacement-driven xz shear  (2026-10-13; grip plates 2026-10-14) =====
# SHEAR MODE ONLY, on a gel that is NOT periodic in any direction: a finite block
# (the tall 9 x 9 x 21-cell gel equilibrated free in its bath by slab_with_support,
# BARO_MODE=iso) floating in a solvent bath that the two wet NPT-pistons of the
# compression decks hold at P_target.  The laterally periodic version of this deck
# (gel spanning x and y, z-face layers driven +/-x) is kept next to it as
# shear_slab_two_pist_periodic.lmp (run with DECK_FILE=shear_slab_two_pist_periodic,
# see shear_slab_two_pist_periodic.batch); this file is what shear_slab_two_pist.batch runs.
#
# WHY: the periodic slab's G (~0.2) is 5x the compression sweep's G (~0.04) and one
# suspicion is that the laterally periodic sheared membrane overstates G (an earlier
# non-periodic cube gave a small G).  Here the sheared faces are the gel's LEFT and
# RIGHT x-faces -- its LONG sides (the gel is ~2.2x taller in z than wide in x) --
# driven DOWN (-z, left) and UP (+z, right), so the shear direction is the gel's long
# axis and the free top / bottom (z) faces are far from the measurement core.
#
#   AXES OF THIS DECK:  x = GAP direction (between the two driven faces),
#                       z = SHEAR direction (the long axis of the gel),  y = neutral.
#   This is the transpose of shear_slab.lmp / shear_slab_two_pist_periodic.lmp (z gap,
#   x shear).  The measured component is the same sigma_xz (symmetric), gamma_xz > 0
#   when the right face moves +z.  lib/shear.py reads these files with
#   DECK = "shear_slab_two_pist_iso": it relabels x <-> z at read time (file names
#   stress_profile_x_* / disp_z_polymer_* -> the notebooks' "z"/"u_x" frame).
#
# Input: <stem>_x_plates.data from scripts/lib/add_more_plates_to_gel.py
#   (lib/add_more_plates_to_gel.py, layout = x_plates): the CONVERTER of an equilibrated
#   ISOLATED-gel snapshot -- gel made whole and centred, bath cropped to bath_margin_xy /
#   reservoir_z, two full-width wet pistons (types 5 feed above, 6 permeate below) with
#   vacuum margins, and TWO solvent-transparent GRIP PLATES (types 8 x-lo, 9 x-hi) PARKED
#   plate_park_gap (3 sigma) outside the gel's x bounding-box faces.  This deck SEATS the
#   two plates onto the gel's x-faces (Phase 1.25, compress_slab's seating) and drives
#   them -/+z: plate + the polymer layer it rests on = one rigid grip.  Any OTHER load
#   plate in the file (a six_plates file: types 4, 7, 10, 11) is deleted right after
#   read_data (delete_atoms, IDs kept), so the compress_slab input works here too.
# Variables from run_lammps.sh: dataname, interaction, epsSS, epsSP, nsteps,
#   strains (+ strains_list), press_target, piston_mass, c_pist_frac,
#   npt_piston_steps, settle_halt, wall_timeout.  No cont / continue_sim.sh support
#   (as every two-piston deck): a sweep that outruns the SLURM wall time ends CLEANLY
#   instead -- `timer timeout` (wall_timeout, below) stops the run in flight, the
#   sweep loop exits (the remaining levels are not started) and the final write_data
#   still happens; the level in flight is truncated (its files stop early: drop it
#   from STRAINS in the notebook, the finished levels are intact).
# Optional -var overrides (index-style knobs; short local smoke test e.g.
#    -var phase0_steps 200 -var npt_piston_steps 400 -var min_iter 50 -var ref_avg_steps 400
#    -var ref_nfreq 200 -var series_freq 100 -var stress_freq 100 -var nsteps_shear_base 3000
#    -var nsteps_shear 6000 -var num_dump_frames 1 -var strains 0.005 0.01 -var nsteps 2000):
#   phase0_steps, npt_piston_steps, min_iter, ref_avg_steps, ref_nfreq, series_freq,
#   stress_freq, thermo_freq, nsteps_shear_base, nsteps_shear, layer_thick,
#   track_thick, core_margin_y, core_margin_z, pin_gel_every, num_dump_frames,
#   seat_mode (rg|bb), t_seat, seat_settle_steps
#
# Atom types (the converter's fixed table): 1=crosslink, 2=chain bead, 3=solvent, 5=feed
#   piston, 6=permeate piston, 8=plate x-lo (LEFT grip), 9=plate x-hi (RIGHT grip);
#   4, 7, 10, 11 = compress_slab's other load plates (deleted here if present).
#
# GEOMETRY (z from bottom to top; boundary p p p -- the BATH is periodic in x and y,
# the GEL touches nothing; box orthogonal and never changed):
#       vacuum | permeate piston (P_target, pushes UP) | bath (reservoir_z below the gel)
#       | GEL (bath_margin_xy + 3 sigma of bath on every side in x, y; its periodic
#       image is >= 2 x 15 sigma of bath away) | bath (reservoir_z above) |
#       feed piston (P_target, pushes DOWN) | vacuum
#   The two pistons close ONE connected bath; both at P_target they are redundant
#   and harmless (P_feed_meas = P_perm_meas = the bath pressure, logged).
#
# GRIPS = PLATE + the polymer layer it is seated on (static groups, fixed bead sets, defined
# after the seating):
#   grip_l = plate_l (type 8) + poly_l = polymer with x <  x_face_l + layer_thick
#   grip_r = plate_r (type 9) + poly_r = polymer with x >  x_face_r - layer_thick
#   where x_face_l/r = the plate's SEAT PLANE = plate x +/- contact_gap (the Rg x-face it was
#   seated on, seat_mode rg; or the outermost bead, seat_mode bb).  The plates are
#   solvent-TRANSPARENT (pair 3-8 / 3-9 off, as compress_slab's plates), so solvent drains
#   through the gripped faces and nothing is trapped between plate and gel.  A grip is
#   RIGID IN ALL THREE DIRECTIONS (fix setforce 0 0 0 + velocity set; fix nve only
#   integrates the prescribed velocity; no thermostat on it):
#       velocity set 0 0 +/-vshear   -- drive: uniform z-translation, +z right, -z left
#       velocity set 0 0 0           -- hold / reference: the grip is frozen where it is
#   The plate is a hard WCA wall for the polymer beyond the seat plane (the rough outer
#   shell the seating folded in) and, carried with the layer, it holds the gel's x-width;
#   the layer beads bonded into the network transmit the shear.  (Equivalent to a plate
#   perfectly bonded to the face layer; no bonds are added.)
#   WHY fully rigid and not "free along the gap" as in the periodic deck: a finite
#   block gripped on two opposite faces has a RIGID-ROTATION mode about y (dz = -theta x,
#   dx = +theta z) that reproduces the prescribed +/-dz of the two faces EXACTLY with
#   zero strain and zero stress if the grips may slide in x.  The periodic network
#   cannot rotate; this one can, so the grips' x (and y) must be held too.  Fixing
#   the layers in x also pins the gel's x-width at its settled, bath-equilibrated
#   value; y and z faces stay free (bath at P_target).  The constraint force the
#   layers take up is logged in every component: its z part / face area is the shear
#   traction (S_r, S_l = sigma_xz at each grip), its x part / face area the normal
#   traction the grips carry (N_r, N_l; the Poynting-type normal stress and any x
#   swelling drive -- expected small).
#   N_* are the NET x-forces (polymer + solvent); Np_* in plate_pressure_* are the
#   polymer-only x-forces on the plates (compress_slab's seated preload).
#   Before the grips exist (Phase 0, the piston settle and the seating) the free gel is
#   kept from drifting and turning by fix momentum on the polymer (linear + angular, every
#   pin_gel_every steps -- the PIN_GEL of the slab_with_support isolated runs).
#
# MEASUREMENT CORE (the "bulk" of the periodic deck, now a 3-D block inside the gel):
#   x in [x_face_l + plate_excl, x_face_r - plate_excl]   (plate_excl = layer_thick + track_thick:
#                                                          the grips and the tracking slabs are excluded)
#   y in [y_face_lo + core_margin_y, y_face_hi - core_margin_y]   (free y faces: surface layer excluded)
#   z in [z_face_lo + core_margin_z, z_face_hi - core_margin_z]   (free z faces: sigma_xz MUST vanish on a
#        free surface, so near the top / bottom the shear stress ramps down over ~W/2 -- the
#        Saint-Venant end zone of a gripped block of width W; core_margin_z default 20 sigma
#        excludes it on a 52 x 115 gel.  stress_profile_z_* (sigma binned ALONG z inside the
#        core x, y window) shows the end zones so the margin can be judged in the notebook.)
#   All faces are the Rg-based faces of the settled configuration (frozen numbers).
#   Bulk stresses = sum of stress/atom over the DYNAMIC groups in the core / core volume.
#   Profiles along x (the gap) bin the atoms inside the core y, z window over the WHOLE
#   box length (reduced x/lx, bin volume = core_area_yz * binWidth): the gel bins, the
#   grip layers (stress ramp) and the bath beyond the faces (solvent only, p_pore) are
#   all seen, like the whole-box z-profiles of the periodic deck.
#
# STRAIN DEFINITIONS (relative z-displacement of two material planes over the x-distance
#   between them):
#   gamma     = (z_drv_r - z_drv_l - z_drv0) / W_drv   -- driven-layer COMs, the PRESCRIBED
#               strain: the halt watches it (shear_strain_* column 4, W_drv in column 3)
#   gamma_trk = (z_trk_r - z_trk_l - z_trk0) / W_trk   -- two static TRACKING slabs of polymer
#               (track_thick thick) just inside the grips, where the stress is already
#               uniform: the strain the INTERIOR carries (shear_strain_surface_* column 3,
#               stress_series column 12)
#   The notebooks divide G by the NETWORK strain = the interior slope du_z/dx of the steady
#   cumulative displacement profile (disp_z_polymer_cum), as the periodic deck.
#
# Behaviour:
#   - Phase 0:   read, delete any extra plates, brief minimize + short Langevin NVT, pistons and
#                grip plates frozen, gel pinned.
#   - Phase 1:   NPT-PISTON SETTLE of both wet pistons at P_target (the compression deck's
#                Phase 1, verbatim).  The wet pistons stay live to the end.
#   - Phase 1.25: SEATING: the two grip plates travel over t_seat to contact_gap short of the
#                gel x-face they load (seat_mode rg = the Rg face, bb = the outermost bead),
#                then seat_settle_steps with the plates fixed (Langevin).  The grips are
#                defined from the seated plates; the plate x-forces are the seated preload.
#   - Phase 1.5: gamma = 0 REFERENCE window (_ref files), grips frozen at their seated positions.
#   - Phase 2/3: STRAIN SWEEP over ${strains} (cumulative).  For each target:
#                  2. DRIVE -- layers translate at -/+vshear (left -z, right +z) until gamma >= target (fix halt);
#                  3. HOLD  -- layers frozen, gel NVT for nsteps; the relaxed shear stress is MEASURED.
#                G = <sigma_xz>_core / gamma_network
#   (No unload phase: the run ends in the last level's held state.)
#
# Recorded observables -- the shear_slab_two_pist set with the axes renamed where they matter
# (${stem} = ${dataname}_${interaction}_${nsteps}; levels tagged _g<strain>):
#   stress_data/stress_tensor_{polymer,solvent}_${stem}_g<γ>.dat   core 6-component stress, one row per nfreq block
#   stress_data/stress_series_${stem}_g<γ>.dat          fine block averages: sp_xx sp_yy sp_zz sp_xz ss_xx ss_yy ss_zz ss_xz S_r S_l gamma_trk
#                                                       (S_* = constraint z-force on a grip layer / face area) over drive + hold
#   stress_data/stress_profile_x_{polymer,solvent}_${stem}_g<γ>.dat   stress binned ALONG x (the gap; reduced x/lx) inside the core y,z window
#   stress_data/stress_profile_z_{polymer,solvent}_${stem}_g<γ>.dat   stress binned ALONG z (the shear direction; reduced z/lz) inside the core x,y window -- END-ZONE DIAGNOSTIC
#   stress_data/shear_strain_${stem}_g<γ>.dat           step  gel_lx_initial  W_drv  gamma        (drive + hold)
#   stress_data/shear_strain_surface_${stem}_g<γ>.dat   step  gel_gap_bb  gamma_trk  W_trk
#   displacement_data/disp_z_polymer_${stem}_g<γ>.dat   x-binned mean polymer u_z (core y,z window), reference RESET at each hold onset (for D_c)
#   displacement_data/disp_z_polymer_cum_${stem}_g<γ>.dat   the same, CUMULATIVE since the gamma = 0 reference: its interior slope
#                                                       is the network strain G divides by (+ _cum_ref_${stem}: its zero)
#   volume_data/{gel_volume_bb,gel_dimensions_bb,gel_volume_rg,gel_dimensions_rg,box_dimensions,polymer_com}_${stem}_g<γ>.dat
# gamma = 0 REFERENCE (Phase 1.5): the stress / profile / disp_cum files above with the tag _ref_${stem}.
# Whole-run (stem only, from step 0):
#   volume_data/{box_dimensions,box_bounds,gel_dimensions_rg,gel_volume_rg,gel_volume_bb}_${stem}.dat
#   stress_data/shear_strain_${stem}.dat                (from the reference on)
#   stress_data/shear_strain_rg_${stem}.dat             step Rg_xx^2 Rg_xz  (Rg-based shear strain: z -> z + gamma x changes Rg_xz by gamma Rg_xx^2)
#   piston_data/plate_pressure_${stem}.dat              step x_face_r x_face_l P_feed P_perm S_r S_l N_r N_l Np_r Np_l
#                                                       (x_face_* = the plates' seat planes, live from step 0: the seating travel is in the file)
#                                                       (gel Rg x-faces; wet-piston pressures; grip shear tractions; grip normal tractions)
#   piston_data/piston_pressure_${stem}.dat, piston_position_run_${stem}.dat   (as the compression deck; no load piston -> z_load = 0)


# ==========================================================================
#                              PARAMETERS
# ==========================================================================

# ----- Physical Parameters -----
variable sigma         equal 1.0
variable temp_target   equal 1.0
variable press_target  index 1.5          # bath pressure P*; run_lammps.sh passes -var press_target
variable P_target      equal ${press_target}
variable timestep_prod equal 0.005
variable min_iter      index 1000

# ----- NPT-piston knobs (as triaxial_compression_two_pist.lmp) -----
variable piston_mass      index 1000.0    # per bead, applied with `mass 5/6` after read_data
variable K_solv           index 10.0      # solvent bulk modulus for the damping estimate
variable c_pist_frac      index 1.0       # C_pist = c_pist_frac * C_crit
variable npt_piston_steps index 1000000   # Phase-1 settle length
variable two_pi           equal 6.283185307179586
variable settle_halt      index 0
variable settle_tol_v     equal 1.0e-4
variable settle_tol_z     equal 0.05
variable settle_min_steps equal 200000
variable phase0_steps     index 50000
variable box_guard_gap    equal 2.0       # halt if a wet piston face comes this close to a box face
variable pin_gel_every    index 100       # free-gel pin (Phase 0, settle, seating): polymer linear + angular momentum zeroed every N steps

# ----- Wall-clock budget (2026-10-19, for the strain sweep; as slab_with_support.lmp) -----
# wall_timeout = seconds LAMMPS may run, counted from the `timer timeout` command below
# (start-up), 0 = unlimited.  run_lammps.sh sets it from the SLURM job's remaining time
# minus WALL_MARGIN (40 min).  LAMMPS checks the clock every wall_check_every steps
# COUNTED WITHIN EACH RUN (a run shorter than that is never checked; every production
# run here is >= 26 k steps).  When it fires the run in flight returns early ("WARNING:
# Wall time limit reached", timeremain = 0), the strain loop below exits at the end of
# that level (label sweep_cut) and the deck runs through to its final write_data.
variable wall_timeout     index 0
variable wall_check_every index 1000

# ----- Phase 1.25: seating of the two grip plates (compress_slab's seating, x only) -----
variable contact_gap       equal 1.12     # a plate stops this far (= WCA cutoff) short of the gel face it seats on
variable seat_mode         index rg       # rg: the Rg-based x-face (com +/- L_rg/2; the outer shell is folded in, default)
                                          # bb: the outermost polymer bead of each x-face
variable t_seat            index 100000   # common approach time of both plates (steps)
variable seat_settle_steps index 200000   # plates fixed, Langevin, before the grips are defined

# ---- STRAIN SWEEP: cumulative shear-strain targets (as shear_slab.lmp) --------
# `strains` is an index-style variable supplied by run_lammps.sh as
#   -var strains 0.1 0.15 ...     (shear_slab_two_pist.batch: STRAINS_LIST=(...)).
# CUMULATIVE: each level shears FURTHER from the held state.
variable strains      index 0.10
variable strains_list index "STALE-run_lammps.sh--no-list-passed--running-single-default-only"

# ----- Shear Phase 2 (STRAIN-CONTROLLED drive; shear_slab.lmp's speed law) -----
#   vshear = 1.1 * strain_rate_ref * W_drv / (2 * nsteps_shear_base * dt)   per layer
variable strain_rate_ref   equal 0.10
variable nsteps_shear_base index 285000   # steps a 0.10 increment would take at vshear/1.1
variable nsteps_shear      index 570000   # safety cap per increment (2x); the halt fires first

# ----- Driven layers (grips), strain-tracking slabs, measurement core -----
variable layer_thick   index 3.0    # grip: polymer within this depth of each Rg x-face (plus everything beyond the face)
variable track_thick   index 2.0    # tracking slab just inside each grip (strain numerator)
variable core_margin_y index 6.0    # core stops this far inside each free y face (Rg)
variable core_margin_z index 20.0   # core stops this far inside each free z face (Rg): the sigma_xz end zones (~W/2)

# ----- Output Frequencies -----
variable thermo_freq index 250000
variable stress_freq index 1000     # fix print cadence (strain, gel/box dims, COM)
variable volume_freq index 5000     # piston logs

# ----- Phase 1.5: gamma = 0 REFERENCE window -----
variable ref_avg_steps index 150000
variable ref_nevery    equal 100
variable ref_nfreq     index 10000
variable ref_nrepeat   equal v_ref_nfreq/v_ref_nevery

# ----- Fine block-averaged core stress series -----
variable series_freq    index 5000
variable series_nevery  equal 50
variable series_nrepeat equal floor(v_series_freq/v_series_nevery)
variable series_nfreq   equal v_series_nevery*v_series_nrepeat

# ----- Trajectory dump frame budget -----
variable num_dump_frames index 30
variable dump_freq_prod  equal floor(${nsteps}/v_num_dump_frames)
variable setup_span      equal v_phase0_steps+v_npt_piston_steps+v_t_seat+v_seat_settle_steps+v_ref_avg_steps
variable dump_freq_setup equal floor(v_setup_span/v_num_dump_frames)

# ----- Time Averaging (stress): nfreq = nevery * nrepeat, ~num_stress_curves blocks per hold -----
variable num_stress_curves equal 10
variable nevery_target     equal 100
variable nrepeat_max       equal 2000
variable nrepeat_min       equal 50
variable nfreq_raw    equal floor(${nsteps}/v_num_stress_curves)
variable nrepeat_raw  equal floor(v_nfreq_raw/v_nevery_target)
variable nr_lo equal (v_nrepeat_raw>v_nrepeat_min)*v_nrepeat_raw+(v_nrepeat_raw<=v_nrepeat_min)*v_nrepeat_min
variable nrepeat_stress equal (v_nr_lo<v_nrepeat_max)*v_nr_lo+(v_nr_lo>=v_nrepeat_max)*v_nrepeat_max
variable nevery_stress equal floor(v_nfreq_raw/v_nrepeat_stress)
variable nfreq_stress  equal v_nevery_stress*v_nrepeat_stress
print ">>> Stress averaging: nevery=${nevery_stress}  nrepeat=${nrepeat_stress}  nfreq=${nfreq_stress}"
print ">>> Mode: SHEAR, ISOLATED GEL in a two-piston bath (grip plates seated on the x-faces, driven -/+z; wet pistons hold the bath at P_target)"

# ----- Spatial Binning -----
variable binWidth   equal 2.0   # bin width (sigma) along x (gap profiles) and z (end-zone profiles); lib/shear.py Config.binWidth
variable plate_excl equal v_layer_thick+v_track_thick   # core starts this far inside each Rg x-face (grip + tracking slab)


# ==========================================================================
#                           INITIALIZATION
# ==========================================================================

units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

pair_style lj/cut 1.122
bond_style fene      # plain fene (no hybrid): the per-atom bond virial is tallied correctly with /omp

# Arm the wall-clock budget here so the read / minimize / settle are charged against it.
if "${wall_timeout} > 0" then "timer timeout ${wall_timeout} every ${wall_check_every}"

read_data data_files/${dataname}.data nocoeff

mass 5 ${piston_mass}
mass 6 ${piston_mass}

comm_modify cutoff 5.0

print "========================================"
print "Shear, ISOLATED gel (grip plates seated on the x-faces, driven -/+z), two-piston bath: ${dataname}"
print "Interaction: epsSS=${epsSS}, epsSP=${epsSP}"
print "P_target=${P_target}  piston_mass=${piston_mass}  c_pist_frac=${c_pist_frac}  settle=${npt_piston_steps}"
print "Hold steps per strain level: ${nsteps};  first strain target = ${strains}"
print "========================================"


# ==========================================================================
#        GROUP DEFINITIONS + DELETION OF ANY LOAD PLATE THAT IS NOT A GRIP PLATE
# ==========================================================================
variable n_types equal extract_setting(ntypes)
if "${n_types} < 9" then &
    "print 'ERROR: the data file has only ${n_types} atom types -- no grip plates (types 8, 9). Convert with add_more_plates_to_gel layout = x_plates.'" &
    "quit 1"
group polymer     type 1 2
group solvent     type 3
group piston_feed type 5
group piston_perm type 6
group plate_l     type 8          # grip plate on the gel's x-lo (LEFT) face
group plate_r     type 9          # grip plate on the gel's x-hi (RIGHT) face
group plates      union plate_l plate_r
group mobile      type 1 2 3
group gel_system  type 1 2 3 5 6 8 9

# compress_slab's other load plates (a six_plates file) are not used here: delete them,
# keeping the atom IDs of everything else (compress no) so dumps and the data file agree.
if "${n_types} >= 11" then &
    "group plates_extra type 4 7 10 11" &
else &
    "group plates_extra type 4 7"
variable N_extra equal count(plates_extra)
print ">>> other load plates in the file (types 4, 7, 10, 11): ${N_extra} beads -> deleted (IDs kept)"
delete_atoms group plates_extra compress no
group plates_extra delete

variable N_feed equal count(piston_feed)
variable N_perm equal count(piston_perm)
variable N_pl_l equal count(plate_l)
variable N_pl_r equal count(plate_r)
if "${N_pl_l} == 0 || ${N_pl_r} == 0" then &
    "print 'ERROR: grip plates missing (type 8: ${N_pl_l} beads, type 9: ${N_pl_r} beads). Convert with add_more_plates_to_gel layout = x_plates.'" &
    "quit 1"
print ">>> sheets: feed ${N_feed}  permeate ${N_perm};  grip plates: left ${N_pl_l}  right ${N_pl_r};  atoms now $(atoms)"


# ==========================================================================
#                       INTERATOMIC POTENTIALS  (the compression deck's table)
# ==========================================================================
pair_coeff * * 1.0 ${sigma} 1.122
pair_coeff 1 3 ${epsSP} ${sigma} 1.122
pair_coeff 2 3 ${epsSP} ${sigma} 1.122
pair_coeff 3 3 ${epsSS} ${sigma} 1.122
pair_coeff 1 5 1.0 ${sigma} 1.122         # polymer-wet pistons: WCA (the gel never reaches them)
pair_coeff 2 5 1.0 ${sigma} 1.122
pair_coeff 1 6 1.0 ${sigma} 1.122
pair_coeff 2 6 1.0 ${sigma} 1.122
pair_coeff 3 5 1.0 ${sigma} 1.122         # solvent-wet pistons: ALWAYS ON
pair_coeff 3 6 1.0 ${sigma} 1.122
pair_coeff 5 5 0.0 ${sigma} 0.0
pair_coeff 5 6 0.0 ${sigma} 0.0
pair_coeff 6 6 0.0 ${sigma} 0.0
# grip plates: WCA wall for the polymer (* * above), TRANSPARENT to solvent (compress_slab's
# plates: the gel drains through the gripped faces), nothing between walls
pair_coeff 3 8 0.0 ${sigma} 0.0
pair_coeff 3 9 0.0 ${sigma} 0.0
pair_coeff 5 8 0.0 ${sigma} 0.0
pair_coeff 5 9 0.0 ${sigma} 0.0
pair_coeff 6 8 0.0 ${sigma} 0.0
pair_coeff 6 9 0.0 ${sigma} 0.0
pair_coeff 8 8 0.0 ${sigma} 0.0
pair_coeff 8 9 0.0 ${sigma} 0.0
pair_coeff 9 9 0.0 ${sigma} 0.0

bond_coeff * 30.0 1.5 1.0 1.0
special_bonds fene

neigh_modify exclude type 5 5
neigh_modify exclude type 5 6
neigh_modify exclude type 6 6
neigh_modify exclude type 3 8
neigh_modify exclude type 3 9
neigh_modify exclude type 5 8
neigh_modify exclude type 5 9
neigh_modify exclude type 6 8
neigh_modify exclude type 6 9
neigh_modify exclude type 8 8
neigh_modify exclude type 8 9
neigh_modify exclude type 9 9

# MPI load balance across the vacuum margins
balance 1.05 shift z 20 1.05
fix lb all balance 1000 1.05 shift z 20 1.05


# ==========================================================================
#   WET PISTONS parked (frozen) until the settle, GRIP PLATES parked until the seating;
#   the free gel is PINNED
# ==========================================================================
velocity piston_feed set 0.0 0.0 0.0
velocity piston_perm set 0.0 0.0 0.0
velocity plates      set 0.0 0.0 0.0
fix freeze_feed   piston_feed setforce 0.0 0.0 0.0
fix freeze_perm   piston_perm setforce 0.0 0.0 0.0
fix freeze_plates plates      setforce 0.0 0.0 0.0     # not integrated until the seating: immobile
# an isolated block in a bath drifts and turns under the pressure noise (the slab_with_support
# PIN_GEL): zero the polymer's linear + angular momentum until the rigid grips take over
fix pin_gel polymer momentum ${pin_gel_every} linear 1 1 1 angular
print ">>> gel pinned (polymer linear + angular momentum zeroed every ${pin_gel_every} steps) until the grips are defined"


# ==========================================================================
#                           THERMO OUTPUT
# ==========================================================================
# press / c_mobile_press include the vacuum margins -> meaningless (see the
# compression deck); the bath pressure is read from the wet pistons.
compute mobile_temp mobile temp
compute mobile_press all pressure thermo_temp pair bond
thermo_style custom step c_mobile_temp pe ke etotal press c_mobile_press pxz vol lx ly lz
thermo_modify lost warn
thermo ${thermo_freq}


# ==========================================================================
#                 PISTON FORCE READOUT (compute group/group)
# ==========================================================================
compute fp_feed piston_feed group/group mobile
compute fp_perm piston_perm group/group mobile
variable area        equal lx*ly
variable P_feed_meas equal  c_fp_feed[3]/v_area
variable P_perm_meas equal -c_fp_perm[3]/v_area
# grip tractions: 0 until the grips exist (redefined in the characterisation)
variable S_r equal 0.0
variable S_l equal 0.0
variable N_r equal 0.0
variable N_l equal 0.0
# grip plates: positions (unwrapped COM) and the polymer-only x-force on each (the seated
# preload of compress_slab; + = the polymer pushes the plate OUTWARD = compressive on the gel)
compute pl_l_com plate_l com
compute pl_r_com plate_r com
compute fp_pl_l plate_l group/group polymer
compute fp_pl_r plate_r group/group polymer
variable x_pl_l  equal c_pl_l_com[1]
variable x_pl_r  equal c_pl_r_com[1]
variable seat_l  equal c_pl_l_com[1]+v_contact_gap      # the plates' seat planes = the gripped faces once seated
variable seat_r  equal c_pl_r_com[1]-v_contact_gap
variable area_face equal 1.0                             # redefined (Rg face area) in the characterisation
variable Np_l equal -c_fp_pl_l[1]/v_area_face
variable Np_r equal  c_fp_pl_r[1]/v_area_face

compute feed_com piston_feed com
compute perm_com piston_perm com
compute feed_vz  piston_feed reduce ave vz
compute perm_vz  piston_perm reduce ave vz
variable z_load  equal 0.0                # no load piston in this deck (column kept for the piston readers)
variable z_feed  equal c_feed_com[3]
variable z_perm  equal c_perm_com[3]
variable vz_feed equal c_feed_vz
variable vz_perm equal c_perm_vz
variable feed_z_bot equal c_feed_com[3]-0.5*${sigma}
variable feed_z_top equal c_feed_com[3]+0.5*${sigma}
variable perm_z_top equal c_perm_com[3]+0.5*${sigma}
variable perm_z_bot equal c_perm_com[3]-0.5*${sigma}


# ==========================================================================
#   GEL / BOX TRACKING COMPUTES + WHOLE-RUN CONVERGENCE LOGGERS (from step 0)
# ==========================================================================
compute polymer_com polymer com
compute minx polymer reduce min x
compute maxx polymer reduce max x
compute miny polymer reduce min y
compute maxy polymer reduce max y
compute minz polymer reduce min z
compute maxz polymer reduce max z
variable gel_lx_bb  equal c_maxx-c_minx
variable gel_ly_bb  equal c_maxy-c_miny
variable gel_lz_bb  equal c_maxz-c_minz
variable gel_vol_bb equal v_gel_lx_bb*v_gel_ly_bb*v_gel_lz_bb
compute rg_tensor polymer gyration
variable gel_lx_rg  equal 2.0*sqrt(3.0*c_rg_tensor[1])
variable gel_ly_rg  equal 2.0*sqrt(3.0*c_rg_tensor[2])
variable gel_lz_rg  equal 2.0*sqrt(3.0*c_rg_tensor[3])
variable gel_vol_rg equal v_gel_lx_rg*v_gel_ly_rg*v_gel_lz_rg
# Rg-based faces (live): x = the gripped faces, y and z = the free faces
variable gel_xr_rg equal c_polymer_com[1]+0.5*v_gel_lx_rg
variable gel_xl_rg equal c_polymer_com[1]-0.5*v_gel_lx_rg
variable gel_yhi_rg equal c_polymer_com[2]+0.5*v_gel_ly_rg
variable gel_ylo_rg equal c_polymer_com[2]-0.5*v_gel_ly_rg
variable gel_top_rg equal c_polymer_com[3]+0.5*v_gel_lz_rg
variable gel_bot_rg equal c_polymer_com[3]-0.5*v_gel_lz_rg

fix trk_box all print ${stress_freq} "$(step) $(lx) $(ly) $(lz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${nsteps}.dat screen no
fix trk_box_bounds all print ${stress_freq} "$(step) $(xlo) $(xhi) $(ylo) $(yhi) $(zlo) $(zhi)" &
    title "# step xlo xhi ylo yhi zlo zhi   (box bounds; the face planes in plate_pressure_* are absolute x: reduced x = (x - xlo)/lx)" &
    file output_files/volume_data/box_bounds_${dataname}_${interaction}_${nsteps}.dat screen no
fix trk_dims_rg all print ${stress_freq} "$(step) $(v_gel_lx_rg) $(v_gel_ly_rg) $(v_gel_lz_rg)" &
    file output_files/volume_data/gel_dimensions_rg_${dataname}_${interaction}_${nsteps}.dat screen no
# gyration-tensor components for the Rg-based shear strain: a simple shear z -> z + gamma*x changes
# Rg_xz by gamma*Rg_xx^2, so gamma_rg = (Rg_xz - <Rg_xz>_ref)/Rg_xx^2 (the periodic deck's formula with
# x and z swapped; the notebooks form it, G_STRAIN fallback after the displacement-profile slope).
fix trk_rg all print ${stress_freq} "$(step) $(c_rg_tensor[1]) $(c_rg_tensor[5])" &
    title "# step Rg_xx^2 Rg_xz   (polymer gyration tensor, unwrapped coordinates; gap axis = x)" &
    file output_files/stress_data/shear_strain_rg_${dataname}_${interaction}_${nsteps}.dat screen no
fix trk_vol_rg all print ${stress_freq} "$(step) $(v_gel_vol_rg)" &
    file output_files/volume_data/gel_volume_rg_${dataname}_${interaction}_${nsteps}.dat screen no
fix trk_vol_bb all print ${stress_freq} "$(v_gel_vol_bb)" &
    file output_files/volume_data/gel_volume_bb_${dataname}_${interaction}_${nsteps}.dat screen no
fix trk_plates all print ${stress_freq} "$(step) $(v_seat_r) $(v_seat_l) $(v_P_feed_meas) $(v_P_perm_meas) $(v_S_r) $(v_S_l) $(v_N_r) $(v_N_l) $(v_Np_r) $(v_Np_l)" &
    title "# step x_face_r x_face_l P_feed P_perm S_r S_l N_r N_l Np_r Np_l   (x_face_* = grip-plate seat planes = plate x -/+ contact_gap, the gripped faces once seated; wet-piston pressures; S_* = constraint z-force on each grip / face area = sigma_xz at that grip; N_* = net x-force of the gel ON each grip / face area, + = gel pushing outward; Np_* = polymer-only x-force on each PLATE / face area, + = compressive preload)" &
    file output_files/piston_data/plate_pressure_${dataname}_${interaction}_${nsteps}.dat screen no


# ==========================================================================
#                    PHASE 0: MINIMIZE + LANGEVIN NVT (pistons frozen)
# ==========================================================================
print "========================================"
print "Phase 0: minimize + Langevin NVT (${phase0_steps} steps), pistons + grip plates frozen, gel pinned"
print "========================================"
reset_timestep 0
timestep ${timestep_prod}

# setup movie: Phase 0 + settle + reference + the FIRST level's ramp
print ">>> gel_setup dump: ~${num_dump_frames} frames over setup span $(v_setup_span:%.0f) steps -> every ${dump_freq_setup} steps"
dump traj_setup gel_system custom ${dump_freq_setup} &
   traj_files/gel_setup_${dataname}_${interaction}_${nsteps}.lammpstrj &
   id type mol x y z

minimize 1.0e-4 1.0e-6 ${min_iter} 10000

fix nve_mob mobile nve
fix lang_p0 mobile langevin ${temp_target} ${temp_target} 1.0 48279
run ${phase0_steps}
unfix lang_p0
print ">>> Post-Phase-0: T=$(c_mobile_temp)"
run 0

print ">>> feed piston z = $(v_z_feed)  permeate piston z = $(v_z_perm)"
print ">>> gel (Rg): x $(v_gel_xl_rg) .. $(v_gel_xr_rg)   y $(v_gel_ylo_rg) .. $(v_gel_yhi_rg)   z $(v_gel_bot_rg) .. $(v_gel_top_rg)"
print ">>> gel (BB): x $(c_minx) .. $(c_maxx)   y $(c_miny) .. $(c_maxy)   z $(c_minz) .. $(c_maxz)"

# ONE connected bath: its effective solvent column (bath volume / area) sets the
# compressibility spring of the damping estimate for BOTH pistons.
variable L_bath equal (v_feed_z_bot-v_perm_z_top)-v_gel_vol_rg/v_area
variable L_feed equal v_L_bath
variable L_perm equal v_L_bath
print ">>> Bath: pistons $(v_perm_z_top:%.2f) .. $(v_feed_z_bot:%.2f), gel volume (Rg) $(v_gel_vol_rg:%.0f) -> effective solvent column L=$(v_L_bath:%.2f) sigma   A=$(v_area:%.2f)"

# ----- Critical-damping estimate (see triaxial_permeation_two_pist.lmp) -----
variable k_feed      equal $(v_K_solv*v_area/v_L_feed)
variable k_perm      equal $(v_K_solv*v_area/v_L_perm)
variable omega_feed  equal $(sqrt(v_k_feed/(v_N_feed*v_piston_mass)))
variable omega_perm  equal $(sqrt(v_k_perm/(v_N_perm*v_piston_mass)))
variable period_feed equal $(v_two_pi/v_omega_feed/v_timestep_prod)
variable period_perm equal $(v_two_pi/v_omega_perm/v_timestep_prod)
variable C_crit_feed equal $(2.0*sqrt(v_k_feed*v_piston_mass/v_N_feed))
variable C_crit_perm equal $(2.0*sqrt(v_k_perm*v_piston_mass/v_N_perm))
variable C_pist_feed equal $(v_c_pist_frac*v_C_crit_feed)
variable C_pist_perm equal $(v_c_pist_frac*v_C_crit_perm)
print "############################################################"
print ">>> NPT-PISTON damping estimate (K_solv=${K_solv}, piston_mass=${piston_mass}, c_pist_frac=${c_pist_frac})"
print ">>>   feed:     period=$(v_period_feed:%.0f) steps  C_pist=$(v_C_pist_feed:%.3f)"
print ">>>   permeate: period=$(v_period_perm:%.0f) steps  C_pist=$(v_C_pist_perm:%.3f)"
if "$(v_npt_piston_steps) < $(3.0*v_period_feed)" then &
    "print '>>>   WARNING: settle shorter than 3 feed-piston periods -- raise npt_piston_steps'"
print "############################################################"


# ==========================================================================
#            PHASE 1: NPT-PISTON SETTLE  (wet pistons at P_target; live to the end of the run)
# ==========================================================================
print "========================================"
print "Phase 1: NPT-piston settle, ${npt_piston_steps} steps, P_feed = P_perm = ${P_target}"
print "========================================"
variable fz_feed equal -v_P_target*v_area/v_N_feed-v_C_pist_feed*vcm(piston_feed,z)
variable fz_perm equal  v_P_target*v_area/v_N_perm-v_C_pist_perm*vcm(piston_perm,z)

unfix freeze_feed
unfix freeze_perm
velocity piston_feed set 0.0 0.0 0.0
velocity piston_perm set 0.0 0.0 0.0
fix feed_xy  piston_feed setforce 0.0 0.0 NULL
fix feed_z   piston_feed aveforce NULL NULL v_fz_feed
fix feed_nve piston_feed nve
fix perm_xy  piston_perm setforce 0.0 0.0 NULL
fix perm_z   piston_perm aveforce NULL NULL v_fz_perm
fix perm_nve piston_perm nve

fix lang_settle mobile langevin ${temp_target} ${temp_target} 1.0 58291

fix out_piston_pressure all print ${volume_freq} &
    "$(step) $(v_P_feed_meas) $(v_P_target) $(v_P_perm_meas) $(v_P_target)" &
    title "# step P_feed_meas P_feed_app P_perm_meas P_perm_app" &
    file output_files/piston_data/piston_pressure_${dataname}_${interaction}_${nsteps}.dat screen no
fix out_piston_pos_run all print ${volume_freq} "$(step) $(v_z_load) $(v_z_feed) $(v_z_perm)" &
    title "# step z_load z_feed z_perm   (no load piston in this deck: z_load = 0)" &
    file output_files/piston_data/piston_position_run_${dataname}_${interaction}_${nsteps}.dat screen no

fix settle_win all ave/time 100 100 10000 v_vz_feed v_vz_perm v_z_feed v_z_perm ave one
variable settle_start equal $(step)
variable settle_ok equal (step>=v_settle_start+v_settle_min_steps)*(abs(f_settle_win[1])<v_settle_tol_v)*(abs(f_settle_win[2])<v_settle_tol_v)*(abs(v_z_feed-f_settle_win[3])<v_settle_tol_z)*(abs(v_z_perm-f_settle_win[4])<v_settle_tol_z)
if "${settle_halt} == 1" then "fix halt_settle all halt 10000 v_settle_ok > 0.5 error continue"

print ">>> settle start: z_feed=$(v_z_feed:%.3f) z_perm=$(v_z_perm:%.3f)  P_feed_meas=$(v_P_feed_meas:%.4f) P_perm_meas=$(v_P_perm_meas:%.4f)"
thermo 10000
run ${npt_piston_steps}
thermo ${thermo_freq}
if "${settle_halt} == 1" then "unfix halt_settle"
unfix settle_win
print ">>> settle end (step $(step)): z_feed=$(v_z_feed:%.3f) z_perm=$(v_z_perm:%.3f)  vz_feed=$(v_vz_feed:%.2e) vz_perm=$(v_vz_perm:%.2e)"
print ">>>   P_feed_meas=$(v_P_feed_meas:%.4f) P_perm_meas=$(v_P_perm_meas:%.4f) (applied ${P_target})  T=$(c_mobile_temp:%.4f)"


# ==========================================================================
#   PHASE 1.25: SEATING -- the two grip plates onto the gel's x-faces (compress_slab's seating)
# ==========================================================================
# Both plates travel v = d/t over the COMMON time t_seat to contact_gap short of the
# x-face they load, so neither arrives early and shoves the gel sideways (the gel is
# still pinned); ballistic translation (nve + setforce 0 + set velocity), stopped by
# zeroing the velocity.  Transparent to solvent, the plates slide through the bath.
# Then seat_settle_steps with the plates fixed (Langevin on the mobile atoms) before
# the grips are defined from the seated plates.
print "========================================"
print "Phase 1.25: seating of the two grip plates (seat_mode ${seat_mode}, t_seat ${t_seat}) + ${seat_settle_steps} settle steps"
print "========================================"
if "${seat_mode} == bb" then &
    "variable face_xlo equal $(c_minx)" &
    "variable face_xhi equal $(c_maxx)" &
elif "${seat_mode} == rg" &
    "variable face_xlo equal $(v_gel_xl_rg)" &
    "variable face_xhi equal $(v_gel_xr_rg)" &
else &
    "print 'ERROR: seat_mode must be rg or bb (got ${seat_mode})'" &
    "quit 1"
variable d_xlo  equal $(v_face_xlo-v_x_pl_l-v_contact_gap)
variable d_xhi  equal $(v_x_pl_r-v_face_xhi-v_contact_gap)
variable seat_T equal $(v_t_seat*v_timestep_prod)
print ">>> seat_mode = ${seat_mode}: gel x-faces ${face_xlo} / ${face_xhi}   (Rg $(v_gel_xl_rg:%.2f) / $(v_gel_xr_rg:%.2f), BB $(c_minx:%.2f) / $(c_maxx:%.2f))"
print ">>> plates parked at x = $(v_x_pl_l:%.3f) / $(v_x_pl_r:%.3f);  seating travel ${d_xlo} / ${d_xhi} sigma over ${t_seat} steps"
if "${d_xlo} <= 0.0 || ${d_xhi} <= 0.0" then &
    "print 'ERROR: a grip plate is already inside its seat plane (travel ${d_xlo} / ${d_xhi}): the gel swelled into a parked plate -- raise plate_park_gap in the converter'" &
    "quit 1"
fix nve_plates plates nve
velocity plate_l set $(v_d_xlo/v_seat_T) 0.0 0.0
velocity plate_r set $(-v_d_xhi/v_seat_T) 0.0 0.0
run ${t_seat}
velocity plates set 0.0 0.0 0.0
unfix nve_plates
print ">>> plates seated at x = $(v_x_pl_l:%.3f) / $(v_x_pl_r:%.3f) (seat planes $(v_seat_l:%.3f) / $(v_seat_r:%.3f));  settling ${seat_settle_steps} steps..."
run ${seat_settle_steps}
print ">>> seated (step $(step)):  gel Rg x $(v_gel_xl_rg:%.2f) .. $(v_gel_xr_rg:%.2f), BB x $(c_minx:%.2f) .. $(c_maxx:%.2f);  polymer x-force on the plates (raw): left $(c_fp_pl_l[1]:%.3f) right $(c_fp_pl_r[1]:%.3f)"
print ">>>   P_feed_meas=$(v_P_feed_meas:%.4f) P_perm_meas=$(v_P_perm_meas:%.4f)  T=$(c_mobile_temp:%.4f)"

# ----- end of the Langevin stages.  The production integrators are created in the
# characterisation below, once the grips exist (they are integrated apart from the
# thermostatted atoms).  No steps run in between.
unfix lang_settle
unfix nve_mob

# box-face guard for the wet pistons
variable box_guard equal (v_feed_z_top>=zhi-v_box_guard_gap)+(v_perm_z_bot<=zlo+v_box_guard_gap)
fix halt_box all halt 1000 v_box_guard > 0.5 error continue

run 0


# ==========================================================================
#      GEL CHARACTERISATION: faces, grips, tracking slabs, measurement core   [ONCE]
# ==========================================================================
# Everything here is frozen to numbers from the seated configuration ($(...)).
# The gripped faces are the plates' SEAT PLANES (plate x +/- contact_gap), not the live Rg
# faces: the grips are defined relative to the plates they move with.
variable x_face_l       equal $(v_seat_l)
variable x_face_r       equal $(v_seat_r)
variable y_face_lo      equal $(v_gel_ylo_rg)
variable y_face_hi      equal $(v_gel_yhi_rg)
variable z_face_lo      equal $(v_gel_bot_rg)
variable z_face_hi      equal $(v_gel_top_rg)
variable gel_xlo        equal $(c_minx)
variable gel_xhi        equal $(c_maxx)
variable gel_gap        equal $(v_gel_xhi - v_gel_xlo)       # polymer bounding-box width in x (diagnostic)
variable gel_lx_initial equal $(v_gel_lx_rg)                 # Rg x-width (diagnostic; column 2 of shear_strain)
variable area_face      equal $(v_gel_ly_rg*v_gel_lz_rg)     # Rg face area of a gripped x-face (traction denominator; also Np_*)

variable x_drv_l equal $(v_x_face_l + v_layer_thick)         # grips: x < x_drv_l (left) / x > x_drv_r (right)
variable x_drv_r equal $(v_x_face_r - v_layer_thick)
variable x_trk_l equal $(v_x_drv_l + v_track_thick)          # tracking slabs: x_drv_l..x_trk_l / x_trk_r..x_drv_r
variable x_trk_r equal $(v_x_drv_r - v_track_thick)

region reg_drv_l block EDGE       ${x_drv_l} EDGE EDGE EDGE EDGE units box
region reg_drv_r block ${x_drv_r} EDGE       EDGE EDGE EDGE EDGE units box
region reg_trk_l block ${x_drv_l} ${x_trk_l} EDGE EDGE EDGE EDGE units box
region reg_trk_r block ${x_trk_r} ${x_drv_r} EDGE EDGE EDGE EDGE units box
group all_drv_l region reg_drv_l
group all_drv_r region reg_drv_r
group all_trk_l region reg_trk_l
group all_trk_r region reg_trk_r
group poly_l     intersect polymer all_drv_l    # STATIC: the same beads are the grip for the whole run
group poly_r     intersect polymer all_drv_r
group poly_trk_l intersect polymer all_trk_l
group poly_trk_r intersect polymer all_trk_r
group all_drv_l delete
group all_drv_r delete
group all_trk_l delete
group all_trk_r delete
variable N_l equal $(count(poly_l))
variable N_r equal $(count(poly_r))
group poly_drv  union    poly_l poly_r
group grip_l    union    plate_l poly_l               # the rigid grips: plate + the layer it is seated on
group grip_r    union    plate_r poly_r
group grips     union    grip_l grip_r
group poly_free subtract mobile poly_l poly_r         # everything the thermostat acts on

# ----- the rigid grips take over from the momentum pin and the plate freeze -----
unfix pin_gel
unfix freeze_plates

# ----- production integrators -----
# poly_free: full 3-D Nose-Hoover (the compression deck's choice; nothing streams once a
# hold has settled) + x/y COM-momentum zeroing of the bath + free network (left over from the
# Langevin stages; nothing else holds the bath in x, y).  z is left alone (the wet pistons exchange it).
# grips (plate + layer): plain nve -- all three components are PRESCRIBED below (setforce 0 0 0
# + velocity set), so nve only integrates the prescribed uniform velocity; a thermostat on
# these beads would rescale it, so none is applied.
fix nvt_prod poly_free nvt temp ${temp_target} ${temp_target} 1.0
fix mom_prod poly_free momentum 100 linear 1 1 0
fix nve_drv  grips     nve
# rigid from here to the end of the run: no force reaches a grip bead, so the velocity set
# below is kept exactly (0 in the reference and every hold, -/+vshear in a drive).  setforce
# must come AFTER every other force-modifying fix on these atoms (it does: nothing else touches them).
velocity grip_l set 0.0 0.0 0.0
velocity grip_r set 0.0 0.0 0.0
fix shear_l grip_l setforce 0.0 0.0 0.0
fix shear_r grip_r setforce 0.0 0.0 0.0

# strain from the PLATE positions (rigid, well-defined; the layer moves with its plate)
compute trk_l_com poly_trk_l com      # unwrapped COMs
compute trk_r_com poly_trk_r com
run 0

variable W_drv  equal $(v_x_drv_r - v_x_drv_l)               # prescribed-strain denominator: the gel between the grip layers (the plate_sep of shear_slab.lmp)
variable W_trk  equal $(c_trk_r_com[1] - c_trk_l_com[1])     # interior-strain denominator
variable z_drv0 equal $(c_pl_r_com[3] - c_pl_l_com[3])
variable z_trk0 equal $(c_trk_r_com[3] - c_trk_l_com[3])
variable gamma     equal (c_pl_r_com[3] - c_pl_l_com[3] - v_z_drv0) / v_W_drv
variable gamma_trk equal (c_trk_r_com[3] - c_trk_l_com[3] - v_z_trk0) / v_W_trk

print "Rg:  Lx=$(v_gel_lx_rg) Ly=$(v_gel_ly_rg) Lz=$(v_gel_lz_rg)   BB:  Lx=$(v_gel_lx_bb) Ly=$(v_gel_ly_bb) Lz=$(v_gel_lz_bb)"
print ">>> Gripped faces (plate seat planes): x_l = ${x_face_l}  x_r = ${x_face_r}  (plates at $(v_x_pl_l:%.3f) / $(v_x_pl_r:%.3f); live Rg faces $(v_gel_xl_rg:%.2f) / $(v_gel_xr_rg:%.2f));  polymer BB x-extent ${gel_xlo} to ${gel_xhi};  face area (Rg) ${area_face}"
print ">>> Free faces (Rg): y ${y_face_lo} .. ${y_face_hi};  z ${z_face_lo} .. ${z_face_hi}"
print ">>> Grips = plate + polymer ${layer_thick} sigma inside each seat plane (+ everything beyond): left ${N_pl_l} plate + ${N_l} polymer beads (x < ${x_drv_l}), right ${N_pl_r} plate + ${N_r} polymer beads (x > ${x_drv_r});  W_drv = ${W_drv} sigma (strain denominator)"
print ">>> Tracking slabs (${track_thick} sigma): left $(count(poly_trk_l)) beads, right $(count(poly_trk_r)) beads;  W_trk = ${W_trk} sigma"
print ">>> Thermostatted atoms (poly_free): $(count(poly_free));  rigid grip beads (grips, nve): $(count(grips))"
print ">>> Seated preload (polymer-only x-force on each plate / face area): left $(v_Np_l:%.5f)  right $(v_Np_r:%.5f)"

# ----- grip tractions from the constraint force -----
# f_shear_*[k] = total force on the grip (plate + layer) BEFORE setforce zeroed it = the
# force the rest of the system exerts on the grip (plate-layer forces are internal and
# cancel).  The constraint supplies the opposite, so sigma_xz at each face = the external
# z-force on the grip / face area (+ for gamma > 0: the right grip moves +z and the gel
# pulls it back -z):
variable S_r equal -f_shear_r[3]/v_area_face
variable S_l equal  f_shear_l[3]/v_area_face
# normal traction the grips carry: net x-force (polymer + solvent) ON the grip / face area,
# + = gel pushing outward (the polymer-only part on the plate is Np_*)
variable N_r equal  f_shear_r[1]/v_area_face
variable N_l equal -f_shear_l[1]/v_area_face

# ----- drive speed (per grip; the halt sets where it stops) -----
variable vshear equal $(v_strain_rate_ref * v_W_drv / (2.0 * v_nsteps_shear_base * v_timestep_prod) * 1.1)
print ">>> vshear = ${vshear} sigma/tau  (each grip; halt fires at each ${strains} target)"


# ==========================================================================
#     MEASUREMENT CORE (plate_excl inside the x-faces, core margins inside y, z)   [ONCE]
# ==========================================================================
# Excludes the grips (stress ramp), the tracking slabs and the free-surface zones;
# DYNAMIC groups (solvent exchanges freely with the bath).
variable core_xlo equal ${x_face_l}+${plate_excl}
variable core_xhi equal ${x_face_r}-${plate_excl}
variable core_ylo equal ${y_face_lo}+${core_margin_y}
variable core_yhi equal ${y_face_hi}-${core_margin_y}
variable core_zlo equal ${z_face_lo}+${core_margin_z}
variable core_zhi equal ${z_face_hi}-${core_margin_z}
variable core_lx  equal v_core_xhi-v_core_xlo
variable core_ly  equal v_core_yhi-v_core_ylo
variable core_lz  equal v_core_zhi-v_core_zlo
variable bulk_vol equal v_core_lx*v_core_ly*v_core_lz
variable core_area_yz equal v_core_ly*v_core_lz      # cross-section of the x-profile bins
variable core_area_xy equal v_core_lx*v_core_ly      # cross-section of the z-profile bins
variable core_min equal 2.0*v_binWidth      # (the if-command Boolean takes no arithmetic)
if "${core_lx} <= ${core_min} || ${core_ly} <= ${core_min} || ${core_lz} <= ${core_min}" then &
    "print '>>> ERROR: measurement core is empty or too thin (lx ${core_lx}, ly ${core_ly}, lz ${core_lz}): lower core_margin_y / core_margin_z or layer_thick / track_thick'" &
    "quit 1"
region   reg_core    block ${core_xlo} ${core_xhi} ${core_ylo} ${core_yhi} ${core_zlo} ${core_zhi} units box
region   reg_core_yz block EDGE        EDGE        ${core_ylo} ${core_yhi} ${core_zlo} ${core_zhi} units box   # x-profiles: all x, core y,z
region   reg_core_xy block ${core_xlo} ${core_xhi} ${core_ylo} ${core_yhi} EDGE        EDGE        units box   # z-profiles: all z, core x,y
group    poly_bulk dynamic polymer region reg_core every 50
group    solv_bulk dynamic solvent region reg_core every 50
print ">>> Core: x ${core_xlo} .. ${core_xhi} (${core_lx}), y ${core_ylo} .. ${core_yhi} (${core_ly}), z ${core_zlo} .. ${core_zhi} (${core_lz});  bulk_vol = $(v_bulk_vol:%.0f)"


# ==========================================================================
#              ANALYSIS: PARTIAL STRESSES   [computes defined ONCE]
# ==========================================================================
# As shear_slab.lmp: stress/atom NULL (kinetic term included), order xx yy zz xy
# xz yz, mechanical sign for the shear components (sum/V = sigma_xz > 0 for the
# right grip driven +z).  fix setforce does not enter the virial, so these are the
# gel's own interaction stresses.
compute stress_polymer polymer stress/atom NULL
compute stress_solvent solvent stress/atom NULL

compute sig_p_xx poly_bulk reduce sum c_stress_polymer[1]
compute sig_p_yy poly_bulk reduce sum c_stress_polymer[2]
compute sig_p_zz poly_bulk reduce sum c_stress_polymer[3]
compute sig_p_xy poly_bulk reduce sum c_stress_polymer[4]
compute sig_p_xz poly_bulk reduce sum c_stress_polymer[5]
compute sig_p_yz poly_bulk reduce sum c_stress_polymer[6]
variable stress_p_xx equal c_sig_p_xx/v_bulk_vol
variable stress_p_yy equal c_sig_p_yy/v_bulk_vol
variable stress_p_zz equal c_sig_p_zz/v_bulk_vol
variable stress_p_xy equal c_sig_p_xy/v_bulk_vol
variable stress_p_xz equal c_sig_p_xz/v_bulk_vol
variable stress_p_yz equal c_sig_p_yz/v_bulk_vol

compute sig_s_xx solv_bulk reduce sum c_stress_solvent[1]
compute sig_s_yy solv_bulk reduce sum c_stress_solvent[2]
compute sig_s_zz solv_bulk reduce sum c_stress_solvent[3]
compute sig_s_xy solv_bulk reduce sum c_stress_solvent[4]
compute sig_s_xz solv_bulk reduce sum c_stress_solvent[5]
compute sig_s_yz solv_bulk reduce sum c_stress_solvent[6]
variable stress_s_xx equal c_sig_s_xx/v_bulk_vol
variable stress_s_yy equal c_sig_s_yy/v_bulk_vol
variable stress_s_zz equal c_sig_s_zz/v_bulk_vol
variable stress_s_xy equal c_sig_s_xy/v_bulk_vol
variable stress_s_xz equal c_sig_s_xz/v_bulk_vol
variable stress_s_yz equal c_sig_s_yz/v_bulk_vol

# per-atom stresses per bin volume: x-profiles (core y,z cross-section) ...
variable s_p_xx atom c_stress_polymer[1]/(v_core_area_yz*${binWidth})
variable s_p_yy atom c_stress_polymer[2]/(v_core_area_yz*${binWidth})
variable s_p_zz atom c_stress_polymer[3]/(v_core_area_yz*${binWidth})
variable s_p_xy atom c_stress_polymer[4]/(v_core_area_yz*${binWidth})
variable s_p_xz atom c_stress_polymer[5]/(v_core_area_yz*${binWidth})
variable s_p_yz atom c_stress_polymer[6]/(v_core_area_yz*${binWidth})
variable s_s_xx atom c_stress_solvent[1]/(v_core_area_yz*${binWidth})
variable s_s_yy atom c_stress_solvent[2]/(v_core_area_yz*${binWidth})
variable s_s_zz atom c_stress_solvent[3]/(v_core_area_yz*${binWidth})
variable s_s_xy atom c_stress_solvent[4]/(v_core_area_yz*${binWidth})
variable s_s_xz atom c_stress_solvent[5]/(v_core_area_yz*${binWidth})
variable s_s_yz atom c_stress_solvent[6]/(v_core_area_yz*${binWidth})
# ... and z-profiles (core x,y cross-section; the end-zone diagnostic)
variable q_p_xx atom c_stress_polymer[1]/(v_core_area_xy*${binWidth})
variable q_p_yy atom c_stress_polymer[2]/(v_core_area_xy*${binWidth})
variable q_p_zz atom c_stress_polymer[3]/(v_core_area_xy*${binWidth})
variable q_p_xy atom c_stress_polymer[4]/(v_core_area_xy*${binWidth})
variable q_p_xz atom c_stress_polymer[5]/(v_core_area_xy*${binWidth})
variable q_p_yz atom c_stress_polymer[6]/(v_core_area_xy*${binWidth})
variable q_s_xx atom c_stress_solvent[1]/(v_core_area_xy*${binWidth})
variable q_s_yy atom c_stress_solvent[2]/(v_core_area_xy*${binWidth})
variable q_s_zz atom c_stress_solvent[3]/(v_core_area_xy*${binWidth})
variable q_s_xy atom c_stress_solvent[4]/(v_core_area_xy*${binWidth})
variable q_s_xz atom c_stress_solvent[5]/(v_core_area_xy*${binWidth})
variable q_s_yz atom c_stress_solvent[6]/(v_core_area_xy*${binWidth})

# ----- binning ALONG x over the whole box length, atoms inside the core y,z window
# (reduced x/lx, the file format of the periodic deck's z-profiles; box fixed) -----
variable binWidth_rx equal $(v_binWidth/lx)
variable binWidth_rz equal $(v_binWidth/lz)
compute chunk_x_polymer   polymer chunk/atom bin/1d x lower ${binWidth_rx} units reduced region reg_core_yz
compute chunk_x_solvent   solvent chunk/atom bin/1d x lower ${binWidth_rx} units reduced region reg_core_yz
compute chunk_x_poly_disp polymer chunk/atom bin/1d x lower ${binWidth_rx} units reduced region reg_core_yz
# ----- binning ALONG z (the shear direction), atoms inside the core x,y window -----
compute chunk_z_polymer   polymer chunk/atom bin/1d z lower ${binWidth_rz} units reduced region reg_core_xy
compute chunk_z_solvent   solvent chunk/atom bin/1d z lower ${binWidth_rz} units reduced region reg_core_xy

# ----- polymer z-displacement u_z(x) for D_c: the reference is RESET at the onset of
# each hold (uncompute/compute in the loop), as shear_slab.lmp -----
compute  displace_shear polymer displace/atom
variable uz_shear atom c_displace_shear[3]
# CUMULATIVE displacement since the gamma = 0 reference (never reset): the steady profile
# u_z(x) of each hold, whose interior slope du_z/dx is the shear strain the NETWORK carries --
# the strain G divides by in the notebooks (G_STRAIN = 'disp').  The reference-window
# profile (_cum_ref) is its zero.
compute  displace_cum polymer displace/atom
variable uz_cum atom c_displace_cum[3]
compute  chunk_x_poly_cum polymer chunk/atom bin/1d x lower ${binWidth_rx} units reduced region reg_core_yz


# ==========================================================================
#          PHASE 1.5: gamma = 0 REFERENCE-STATE RECORDING
# ==========================================================================
print "========================================"
print "Phase 1.5: gamma = 0 reference recording (${ref_avg_steps} steps, ref_nfreq=${ref_nfreq})"
print "========================================"
fix trk_shear_strain all print ${stress_freq} &
    "$(step) ${gel_lx_initial} ${W_drv} $(v_gamma)" &
    file output_files/stress_data/shear_strain_${dataname}_${interaction}_${nsteps}.dat screen no
fix ref_tensor_p all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} &
    v_stress_p_xx v_stress_p_yy v_stress_p_zz v_stress_p_xy v_stress_p_xz v_stress_p_yz &
    file output_files/stress_data/stress_tensor_polymer_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_tensor_s all ave/time ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} &
    v_stress_s_xx v_stress_s_yy v_stress_s_zz v_stress_s_xy v_stress_s_xz v_stress_s_yz &
    file output_files/stress_data/stress_tensor_solvent_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_prof_p polymer ave/chunk ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} chunk_x_polymer &
    v_s_p_xx v_s_p_yy v_s_p_zz v_s_p_xy v_s_p_xz v_s_p_yz norm none &
    file output_files/stress_data/stress_profile_x_polymer_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_prof_s solvent ave/chunk ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} chunk_x_solvent &
    v_s_s_xx v_s_s_yy v_s_s_zz v_s_s_xy v_s_s_xz v_s_s_yz norm none &
    file output_files/stress_data/stress_profile_x_solvent_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_prof_pz polymer ave/chunk ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} chunk_z_polymer &
    v_q_p_xx v_q_p_yy v_q_p_zz v_q_p_xy v_q_p_xz v_q_p_yz norm none &
    file output_files/stress_data/stress_profile_z_polymer_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_prof_sz solvent ave/chunk ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} chunk_z_solvent &
    v_q_s_xx v_q_s_yy v_q_s_zz v_q_s_xy v_q_s_xz v_q_s_yz norm none &
    file output_files/stress_data/stress_profile_z_solvent_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_disp_cum polymer ave/chunk ${ref_nevery} ${ref_nrepeat} ${ref_nfreq} chunk_x_poly_cum v_uz_cum &
    file output_files/displacement_data/disp_z_polymer_cum_ref_${dataname}_${interaction}_${nsteps}.dat
fix ref_series all ave/time ${series_nevery} ${series_nrepeat} ${series_nfreq} &
    v_stress_p_xx v_stress_p_yy v_stress_p_zz v_stress_p_xz v_stress_s_xx v_stress_s_yy v_stress_s_zz v_stress_s_xz v_S_r v_S_l v_gamma_trk &
    title2 "# TimeStep sp_xx sp_yy sp_zz sp_xz ss_xx ss_yy ss_zz ss_xz S_r S_l gamma_trk   (core partial stresses, grip sigma_xz, tracking-slab strain; block-averaged; gamma = 0 reference)" &
    file output_files/stress_data/stress_series_ref_${dataname}_${interaction}_${nsteps}.dat
variable ref_run_steps equal (floor(($(step)+${ref_avg_steps}-1)/${ref_nfreq})+1)*${ref_nfreq}-$(step)
print ">>> Reference window: running ${ref_run_steps} steps (>= ${ref_avg_steps}, aligned to ref_nfreq=${ref_nfreq})"
run ${ref_run_steps}
unfix ref_series
unfix ref_disp_cum
unfix ref_prof_sz
unfix ref_prof_pz
unfix ref_prof_s
unfix ref_prof_p
unfix ref_tensor_s
unfix ref_tensor_p
print ">>> Reference recording done.  step=$(step)  gamma=$(v_gamma:%.5f)  gamma_trk=$(v_gamma_trk:%.5f)  sigma_p,xz(core)=$(v_stress_p_xz:%.5f)"
print ">>>   P_feed_meas=$(v_P_feed_meas:%.4f) P_perm_meas=$(v_P_perm_meas:%.4f)  S_r=$(v_S_r:%.5f) S_l=$(v_S_l:%.5f)  N_r=$(v_N_r:%.5f) N_l=$(v_N_l:%.5f)  Np_r=$(v_Np_r:%.5f) Np_l=$(v_Np_l:%.5f)"


# ==========================================================================
#                 STRAIN SWEEP LOOP (cumulative, incremental shear)
# ==========================================================================
variable movie_open equal 1

print "############################################################"
print ">>> STRAIN SWEEP LIST (raw from run_lammps.sh): ${strains_list}"
print ">>>   first target=${strains}   drive cap=${nsteps_shear}   hold=${nsteps} steps per level"
print ">>>   W_drv = ${W_drv} sigma (strain denominator);  vshear = ${vshear} sigma/tau (+z right grip, -z left grip);  seated preload Np_l/Np_r = $(v_Np_l:%.4f) / $(v_Np_r:%.4f)"
print ">>>   If the list reads 'STALE-run_lammps.sh...', only ONE strain will run -- update run_lammps.sh on the cluster and resubmit."
print "############################################################"

label strain_loop

print "########################################################"
print "  STRAIN TARGET (cumulative) = ${strains}"
print "########################################################"

# ----- Per-level loggers that span BOTH the drive and the hold (no chunk lock) -----
fix out_shear_strain all print ${stress_freq} &
    "$(step) ${gel_lx_initial} ${W_drv} $(v_gamma)" &
    file output_files/stress_data/shear_strain_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no
fix out_shear_surf all print ${stress_freq} &
    "$(step) ${gel_gap} $(v_gamma_trk) ${W_trk}" &
    title "# step gel_gap_bb gamma_trk W_trk   (tracking-slab strain: what the interior carries; compare with gamma in shear_strain_*)" &
    file output_files/stress_data/shear_strain_surface_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no
fix out_series all ave/time ${series_nevery} ${series_nrepeat} ${series_nfreq} &
    v_stress_p_xx v_stress_p_yy v_stress_p_zz v_stress_p_xz v_stress_s_xx v_stress_s_yy v_stress_s_zz v_stress_s_xz v_S_r v_S_l v_gamma_trk &
    title2 "# TimeStep sp_xx sp_yy sp_zz sp_xz ss_xx ss_yy ss_zz ss_xz S_r S_l gamma_trk   (core partial stresses, grip sigma_xz, tracking-slab strain; block-averaged; drive + hold)" &
    file output_files/stress_data/stress_series_${dataname}_${interaction}_${nsteps}_g${strains}.dat
fix out_gel_vol_bb all print ${stress_freq} "$(step) $(v_gel_vol_bb)" &
    file output_files/volume_data/gel_volume_bb_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no
fix out_gel_dims_bb all print ${stress_freq} "$(step) $(v_gel_lx_bb) $(v_gel_ly_bb) $(v_gel_lz_bb)" &
    file output_files/volume_data/gel_dimensions_bb_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no
fix out_gel_vol_rg all print ${stress_freq} "$(step) $(v_gel_vol_rg)" &
    file output_files/volume_data/gel_volume_rg_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no
fix out_gel_dims_rg all print ${stress_freq} "$(step) $(v_gel_lx_rg) $(v_gel_ly_rg) $(v_gel_lz_rg)" &
    file output_files/volume_data/gel_dimensions_rg_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no
fix out_box_dims all print ${stress_freq} "$(step) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no
fix out_polymer_com all print ${stress_freq} &
    "$(step) $(c_polymer_com[1]) $(c_polymer_com[2]) $(c_polymer_com[3])" &
    file output_files/volume_data/polymer_com_${dataname}_${interaction}_${nsteps}_g${strains}.dat screen no

# ----- PHASE 2: drive -- the grips translate at -/+vshear (left -z, right +z) until gamma >= ${strains} -----
# (all forces on the grips are zeroed by setforce, so the velocity set here persists unchanged)
velocity grip_r set 0.0 0.0  ${vshear}
velocity grip_l set 0.0 0.0 -${vshear}
fix halt_shear all halt ${stress_freq} v_gamma >= ${strains} error continue
variable drive_dump_freq equal floor(${nsteps_shear_base}*1.1/5)
if "${movie_open} == 1" then "dump_modify traj_setup every ${drive_dump_freq}"
print ">>> [strain=${strains}] driving the grips at -/+${vshear} sigma/tau (z) until gamma >= ${strains} (cap ${nsteps_shear} steps)..."
run ${nsteps_shear}
unfix halt_shear
if "${movie_open} == 1" then &
    "undump traj_setup" &
    "variable movie_open delete" &
    "variable movie_open equal 0"
# freeze the grips where the halt left them (the frozen plates of the hold)
velocity grip_r set 0.0 0.0 0.0
velocity grip_l set 0.0 0.0 0.0
print ">>> [strain=${strains}] drive done: gamma = $(v_gamma:%.4f)  (target ${strains});  tracking-slab strain = $(v_gamma_trk:%.4f)  step=$(step)"

# ----- reset the displacement reference to the held state (u_z(x,0) = 0 at the hold onset, for D_c) -----
variable  uz_shear delete
uncompute displace_shear
compute   displace_shear polymer displace/atom
variable  uz_shear atom c_displace_shear[3]

# ----- PHASE 3: production HOLD (grips frozen) -- chunk-locked averaging fixes created HERE -----
dump traj_prod gel_system custom ${dump_freq_prod} &
    traj_files/gel_prod_${dataname}_${interaction}_${nsteps}_g${strains}.lammpstrj &
    id type mol x y z

fix avg_stress_polymer all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_p_xx v_stress_p_yy v_stress_p_zz &
    v_stress_p_xy v_stress_p_xz v_stress_p_yz &
    file output_files/stress_data/stress_tensor_polymer_${dataname}_${interaction}_${nsteps}_g${strains}.dat
fix avg_stress_solvent all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_s_xx v_stress_s_yy v_stress_s_zz &
    v_stress_s_xy v_stress_s_xz v_stress_s_yz &
    file output_files/stress_data/stress_tensor_solvent_${dataname}_${interaction}_${nsteps}_g${strains}.dat
fix avg_prof_x_poly polymer ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_x_polymer &
    v_s_p_xx v_s_p_yy v_s_p_zz v_s_p_xy v_s_p_xz v_s_p_yz &
    norm none &
    file output_files/stress_data/stress_profile_x_polymer_${dataname}_${interaction}_${nsteps}_g${strains}.dat
fix avg_prof_x_solv solvent ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_x_solvent &
    v_s_s_xx v_s_s_yy v_s_s_zz v_s_s_xy v_s_s_xz v_s_s_yz &
    norm none &
    file output_files/stress_data/stress_profile_x_solvent_${dataname}_${interaction}_${nsteps}_g${strains}.dat
fix avg_prof_z_poly polymer ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_z_polymer &
    v_q_p_xx v_q_p_yy v_q_p_zz v_q_p_xy v_q_p_xz v_q_p_yz &
    norm none &
    file output_files/stress_data/stress_profile_z_polymer_${dataname}_${interaction}_${nsteps}_g${strains}.dat
fix avg_prof_z_solv solvent ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_z_solvent &
    v_q_s_xx v_q_s_yy v_q_s_zz v_q_s_xy v_q_s_xz v_q_s_yz &
    norm none &
    file output_files/stress_data/stress_profile_z_solvent_${dataname}_${interaction}_${nsteps}_g${strains}.dat
fix avg_disp_x_poly polymer ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_x_poly_disp v_uz_shear &
    file output_files/displacement_data/disp_z_polymer_${dataname}_${interaction}_${nsteps}_g${strains}.dat
fix avg_disp_x_cum polymer ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_x_poly_cum v_uz_cum &
    file output_files/displacement_data/disp_z_polymer_cum_${dataname}_${interaction}_${nsteps}_g${strains}.dat

# hold padded to an nfreq_stress epoch boundary (chunk/atom lock released before the unfix)
variable hold_steps equal (floor(($(step)+${nsteps}-1)/${nfreq_stress})+1)*${nfreq_stress}-$(step)
print "========================================"
print ">>> [strain=${strains}] measurement HOLD (grips frozen, stress relaxes) for ${hold_steps} steps (>= nsteps=${nsteps}, aligned to nfreq_stress=${nfreq_stress})"
print ">>> [strain=${strains}] gamma = $(v_gamma:%.4f) (grips);  tracking-slab strain = $(v_gamma_trk:%.4f)"
print "========================================"
run ${hold_steps}

unfix avg_disp_x_poly
unfix avg_disp_x_cum
unfix avg_prof_z_solv
unfix avg_prof_z_poly
unfix avg_prof_x_solv
unfix avg_prof_x_poly
unfix avg_stress_solvent
unfix avg_stress_polymer
undump traj_prod
unfix out_polymer_com
unfix out_box_dims
unfix out_gel_dims_rg
unfix out_gel_vol_rg
unfix out_gel_dims_bb
unfix out_gel_vol_bb
unfix out_series
unfix out_shear_surf
unfix out_shear_strain

print ">>> Completed strain=${strains}:  gamma = $(v_gamma:%.4f)  tracking-slab strain = $(v_gamma_trk:%.4f)  S_r = $(v_S_r:%.5f)  S_l = $(v_S_l:%.5f)  N_r = $(v_N_r:%.5f)  N_l = $(v_N_l:%.5f)  sigma_p,xz(core) = $(v_stress_p_xz:%.5f)  step=$(step)"
if "${wall_timeout} > 0" then &
    "print '>>> wall-clock budget left after strain=${strains}: $(timeremain:%.0f) s of ${wall_timeout} s  (0 = budget spent: this level was cut short and the remaining levels are not started)'"

variable hold_steps      delete
variable drive_dump_freq delete

# wall-clock budget spent (timer timeout fired inside this level): leave the sweep here
if "${wall_timeout} > 0 && $(timeremain) <= 0.0" then "jump SELF sweep_cut"

next strains
jump SELF strain_loop

label sweep_cut
print ">>> WALL-CLOCK BUDGET SPENT: the strain sweep stops after strain=${strains} (this level is truncated; levels after it were not run)"


# ==========================================================================
#                            FINAL STATE
# ==========================================================================
print "========================================"
print "Shear, isolated gel (grip plates seated on the x-faces, driven -/+z) strain sweep complete"
print "  Final gamma: $(v_gamma:%.4f)   tracking-slab strain: $(v_gamma_trk:%.4f)"
print "  W_drv: ${W_drv}  W_trk: ${W_trk}  gel_gap (BB, x): ${gel_gap}  gel_lx_initial: ${gel_lx_initial}"
print "========================================"

unfix shear_r
unfix shear_l
unfix halt_box
unfix trk_shear_strain
unfix out_piston_pressure
unfix out_piston_pos_run
unfix trk_plates
unfix trk_vol_bb
unfix trk_vol_rg
unfix trk_dims_rg
unfix trk_rg
unfix trk_box
unfix trk_box_bounds

variable outfile string "final_shear_${dataname}_${interaction}_${nsteps}"
write_data ${outfile}.data
