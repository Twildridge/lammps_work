#!/usr/bin/env bash
#SBATCH --job-name=shear_2p_sweep
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=6
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH --mem=0
#SBATCH --time=20:00:00
#SBATCH --output=%x.o%j.%N
source "$HOME/Documents/lammps_work/scripts/batch_prologue.sh"

# DEFAULT shear strain SWEEP of this folder since 2026-11-14: the laterally PERIODIC gel (deck
# shear_slab_two_pist_periodic.lmp, picked by DECK_FILE) through cumulative strain levels in one
# job: each level drives the face layers to the next target and holds NSTEPS (files _g<strain>).
# Same input file and geometry as shear_slab_two_pist_single.batch (see its header). The periodic
# deck has NO unload phase and NO wall_timeout: the run ends in the last level's held state, and a
# job that outgrows --time is killed mid-level (finished levels stay on disk). Sizing: about
# 2 M setup steps + 4 x (drive + 3 M hold) ~ 14.5 M steps; at the 5-bead rot45 rate on 6 nodes
# (10.8 M steps in 6.8 h) that is ~9 h. Bigger gels: `sbatch --nodes=10 --time=...`.
# REF_AVG_STEPS is the gamma = 0 reference window every level subtracts; its noise is the floor
# under the small levels.
#     DATANAME=<stem> sbatch shear_slab_two_pist_sweep.batch
# The ISOLATED-gel sweep (with its unload phase) is shear_slab_two_pist_isolated_sweep.batch.
# Analyse with shear_analysis_sweep.ipynb, DECK = "shear_slab_two_pist", STRAINS as written here.

FOLDER=shear_slab_two_pist
export DECK_FILE=shear_slab_two_pist_periodic
DATANAME="${DATANAME:-final_config_slab_support_periodic_5beads_tall_rho04_rot45_1.0_1.0_20000000_two_pist_pm40}"
INTERACTION=1.0_1.0
NSTEPS=3000000          # hold per strain level, and the output-file tag
export PRESS_TARGET=1.5
export STRAINS="${STRAINS:-0.01 0.03 0.05 0.1}"
export REF_AVG_STEPS=1000000
echo ">>> DATANAME=$DATANAME DECK_FILE=$DECK_FILE STRAINS=$STRAINS"

bash "$LAMMPS_WORK_DIR/scripts/run_lammps.sh" "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS"
