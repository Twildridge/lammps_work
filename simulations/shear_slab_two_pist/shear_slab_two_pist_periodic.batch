#!/usr/bin/env bash
#SBATCH --job-name=shear_2p_per
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=6
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --output=%x.o%j.%N
source "$HOME/Documents/lammps_work/scripts/batch_prologue.sh"

# Laterally PERIODIC two-piston shear (deck shear_slab_two_pist_periodic.lmp, picked by
# DECK_FILE; the folder's default deck is the isolated-gel version). Both reservoirs are held at
# PRESS_TARGET by the NPT pistons; the polymer beads of the gel's top and bottom face layers are
# driven +x / -x until gamma reaches each target, then held NSTEPS steps (files _g<strain>);
# G = sigma_xz / gamma. Input: the compression deck's converter output of the 14000002 slab.
# Piston knobs (PISTON_MASS, C_PIST_FRAC, NPT_PISTON_STEPS, SETTLE_HALT) at the deck defaults.
# Analyse with DECK = "shear_slab_two_pist" in the shear notebooks.

FOLDER=shear_slab_two_pist
export DECK_FILE=shear_slab_two_pist_periodic
DATANAME=final_config_slab_support_periodic_5beads_tall_rho04_new_1.0_1.0_14000002_two_pist
INTERACTION=1.0_1.0
NSTEPS=9000000          # hold per strain level, and the output-file tag
export PRESS_TARGET=1.5
export STRAINS="0.1"    # cumulative shear strains, space-separated

bash "$LAMMPS_WORK_DIR/scripts/run_lammps.sh" "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS"
