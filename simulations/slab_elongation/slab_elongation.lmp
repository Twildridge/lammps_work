# ========== Uniaxial Elongation Deformation Test ==========
# Starting from isolated gel configuration (snug box)
# Variables from bash script: dataname, interaction, epsSS, epsSP, nsteps
#
# Atom types: 1=polymer, 2=crosslinker, 3=solvent
#
# Reduced LJ units: tau = sigma*sqrt(m/epsilon)
# dt = 0.005 → 1e6 steps ≈ 4.1e3 tau
#
# Phases:
#   1. NPT equilibration (undeformed box)
#   2. Elongation in z direction (fix deform, x/y fixed)
#   3. NVT production (deformed configuration)


# ==========================================================================
#                              PARAMETERS
# ==========================================================================

# ----- Physical Parameters -----
variable sigma equal 1.0
variable temp_target equal 1.0
variable press_target equal 0.0
variable timestep_prod equal 0.005

# ----- Deformation Parameters -----
variable strain equal 0.005              # Engineering strain ξ
variable nsteps_equil equal 10000        # NPT equilibration steps
variable nsteps_deform equal 5000        # Deformation steps
# nsteps = production steps (from bash)

# ----- Output Frequencies -----
variable thermo_freq equal 1000
variable dump_freq_setup equal 1000      # Frequent dumps during setup (Phases 1-2)
variable dump_freq_prod equal 10000      # Sparse dumps during production (Phase 3)
variable stress_freq equal 1000

# ----- Time Averaging (stress) -----
# nfreq = nevery * nrepeat
variable nevery_stress equal 10
variable nrepeat_stress equal 100
variable nfreq_stress equal 1000


# ==========================================================================
#                           INITIALIZATION
# ==========================================================================

units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

pair_style lj/cut 2.5
bond_style fene

read_data data_files/${dataname}.data nocoeff

comm_modify cutoff 5.0

# Store initial box dimensions for deformation calculation
variable Lz0 equal lz
variable Lz_final equal v_Lz0*(1.0+v_strain)

print "========================================"
print "Uniaxial elongation: ${dataname}"
print "Interaction: epsSS=${epsSS}, epsSP=${epsSP}"
print "Engineering strain: ${strain}"
print "Initial Lz: ${Lz0}"
print "Final Lz: ${Lz_final}"
print "Equilibration steps: ${nsteps_equil}"
print "Deformation steps: ${nsteps_deform}"
print "Production steps: ${nsteps}"
print "========================================"


# ==========================================================================
#                          GROUP DEFINITIONS
# ==========================================================================

group polymer type 1 2
group solvent type 3
group all_mobile type 1 2 3


# ==========================================================================
#                       INTERATOMIC POTENTIALS
# ==========================================================================

# ----- LJ Interactions -----
pair_coeff * * 1.0 ${sigma} 2.5

# Polymer-solvent & solvent-solvent (tunable)
pair_coeff 1 3 ${epsSP} ${sigma} 2.5    # polymer-solvent
pair_coeff 2 3 ${epsSP} ${sigma} 2.5    # crosslinker-solvent
pair_coeff 3 3 ${epsSS} ${sigma} 2.5    # solvent-solvent

# ----- Bonds -----
bond_coeff * 40.0 3.0 1.0 1.0
special_bonds fene


# ==========================================================================
#                           THERMO OUTPUT
# ==========================================================================

thermo_style custom step temp pe ke etotal press pxx pyy pzz pxy pxz pyz vol lx ly lz
thermo_modify lost warn
thermo ${thermo_freq}


# ==========================================================================
#              PHASE 1: NPT EQUILIBRATION (Undeformed)
# ==========================================================================

print "========================================"
print "Phase 1: NPT equilibration (undeformed box)"
print "========================================"

reset_timestep 0
timestep ${timestep_prod}

# Trajectory dump for setup phases
dump traj_setup all_mobile custom ${dump_freq_setup} &
    traj_files/setup_${dataname}_${interaction}_${nsteps}.lammpstrj &
    id type mol x y z

# NPT with isotropic pressure coupling
fix nvt_equil all_mobile npt temp ${temp_target} ${temp_target} 1.0 iso ${press_target} ${press_target} 10.0

run ${nsteps_equil}

unfix nvt_equil

print "NPT equilibration complete"
print "Box dimensions after equilibration: $(lx) x $(ly) x $(lz)"


# ==========================================================================
#              PHASE 2: UNIAXIAL ELONGATION
# ==========================================================================

print "========================================"
print "Phase 2: Uniaxial elongation in z direction"
print "========================================"

# Update Lz0 after equilibration (box may have changed)
variable Lz0_equil equal lz
variable Lz_final_equil equal v_Lz0_equil*(1.0+v_strain)

print "Post-equilibration Lz: ${Lz0_equil}"
print "Target final Lz: ${Lz_final_equil}"

# Calculate strain rate: need to reach strain in nsteps_deform
# erate = strain / (nsteps_deform * dt)
variable erate equal v_strain/(v_nsteps_deform*v_timestep_prod)

print "Strain rate: ${erate} per time unit"

# NVT thermostat during deformation (no barostat - box is controlled by fix deform)
fix nvt_deform all_mobile nvt temp ${temp_target} ${temp_target} 1.0

# Deform box: elongate z at constant rate, x and y fixed
# "erate" specifies engineering strain rate
fix deform_z all deform 1 z erate ${erate} remap x

run ${nsteps_deform}

unfix deform_z
unfix nvt_deform

print "Elongation complete"
print "Final box dimensions: $(lx) x $(ly) x $(lz)"

# End setup trajectory
undump traj_setup


# ==========================================================================
#              PHASE 3: NVT PRODUCTION (Deformed Configuration)
# ==========================================================================

print "========================================"
print "Phase 3: NVT production in deformed configuration"
print "========================================"

# NVT thermostat for production
fix nvt_prod all_mobile nvt temp ${temp_target} ${temp_target} 1.0

# Production trajectory (sparse sampling)
dump traj_prod all_mobile custom ${dump_freq_prod} &
    traj_files/prod_${dataname}_${interaction}_${nsteps}.lammpstrj &
    id type mol x y z


# ==========================================================================
#                    ANALYSIS: POLYMER STRESS TENSOR
# ==========================================================================

# Per-atom stress for polymer group
compute stress_polymer polymer stress/atom NULL

# Box-wide stress components (sum over all polymer atoms)
# stress/atom outputs: xx, yy, zz, xy, xz, yz (in stress*volume units)
compute stress_xx polymer reduce sum c_stress_polymer[1]
compute stress_yy polymer reduce sum c_stress_polymer[2]
compute stress_zz polymer reduce sum c_stress_polymer[3]
compute stress_xy polymer reduce sum c_stress_polymer[4]
compute stress_xz polymer reduce sum c_stress_polymer[5]
compute stress_yz polymer reduce sum c_stress_polymer[6]

# Convert to true stress by dividing by volume
# Note: stress/atom already includes volume factor, so we divide by V to get stress
variable sigma_xx equal c_stress_xx/vol
variable sigma_yy equal c_stress_yy/vol
variable sigma_zz equal c_stress_zz/vol
variable sigma_xy equal c_stress_xy/vol
variable sigma_xz equal c_stress_xz/vol
variable sigma_yz equal c_stress_yz/vol


# ==========================================================================
#                    ANALYSIS: GEL METRICS
# ==========================================================================

# Center of mass
compute polymer_com polymer com

# Gyration tensor
compute rg_tensor polymer gyration

# Bounding box
compute minx polymer reduce min x
compute maxx polymer reduce max x
compute miny polymer reduce min y
compute maxy polymer reduce max y
compute minz polymer reduce min z
compute maxz polymer reduce max z

variable gel_lx equal c_maxx-c_minx
variable gel_ly equal c_maxy-c_miny
variable gel_lz equal c_maxz-c_minz
variable gel_vol_box equal v_gel_lx*v_gel_ly*v_gel_lz

# Box dimensions
variable box_lx equal lx
variable box_ly equal ly
variable box_lz equal lz


# ==========================================================================
#                    OUTPUT: STRESS TENSOR (time-averaged)
# ==========================================================================

# All 6 stress components in one file
fix avg_stress all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_sigma_xx v_sigma_yy v_sigma_zz v_sigma_xy v_sigma_xz v_sigma_yz &
    file output_files/stress_data/stress_polymer_${dataname}_${interaction}_${nsteps}.dat


# ==========================================================================
#                    OUTPUT: GEL DIMENSIONS
# ==========================================================================

fix out_gel_dims all print ${stress_freq} "$(step) ${gel_lx} ${gel_ly} ${gel_lz}" &
    file output_files/volume_data/gel_dimensions_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_box_dims all print ${stress_freq} "$(step) ${box_lx} ${box_ly} ${box_lz}" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_polymer_com all print ${stress_freq} "$(step) $(c_polymer_com[1]) $(c_polymer_com[2]) $(c_polymer_com[3])" &
    file output_files/volume_data/polymer_com_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_rg_tensor all print ${stress_freq} "$(step) $(c_rg_tensor[1]) $(c_rg_tensor[2]) $(c_rg_tensor[3])" &
    file output_files/volume_data/rg_tensor_${dataname}_${interaction}_${nsteps}.dat screen no


# ==========================================================================
#                         PRODUCTION RUN
# ==========================================================================

run ${nsteps}


# ==========================================================================
#                            CLEANUP
# ==========================================================================

print "========================================"
print "Uniaxial elongation simulation complete"
print "Final strain: ${strain}"
print "Final box: $(lx) x $(ly) x $(lz)"
print "========================================"

write_data final_elongation_${dataname}_${interaction}_${nsteps}.data