#!/usr/bin/env bash
#SBATCH --job-name=slab_isolated_tall_random
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH --mem=0
#SBATCH --time=10:00:00
#SBATCH --output=%x.o%j.%N
source "$HOME/Documents/lammps_work/scripts/batch_prologue.sh"

# Free-swelling equilibration of an ISOLATED gel block in its bath (no sheets) at P* = 1.5.
# Current input: the tall rot45 block re-wired into a random f = 4 network
# (scripts/data_file_generator.ipynb, NETWORK = "random"). BARO_MODE=iso keeps the block's
# aspect ratio (aniso has no restoring force on the box shape of an isolated gel); PIN_GEL=1
# zeroes the gel's linear and angular momentum so the free block neither drifts nor turns.
# Then convert final_config_<DATANAME>_1.0_1.0_<NSTEPS>.data with lib/add_more_plates_to_gel.py
# (--layout x_plates for shear_slab_two_pist, six_plates for compress_slab).

FOLDER=slab_with_support
DATANAME=slab_support_5beads_tall_rho04_nowalls_random
INTERACTION=1.0_1.0
NSTEPS=8000000
export PRESS_TARGET=1.5
export BARO_MODE=iso PIN_GEL=1 PISTON_TRANSPARENT=1
export CHAIN=1

bash "$LAMMPS_WORK_DIR/scripts/run_lammps.sh" "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS"
