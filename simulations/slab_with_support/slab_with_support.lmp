# ========== Slab equilibrating in solvent WITH SUPPORT ==========
# Variables loaded via bash script:
# - dataname: name of data file
# - interaction: epsSS_epsSP
# - nsteps: production run steps
# - oldsteps: previous timesteps (for restart)
# - totsteps: total cumulative timesteps
# - epsSS: solvent-solvent interaction strength
# - epsSP: solvent-polymer interaction strength

# Reduced LJ units: tau = sigma*sqrt(m/epsilon)
# (sigma = 1, m = 1, epsilon = 1.5)
# dt = 0.005 → 1e6 steps ≈ 4.1e3 tau


# ========== Simulation Parameters ==========
variable sigma equal 1.0
variable binWidth equal 2

# Time averaging parameters
variable nevery_avg_stress equal 100 
variable nrepeat_avg_stress equal 1000 # 625 or 50
variable nfreq_avg_stress equal 10000 # 125000 or 10000

# Output frequencies
variable thermo_freq equal 10000
variable dump_freq equal 10000
variable volume_freq equal 10000

# Equilibration parameters
variable temp_target equal 1.0
variable press_target equal 1.5 # APPROPRIATE VALUE IMPORTANT
variable tdamp equal 1.0
variable pdamp equal 1.0
variable timestep_gentle equal 0.001
variable timestep_prod equal 0.005
variable nsteps_gentle equal 5000



# ========== Initialization ==========
units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

# Read initial data or restart
variable is_restart equal is_file(restart_${dataname}_${interaction}_${oldsteps}.restart)
variable restartFlag string file

# Force fresh start if oldsteps is 0
if "${oldsteps} == 0" then &
    "variable is_restart equal 0"

if "${is_restart} == 1" then &
    "read_restart restart_${dataname}_${interaction}_${oldsteps}.restart" &
else &
    "read_data data_files/${dataname}.data"

if "${is_restart} == 1" then &
    "variable restartFlag string append"


print ">>> is_restart = ${is_restart}"
print ">>> Previous    # of timesteps: ${oldsteps}"
print ">>> Current     # of timesteps: ${nsteps}"
print ">>> Cumulative  # of timesteps: ${totsteps}"

comm_modify cutoff 5.0



# ========== Group Definitions ==========
group polymer type 1 2
group solvent type 3
group support type 4
group piston type 5
group mobile type 1 2 3
group polymer_and_support type 1 2 4 5



# =====================================================================
#   PHASE 0 (fresh start only): SOFT PUSH-OFF
# =====================================================================
# Harmonic bonds pull beads to r₀ = 0.96σ without any divergence
# Soft pairs prevent pair overlaps with finite, bounded forces

if "${is_restart} == 0" then &
    "pair_style soft 1.122"              &
    "pair_coeff * * 50.0"              &
    "pair_coeff 4 4 0.0"              &
    "pair_coeff 5 5 0.0"              &
    "pair_coeff 4 5 0.0"              &
    "bond_style harmonic"              &
    "bond_coeff * 200.0 0.96"         &
    "special_bonds lj 0 1 1"

# Freeze support and piston during push-off
velocity support set 0.0 0.0 0.0
fix freeze_support support setforce 0.0 0.0 0.0
velocity piston set 0.0 0.0 0.0
fix freeze_piston piston setforce 0.0 0.0 0.0

# Thermo output for monitoring push-off
thermo_style custom step temp pe ke etotal press vol lx ly lz
thermo 1000

if "${is_restart} == 0" then &
    "velocity mobile create 0.01 12345 mom yes rot no"   &
    "fix pushoff mobile nve/limit 0.05"                   &
    "fix lang_pushoff mobile langevin 0.01 0.01 ${tdamp} 904297" &
    "timestep ${timestep_gentle}"                        &
    "run 10000"                                          &
    "unfix pushoff"                                      &
    "unfix lang_pushoff"

# After push-off, bonds should be near 0.96σ. Check with thermo PE:
# PE should have dropped from ~10^19 to ~10^3 or lower.


# =====================================================================
#   PHASE 1: SWITCH TO PRODUCTION POTENTIALS
# =====================================================================
# Redefine pair and bond styles. This is required for both fresh and
# restart paths — on restart, read_restart restores styles, but we
# redefine them here for clarity and safety.

pair_style lj/cut 1.122                  # WAS 2.5
pair_coeff * * 1.0 ${sigma} 1.122        # WAS 2.5
pair_coeff 1 3 ${epsSP} ${sigma} 1.122 # WAS 2.5   # polymer-solvent
pair_coeff 2 3 ${epsSP} ${sigma} 1.122 # WAS 2.5   # crosslinker-solvent
pair_coeff 3 3 ${epsSS} ${sigma} 1.122 # WAS 2.5   # solvent-solvent
pair_coeff 1 4 1.0 ${sigma} 1.122       # polymer-support (WCA)
pair_coeff 2 4 1.0 ${sigma} 1.122       # crosslinker-support (WCA)
pair_coeff 3 4 0.0 ${sigma} 0.0        # solvent-support (off)
pair_coeff 4 4 0.0 ${sigma} 0.0        # support-support (off)
pair_coeff 1 5 1.0 ${sigma} 1.122       # polymer-piston (WCA)
pair_coeff 2 5 1.0 ${sigma} 1.122       # crosslinker-piston (WCA)
pair_coeff 3 5 1.0 ${sigma} 1.122       # solvent-piston (WCA)
pair_coeff 4 5 0.0 ${sigma} 0.0        # support-piston (off)
pair_coeff 5 5 0.0 ${sigma} 0.0        # piston-piston (off)

bond_style fene
bond_coeff * 30.0 1.5 1.0 1.0
special_bonds fene

# Neighbor list exclusions
neigh_modify exclude type 4 4   # support-support
neigh_modify exclude type 5 5   # piston-piston
neigh_modify exclude type 4 5   # support-piston

# Angle style (uncomment if angles present in data file)
#angle_style hybrid cosine harmonic
#angle_coeff 1 cosine 1.0
#angle_coeff 2 harmonic 40.0 109.47


# =====================================================================
#   PHASE 2: ENERGY MINIMIZATION
# =====================================================================
# Now safe — bonds are near 0.96σ (after push-off) or at equilibrium
# (after restart). Piston/support still frozen via setforce.

if "${is_restart} == 0" then &
    "minimize 1.0e-4 1.0e-6 10000 100000"

# Release piston: switch from setforce freeze to z-free rigid body
unfix freeze_piston
fix rigid_piston piston rigid single force * off off on torque * off off off


# =====================================================================
#   THERMO OUTPUT
# =====================================================================
thermo_style custom step temp pe ke etotal press vol lx ly lz
thermo ${thermo_freq}

# Trajectory output
dump poly_traj polymer_and_support custom ${dump_freq} traj_files/polymer_${dataname}_${interaction}_${totsteps}.lammpstrj id type mol x y z

# =====================================================================
#   PHASE 3: GENTLE NVT THERMALIZATION
# =====================================================================
if "${is_restart} == 0" then "reset_timestep 0"
if "${is_restart} == 0" then "velocity mobile create 0.01 12345 mom yes rot no"
if "${is_restart} == 0" then "fix 1 mobile nve/limit 0.05"
if "${is_restart} == 0" then "fix 2 mobile langevin 0.01 ${temp_target} ${tdamp} 904297"
if "${is_restart} == 0" then "timestep ${timestep_gentle}"
if "${is_restart} == 0" then "run ${nsteps_gentle}"
if "${is_restart} == 0" then "unfix 1"
if "${is_restart} == 0" then "unfix 2"


# ========== Gel Volume Calculations ==========
# Method 1: Bounding box
compute minx polymer reduce min x
compute maxx polymer reduce max x
compute miny polymer reduce min y
compute maxy polymer reduce max y
compute minz polymer reduce min z
compute maxz polymer reduce max z

variable gel_lx equal c_maxx-c_minx
variable gel_ly equal c_maxy-c_miny
variable gel_lz equal c_maxz-c_minz
variable gel_vol_box equal v_gel_lx*v_gel_ly*v_gel_lz

# Method 2: Radius of gyration
compute rg_polymer polymer gyration
variable rg_cubed equal c_rg_polymer^3



# ========== Box Dimensions ==========
variable box_lx equal lx
variable box_ly equal ly
variable box_lz equal lz



# ========== NPT Equilibration ==========
#if "${is_restart} == 0" then "reset_timestep 0"
fix 1 mobile npt temp ${temp_target} ${temp_target} ${tdamp} iso ${press_target} ${press_target} ${pdamp} # dilate mobile fixedpoint $(lx/2) $(ly/2) 0
timestep ${timestep_prod}
if "${is_restart} == 0" then "run ${nsteps_gentle}"



# ========== Production Run with Time Averaging ==========

# Volume and dimension output
fix gel_vol_bb_output all print ${volume_freq} "${gel_vol_box}" &
    ${restartFlag} output_files/volume_data/gel_volume_bb_${dataname}_${interaction}_${totsteps}.dat screen no

fix gel_vol_rg_output all print ${volume_freq} "$(step) ${rg_cubed}" &
    ${restartFlag} output_files/volume_data/gel_volume_rg_${dataname}_${interaction}_${totsteps}.dat screen no

fix gel_dims_output all print ${volume_freq} "$(step) ${gel_lx} ${gel_ly} ${gel_lz}" &
    ${restartFlag} output_files/volume_data/gel_dimensions_${dataname}_${interaction}_${totsteps}.dat screen no

fix box_dims_output all print ${volume_freq} "$(step) ${box_lx} ${box_ly} ${box_lz}" &
    ${restartFlag} output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat screen no



# Production run
fix remove_drift mobile momentum 1000 linear 1 1 1 angular
run ${nsteps}



# ========== Cleanup ==========
unfix 1
unfix remove_drift
undump poly_traj



# ========== Save Final Configuration ==========
write_restart restart_${dataname}_${interaction}_${totsteps}.restart
write_data final_config_${dataname}_${interaction}_${totsteps}.data
