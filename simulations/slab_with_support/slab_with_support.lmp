# ========== Slab equilibrating in solvent WITH SUPPORT ==========
# Variables loaded via bash script:
# - dataname: name of data file
# - interaction: epsSS_epsSP
# - nsteps: production run steps
# - oldsteps: previous timesteps (for restart)
# - totsteps: total cumulative timesteps
# - epsSS: solvent-solvent interaction strength
# - epsSP: solvent-polymer interaction strength

# Reduced LJ units: tau = sigma*sqrt(m/epsilon)
# (sigma = 1, m = 1, epsilon = 1.5)
# dt = 0.005 → 1e6 steps ≈ 4.1e3 tau


# ========== Simulation Parameters ==========
variable sigma equal 1.0
variable binWidth equal 2

# Time averaging parameters
variable nevery_avg_stress equal 100 
variable nrepeat_avg_stress equal 1000 # 625 or 50
variable nfreq_avg_stress equal 10000 # 125000 or 10000

# Output frequencies
variable thermo_freq equal 100000
variable dump_freq equal 100000
variable volume_freq equal 10000

# ----- Continuation flag -----
# 0 = fresh start (default)  1 = continuation from a final .data file
# When cont=1 the push-off, minimization, gentle NVT thermalization, and NPT
# warm-up are all skipped — the data file already holds an equilibrated config.
variable cont       index 0

# ----- Ghost-atom (comm) cutoff (2026-11-07) -----
# comm_modify cutoff must reach every bonded partner.  A fresh walk-placed file holds a few
# bonds of several sigma until the push-off shortens them, so start-up keeps 5.0; once the
# bonds sit near 0.96 sigma (after the minimize, or straight away with cont=1) the cutoff
# drops to comm_cutoff.  The allocation benchmark (simulations/allocation_benchmark,
# layouts_rot45.txt) measured 1.4-1.6x more steps/s at 2.5 with identical step-0 forces.
variable comm_cutoff index 2.5

# ----- Wall-clock budget (2026-09-30) -----
# wall_timeout = seconds LAMMPS may run (counted from the `timer timeout` command
# below, i.e. from start-up) before it ends the production loop on its own;
# 0 = unlimited.  run_lammps.sh / continue_sim.sh set it from the SLURM job's
# remaining time minus a margin.  When it fires, the production block in flight
# returns early ("WARNING: Wall time limit reached"), its snapshot is written as
# usual, the loop exits and the deck reports PRODUCTION_STEPS_DONE ... INCOMPLETE,
# which is what `continue_sim.sh --chain` (CHAIN=1 in the .batch) turns into a
# continuation job for the remaining steps.  docs/running_simulations.md 5e.
variable wall_timeout index 0

# ----- Piston transparency (trial, 2026-09-07) -----
# 0 = piston sheet is a WCA wall to solvent (default).  1 = solvent-piston pair
# zeroed, so the sheet is invisible to solvent (it still repels polymer and is
# still backstopped by the support).  Purpose: a stress-profile rerun on the
# 14M-step rho04 snapshots showed the ONLY large deviatoric-stress source in the
# box is the solvent-excluded layer on each side of the piston (~2.8 eps/sigma^2
# of wall tension); the aniso barostat then forces the gel to carry the equal and
# opposite in-plane stress, giving sig_p,xx = sig_p,yy = 1.0185 * sig_p,zz.  With
# the piston transparent that offset should collapse to ~0.  Set via
# PISTON_TRANSPARENT=1 in the batch file (run_lammps.sh passes it as -var).
variable piston_transparent index 0

# ----- Barostat coupling (2026-09-29) -----
# aniso (default) = x, y, z barostatted INDEPENDENTLY: right for a gel that is
#   PERIODIC in x and y, whose network elasticity fixes lx and ly.
# iso | z = for an ISOLATED gel (a finite network floating in its bath, e.g. the
#   cube of slab_support_5beads_tall_rho04_new_03).  Nothing elastic spans the box
#   there, so the box SHAPE is a neutral mode of the aniso barostat and any small
#   stress anisotropy (the wall tension of the support / piston sheets) drives it
#   without limit: run new_02 (1.0_1.2, 500k steps) went from 99.6 x 99.6 x 86.6 to
#   71.4 x 71.3 x 238.2 at CONSTANT VOLUME while the gel stayed ~62-66 sigma (Rg),
#   i.e. the box collapsed laterally onto the gel -- the gel did not swell into it.
#   iso scales the three edges together (aspect ratio of the data file kept);
#   z moves lz only (lx, ly of the data file kept).  Use PISTON_TRANSPARENT=1 with
#   iso so the sheets carry no solvent wall tension into the mean pressure.
#   A data file WITHOUT sheets (slab_with_support.ipynb, includeWalls = False) has no
#   wall tension, so `aniso` no longer runs away; the box shape then only random-walks
#   under the pressure noise (no restoring force) -- watch box_dimensions.
# Set via BARO_MODE in the batch file (run_lammps.sh passes it as -var).
variable baro_mode index aniso

# ----- Pin the gel (2026-09-30, isolated gel only) -----
# 1 = zero the POLYMER group's linear and angular momentum every pin_gel_every steps
# (velocity reset only; the thermostat replaces the removed kinetic energy).  A free
# ~60-sigma block diffuses ~8 sigma and TURNS ~0.25 rad (~14 deg) in 10M steps; a
# turned cube no longer has its faces along the box axes, and add_more_plates_to_gel
# parks the plates along the box axes.  fix remove_drift below zeroes the momentum of
# ALL mobile atoms (gel + bath), which does not stop the gel moving relative to the
# bath.  Off by default: the angular momentum of a network that spans the periodic
# box (the slab) is not a meaningful quantity.  Set via PIN_GEL in the batch file.
variable pin_gel       index 0
variable pin_gel_every index 100

# ----- Rg-plateau halt (2026-11-03, chain_length_testing) -----
# rg_halt = 1 ends production early once the gel's radius of gyration has stopped
# moving: production runs in blocks of rg_block steps (n_snaps is then
# ceil(nsteps / rg_block), a snapshot after every block as before); fix rg_block_avg
# averages c_rg_polymer over each block (one sample every rg_every steps) and after
# each block the relative change of the block mean from the previous block's is
# compared with rg_tol.  rg_nconsec consecutive blocks under rg_tol = the plateau is
# DETECTED (RG_PLATEAU_DETECTED); the deck then runs a TAIL of rg_extra x the
# production steps done so far, rounded up to whole blocks (at least one), prints
# RG_PLATEAU_CONVERGED, leaves the loop and reports STATUS COMPLETE (the final_config
# is written and the chain stops) -- the <totsteps> tag of the file names stays the
# requested budget; the log says how many steps were run.  The 5-bead random slab's
# Rg (14 M steps) changed by 2.7 % over its first 1 M-step block and by 0.02-0.14 %
# per block after 10 M (block-to-block noise ~0.05 %); on its convergence plot the
# Rg^3 trace is flat from ~13-14 M, and the user wants the run 5-10 % longer than
# that point (2026-11-03).  rg_tol 0.0015 with THREE consecutive blocks detects the
# plateau there at 13 M and the 10 % tail (2 blocks) ends it at 15 M.  Longer
# strands relax more slowly (the collective time scales with the mesh size), so give
# them LONGER blocks (chain_length_testing_sweep.batch: 1.5-3 M) rather than a
# looser tolerance: a slow drift inside a short block would pass as a plateau.  A
# continuation job starts its count afresh (the previous blocks' means are not
# carried over), so a chain hop costs rg_nconsec + tail extra blocks at most.  Knobs
# come from the batch through run_lammps.sh / continue_sim.sh (RG_HALT, RG_BLOCK,
# RG_EVERY, RG_TOL, RG_NCONSEC, RG_EXTRA); rg_every must divide rg_block.
variable rg_halt    index 0
variable rg_block   index 1000000
variable rg_every   index 10000
variable rg_tol     index 0.0015
variable rg_nconsec index 3
variable rg_extra   index 0.10

# Equilibration parameters
variable temp_target equal 1.0
variable press_target index 1.5 # APPROPRIATE VALUE IMPORTANT — overridden by -var on command line
variable vel_seed     index 12345  # RNG seed for create_velocity; overridden by -var for replica sweeps
variable tdamp equal 1.0
variable pdamp equal 5.0   # ~1000*dt (dt=0.005); looser than 1.0 to avoid barostat ringing during swelling
variable timestep_gentle equal 0.001
variable timestep_prod equal 0.005
variable nsteps_gentle equal 5000



# ========== Initialization ==========
units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

# Arm the wall-clock budget here (not at the production loop) so the ~1 h of
# push-off/minimize/warm-up of a 1 M-atom system is charged against it.
if "${wall_timeout} > 0" then "timer timeout ${wall_timeout} every 1000"

# Read initial data or restart
variable is_restart equal is_file(restart_${dataname}_${interaction}_${oldsteps}.restart)
variable restartFlag string file

# Force fresh start if oldsteps is 0
if "${oldsteps} == 0" then &
    "variable is_restart equal 0"

# A continuation reads a write_data snapshot, which carries "Pair Coeffs # lj/cut"
# and "Bond Coeffs # fene" sections that read_data refuses unless the styles are
# already declared (2026-09-30: the cont=1 path had never run for this deck).
# Phase 1 re-declares both and sets every coefficient, so nothing else changes.
if "${cont} == 1" then &
    "pair_style lj/cut 1.122" &
    "bond_style fene"

if "${is_restart} == 1" then &
    "read_restart restart_${dataname}_${interaction}_${oldsteps}.restart" &
else &
    "read_data data_files/${dataname}.data"

if "${is_restart} == 1" then &
    "variable restartFlag string append"


print ">>> is_restart = ${is_restart}"
print ">>> Previous    # of timesteps: ${oldsteps}"
print ">>> Current     # of timesteps: ${nsteps}"
print ">>> Cumulative  # of timesteps: ${totsteps}"

comm_modify cutoff 5.0



# ========== Group Definitions ==========
group polymer type 1 2
group solvent type 3
group support type 4
group piston type 5
group mobile type 1 2 3
group polymer_and_support type 1 2 4 5

# ---------- Thermostatted-group temperature (diagnostic) ----------
# The thermo `temp` column is compute thermo_temp over group `all`, but only
# `mobile` (types 1,2,3) is thermostatted: the support is frozen and the piston
# is a force-constrained plate, so 46632 of the 238717 atoms carry no thermal
# kinetic energy and drag the reported value down by exactly N_mobile/N_all =
# 192085/238717 = 0.8047.  That is why the 14M-step runs log temp ~= 0.804 while
# temp_target = 1.0 -- nothing is wrong with the thermostat (`fix langevin`
# computes its own temperature internally on its own group).  c_mobile_temp
# below is the physical temperature and should sit at ${temp_target}.
# Naming matches triaxial_compression.lmp / triaxial_permeation.lmp so that
# plot_lammps_log.py picks it up (it already prefers c_mobile_temp over Temp).
# NOTE: diagnostic column only -- do NOT `thermo_modify temp mobile_temp`, that
# would also feed the mobile temperature into thermo_press's kinetic term and
# change the reported pressure the barostat diagnostics rely on.
compute mobile_temp mobile temp



# =====================================================================
#   PHASE 0 (fresh start only): SOFT PUSH-OFF
# =====================================================================
# Harmonic bonds pull beads to r₀ = 0.96σ without any divergence
# Soft pairs prevent pair overlaps with finite, bounded forces

if "${is_restart} == 0 && ${cont} == 0" then &
    "pair_style soft 1.122"              &
    "pair_coeff * * 50.0"              &
    "pair_coeff 4 4 0.0"              &
    "pair_coeff 5 5 0.0"              &
    "pair_coeff 4 5 0.0"              &
    "bond_style harmonic"              &
    "bond_coeff * 200.0 0.96"         &
    "special_bonds lj 0 1 1"

# Freeze support and piston during push-off
velocity support set 0.0 0.0 0.0
fix freeze_support support setforce 0.0 0.0 0.0
velocity piston set 0.0 0.0 0.0
fix freeze_piston piston setforce 0.0 0.0 0.0

# Thermo output for monitoring push-off
thermo_style custom step temp c_mobile_temp pe ke etotal press vol lx ly lz
thermo 1000

if "${is_restart} == 0 && ${cont} == 0" then &
    "velocity mobile create 0.01 ${vel_seed} mom yes rot no"   &
    "fix pushoff mobile nve/limit 0.05"                          &
    "fix lang_pushoff mobile langevin 0.01 0.01 ${tdamp} 904297" &
    "timestep ${timestep_gentle}"                        &
    "run 10000"                                          &
    "unfix pushoff"                                      &
    "unfix lang_pushoff"

# After push-off, bonds should be near 0.96σ. Check with thermo PE:
# PE should have dropped from ~10^19 to ~10^3 or lower.


# =====================================================================
#   PHASE 1: SWITCH TO PRODUCTION POTENTIALS
# =====================================================================
# Redefine pair and bond styles. This is required for both fresh and
# restart paths — on restart, read_restart restores styles, but we
# redefine them here for clarity and safety.

pair_style lj/cut 1.122                  # WAS 2.5
pair_coeff * * 1.0 ${sigma} 1.122        # WAS 2.5
pair_coeff 1 3 ${epsSP} ${sigma} 1.122 # WAS 2.5   # polymer-solvent
pair_coeff 2 3 ${epsSP} ${sigma} 1.122 # WAS 2.5   # crosslinker-solvent
pair_coeff 3 3 ${epsSS} ${sigma} 1.122 # WAS 2.5   # solvent-solvent
pair_coeff 1 4 1.0 ${sigma} 1.122       # polymer-support (WCA)
pair_coeff 2 4 1.0 ${sigma} 1.122       # crosslinker-support (WCA)
pair_coeff 3 4 0.0 ${sigma} 0.0        # solvent-support (off)
pair_coeff 4 4 0.0 ${sigma} 0.0        # support-support (off)
pair_coeff 1 5 1.0 ${sigma} 1.122       # polymer-piston (WCA)
pair_coeff 2 5 1.0 ${sigma} 1.122       # crosslinker-piston (WCA)
pair_coeff 3 5 1.0 ${sigma} 1.122       # solvent-piston (WCA)
pair_coeff 4 5 1.0 ${sigma} 1.122      # support-piston (WCA backstop): if the
                                       #   piston floats up through the top z-PBC
                                       #   it re-enters below the support and is
                                       #   stopped at contact instead of passing
                                       #   through into the gel from below.
pair_coeff 5 5 0.0 ${sigma} 0.0        # piston-piston (off)
if "${piston_transparent} == 1" then &
    "pair_coeff 3 5 0.0 ${sigma} 0.0" &
    "neigh_modify exclude type 3 5" &
    "print '>>> PISTON TRANSPARENT TO SOLVENT (pair 3-5 off)'"

bond_style fene
bond_coeff * 30.0 1.5 1.0 1.0
special_bonds fene

# Neighbor list exclusions
neigh_modify exclude type 4 4   # support-support
neigh_modify exclude type 5 5   # piston-piston
# neigh_modify exclude type 4 5   # support-piston: EXCLUSION REMOVED so the
#   WCA backstop above (pair_coeff 4 5) is actually computed. Re-add this line
#   (and reset pair_coeff 4 5 to 0.0) to restore pass-through behavior.

# Angle style (uncomment if angles present in data file)
#angle_style hybrid cosine harmonic
#angle_coeff 1 cosine 1.0
#angle_coeff 2 harmonic 40.0 109.47


# =====================================================================
#   PHASE 2: ENERGY MINIMIZATION
# =====================================================================
# Now safe — bonds are near 0.96σ (after push-off) or at equilibrium
# (after restart). Piston/support still frozen via setforce.

if "${is_restart} == 0 && ${cont} == 0" then &
    "minimize 1.0e-4 1.0e-6 10000 100000"

# Bonds are relaxed from here on: shrink the ghost cutoff (see comm_cutoff at the top).
comm_modify cutoff ${comm_cutoff}

# Release piston: free to fluctuate in z, frozen and PERIODIC in x/y.
# NOTE: do NOT use `fix rigid` here — the piston sheet now spans the entire
# periodic box in x and y, and a rigid body wider than half the box is
# mis-reconstructed by rigid's nearest-image unwrapping. Instead:
#   - setforce 0 0 NULL  : zero x/y forces so the sheet can't drift laterally
#                          (it stays tiled and periodic with the box)
#   - aveforce NULL NULL 0.0 : give every piston atom the SAME z-force (the
#                          group average), so the plate translates uniformly in
#                          z and stays flat as solvent equilibrates around it
#   - nve                : integrate the piston (mobile group / npt does not)
# This is periodic-safe and frictionless; the box-expansion coupling is a
# separate issue (dilate/aniso-z) handled elsewhere.
unfix freeze_piston
fix piston_xy  piston setforce 0.0 0.0 NULL
fix piston_z   piston aveforce NULL NULL 0.0
fix piston_nve piston nve


# =====================================================================
#   THERMO OUTPUT
# =====================================================================
thermo_style custom step temp c_mobile_temp pe ke etotal press vol lx ly lz
thermo ${thermo_freq}

# Trajectory output
dump poly_traj polymer_and_support custom ${dump_freq} traj_files/polymer_${dataname}_${interaction}_${totsteps}.lammpstrj id type mol x y z

# =====================================================================
#   PHASE 3: GENTLE NVT THERMALIZATION
# =====================================================================
if "${is_restart} == 0 && ${cont} == 0" then "reset_timestep 0"
if "${is_restart} == 0 && ${cont} == 0" then "velocity mobile create 0.01 ${vel_seed} mom yes rot no"
if "${is_restart} == 0 && ${cont} == 0" then "fix 1 mobile nve/limit 0.05"
if "${is_restart} == 0 && ${cont} == 0" then "fix 2 mobile langevin 0.01 ${temp_target} ${tdamp} 904297"
if "${is_restart} == 0 && ${cont} == 0" then "timestep ${timestep_gentle}"
if "${is_restart} == 0 && ${cont} == 0" then "run ${nsteps_gentle}"
if "${is_restart} == 0 && ${cont} == 0" then "unfix 1"
if "${is_restart} == 0 && ${cont} == 0" then "unfix 2"


# ========== Gel Volume Calculations ==========
# Method 1: Bounding box
compute minx polymer reduce min x
compute maxx polymer reduce max x
compute miny polymer reduce min y
compute maxy polymer reduce max y
compute minz polymer reduce min z
compute maxz polymer reduce max z

variable gel_lx equal c_maxx-c_minx
variable gel_ly equal c_maxy-c_miny
variable gel_lz equal c_maxz-c_minz
variable gel_vol_box equal v_gel_lx*v_gel_ly*v_gel_lz

# Method 2: Radius of gyration
compute rg_polymer polymer gyration
variable rg_cubed equal c_rg_polymer^3



# ========== Box Dimensions ==========
variable box_lx equal lx
variable box_ly equal ly
variable box_lz equal lz



# ========== NPT Equilibration ==========
#if "${is_restart} == 0" then "reset_timestep 0"
# aniso: barostat x, y, z INDEPENDENTLY to press_target (σxx=σyy=σzz=P), box
# aspect ratio free. This is the free-swelling-in-a-bath analogue — each face is
# held at the bath pressure with no imposed coupling, so the gel relaxes to its
# own equilibrium shape instead of being locked to the data file's tall aspect
# ratio (which is what `iso` did: it controls only the mean pressure and freezes
# the aspect ratio, so the inherited z-swelling / z-padding never relaxes).
# Cell stays orthogonal (no tilt) — use `tri` only if a real shear stress must relax.
# THERMOSTAT (2026-09-05): Langevin + NPH, not Nose-Hoover NPT.  The Nose-Hoover
# `fix npt` this used to be did NOT hold T = temp_target here -- the 14M-step
# rho04 output data file carries velocities at T = 1.24 in all three directions
# (FENE bonds feed KE in faster than a single Nose-Hoover chain removes it; the
# triaxial script saw the same and switched to Langevin long ago).  Every
# downstream run then had to cool the slab to T = 1 and re-shrink the box.
# Langevin's per-atom friction always wins, so the state written at the end is
# genuinely at temp_target.  The barostat is unchanged: `nph aniso` relaxes x, y
# and z INDEPENDENTLY to press_target with the aspect ratio free (see the note
# above); Langevin supplies the temperature, nph the pressure.  Both are unfixed
# together in Cleanup.
fix lang_prod mobile langevin ${temp_target} ${temp_target} ${tdamp} 480279
if "${baro_mode} == iso" then &
    "fix 1 mobile nph iso ${press_target} ${press_target} ${pdamp}" &
elif "${baro_mode} == z" &
    "fix 1 mobile nph z ${press_target} ${press_target} ${pdamp}" &
else &
    "fix 1 mobile nph aniso ${press_target} ${press_target} ${pdamp}"
print ">>> barostat coupling: baro_mode = ${baro_mode}"
timestep ${timestep_prod}
if "${is_restart} == 0 && ${cont} == 0" then "run ${nsteps_gentle}"



# ========== Production Run with Time Averaging ==========

# Volume and dimension output
fix gel_vol_bb_output all print ${volume_freq} "${gel_vol_box}" &
    ${restartFlag} output_files/volume_data/gel_volume_bb_${dataname}_${interaction}_${totsteps}.dat screen no

fix gel_vol_rg_output all print ${volume_freq} "$(step) ${rg_cubed}" &
    ${restartFlag} output_files/volume_data/gel_volume_rg_${dataname}_${interaction}_${totsteps}.dat screen no

fix gel_dims_output all print ${volume_freq} "$(step) ${gel_lx} ${gel_ly} ${gel_lz}" &
    ${restartFlag} output_files/volume_data/gel_dimensions_${dataname}_${interaction}_${totsteps}.dat screen no

fix box_dims_output all print ${volume_freq} "$(step) ${box_lx} ${box_ly} ${box_lz}" &
    ${restartFlag} output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat screen no

# ========== Sparse stress-anisotropy check (2026-09-05) ==========
# Under the aniso barostat the BOX-AVERAGE P_xx = P_yy = P_zz = press_target by
# construction, so the total pressure tensor says nothing about whether the GEL
# itself has relaxed.  The polymer partial stress does: sigma_p,ii = -sum_i S_ii/V
# over the polymer group (stress/atom, kinetic term included) is anisotropic
# (xx/zz, yy/zz != 1) until the slab has relaxed its inherited aspect ratio, and
# the triaxial reference state inherits whatever anisotropy is left here.
# plot_lammps_log.py draws sigma_p,xx/sigma_p,zz and sigma_p,yy/sigma_p,zz vs step
# from this file (stress_anisotropy panel).
#
# COST: the per-atom virial is tallied only on the timesteps this fix samples
# (fix ave/time registers them with addstep_compute), i.e. aniso_nrepeat one-step
# tallies per aniso_nfreq steps -- 20 per 200k = 0.01% of the steps.  Reported
# every 200k steps; each report averages 20 samples 10k steps apart (a single
# global sum is noisy enough that the 20-sample mean is worth the free averaging).
# The total pressure tensor (compute pressure) is logged alongside for context.
shell mkdir output_files/stress_data
compute stress_poly_aniso polymer stress/atom NULL
compute sp_xx polymer reduce sum c_stress_poly_aniso[1]
compute sp_yy polymer reduce sum c_stress_poly_aniso[2]
compute sp_zz polymer reduce sum c_stress_poly_aniso[3]
variable sig_p_xx equal -c_sp_xx/vol
variable sig_p_yy equal -c_sp_yy/vol
variable sig_p_zz equal -c_sp_zz/vol
compute press_tensor all pressure thermo_temp
variable aniso_nevery  equal 10000
variable aniso_nrepeat equal 20
variable aniso_nfreq   equal 200000     # = aniso_nevery * aniso_nrepeat
fix stress_aniso_output all ave/time ${aniso_nevery} ${aniso_nrepeat} ${aniso_nfreq} &
    v_sig_p_xx v_sig_p_yy v_sig_p_zz c_press_tensor[1] c_press_tensor[2] c_press_tensor[3] &
    ${restartFlag} output_files/stress_data/stress_aniso_${dataname}_${interaction}_${totsteps}.dat &
    title2 "# TimeStep sig_p_xx sig_p_yy sig_p_zz P_xx P_yy P_zz   (polymer partial stress = -sum S_ii/V, pressure sign; total pressure tensor)"




# Production run — split into n_snaps sequential blocks; write a data snapshot after each.
# Snapshot files: final_config_${dataname}_${interaction}_${totsteps}_snap<N>.data
# volmix_sweep isolates each snapshot independently so ΔV_mix error bars capture
# both snapshot-to-snapshot composition variance AND thermal (NPT-replica) variance.
variable n_snaps        index 3   # snapshots per run; override with -var n_snaps N
# With the Rg-plateau halt the block IS the test window: rg_block steps per snapshot,
# as many blocks as the budget holds (the last may run past nsteps by < rg_block).
if "${rg_halt} == 1" then &
    "variable n_blocks       equal ceil(${nsteps}/${rg_block})" &
    "variable steps_per_snap equal ${rg_block}" &
else &
    "variable n_blocks       equal ${n_snaps}" &
    "variable steps_per_snap equal round(${nsteps}/${n_snaps})"

if "${cont} == 1" then "print '>>> Continuing after ${oldsteps} timesteps'"
fix remove_drift mobile momentum 1000 linear 1 1 1 angular
if "${pin_gel} == 1" then &
    "fix pin_gel polymer momentum ${pin_gel_every} linear 1 1 1 angular" &
    "print '>>> gel pinned: polymer linear + angular momentum zeroed every ${pin_gel_every} steps'"

variable prod_start  equal $(step)             # absolute step at which production starts
variable prod_done   equal step-v_prod_start    # production steps completed so far
variable prod_target equal ${nsteps}-${n_blocks}   # "all of nsteps" up to the steps_per_snap rounding

# Rg-plateau bookkeeping (rg_halt = 1 only; see the knob block).  rg_prev = the previous
# block's mean Rg (0 before the first), rg_ok = consecutive blocks under rg_tol,
# rg_conv = 1 once converged.  The three are re-set each block with `variable delete`
# + redefine; rg_dev / rg_ok_next are formulas evaluated at that moment.  The block
# mean is read as f_rg_block_avg right after the block's run: fix ave/time completes a
# window every rg_block steps, so each block ends with a fresh window (its samples lag
# the block by the warm-up offset, the same for every block).  A block whose window
# could not complete (a continuation starting mid-window) reads 0 and is never
# counted as converged (the f_rg_block_avg > 0 factor; the denominator guard avoids
# a divide by zero).
variable rg_prev      equal 0.0
variable rg_ok        equal 0
variable rg_conv      equal 0      # 1 once the plateau is detected (the tail is running)
variable rg_tail_left equal 0      # tail blocks still to run after detection
# tail length in blocks = max(1, ceil(rg_extra * prod_done / rg_block)), written without max() (a
# vector-only special function in LAMMPS formulas): x + (x < 1) * (1 - x)
variable rg_tail_calc equal ceil(v_rg_extra*v_prod_done/v_rg_block)+(ceil(v_rg_extra*v_prod_done/v_rg_block)<1)*(1-ceil(v_rg_extra*v_prod_done/v_rg_block))
if "${rg_halt} == 1" then &
    "variable rg_nrep equal round(${rg_block}/${rg_every})" &
    "fix rg_block_avg all ave/time ${rg_every} ${rg_nrep} ${rg_block} c_rg_polymer" &
    "variable rg_dev     equal abs(f_rg_block_avg-v_rg_prev)/(f_rg_block_avg+(f_rg_block_avg==0))" &
    "variable rg_ok_next equal (f_rg_block_avg>0)*(v_rg_dev<v_rg_tol)*(v_rg_ok+1)" &
    "print '>>> RG_HALT armed: block ${rg_block} steps (${n_blocks} blocks budgeted), tol ${rg_tol}, ${rg_nconsec} consecutive blocks, then a tail of ${rg_extra} x the steps done'"

variable snap_i loop ${n_blocks}
label snap_loop
    run ${steps_per_snap}
    variable snap_outfile string "final_config_${dataname}_${interaction}_${totsteps}_snap${snap_i}"
    write_data ${snap_outfile}.data
    print ">>> Wrote snapshot ${snap_i}/${n_blocks} at step $(step)"
    # Wall-clock budget spent (timeremain = seconds left on `timer timeout`, 0 once it
    # fired): the run above returned early and the snapshot just written is the resume
    # point, so leave the loop instead of starting the next block.
    if "${wall_timeout} > 0 && $(timeremain) <= 0.0" then "jump SELF snap_done"
    # Rg-plateau test on the block just finished
    if "${rg_halt} == 0" then "jump SELF rg_skip"
    print ">>> RG_BLOCK step $(step) Rg_block $(f_rg_block_avg:%.5f) Rg_prev $(v_rg_prev:%.5f) rel_change $(v_rg_dev:%.3e) consecutive_under_tol_after $(v_rg_ok_next:%.0f)"
    variable rg_ok_tmp equal $(v_rg_ok_next)
    variable rg_ok delete
    variable rg_ok equal $(v_rg_ok_tmp)
    variable rg_ok_tmp delete
    variable rg_prev_tmp equal $(f_rg_block_avg)
    variable rg_prev delete
    variable rg_prev equal $(v_rg_prev_tmp)
    variable rg_prev_tmp delete
    if "${rg_conv} == 1" then "jump SELF rg_tail"
    if "${rg_ok} >= ${rg_nconsec}" then &
        "variable rg_tail_left delete" &
        "variable rg_tail_left equal $(v_rg_tail_calc)" &
        "print '>>> RG_PLATEAU_DETECTED at step $(step) after $(v_prod_done) production steps: ${rg_ok} consecutive ${rg_block}-step blocks changed Rg by less than ${rg_tol}; running $(v_rg_tail_calc) more blocks (rg_extra ${rg_extra})'" &
        "variable rg_conv delete" &
        "variable rg_conv equal 1"
    jump SELF rg_skip
    # the tail after detection: count the blocks down, then leave
    label rg_tail
    variable rg_tail_tmp equal $(v_rg_tail_left-1)
    variable rg_tail_left delete
    variable rg_tail_left equal $(v_rg_tail_tmp)
    variable rg_tail_tmp delete
    if "${rg_tail_left} <= 0" then &
        "print '>>> RG_PLATEAU_CONVERGED at step $(step) after $(v_prod_done) production steps (plateau detected, tail of ${rg_extra} x the steps done run)'" &
        "jump SELF snap_done"
    label rg_skip
    next snap_i
    jump SELF snap_loop
label snap_done
if "${rg_halt} == 1" then "unfix rg_block_avg"



# ========== Cleanup ==========
unfix 1
unfix lang_prod
unfix remove_drift
if "${pin_gel} == 1" then "unfix pin_gel"
unfix stress_aniso_output
undump poly_traj



# ========== Production bookkeeping + Save Final Configuration ==========
# One machine-readable line for run_lammps.sh / continue_sim.sh --chain: production
# steps done in THIS job, the nsteps it was asked for, and the oldsteps/totsteps it
# ran under (the chain adds done to oldsteps and asks the next job for the rest).
# The un-suffixed final_config file is written ONLY when production completed, so
# its presence remains the completion marker; continue_sim.sh resumes from the
# newest final_config_*_snap<N>.data when it is missing.
variable outfile string "final_config_${dataname}_${interaction}_${totsteps}"
if "${prod_done} >= ${prod_target} || ${rg_conv} == 1" then &
    "print '>>> PRODUCTION_STEPS_DONE ${prod_done} OF ${nsteps} OLDSTEPS ${oldsteps} TOTSTEPS ${totsteps} STATUS COMPLETE'" &
    "write_restart ${outfile}.restart" &
    "write_data ${outfile}.data" &
else &
    "print '>>> PRODUCTION_STEPS_DONE ${prod_done} OF ${nsteps} OLDSTEPS ${oldsteps} TOTSTEPS ${totsteps} STATUS INCOMPLETE'" &
    "print '>>> Wall-clock budget reached: no final_config written; resume from the newest final_config_*_snap<N>.data'"
# (the final file is identical to snap${n_snaps}; retained for backward compatibility)
