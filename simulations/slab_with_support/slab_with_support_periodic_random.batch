#!/usr/bin/env bash
#SBATCH --job-name=slab_periodic_random
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH --mem=0
#SBATCH --time=24:00:00
#SBATCH --output=%x.o%j.%N
source "$HOME/Documents/lammps_work/scripts/batch_prologue.sh"

# The x/y-periodic random f = 4 network slab (scripts/lib/periodic_data_file_generator.py
# --network random), equilibrated like the 14000002 reference slab: aniso NPH at P* = 1.5 with
# the piston parked in the bath and transparent to solvent. Submitted by
# scripts/submit_random_periodic_pipeline.sh, whose bridge job (chain_random_periodic.batch)
# then converts the final configuration and submits the two-piston compression.

FOLDER=slab_with_support
DATANAME=slab_support_periodic_5beads_tall_rho04_random
INTERACTION=1.0_1.0
NSTEPS=14000000
export PRESS_TARGET=1.5
export PISTON_TRANSPARENT=1 BARO_MODE=aniso PIN_GEL=0
export CHAIN=1      # continue in a new job if the wall limit comes first

bash "$LAMMPS_WORK_DIR/scripts/run_lammps.sh" "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS"
