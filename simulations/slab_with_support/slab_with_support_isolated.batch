#!/usr/bin/env bash

#SBATCH --job-name=slab_isolated
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=128 # was 32, 128
#SBATCH --cpus-per-task=1     # was 4, 1
#SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --output=%x.o%j.%N
# #SBATCH --error=%x.e%j.%N

# Set environment variables
declare -xr OMPI_UNIT='core'
declare -xr OMPI_MCA_btl='self,vader'

declare -xr UCX_LOG_LEVEL='ERROR'
declare -xr UCX_TLS='self,cma,shm,rc,ud,dc'
declare -xr UCX_NET_DEVICES='mlx5_2:1'
declare -xir UCX_MAX_RNDV_RAILS=1

declare -xir OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"

# Load required modules for LAMMPS on Expanse (use this order)
module reset
module load gcc/10.2.0
module load openmpi/4.1.3
module load python/3.8.12

# =======================================================================
# ISOLATED GEL (2026-09-30): free swelling of a finite gel block in its bath, the
# equilibration that feeds compress_slab (bulk modulus K) through
# scripts/add_more_plates_to_gel.ipynb.
#
# The data file has NO support and NO piston (slab_with_support.ipynb, includeWalls =
# False): the sheets are what made `nph aniso` collapse the box of run new_02 (Pod,
# piston visible to solvent): a solvent-excluding sheet carries an in-plane tension
# that lowers the box-averaged lateral pressure by gamma/L_z, the aniso barostat
# contracts x, y and stretches z at constant volume, and nothing in a bath with a
# FREE inclusion resists a change of box shape (99.6 x 99.6 x 86.6 -> 71.4 x 71.3 x
# 238.2 in 500k steps, gel 2.5 sigma from its image).  Without sheets that drive is
# gone, so the run keeps the default `aniso` (BARO_MODE below).  What remains is
# that the box SHAPE has no restoring force: it random-walks under the pressure
# noise.  Small-box test (21k atoms, 50k steps): +/- 1.5 sigma on a 35-sigma edge;
# scaled to this system (1.1 M mobile atoms, 10 M steps) that is roughly +/- 8 %
# rms of an edge, i.e. ~10 sigma against ~40 sigma of lateral bath per side after
# swelling.  Watch box_dimensions_*.dat (plot_lammps_log.py's convergence panel):
# if the aspect ratio wanders, rerun with BARO_MODE=iso -- nothing else changes.
# For an isolated gel the box faces are not the gel's faces; its own anisotropy is
# read from stress_aniso_*.dat (sig_p,xx/yy/zz) and the Rg edges in
# gel_dimensions_*.dat, both drawn by plot_lammps_log.py and by
# bulk_modulus_analysis_*.ipynb (SWELL_ANISO).
#
# The file holds NO crosslink bead without a chain (the generator wrote 4 per cube
# until 2026-09-29).  COST: 1.13 M atoms (1.03 M solvent at rhoSolv = 1).  n_snaps = 3
# snapshots are written, so a job that reaches the wall limit still leaves a usable
# configuration; continue with scripts/continue_sim.sh.
# =======================================================================
FOLDER="slab_with_support"
DATANAME="slab_support_5beads_tall_rho04_new_03_nowalls"
INTERACTION="1.0_1.0"   # the interaction of the triaxial runs, so that K, M and G belong to the same gel
NSTEPS=14000000
TYPE=""             # Options: stress, volume, stressvol, or leave empty (just type "")
PRESS_TARGET=1.5    # Barostat target pressure (overrides press_target in .lmp)
SEED=12345          # RNG seed for create_velocity / langevin

export BARO_MODE=aniso        # x, y, z barostatted independently (the deck's default); iso = the fallback above
export PIN_GEL=1              # zero the gel's linear + angular momentum every 100 steps: a free 60-sigma block
                              # would turn ~14 deg in 10M steps, and the plates of compress_slab are parked along
                              # the box axes (see slab_with_support.lmp)
export PISTON_TRANSPARENT=1   # no piston in this file: irrelevant, kept so a file WITH a piston is safe too

# Navigate to the scripts directory
cd ~/Documents/lammps_work/scripts || exit 1

# Run the simulation
# Positional args to run_lammps.sh: FOLDER DATANAME INTERACTION NSTEPS TYPE PRESS_TARGET VEL_SEED
bash run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS" "$TYPE" "$PRESS_TARGET" "$SEED"
