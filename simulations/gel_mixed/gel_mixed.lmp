# ========== Isolated Gel (Mixed) Single-Pressure NPT Equilibration ==========
# Equilibrates the isolated gel (polymer network + internal solvent, no support/
# piston/bath solvent) at a single target pressure P* to obtain V_mix for the
# volume of mixing calculation:
#
#   ΔV_mix = V_mix − V_pure_polymer − V_pure_solvent
#
# Input data file is produced by isolate_gel.py — contains only gel-internal
# atoms; support, piston, and bath solvent have been removed.
#
# Atom types (unchanged from isolate_gel.py output):
#   1 = Crosslink   2 = Chain bead   3 = Solvent (gel-internal only)
#
# Interactions match slab_with_support.lmp exactly (all WCA, cutoff 1.122σ):
#   1–1, 1–2, 2–2  : ε = 1.0  (polymer–polymer)
#   1–3, 2–3       : ε = epsSP (polymer–solvent)
#   3–3            : ε = epsSS (solvent–solvent)
#   Bonds (polymer): FENE  k=30, r0=1.5, ε=1.0, σ=1.0
#
# Structure:
#   Stage 0 — Gentle Langevin NVT (50k steps) to bring to T*=1.0
#   Stage 1 — NPT production (nsteps, block-averaged output)
#
# Variables passed from run_lammps.sh:
#   dataname     — isolated data file name (no extension)
#   interaction  — epsilon label (e.g. "1.0_1.0")
#   epsSS        — solvent–solvent LJ epsilon
#   epsSP        — solvent–polymer LJ epsilon
#   nsteps       — NPT production run length (divisible by n_blocks * 100)
#   totsteps     — same as nsteps for fresh runs
#   press_target — target pressure P*
#
# Outputs:
#   output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat
#     → columns: step  lx  ly  lz
#   vol_gel_mixed_${dataname}_${interaction}.dat
#     → columns: step  press_mean  vol_mean  rho_mean  (one row per block)



# ========== Parameters ==========
variable sigma        equal 1.0
variable temp_target  equal 1.0
variable press_target index 1.5  # overridden by -var on command line
variable tdamp        equal 1.0
variable pdamp        equal 1.0
variable n_blocks     equal 10

variable timestep_gentle equal 0.001
variable timestep_prod   equal 0.005
variable nsteps_gentle   equal 50000

variable thermo_freq   equal 10000
variable volume_freq   equal 10000

variable block_steps   equal ${nsteps}/${n_blocks}
variable nrepeat_block equal ${block_steps}/100



# ========== Initialization ==========
units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

read_data data_files/${dataname}.data

print ">>> gel_mixed: T*=${temp_target} P*=${press_target} epsSS=${epsSS} epsSP=${epsSP} nsteps=${nsteps}"

comm_modify cutoff 5.0



# ========== Group Definitions ==========
group polymer type 1 2
group solvent type 3
group mobile  type 1 2 3



# ========== Pair Interactions (WCA, matching slab_with_support.lmp) ==========
pair_style lj/cut 1.122
pair_coeff * * 1.0 ${sigma} 1.122        # default: polymer–polymer WCA
pair_coeff 1 3 ${epsSP} ${sigma} 1.122  # crosslink–solvent
pair_coeff 2 3 ${epsSP} ${sigma} 1.122  # chain–solvent
pair_coeff 3 3 ${epsSS} ${sigma} 1.122  # solvent–solvent

bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0

special_bonds lj 0.0 1.0 1.0

thermo_style custom step temp pe ke etotal press vol lx ly lz
thermo ${thermo_freq}



# =====================================================================
#   STAGE 0a — Harmonic pre-relaxation (WCA + harmonic bonds, NVE/limit)
#
#   The isolated gel can have polymer bonds stretched beyond FENE r0=1.5
#   due to periodic-image atoms being remapped into a smaller box.
#   Using harmonic bonds (no divergence) at very low T with tiny max
#   displacement relaxes those bonds safely before FENE is activated.
# =====================================================================
bond_style harmonic
bond_coeff 1 30.0 0.96

reset_timestep 0
velocity mobile create 0.01 48291 mom yes rot no
fix pre  mobile nve/limit 0.01
fix lang mobile langevin 0.01 0.01 ${tdamp} 904297
timestep ${timestep_gentle}
run 10000
unfix pre
unfix lang



# =====================================================================
#   STAGE 0b — Switch to FENE, gentle Langevin NVT ramp to T*=1.0
# =====================================================================
bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0

reset_timestep 0
fix gentle mobile nve/limit 0.01
fix lang   mobile langevin 0.01 ${temp_target} ${tdamp} 904297
timestep ${timestep_gentle}
run ${nsteps_gentle}
unfix gentle
unfix lang



# =====================================================================
#   STAGE 1 — NPT production with block averaging
#
#   iso NPT couples all three box dimensions to the barostat.
#   The gel + solvent are both mobile; no frozen walls present.
# =====================================================================
variable N_mobile    equal count(mobile)
variable box_vol     equal lx*ly*lz
variable num_density equal v_N_mobile/v_box_vol
variable inst_press  equal press

reset_timestep 0
fix 1 mobile npt temp ${temp_target} ${temp_target} ${tdamp} &
    iso ${press_target} ${press_target} ${pdamp}
timestep ${timestep_prod}

fix box_out all print ${volume_freq} "$(step) $(lx) $(ly) $(lz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${totsteps}.dat &
    screen no title "# step lx ly lz"

fix block_avg all ave/time 100 ${nrepeat_block} ${block_steps} &
    v_inst_press v_box_vol v_num_density &
    ave one &
    file vol_gel_mixed_${dataname}_${interaction}.dat &
    title1 "# one row per ${block_steps}-step block" &
    title2 "# step  press_mean  vol_mean  rho_mean"

run ${nsteps}

unfix block_avg
unfix box_out
unfix 1



write_data final_config_gel_mixed_${dataname}_${interaction}.data
print ">>> Done. Output: vol_gel_mixed_${dataname}_${interaction}.dat"
