# ========== Compression Modulus Simulation — Plate-Driven (Isotropic) ==========
# Input: isolated gel WITH six plates attached (from add_more_plates_to_gel.ipynb).
# Atom types: 1=polymer, 2=crosslinker, 3=solvent, 4=plate
# Bond types:  1=FENE (polymer-polymer only; plates interact via WCA, no bonds)
#
# Compression: fix move linear on all six plates (isotropic, box fixed) — NOT
# fix deform, since that would conflict with the plate-polymer harmonic bonds.
#
# Phases: 0 NVT settle -> 0.5 Langevin+NPH iso (find P_target volume) -> 1b NVT
# relax -> Stage 0 ε_vol=0 reference hold -> Stage loop (compress to each
# target in ${stage_targets}, freeze+drain, measure) -> cleanup.
# Stage count/targets come entirely from the batch script via -var stage_targets;
# defaults below (0.015 0.030 0.045) reproduce the original fixed 3-stage ladder.
# All stages' stress data append into the same output files so K = slope of
# P'_net vs ε_vol across stages (see bulk_modulus_analysis.ipynb).
#
# NOTE: nsteps (per-stage hold length) has NOT been validated against a solvent
# drainage timescale (τ ~ L_gel²/D_c) — check stress_tensor_solvent_*.dat has
# plateaued within each stage's hold before trusting the fitted slope.
#
# NOTE: hold `run`s are padded to end on an nfreq_stress boundary — required,
# not cosmetic: fix ave/chunk only releases its compute chunk/atom lock at an
# epoch boundary, and unfixing mid-epoch aborts the NEXT stage's ave/chunk with
# "Two fix commands using same compute chunk/atom command in incompatible ways".
#
# Plate mol IDs (from add_more_plates_to_gel.ipynb): max_mol_gel + 1..6, in
# order top/bot/front/back/right/left. Resolved at runtime via compute reduce
# max mol (spatial region grouping fails: right/left plates span the full
# box y-range, overlapping front/back).
#
# Outputs (continuous across the whole staged run unless noted):
#   stress_data/bulk_modulus_plot_data_*.dat   Rg-normalised osmotic path (NOT for K)
#   stress_data/plate_force_*.dat              net force per plate
#   stress_data/stress_tensor_{polymer,solvent}_ref_*.dat   ε_vol=0 baseline
#   stress_data/stress_tensor_{polymer,solvent}_*.dat       per-stage stress (the K data)
#   stress_data/stress_profile_z_{polymer,solvent}_*.dat    z-binned stress
#   stress_data/compress_strain_*.dat          strain vs step (staircase)
#   volume_data/{gel_dimensions_rg,box_dimensions,polymer_com}_*.dat


# ── PARAMETERS ──

variable sigma          equal 1.0
variable temp_target    equal 1.0
variable P_target       equal 1.5
variable timestep_prod  equal 0.005

# Cumulative VOLUMETRIC strain targets (ε_vol, not per-axis — isotropic
# compression means ε_vol ≈ 3·ε_axis). Defaults sit inside the estimated
# linear-elastic window, so the N-point fit (+ ε_vol=0 origin) gives K.
# Set entirely from the batch script via -var stage_targets <list>.
variable stage_targets      index 0.015 0.030 0.045
variable stage_targets_list index "0.015 0.030 0.045"

variable nsteps_phase0        equal 50000    # Phase 0:   NVT settle at fixed box
variable nsteps_npt           equal 50000    # Phase 0.5: Langevin+NPH — find equilibrium volume at P_target
variable nsteps_equil         equal 50000    # Phase 1b:  NVT — equilibrate at NPH-final volume
variable nsteps_ref           equal 100000   # Stage 0:   ε_vol = 0 reference hold (own file, own length)
# vcompress is recomputed per stage in the loop below, sized off that stage's
# own incremental strain to cover it in ~nsteps_compress_base/1.1 steps.
variable nsteps_compress_base equal 33000
variable nsteps_compress      equal 30000    # 3x safety buffer per-stage ramp; halt fires ~10000
# nsteps (from -var nsteps): length of EACH per-stage drain hold, not Stage 0.

# Langevin+NPH (not Nose-Hoover NPT): FENE bonds heat faster than an NH chain
# can remove ("FENE bond too long"); Langevin's per-atom friction always wins.
variable npt_P_damp equal 50.0   # NPH barostat damping (τ); raise to 500-1000 if FENE warnings persist
variable lang_T_damp equal 1.0   # Langevin damping (τ)
# NOTE: NPH targets TOTAL pressure incl. barostat virial; if c_gel_press
# doesn't converge to ~P_target, add an offset to the NPH target.

# thermo_freq is index-style so a debug run can override it: lmp ... -var thermo_freq 1
variable thermo_freq     index 25000
variable dump_freq_setup equal 25000
# dump_freq_prod sized to stay under a ~1.5 GB traj_files/prod_*.lammpstrj cap
# (~23 MB/frame at this system size) — recheck if atom count changes materially.
variable dump_freq_prod  equal 12000
variable stress_freq     equal 10000

# fix halt checks every halt_freq steps, so the ramp overshoots its target by
# up to one interval (~1% of a 0.015 increment at halt_freq=100).
variable halt_freq       equal 100

variable num_stress_curves equal 10
variable nevery_target     equal 100
variable nrepeat_max       equal 2000
variable nrepeat_min       equal 50

variable nfreq_raw    equal floor(${nsteps}/v_num_stress_curves)
variable nrepeat_raw  equal floor(v_nfreq_raw/v_nevery_target)

variable nr_lo equal (v_nrepeat_raw>v_nrepeat_min)*v_nrepeat_raw+(v_nrepeat_raw<=v_nrepeat_min)*v_nrepeat_min
variable nrepeat_stress equal (v_nr_lo<v_nrepeat_max)*v_nr_lo+(v_nr_lo>=v_nrepeat_max)*v_nrepeat_max
variable nevery_stress equal floor(v_nfreq_raw/v_nrepeat_stress)
variable nfreq_stress  equal v_nevery_stress*v_nrepeat_stress

print ">>> Stress averaging: nevery=${nevery_stress}  nrepeat=${nrepeat_stress}  nfreq=${nfreq_stress}"
print ">>> Compression (plate-driven, isotropic): ε_vol ladder = ${stage_targets_list}"
print ">>> halt_freq=${halt_freq}  nsteps_compress=${nsteps_compress}"

variable binWidth    equal 2.0
variable rg_scale    equal 1.8
variable region_frac equal 1


# ── INITIALIZATION ──

units lj
dimension 3
boundary p p p
atom_style molecular
atom_modify map array

# balance_style couples decomposition+comm style (rcb needs comm_style tiled).
# Default `shift` is safer on this geometry — `rcb` carved the gel into thin
# tiles and is the suspected cause of a ~2h stall (job 286541, 2026-07-24).
# Kept selectable for A/B: lmp ... -var balance_style rcb
variable balance_style index shift

if "${balance_style} == rcb" then "comm_style tiled"

pair_style lj/cut 1.122
bond_style fene

read_data data_files/${dataname}.data nocoeff

# Must be >= longest bond (FENE R0=1.5). Previously 5.0, which made Comm ~47%
# of wall time (Nghost ~4x Nlocal) while Pair was only 0.14%.
comm_modify cutoff 2.0

print "========================================"
print "Compression slab simulation (plate-driven): ${dataname}"
print "Interaction: epsSS=${epsSS}, epsSP=${epsSP}"
print "Production steps: ${nsteps}"
print "Cumulative volumetric strain ladder: ${stage_targets_list}"
print "========================================"


# ── GROUP DEFINITIONS ──

group polymer    type 1 2
group backbone   type 1
group crosslinks type 2
group solvent    type 3
group gel        type 1 2 3      # all mobile gel atoms (NVT target)
group plate      type 4          # all plate atoms (all 6 plates combined)

# Individual plate subgroups defined later, once plate mol IDs are resolved.


# ── INTERATOMIC POTENTIALS ──

pair_coeff * * 1.0 ${sigma} 1.122

pair_coeff 1 3 ${epsSP} ${sigma} 1.122
pair_coeff 2 3 ${epsSP} ${sigma} 1.122
pair_coeff 3 3 ${epsSS} ${sigma} 1.122

# Plate-plate and plate-solvent interactions DISABLED: plates must not repel
# each other, and must be transparent to solvent (measuring NETWORK modulus
# only — WCA here previously caused ~7.7e8 pressure / "Domain too large").
neigh_modify exclude type 4 4
neigh_modify exclude type 3 4
pair_coeff 4 4 0.0 ${sigma} 0.0               # plate-plate DISABLED
pair_coeff 1 4 1.0 ${sigma} 1.122             # polymer-plate WCA
pair_coeff 2 4 1.0 ${sigma} 1.122             # crosslinker-plate WCA
pair_coeff 3 4 0.0 ${sigma} 0.0               # solvent-plate DISABLED (solvent flows through)

# Type 5: leftover orphan atoms from the pre-plate file (add_more_plates_to_gel.py
# doesn't strip them out). Mirror the type-4 treatment so they don't silently
# inherit full-strength WCA against solvent via pair_coeff * *.
neigh_modify exclude type 4 5
neigh_modify exclude type 5 5
pair_coeff 5 5 0.0 ${sigma} 0.0               # orphan-orphan DISABLED
pair_coeff 4 5 0.0 ${sigma} 0.0               # orphan-plate DISABLED
pair_coeff 1 5 1.0 ${sigma} 1.122             # polymer-orphan WCA
pair_coeff 2 5 1.0 ${sigma} 1.122             # crosslinker-orphan WCA
pair_coeff 3 5 0.0 ${sigma} 0.0               # solvent-orphan DISABLED (transparent)

bond_coeff 1 30.0 1.5 1.0 1.0   # polymer-polymer FENE (Kremer-Grest)

special_bonds fene
neigh_modify delay 0 every 1 check yes

# One-time repartition, then periodic rebalance (density barely moves here —
# ε_vol only reaches 0.045 — so cadence/threshold are relaxed vs. the old
# 10000/1.05 defaults). xyz (not just z): the six-plate geometry compacts the
# gel in all three directions.
variable balance_freq   index 50000
variable balance_thresh index 1.10

if "${balance_style} == rcb" then &
    "balance 1.0 rcb" &
    "fix balance all balance ${balance_freq} ${balance_thresh} rcb" &
else &
    "balance 1.0 shift xyz 20 1.05" &
    "fix balance all balance ${balance_freq} ${balance_thresh} shift xyz 10 1.05"

print ">>> Load balancing: style=${balance_style}  every ${balance_freq} steps  threshold=${balance_thresh}"


# ── THERMO OUTPUT ──

compute gel_temp  gel   temp
compute gel_press all   pressure gel_temp pair bond

# Global polymer osmotic stress (whole polymer / Rg gel volume), defined here
# so it prints from Phase 0 onward. stress/atom NULL = per-atom virial stress
# (pressure*volume units, no kinetic term); dividing the summed diagonal by
# V_gel (Rg-based, not box volume) gives σ_ii^poly. Component order:
# [1]=xx [2]=yy [3]=zz [4]=xy [5]=xz [6]=yz.
compute rg_tensor       polymer gyration
compute stress_poly_all polymer stress/atom NULL
compute sumS_p_xx       polymer reduce sum c_stress_poly_all[1]
compute sumS_p_yy       polymer reduce sum c_stress_poly_all[2]
compute sumS_p_zz       polymer reduce sum c_stress_poly_all[3]
compute sumS_p_xy       polymer reduce sum c_stress_poly_all[4]
compute sumS_p_zx       polymer reduce sum c_stress_poly_all[5]
compute sumS_p_yz       polymer reduce sum c_stress_poly_all[6]

variable gel_lx_rg  equal 2.0*sqrt(3.0*c_rg_tensor[1])
variable gel_ly_rg  equal 2.0*sqrt(3.0*c_rg_tensor[2])
variable gel_lz_rg  equal 2.0*sqrt(3.0*c_rg_tensor[3])
variable gel_vol_rg equal v_gel_lx_rg*v_gel_ly_rg*v_gel_lz_rg

variable sigP_xx equal c_sumS_p_xx/v_gel_vol_rg
variable sigP_yy equal c_sumS_p_yy/v_gel_vol_rg
variable sigP_zz equal c_sumS_p_zz/v_gel_vol_rg
variable sigP_xy equal c_sumS_p_xy/v_gel_vol_rg
variable sigP_zx equal c_sumS_p_zx/v_gel_vol_rg
variable sigP_yz equal c_sumS_p_yz/v_gel_vol_rg
# Total osmotic pressure Π = -(1/3) tr(σ^poly). The leading minus is required:
# LAMMPS stress/atom uses the continuum-mechanics sign convention (tension
# positive, compression negative) — summed over atoms and divided by volume,
# it equals -P, not +P (docs.lammps.org/compute_stress_atom.html). Without
# this minus sign Pi_osm is the NEGATIVE of the physical osmotic pressure
# (negative under compression, backwards from what a swollen/compressed
# network should show).
variable Pi_osm  equal -(v_sigP_xx+v_sigP_yy+v_sigP_zz)/3.0

thermo_style custom step c_gel_temp pe ke etotal press c_gel_press &
    v_sigP_xx v_sigP_yy v_sigP_zz v_Pi_osm vol lx ly lz xy xz yz

# `error` (not `warn`) so lost atoms abort with a diagnosable error instead of
# silently corrupting the run (this is why 2026-07-24's runs died with no
# error). Revert to `warn` only if legitimate orphan (type-5) escapes need it.
variable lost_atoms index error

# flush yes: without it, output near an abnormal death is lost in the stdio buffer.
thermo_modify lost ${lost_atoms} flush yes
thermo ${thermo_freq}


# ── PHASE 1: EQUILIBRATION  (Phase 0 NVT → Phase 0.5 Langevin+NPH → Phase 1b NVT) ──
# Phase 0: NVT, fixed box, plates frozen — settle the cold starting config.
# Phase 0.5: Langevin+NPH iso -> P_target; plates released to nve+setforce so
#   they scale isotropically with the box (fix-move-0 would pin them in
#   absolute space while the box shrinks — a latent bug), then re-frozen.
# Phase 1b: NVT at the NPH-final volume, plates re-frozen.

print "========================================"
print "Phase 0: NVT equilibration (${nsteps_phase0} steps, fixed box, all plates frozen)"
print "========================================"

reset_timestep 0
timestep ${timestep_prod}

# Triclinic box required before any dump (LAMMPS restriction).
change_box all triclinic

dump traj_setup all custom ${dump_freq_setup} &
    traj_files/setup_${dataname}_${interaction}_${nsteps}.lammpstrj &
    id type mol x y z

# Minimize with all plates frozen — only gel atoms relax around plates.
fix freeze_plates_min plate setforce 0.0 0.0 0.0
velocity plate set 0.0 0.0 0.0
minimize 1.0e-4 1.0e-6 5000 50000
unfix freeze_plates_min

# step here = CG iteration count, not a dynamics step (minimize advances the
# counter by iterations) — disambiguates minimize output from a run's.
print ">>> Minimize COMPLETE: step=$(step) (= CG iterations)  T=$(c_gel_temp)  PE=$(pe)  Press=$(press)"

# Seed velocities: input config is cold (T=0); without this the thermostats
# must heat from zero, leaving bonds pinned near R0.
velocity gel create ${temp_target} 90210 mom yes rot yes dist gaussian

# Never unfixed — records continuously through the whole run. Pairs Π with the
# co-evolving Rg gel volume for the osmotic bulk modulus K = -V(dΠ/dV) in
# bulk_modulus_analysis.ipynb.
# Columns: step sigP_xx sigP_yy sigP_zz sigP_xy sigP_zx sigP_yz Pi_osm V_gel_rg lx_rg ly_rg lz_rg
fix out_bulk_modulus all print ${stress_freq} &
    "$(step) $(v_sigP_xx) $(v_sigP_yy) $(v_sigP_zz) $(v_sigP_xy) $(v_sigP_zx) $(v_sigP_yz) $(v_Pi_osm) $(v_gel_vol_rg) $(v_gel_lx_rg) $(v_gel_ly_rg) $(v_gel_lz_rg)" &
    title "# step sigP_xx sigP_yy sigP_zz sigP_xy sigP_zx sigP_yz Pi_osm V_gel_rg lx_rg ly_rg lz_rg" &
    file output_files/stress_data/bulk_modulus_plot_data_${dataname}_${interaction}_${nsteps}.dat screen no

# Langevin+NVE, not Nose-Hoover: right after `velocity gel create` dumps a
# fresh Gaussian distribution onto a cold, dense system, NH lags and FENE
# bonds overheat before it catches up.
fix freeze_plates_0 plate   move linear 0 0 0
fix nve_phase0      gel     nve
fix lang_phase0     gel     langevin ${temp_target} ${temp_target} ${lang_T_damp} 90211
fix mom_phase0      gel     momentum 100 linear 1 1 1

run ${nsteps_phase0}

unfix mom_phase0
unfix lang_phase0
unfix nve_phase0
unfix freeze_plates_0

print ">>> Post-Phase-0 NVT  T = $(c_gel_temp)  P = $(press)  c_gel_press = $(c_gel_press)"

print "========================================"
print "Phase 0.5: Langevin+NPH iso to P = ${P_target} (${nsteps_npt} steps, plates scale with box)"
print "========================================"

# Release plates: nve + setforce 0 -> zero net force, remapped by the NPH
# barostat (dilate all) so they scale isotropically with the box.
velocity plate set 0.0 0.0 0.0
fix nve_plate      plate nve
fix setforce_plate plate setforce 0.0 0.0 0.0

fix lang_p05 gel langevin ${temp_target} ${temp_target} ${lang_T_damp} 48279
fix nph_p05  gel nph iso ${P_target} ${P_target} ${npt_P_damp}

run ${nsteps_npt}

unfix nph_p05
unfix lang_p05

print ">>> Post-Langevin+NPH  T = $(c_gel_temp)  c_gel_press = $(c_gel_press)  box = $(lx) x $(ly) x $(lz)"

# Re-freeze plates at their new (scaled) positions.
unfix nve_plate
unfix setforce_plate
velocity plate set 0.0 0.0 0.0

print "========================================"
print "Phase 1b: NVT equilibration (${nsteps_equil} steps, plates frozen at NPH volume)"
print "========================================"

fix freeze_plates_1 plate   move linear 0 0 0
fix nvt_equil       gel     nvt temp ${temp_target} ${temp_target} 1.0
fix mom_equil       gel     momentum 100 linear 1 1 1

run ${nsteps_equil}

unfix mom_equil
unfix nvt_equil
unfix freeze_plates_1

print ">>> Post-NVT T = $(c_gel_temp)  P = $(press)  c_gel_press = $(c_gel_press)"
print ">>> Box after Phase 1: $(lx) x $(ly) x $(lz)"


# ── GEL CHARACTERIZATION & PLATE SETUP (post-equilibration) ──

compute polymer_com  polymer com
compute minx_polymer polymer reduce min x
compute maxx_polymer polymer reduce max x
compute miny_polymer polymer reduce min y
compute maxy_polymer polymer reduce max y
compute minz_polymer polymer reduce min z
compute maxz_polymer polymer reduce max z

variable mol_id atom mol
compute max_mol_gel gel reduce max v_mol_id

run 0

variable gel_xlo equal $(c_minx_polymer)
variable gel_xhi equal $(c_maxx_polymer)
variable gel_ylo equal $(c_miny_polymer)
variable gel_yhi equal $(c_maxy_polymer)
variable gel_zlo equal $(c_minz_polymer)
variable gel_zhi equal $(c_maxz_polymer)

print ">>> Gel x-extent: ${gel_xlo} to ${gel_xhi}  (lx_gel = $(v_gel_xhi - v_gel_xlo) σ)"
print ">>> Gel y-extent: ${gel_ylo} to ${gel_yhi}  (ly_gel = $(v_gel_yhi - v_gel_ylo) σ)"
print ">>> Gel z-extent: ${gel_zlo} to ${gel_zhi}  (lz_gel = $(v_gel_zhi - v_gel_zlo) σ)"
print ">>> Gel Rg dims: $(v_gel_lx_rg) x $(v_gel_ly_rg) x $(v_gel_lz_rg)"

# Rg half-widths (for bulk region sizing — frozen as constants after Phase 2)
variable eps   equal 1.0e-12
variable Rg_xx equal c_rg_tensor[1]
variable Rg_yy equal c_rg_tensor[2]
variable Rg_zz equal c_rg_tensor[3]
variable hw_x equal v_region_frac*v_rg_scale*sqrt(v_Rg_xx + v_eps)
variable hw_y equal v_region_frac*v_rg_scale*sqrt(v_Rg_yy + v_eps)
variable hw_z equal v_region_frac*v_rg_scale*sqrt(v_Rg_zz + v_eps)

variable mol_top_plate   equal round($(c_max_mol_gel)+1)
variable mol_bot_plate   equal round($(c_max_mol_gel)+2)
variable mol_front_plate equal round($(c_max_mol_gel)+3)
variable mol_back_plate  equal round($(c_max_mol_gel)+4)
variable mol_right_plate equal round($(c_max_mol_gel)+5)
variable mol_left_plate  equal round($(c_max_mol_gel)+6)

print ">>> Plate mol IDs: top=${mol_top_plate}  bot=${mol_bot_plate}  front=${mol_front_plate}  back=${mol_back_plate}  right=${mol_right_plate}  left=${mol_left_plate}"

# 'molecule' group style (not the atom-style 'mol' variable) works on all
# LAMMPS versions — the variable approach fails on older cluster builds.
group plate_top   molecule ${mol_top_plate}
group plate_bot   molecule ${mol_bot_plate}
group plate_front molecule ${mol_front_plate}
group plate_back  molecule ${mol_back_plate}
group plate_right molecule ${mol_right_plate}
group plate_left  molecule ${mol_left_plate}

print ">>> plate_top: $(count(plate_top))  plate_bot: $(count(plate_bot))"
print ">>> plate_front: $(count(plate_front))  plate_back: $(count(plate_back))"
print ">>> plate_right: $(count(plate_right))  plate_left: $(count(plate_left))"

compute com_top   plate_top   com
compute com_bot   plate_bot   com
compute com_front plate_front com
compute com_back  plate_back  com
compute com_right plate_right com
compute com_left  plate_left  com

# Net reaction force gel exerts on each plate (fix move linear doesn't zero the
# force array). Reads 0 during Phase 0.5 (fix setforce zeroes it there) — that
# is expected, not a bug.
compute f_top_x   plate_top   reduce sum fx
compute f_top_y   plate_top   reduce sum fy
compute f_top_z   plate_top   reduce sum fz
compute f_bot_x   plate_bot   reduce sum fx
compute f_bot_y   plate_bot   reduce sum fy
compute f_bot_z   plate_bot   reduce sum fz
compute f_front_x plate_front reduce sum fx
compute f_front_y plate_front reduce sum fy
compute f_front_z plate_front reduce sum fz
compute f_back_x  plate_back  reduce sum fx
compute f_back_y  plate_back  reduce sum fy
compute f_back_z  plate_back  reduce sum fz
compute f_right_x plate_right reduce sum fx
compute f_right_y plate_right reduce sum fy
compute f_right_z plate_right reduce sum fz
compute f_left_x  plate_left  reduce sum fx
compute f_left_y  plate_left  reduce sum fy
compute f_left_z  plate_left  reduce sum fz

# Columns: step  {top,bot,front,back,right,left}_{fx,fy,fz}  (18 force values)
fix out_plate_force all print ${stress_freq} &
    "$(step) $(c_f_top_x) $(c_f_top_y) $(c_f_top_z) $(c_f_bot_x) $(c_f_bot_y) $(c_f_bot_z) $(c_f_front_x) $(c_f_front_y) $(c_f_front_z) $(c_f_back_x) $(c_f_back_y) $(c_f_back_z) $(c_f_right_x) $(c_f_right_y) $(c_f_right_z) $(c_f_left_x) $(c_f_left_y) $(c_f_left_z)" &
    title "# step top_fx top_fy top_fz bot_fx bot_fy bot_fz front_fx front_fy front_fz back_fx back_fy back_fz right_fx right_fy right_fz left_fx left_fy left_fz" &
    file output_files/stress_data/plate_force_${dataname}_${interaction}_${nsteps}.dat screen no

run 0

variable gap_z_0 equal $(c_com_top[3]   - c_com_bot[3])
variable gap_y_0 equal $(c_com_front[2] - c_com_back[2])
variable gap_x_0 equal $(c_com_right[1] - c_com_left[1])

print ">>> Plate-to-plate gaps (initial): x = ${gap_x_0}  y = ${gap_y_0}  z = ${gap_z_0}"

# Live gap variables (evaluated each time they appear in output/halt)
variable gap_z_current equal (c_com_top[3]   - c_com_bot[3])
variable gap_y_current equal (c_com_front[2] - c_com_back[2])
variable gap_x_current equal (c_com_right[1] - c_com_left[1])

# Compressive strain per axis: positive = compression
variable compress_strain_z   equal (v_gap_z_0 - v_gap_z_current) / v_gap_z_0
variable compress_strain_y   equal (v_gap_y_0 - v_gap_y_current) / v_gap_y_0
variable compress_strain_x   equal (v_gap_x_0 - v_gap_x_current) / v_gap_x_0
variable compress_strain_vol equal 1.0 - (1.0-v_compress_strain_x)*(1.0-v_compress_strain_y)*(1.0-v_compress_strain_z)


# ── BULK REGION (exclude 3σ near each plate face) ──
# Atoms within 3σ of any plate face carry artifactual constraint stresses from
# the harmonic plate-polymer bonds. Defined ONCE, on the pre-compression gel
# geometry — the same physical atoms are tracked through every stage
# (Lagrangian), not re-snapshotted per stage.

variable xlo_bulk equal ${gel_xlo}+3.0
variable xhi_bulk equal ${gel_xhi}-3.0
variable ylo_bulk equal ${gel_ylo}+3.0
variable yhi_bulk equal ${gel_yhi}-3.0
variable zlo_bulk equal ${gel_zlo}+3.0
variable zhi_bulk equal ${gel_zhi}-3.0
variable bulk_lx  equal v_xhi_bulk-v_xlo_bulk
variable bulk_ly  equal v_yhi_bulk-v_ylo_bulk
variable bulk_lz  equal v_zhi_bulk-v_zlo_bulk
variable bulk_vol equal v_bulk_lx*v_bulk_ly*v_bulk_lz

region reg_bulk block ${xlo_bulk} ${xhi_bulk} ${ylo_bulk} ${yhi_bulk} ${zlo_bulk} ${zhi_bulk} units box
group all_bulk  region reg_bulk
group poly_bulk intersect polymer all_bulk
group solv_bulk intersect solvent all_bulk

print ">>> Bulk x: ${xlo_bulk} to ${xhi_bulk}  (lx = $(v_bulk_lx))"
print ">>> Bulk y: ${ylo_bulk} to ${yhi_bulk}  (ly = $(v_bulk_ly))"
print ">>> Bulk z: ${zlo_bulk} to ${zhi_bulk}  (lz = $(v_bulk_lz))"
print ">>> bulk_vol = $(v_bulk_vol)"
print ">>> poly_bulk: $(count(poly_bulk))  solv_bulk: $(count(solv_bulk))"


# ── ANALYSIS: PARTIAL STRESSES ──

compute stress_polymer poly_bulk stress/atom NULL
compute stress_solvent solv_bulk stress/atom NULL

compute sig_p_xx poly_bulk reduce sum c_stress_polymer[1]
compute sig_p_yy poly_bulk reduce sum c_stress_polymer[2]
compute sig_p_zz poly_bulk reduce sum c_stress_polymer[3]
compute sig_p_xy poly_bulk reduce sum c_stress_polymer[4]
compute sig_p_zx poly_bulk reduce sum c_stress_polymer[5]
compute sig_p_yz poly_bulk reduce sum c_stress_polymer[6]

variable stress_p_xx equal c_sig_p_xx/v_bulk_vol
variable stress_p_yy equal c_sig_p_yy/v_bulk_vol
variable stress_p_zz equal c_sig_p_zz/v_bulk_vol
variable stress_p_xy equal c_sig_p_xy/v_bulk_vol
variable stress_p_zx equal c_sig_p_zx/v_bulk_vol
variable stress_p_yz equal c_sig_p_yz/v_bulk_vol

compute sig_s_xx solv_bulk reduce sum c_stress_solvent[1]
compute sig_s_yy solv_bulk reduce sum c_stress_solvent[2]
compute sig_s_zz solv_bulk reduce sum c_stress_solvent[3]
compute sig_s_xy solv_bulk reduce sum c_stress_solvent[4]
compute sig_s_zx solv_bulk reduce sum c_stress_solvent[5]
compute sig_s_yz solv_bulk reduce sum c_stress_solvent[6]

variable stress_s_xx equal c_sig_s_xx/v_bulk_vol
variable stress_s_yy equal c_sig_s_yy/v_bulk_vol
variable stress_s_zz equal c_sig_s_zz/v_bulk_vol
variable stress_s_xy equal c_sig_s_xy/v_bulk_vol
variable stress_s_zx equal c_sig_s_zx/v_bulk_vol
variable stress_s_yz equal c_sig_s_yz/v_bulk_vol

# Per-atom z-bin stress (slabs normal to z — the top/bot compression axis)
# Bin volume = binWidth * Lx * Ly
variable s_p_xx atom c_stress_polymer[1]/(${binWidth}*lx*ly)
variable s_p_yy atom c_stress_polymer[2]/(${binWidth}*lx*ly)
variable s_p_zz atom c_stress_polymer[3]/(${binWidth}*lx*ly)
variable s_p_xy atom c_stress_polymer[4]/(${binWidth}*lx*ly)
variable s_p_zx atom c_stress_polymer[5]/(${binWidth}*lx*ly)
variable s_p_yz atom c_stress_polymer[6]/(${binWidth}*lx*ly)

variable s_s_xx atom c_stress_solvent[1]/(${binWidth}*lx*ly)
variable s_s_yy atom c_stress_solvent[2]/(${binWidth}*lx*ly)
variable s_s_zz atom c_stress_solvent[3]/(${binWidth}*lx*ly)
variable s_s_xy atom c_stress_solvent[4]/(${binWidth}*lx*ly)
variable s_s_zx atom c_stress_solvent[5]/(${binWidth}*lx*ly)
variable s_s_yz atom c_stress_solvent[6]/(${binWidth}*lx*ly)


# ── ANALYSIS: SPATIAL CHUNKS (z-binning) ──

variable binWidth_reduced equal $(v_binWidth/lz)
compute chunk_z_polymer poly_bulk chunk/atom bin/1d z lower ${binWidth_reduced} units reduced
compute chunk_z_solvent  solv_bulk chunk/atom bin/1d z lower ${binWidth_reduced} units reduced


# ── OUTPUT: GEL AND BOX DIMENSIONS (continuous through all stages) ──

fix out_gel_dims_rg all print ${stress_freq} &
    "$(step) $(v_gel_lx_rg) $(v_gel_ly_rg) $(v_gel_lz_rg)" &
    file output_files/volume_data/gel_dimensions_rg_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_box_dims all print ${stress_freq} &
    "$(step) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" &
    file output_files/volume_data/box_dimensions_${dataname}_${interaction}_${nsteps}.dat screen no

fix out_polymer_com all print ${stress_freq} &
    "$(step) $(c_polymer_com[1]) $(c_polymer_com[2]) $(c_polymer_com[3])" &
    file output_files/volume_data/polymer_com_${dataname}_${interaction}_${nsteps}.dat screen no


# ── PHASE 2/3 STAGED: COMPRESS -> FREEZE -> DRAIN/EQUILIBRATE -> MEASURE ──
# Sign convention (each plate moves toward gel center):
#   Top   (+z face): vz = -vcompress_z   Bot   (-z face): vz = +vcompress_z
#   Front (+y face): vy = -vcompress_y   Back  (-y face): vy = +vcompress_y
#   Right (+x face): vx = -vcompress_x   Left  (-x face): vx = +vcompress_x

undump traj_setup
dump traj_prod all custom ${dump_freq_prod} &
    traj_files/prod_${dataname}_${interaction}_${nsteps}.lammpstrj &
    id type mol x y z

# Output: step  gap_z_0  gap_z_current  compress_strain_z  compress_strain_vol
# Defined once, never unfixed — covers ramps + holds for all stages.
fix out_compress_strain all print ${stress_freq} &
    "$(step) ${gap_z_0} $(v_gap_z_current) $(v_compress_strain_z) $(v_compress_strain_vol)" &
    file output_files/stress_data/compress_strain_${dataname}_${interaction}_${nsteps}.dat screen no


# ── STAGE 0: ε_vol = 0 REFERENCE (undeformed baseline) ──
# Measures P'_net at zero strain instead of assuming it — a swollen,
# pre-stressed network's at-rest stress is not generally zero, so an assumed
# zero would bias K_single by an unknown amount. Same dynamics as a stage
# hold (plates frozen, gel on NVT), own length (nsteps_ref) and own file.

print "========================================"
print "Stage 0: ε_vol = 0 reference (undeformed baseline, ${nsteps_ref} steps)"
print "========================================"

fix freeze_top   plate_top   move linear 0 0 0
fix freeze_bot   plate_bot   move linear 0 0 0
fix freeze_front plate_front move linear 0 0 0
fix freeze_back  plate_back  move linear 0 0 0
fix freeze_right plate_right move linear 0 0 0
fix freeze_left  plate_left  move linear 0 0 0
fix nvt_ref      gel         nvt  temp ${temp_target} ${temp_target} 1.0
fix mom_ref      gel         momentum 100 linear 1 1 1 angular

fix ref_avg_stress_polymer all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_p_xx v_stress_p_yy v_stress_p_zz &
    v_stress_p_xy v_stress_p_zx v_stress_p_yz &
    file output_files/stress_data/stress_tensor_polymer_ref_${dataname}_${interaction}_${nsteps}.dat

fix ref_avg_stress_solvent all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_s_xx v_stress_s_yy v_stress_s_zz &
    v_stress_s_xy v_stress_s_zx v_stress_s_yz &
    file output_files/stress_data/stress_tensor_solvent_ref_${dataname}_${interaction}_${nsteps}.dat

# Epoch-aligned (see NOTE at top of file). Uses nsteps_ref, not nsteps.
variable hold_steps equal (floor(($(step)+${nsteps_ref}-1)/${nfreq_stress})+1)*${nfreq_stress}-$(step)
print ">>> Stage 0 (ref) aligned: ${hold_steps} steps (requested ${nsteps_ref}, nfreq_stress=${nfreq_stress})"

run ${hold_steps}

unfix ref_avg_stress_solvent
unfix ref_avg_stress_polymer
unfix mom_ref
unfix nvt_ref
unfix freeze_left
unfix freeze_right
unfix freeze_back
unfix freeze_front
unfix freeze_bot
unfix freeze_top

print ">>> Stage 0 (ref) done: compress_strain_vol=$(v_compress_strain_vol) (should be ~0) stress_p_zz=$(v_stress_p_zz) stress_s_zz=$(v_stress_s_zz)"


# One iteration per value in ${stage_targets} (see PARAMETERS). next/jump SELF
# idiom, same as slab_with_support.lmp and triaxial_compression.lmp.
variable stage_prev_target equal 0.0
print ">>> STAGE SWEEP LIST: ${stage_targets_list}"

label stage_loop

print "========================================"
print "Stage: compress to compress_strain_vol = ${stage_targets}"
print "========================================"

# Ramp velocity sized off THIS stage's incremental strain (current cumulative
# target minus the previous one) — fix halt (below) is what actually stops
# the ramp; this only needs to be fast enough not to blow the nsteps_compress cap.
variable stage_target_comp equal 1.0-(1.0-${stage_targets})^(1.0/3.0)
variable stage_prev_comp   equal 1.0-(1.0-${stage_prev_target})^(1.0/3.0)
variable vcompress_z equal $((v_stage_target_comp-v_stage_prev_comp)*v_gap_z_0/(2.0*v_nsteps_compress_base*v_timestep_prod)*1.1)
variable vcompress_y equal $((v_stage_target_comp-v_stage_prev_comp)*v_gap_y_0/(2.0*v_nsteps_compress_base*v_timestep_prod)*1.1)
variable vcompress_x equal $((v_stage_target_comp-v_stage_prev_comp)*v_gap_x_0/(2.0*v_nsteps_compress_base*v_timestep_prod)*1.1)
print ">>> vcompress_z=${vcompress_z}  vcompress_y=${vcompress_y}  vcompress_x=${vcompress_x}"

fix drive_top   plate_top   move linear  0             0            -${vcompress_z}
fix drive_bot   plate_bot   move linear  0             0             ${vcompress_z}
fix drive_front plate_front move linear  0            -${vcompress_y}  0
fix drive_back  plate_back  move linear  0             ${vcompress_y}  0
fix drive_right plate_right move linear -${vcompress_x}  0           0
fix drive_left  plate_left  move linear  ${vcompress_x}  0           0

fix nve_compress  gel     nve
fix lang_compress gel     langevin ${temp_target} ${temp_target} ${lang_T_damp} 71623
fix mom_lin_c     gel     momentum 100 linear 1 1 1
fix mom_rot_c     gel     momentum 100 angular

fix halt_compress all halt ${halt_freq} v_compress_strain_vol >= ${stage_targets} error continue

run ${nsteps_compress}

unfix halt_compress
unfix mom_rot_c
unfix mom_lin_c
unfix lang_compress
unfix nve_compress
unfix drive_left
unfix drive_right
unfix drive_back
unfix drive_front
unfix drive_bot
unfix drive_top

print ">>> compression done: compress_strain_z=$(v_compress_strain_z) compress_strain_vol=$(v_compress_strain_vol)"
print "freeze + NVT drain/equilibrate (${nsteps} steps)"

fix freeze_top   plate_top   move linear 0 0 0
fix freeze_bot   plate_bot   move linear 0 0 0
fix freeze_front plate_front move linear 0 0 0
fix freeze_back  plate_back  move linear 0 0 0
fix freeze_right plate_right move linear 0 0 0
fix freeze_left  plate_left  move linear 0 0 0
fix nvt_prod     gel         nvt  temp ${temp_target} ${temp_target} 1.0
fix mom_prod     gel         momentum 100 linear 1 1 1 angular

# file vs append via is_file() (not a stage counter) — works for any list
# length: first stage's file doesn't exist -> file, later stages -> append.
variable stress_file_exists equal is_file(output_files/stress_data/stress_tensor_polymer_${dataname}_${interaction}_${nsteps}.dat)
if "${stress_file_exists} == 0" then &
    "variable stress_write_mode string file" &
else &
    "variable stress_write_mode string append"

fix avg_stress_polymer all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_p_xx v_stress_p_yy v_stress_p_zz &
    v_stress_p_xy v_stress_p_zx v_stress_p_yz &
    ${stress_write_mode} output_files/stress_data/stress_tensor_polymer_${dataname}_${interaction}_${nsteps}.dat

fix avg_stress_solvent all ave/time ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    v_stress_s_xx v_stress_s_yy v_stress_s_zz &
    v_stress_s_xy v_stress_s_zx v_stress_s_yz &
    ${stress_write_mode} output_files/stress_data/stress_tensor_solvent_${dataname}_${interaction}_${nsteps}.dat

fix prof_z_polymer poly_bulk ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_z_polymer &
    v_s_p_xx v_s_p_yy v_s_p_zz v_s_p_xy v_s_p_zx v_s_p_yz &
    norm none &
    ${stress_write_mode} output_files/stress_data/stress_profile_z_polymer_${dataname}_${interaction}_${nsteps}.dat

fix prof_z_solvent solv_bulk ave/chunk ${nevery_stress} ${nrepeat_stress} ${nfreq_stress} &
    chunk_z_solvent &
    v_s_s_xx v_s_s_yy v_s_s_zz v_s_s_xy v_s_s_zx v_s_s_yz &
    norm none &
    ${stress_write_mode} output_files/stress_data/stress_profile_z_solvent_${dataname}_${interaction}_${nsteps}.dat

# Epoch-aligned hold length — see NOTE at top of file. Re-evaluated each loop
# iteration since $(step) is expanded immediately.
variable hold_steps equal (floor(($(step)+${nsteps}-1)/${nfreq_stress})+1)*${nfreq_stress}-$(step)
print ">>> hold aligned: ${hold_steps} steps (requested ${nsteps}, nfreq_stress=${nfreq_stress})"

run ${hold_steps}

unfix prof_z_solvent
unfix prof_z_polymer
unfix avg_stress_solvent
unfix avg_stress_polymer
unfix mom_prod
unfix nvt_prod
unfix freeze_left
unfix freeze_right
unfix freeze_back
unfix freeze_front
unfix freeze_bot
unfix freeze_top

print ">>> hold done: compress_strain_vol=$(v_compress_strain_vol) stress_p_zz=$(v_stress_p_zz) stress_s_zz=$(v_stress_s_zz)"

variable stage_prev_target equal ${stage_targets}
next stage_targets
jump SELF stage_loop


# ── CLEANUP ──
# Each loop iteration tears down its own hold fixes, so nothing is left
# dangling here — this just closes the dump and reports the final state.

undump traj_prod

print "========================================"
print "Compression slab simulation complete (${stage_targets_list} slope method)"
print "  compress_strain_z   = $(v_compress_strain_z)"
print "  compress_strain_y   = $(v_compress_strain_y)"
print "  compress_strain_x   = $(v_compress_strain_x)"
print "  compress_strain_vol = $(v_compress_strain_vol)  (= final ε_vol)"
print "  gel (Rg): $(v_gel_lx_rg) x $(v_gel_ly_rg) x $(v_gel_lz_rg)"
print "  Final box: $(lx) x $(ly) x $(lz)"
print "  stress_tensor_polymer/solvent_*.dat and stress_profile_z_*_*.dat now"
print "  contain 3 equilibrated stages (appended) — fit ΔP′_net vs ε_vol"
print "  across them (plus the ε_vol=0 origin) for the slope = K."
print "========================================"

variable outfile string "final_compress_${dataname}_${interaction}_${nsteps}"
write_data ${outfile}.data
