#!/usr/bin/env bash

#SBATCH --job-name=compress_slab
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH --mem=0
#SBATCH --time=2:00:00
#SBATCH --output=%x.o%j.%N
# #SBATCH --error=%x.e%j.%N

# -----------------------------------------------------------------------
# SELF-SYNC GUARD (must run BEFORE COMPRESS_STAGES is defined below).
# sbatch submits whatever copy of this file is on disk at submit time. If
# that local copy is STALE, the run silently does the wrong thing — and
# run_lammps.sh's own `git pull` is too late to fix it, because this batch
# has ALREADY exported COMPRESS_STAGES by the time run_lammps.sh runs.
# Fix: pull the repo FIRST, then re-exec the freshly pulled batch so
# COMPRESS_STAGES is always read from the current file. The guard var
# prevents an exec loop. (Mirrors shear_slab.batch / triaxial_compression.batch.)
# -----------------------------------------------------------------------
LAMMPS_WORK_DIR="$HOME/Documents/lammps_work"
if [ -z "${COMPRESS_BATCH_SYNCED:-}" ]; then
    echo ">>> [self-sync] pulling lammps_work before defining COMPRESS_STAGES..."
    command -v git &>/dev/null && git -C "$LAMMPS_WORK_DIR" pull --rebase --autostash || true
    export COMPRESS_BATCH_SYNCED=1
    exec bash "$LAMMPS_WORK_DIR/simulations/compress_slab/compress_slab.batch"
fi
echo ">>> [self-sync] running freshly synced batch (COMPRESS_BATCH_SYNCED=1)"

# Set environment variables
declare -xr OMPI_UNIT='core'
declare -xr OMPI_MCA_btl='self,vader'

declare -xr UCX_LOG_LEVEL='ERROR'
declare -xr UCX_TLS='self,cma,shm,rc,ud,dc'
declare -xr UCX_NET_DEVICES='mlx5_2:1'
declare -xir UCX_MAX_RNDV_RAILS=1

declare -xir OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"

# Load required modules for LAMMPS on Expanse (use this order)
module reset
module load gcc/10.2.0
module load openmpi/4.1.3
module load python/3.8.12

# -----------------------------------------------------------------------
# Simulation parameters
# DATANAME: isolated swollen gel with six plates (from add_more_plates_to_gel.ipynb)
#   Input data file: lammps_data/input_data/${DATANAME}.data
# NSTEPS: length of EACH per-stage hold (one per COMPRESSION_N below); all
#         other phase lengths live in compress_slab.lmp
#   Phase 0   (NVT settle):   nsteps_phase0   = 50000
#   Phase 0.5 (NPH equil):    nsteps_npt      = 50000
#   Phase 1b  (NVT equil):    nsteps_equil    = 50000
#   Stage 0   (eps=0 ref):    nsteps_ref      = 100000
#   Stage ramps:              nsteps_compress = 30000 cap (halts at ~10000)
#   Stage holds:              NSTEPS (set here), once per stage
# -----------------------------------------------------------------------
FOLDER="compress_slab"
DATANAME="isolated_slab_support_5beads_tall_rho04_p1.5_1.0_1.0_600000_with_six_plates"
INTERACTION="1.0_1.0"   # epsSS_epsSP (solvent-solvent _ polymer-solvent)
NSTEPS=200000
TYPE=""                 # Options: stress, volume, stressvol, or leave empty

# -----------------------------------------------------------------------
# Compression ladder: cumulative volumetric strain target for each stage, in
# order. This — not compress_slab.lmp — is the one place that controls both
# how many compression stages run and how deep each one goes. Add or remove
# COMPRESSION_N lines to change the stage count; each value is a TOTAL
# (cumulative) strain target, not an increment on top of the previous one.
COMPRESSION_1=0.015
COMPRESSION_2=0.030
COMPRESSION_3=0.045
STAGE_TARGETS=("$COMPRESSION_1" "$COMPRESSION_2" "$COMPRESSION_3")
export COMPRESS_STAGES="${STAGE_TARGETS[*]}"   # scalar, space-separated —
    # arrays do NOT survive into a child process's environment, so this must
    # stay a plain string (same gotcha documented in triaxial_compression.batch).

# Navigate to the scripts directory
cd ~/Documents/lammps_work/scripts || exit 1

# Run the simulation
if [ -z "$TYPE" ]; then
    bash run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS"
else
    bash run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS" "$TYPE"
fi
