#!/usr/bin/env bash

#SBATCH --job-name=compress_slab
#SBATCH --partition=compute
#SBATCH --account=csb197
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH --mem=0
#SBATCH --time=2:00:00
#SBATCH --output=%x.o%j.%N
# #SBATCH --error=%x.e%j.%N

# Set environment variables
declare -xr OMPI_UNIT='core'
declare -xr OMPI_MCA_btl='self,vader'

declare -xr UCX_LOG_LEVEL='ERROR'
declare -xr UCX_TLS='self,cma,shm,rc,ud,dc'
declare -xr UCX_NET_DEVICES='mlx5_2:1'
declare -xir UCX_MAX_RNDV_RAILS=1

declare -xir OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"

# Load required modules for LAMMPS on Expanse (use this order)
module reset
module load gcc/10.2.0
module load openmpi/4.1.3
module load python/3.8.12

# -----------------------------------------------------------------------
# Simulation parameters
# DATANAME: isolated swollen gel with six plates (from add_more_plates_to_gel.ipynb)
#   Input data file: lammps_data/input_data/${DATANAME}.data
# NSTEPS: length of EACH per-stage hold (3 stages); all other phase lengths
#         live in compress_slab.lmp
#   Phase 0   (NVT settle):   nsteps_phase0   = 50000
#   Phase 0.5 (NPH equil):    nsteps_npt      = 50000
#   Phase 1b  (NVT equil):    nsteps_equil    = 50000
#   Stage 0   (eps=0 ref):    nsteps_ref      = 100000
#   Stage ramps:              nsteps_compress = 30000 cap (halts at ~10000)
#   Stage holds:              NSTEPS (set here), x3
# -----------------------------------------------------------------------
FOLDER="compress_slab"
DATANAME="isolated_slab_support_5beads_tall_rho04_p1.5_1.0_1.0_600000_with_six_plates"
INTERACTION="1.0_1.0"   # epsSS_epsSP (solvent-solvent _ polymer-solvent)
NSTEPS=200000
TYPE=""                 # Options: stress, volume, stressvol, or leave empty

# Navigate to the scripts directory
cd ~/Documents/lammps_work/scripts || exit 1

# Run the simulation
if [ -z "$TYPE" ]; then
    bash run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS"
else
    bash run_lammps.sh "$FOLDER" "$DATANAME" "$INTERACTION" "$NSTEPS" "$TYPE"
fi
