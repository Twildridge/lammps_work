# ── Trajectory & restart files (can be enormous) ──
*.lammpstrj
*.restart
*.restart.*

# ── LAMMPS logs ──
log.lammps
*.log

# ── All output subdirectories ──
output_files/
traj_files/

# ── Final config data files written by LAMMPS ──
final_config_*.data
final_flow_*.data

# ── Scratch symlink (points to Expanse-specific Lustre path) ──
# (traj_files is already covered above, but this catches any other symlinks)

# ── Python/Jupyter cruft ──
__pycache__/
*.pyc
.ipynb_checkpoints/

# ── Editor / script backup files (never commit) ──
*.bak
*.bak.*
*.bak_*
*.backup
*_backup.*
*.orig
*.old
*~

# ── OS clutter ──
.DS_Store

# ── Claude context (local session notes, not for repo) ──
CLAUDE_CONTEXT.md

# SLURM stdout/stderr logs
*.e*.*
*.o*.*
slurm_*.out
slurm_*.err
# ── Removed tracking/efficiency artifacts (see write_tracking.py removal) ──
tracking.txt
tracking_backup.txt
time_vs_atoms.png
time_vs_timesteps.png
